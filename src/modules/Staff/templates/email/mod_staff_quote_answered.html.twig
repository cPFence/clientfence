{% block subject %}[{{ guest.system_company.name }}] Quote #{{ quote.id|default('') }} {{ accepted|default(false) ? 'accepted' : 'declined' }}: {{ quote.subject|default('') }}{% endblock %}
{% block content %}
{# ClientFence: sent to the staff member who made a quote when the client or prospect accepts or
   declines it on its page (ClientFence\Mod\Invoice\Quotes::answer()). #}
{% set quote = quote|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Quote {{ accepted|default(false) ? 'Accepted' : 'Declined' }}</h1>
	<p>Hello {{ c.name|default('') }},</p>
	{% if accepted|default(false) %}
		<p><strong>{{ quote.recipient.company|default('') ?: quote.recipient.name|default('') }}</strong> accepted quote <strong>#{{ quote.id|default('') }} {{ quote.subject|default('') }}</strong>. The invoice was made and emailed{% if quote.invoice_id|default('') %} (invoice #{{ quote.invoice_id }}){% endif %}.</p>
	{% else %}
		<p><strong>{{ quote.recipient.company|default('') ?: quote.recipient.name|default('') }}</strong> declined quote <strong>#{{ quote.id|default('') }} {{ quote.subject|default('') }}</strong>. It is now lost.</p>
	{% endif %}
	<p>Total: <strong>{{ quote.total|default(0)|format_currency(quote.currency|default(default_currency)) }}</strong><br>
	Email: <strong>{{ quote.recipient.email|default('') }}</strong></p>

	<p><a href='{{ quote_admin_url|default('') }}' target="_blank">Open the quote</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
