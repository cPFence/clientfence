{% block subject %}[{{ guest.system_company.name }}] {{ 'New order: %title%'|trans({'%title%': order.title|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'New order placed'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'New order placed'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': staff.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'A new order has been placed on %created_at%.'|trans({'%created_at%': order.created_at|default('')|format_date}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Client'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ order.client.first_name|default('') }} {{ order.client.last_name|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Order'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">#{{ order.id|default('') }} &middot; {{ order.title|default('') }}</td></tr>
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "order/manage/#{order.id|default('')}"|url(area: 'admin') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Review order'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
