{% block subject %}[{{ guest.system_company.name }}] {{ 'ClientFence %version% is available'|trans({'%version%': release.version|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'ClientFence %version% is available'|trans({'%version%': release.version|default('')}) }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'ClientFence %version% is available'|trans({'%version%': release.version|default('')}) }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{% if release.release_date|default('') %}{{ 'A new ClientFence release is out (%date%). This site runs ClientFence %version%.'|trans({'%date%': release.release_date|format_date, '%version%': current_version|default('')}) }}{% else %}{{ 'A new ClientFence release is out. This site runs ClientFence %version%.'|trans({'%version%': current_version|default('')}) }}{% endif %}</p>
{% if release.notes|default('') %}
		<div style="margin:0 0 16px;">{{ release.notes|markdown_to_html }}</div>
{% endif %}
		<p style="margin:0 0 16px;">{{ 'Staff allowed to update the system can install it from System > Update: it backs up the database and the files it replaces, installs the release and updates the database.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ update_url|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'See the update'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
