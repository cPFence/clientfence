{% block subject %}[{{ guest.system_company.name }}] {{ 'Reset your password'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Reset your password'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Reset your password'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We received a request to reset the password for your staff account. Click the button below to choose a new password. For your security, the link expires in 15 minutes.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "staff/email/#{hash|default('')}"|url(area: 'admin') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Choose a new password'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'If you did not ask for a password reset, you can safely ignore this email: your password stays the same.'|trans }}</p>
{% endblock %}
