{% block subject %}[{{ guest.system_company.name }}] Ticket #{{ ticket.id|default('') }} assigned to you: {{ ticket.subject|default('') }}{% endblock %}
{% block content %}
{# ClientFence: sent to a staff member when a ticket is assigned to them (ClientFence\Mod\Support\TicketAssign). #}
{% set ticket = ticket|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Ticket Assigned to You</h1>
	<p>Hello {{ c.name|default('') }},</p>
	<p>{% if assigned_by|default('') %}<strong>{{ assigned_by }}</strong> assigned{% else %}An escalation rule assigned{% endif %} ticket <strong>#{{ ticket.id|default('') }} {{ ticket.subject|default('') }}</strong> to you.</p>
	<p>Help desk: <strong>{{ ticket.helpdesk|default('') }}</strong><br>
	Priority: <strong>{{ ticket.priority_title|default('') }}</strong><br>
	Status: <strong>{{ ticket.status_title|default('') }}</strong></p>

	<p><a href='{{ ticket.url|default('') }}' target="_blank">Open the ticket</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
