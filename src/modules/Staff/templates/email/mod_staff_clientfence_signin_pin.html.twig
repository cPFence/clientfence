{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Your sign-in PIN: %pin%'|trans({'%pin%': pin|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your sign-in PIN'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your sign-in PIN'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Enter this PIN to finish signing in to the staff panel. It works for %minutes% minutes.'|trans({'%minutes%': minutes|default(10)}) }}</p>
		<p style="margin:0 0 16px; padding:16px; background-color:#e3f4f2; border:1px solid #c6e8e3; border-radius:12px; text-align:center; font-family:'Courier New', Courier, monospace; font-size:30px; font-weight:bold; letter-spacing:6px; color:#0c2738;">{{ pin|default('') }}</p>
		<p style="margin:0 0 16px; font-size:13px; color:#64748b;">{{ 'Sign-in from %ip%'|trans({'%ip%': ip|default('')}) }}{% if country|default('') %} ({{ country }}){% endif %}.</p>
		<p style="margin:0 0 16px; padding:12px 16px; background-color:#fdf1d8; border:1px solid #f3d9a4; border-radius:10px; font-size:14px; line-height:22px; color:#7a4a05;">{{ 'If this was not you, do not share the PIN with anyone and change your password: someone knows it.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
