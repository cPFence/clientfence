{% block subject %}[{{ guest.system_company.name }}] Cancellation request: #{{ order.id|default('') }} {{ order.title|default('') }}{% endblock %}
{% block content %}
{# ClientFence: sent when a client asks to cancel a service (ClientFence\Mod\Order\CancelRequests). #}
{% set request = request|default({}) %}
{% set order = order|default({}) %}
{% set client = client|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		pre {
			white-space: pre-wrap;
			background: #f5f5f5;
			padding: 10px;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Cancellation Request</h1>
	<p>Hello {{ staff.name|default('') }},</p>
	<p>{% if client.name|default('') %}<strong>{{ client.name }}</strong>{% else %}A client{% endif %} asked to cancel order <strong>#{{ order.id|default('') }} {{ order.title|default('') }}</strong>{% if request.type|default('') == 'end_of_period' %} at the end of its billing period{% if order.expires_at|default('') %} ({{ order.expires_at|format_date }}){% endif %}{% else %} immediately{% endif %}.</p>
	<p>Reason:</p>
	<pre>{{ request.reason|default('') }}</pre>
	<p>Accept or stop the request in Orders &gt; Cancellation Requests. When cancellation requests are processed automatically, the daily cron accepts it; until then the client can withdraw it.</p>

	<p><a href='{{ order.url|default('') }}' target="_blank">Manage order</a> | <a href='{{ order.list_url|default('') }}' target="_blank">Cancellation Requests</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
