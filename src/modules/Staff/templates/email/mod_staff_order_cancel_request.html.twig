{% block subject %}[{{ guest.system_company.name }}] Cancellation request: #{{ order.id|default('') }} {{ order.title|default('') }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>Cancellation request</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f4f8;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f4f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
	<tr><td style="padding:20px 32px; border-bottom:3px solid #2563eb;">
		{% if guest.system_company.logo_url|default('') %}
		<img src="{{ guest.system_company.logo_url }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;">
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#0f172a;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:22px; line-height:30px; color:#0f172a;">Cancellation request</h1>
		<p style="margin:0 0 16px;">Hello {{ staff.name|default('') }},</p>
		<p style="margin:0 0 16px;">{% if client.name|default('') %}<strong>{{ client.name }}</strong>{% else %}A client{% endif %} asked to cancel order <strong>#{{ order.id|default('') }} {{ order.title|default('') }}</strong>{% if request.type|default('') == 'end_of_period' %} at the end of its billing period{% if order.expires_at|default('') %} ({{ order.expires_at|format_date }}){% endif %}{% else %} immediately{% endif %}.</p>
		<p style="margin:0 0 16px;">Reason given:</p>
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f8fafc; border-left:3px solid #cbd5e1; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ request.reason|default('') }}</div>
		<p style="margin:0 0 16px;">Accept or stop the request in Orders &gt; Cancellation Requests. When cancellation requests are processed automatically, the daily cron accepts it; until then the client can withdraw it.</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td style="border-radius:6px; background-color:#2563eb;">
				<a href="{{ order.list_url|default('') }}" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none;">Open Cancellation Requests</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;"><a href="{{ order.url|default('') }}" target="_blank" style="color:#2563eb;">Manage the order</a></p>
	</td></tr>
	<tr><td style="padding:20px 32px; border-top:1px solid #e2e8f0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		<a href="{{ 'staff/login'|url(area: 'admin') }}" target="_blank" style="color:#64748b;">Admin area</a>
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
