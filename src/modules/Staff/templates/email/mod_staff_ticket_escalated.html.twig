{% block subject %}[{{ guest.system_company.name }}] {{ 'Ticket #%id% escalated: %subject%'|trans({'%id%': ticket.id|default(''), '%subject%': ticket.subject|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Ticket escalated'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Ticket escalated'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Ticket %ticket% got no reply for %minutes% min, so the escalation rule %name% acted on it.'|trans_html({'%minutes%': rule.minutes|default('')}, {'%ticket%': '<strong>#' ~ (ticket.id|default(''))|e ~ ' ' ~ (ticket.subject|default(''))|e ~ '</strong>', '%name%': '<strong>' ~ (rule.name|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Ticket'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">#{{ ticket.id|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Help desk'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ ticket.helpdesk|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Priority'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;"><span style="display:inline-block; padding:2px 10px; border-radius:999px; background-color:#d9f2ef; color:#0e5a7a; font-size:12px; font-weight:bold; line-height:18px;">{{ ticket.priority_title|default('')|trans }}</span></td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Status'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;"><span style="display:inline-block; padding:2px 10px; border-radius:999px; background-color:#d9f2ef; color:#0e5a7a; font-size:12px; font-weight:bold; line-height:18px;">{{ ticket.status_title|default('')|trans }}</span></td></tr>
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ticket.url|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open the ticket'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
