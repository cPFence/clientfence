{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Your password was changed'|trans }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your password was changed'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your password was changed'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'This is a confirmation that the password for your staff account has just been changed.'|trans }}</p>
		<p style="margin:0 0 16px; padding:12px 16px; background-color:#fdf1d8; border:1px solid #f3d9a4; border-radius:10px; font-size:14px; line-height:22px; color:#7a4a05;">{{ 'If you did not make this change, contact your administrator immediately.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'staff/login'|url(query: { 'email': c.email|default('') }, area: 'admin') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Sign in'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
