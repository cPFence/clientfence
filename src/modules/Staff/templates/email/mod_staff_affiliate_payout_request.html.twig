{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Affiliate payout request from %name%'|trans({'%name%': affiliate.name|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Affiliate payout request'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Affiliate payout request'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': staff.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ '%affiliate% asked for an affiliate payout of %amount%. The amount is set aside from the affiliate\'s available balance until you pay or decline it.'|trans_html({}, {'%affiliate%': '<strong>' ~ (affiliate.name|default(''))|e ~ (affiliate.company|default('') ? ' (' ~ affiliate.company|e ~ ')' : '') ~ '</strong>', '%amount%': '<strong>' ~ (payout.amount|default(0)|format_currency(payout.currency|default(default_currency)))|e ~ '</strong>'}) }}</p>
		<p style="margin:0 0 8px;">{{ 'Payout details:'|trans }}</p>
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f3f6f8; border-left:3px solid #14a39a; border-radius:8px; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ payout.details|default('') }}</div>
		<p style="margin:0 0 16px;">{{ 'Pay it as account credit, record a payment you made outside ClientFence, or decline it on the client\'s Affiliate tab.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ url|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open the Affiliate tab'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
