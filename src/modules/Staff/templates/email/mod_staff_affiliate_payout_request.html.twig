{% block subject %}[{{ guest.system_company.name }}] {{ 'Affiliate payout request from %name%'|trans({'%name%': affiliate.name|default('')}) }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ 'Affiliate payout request'|trans }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f4f8;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f4f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
	<tr><td style="padding:20px 32px; border-bottom:3px solid {{ guest.system_company.brand_color|default('#2563eb') }};">
		{% if guest.system_company.logo_url|default('') %}
		<img src="{{ guest.system_company.logo_url }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;">
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#0f172a;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:22px; line-height:30px; color:#0f172a;">{{ 'Affiliate payout request'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': staff.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ '%affiliate% asked for an affiliate payout of %amount%. The amount is set aside from the affiliate\'s available balance until you pay or decline it.'|trans_html({}, {'%affiliate%': '<strong>' ~ (affiliate.name|default(''))|e ~ (affiliate.company|default('') ? ' (' ~ affiliate.company|e ~ ')' : '') ~ '</strong>', '%amount%': '<strong>' ~ (payout.amount|default(0)|format_currency(payout.currency|default(default_currency)))|e ~ '</strong>'}) }}</p>
		<p style="margin:0 0 8px;">{{ 'Payout details:'|trans }}</p>
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f8fafc; border-left:3px solid #cbd5e1; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ payout.details|default('') }}</div>
		<p style="margin:0 0 16px;">{{ 'Pay it as account credit, record a payment you made outside ClientFence, or decline it on the client\'s Affiliate tab.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td style="border-radius:6px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }};">
				<a href="{{ url|default('') }}" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open the Affiliate tab'|trans }}</a>
			</td></tr>
		</table>
	</td></tr>
	<tr><td style="padding:20px 32px; border-top:1px solid #e2e8f0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		<a href="{{ 'staff/login'|url(area: 'admin') }}" target="_blank" style="color:#64748b;">{{ 'Admin area'|trans }}</a>
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
