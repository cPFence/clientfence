{% extends 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Profile'|trans }}{% endblock %}

{% block content %}
{% embed 'partial_admin_detail_tabs.html.twig' with {
    title: profile.name,
    subtitle: 'Manage your staff profile details, update your password, and rotate your API key.'|trans
} %}
    {% block detail_tabs %}
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" href="#tab-profile" data-bs-toggle="tab" role="tab">{{ 'Profile'|trans }}</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" href="#tab-password" data-bs-toggle="tab" role="tab">{{ 'Change Password'|trans }}</a>
                    </li>
                    {# ClientFence core patch: the staff member's own authenticator sign-in (Client/TwoFactor.php). #}
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" href="#tab-twofactor" data-bs-toggle="tab" role="tab">{{ 'Two-factor sign-in'|trans }}</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" href="#tab-api" data-bs-toggle="tab" role="tab">API</a>
                    </li>
    {% endblock %}

    {% block detail_tab_content %}
        <div class="tab-pane fade show active" id="tab-profile" role="tabpanel">
            <div class="p-3">
                <form method="post" action="{{ 'profile/update'|api_url }}" {{ fb_api_form({message: 'Profile Updated'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Profile Details'|trans,
                        subtitle: 'Update the name, email address, and signature shown for your staff account.'|trans
                    } %}
                        {% block form_content %}
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Name'|trans }}</label>
                                    <input class="form-control" type="text" name="name" value="{{ profile.name }}" required>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Email'|trans }}</label>
                                    <input class="form-control" type="text" name="email" value="{{ profile.email }}" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">{{ 'Signature'|trans }}</label>
                                    <textarea class="form-control" name="signature" rows="3">{{ profile.signature }}</textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="timezone">{{ 'Timezone'|trans }}</label>
                                    <select class="form-select" name="timezone" id="timezone" data-timezone-select>
                                        <option value="">{{ '-- Use system default --'|trans }}</option>
                                        {% for region, identifiers in guest.system_timezones %}
                                            <optgroup label="{{ region }}">
                                                {% for identifier in identifiers %}
                                                    <option value="{{ identifier }}" {% if identifier == profile.timezone %}selected="selected"{% endif %}>{{ identifier }}</option>
                                                {% endfor %}
                                            </optgroup>
                                        {% endfor %}
                                    </select>
                                    <small class="form-hint text-muted">{{ 'Used to display dates and times in your local time across tickets, invoices, and the admin dashboard.'|trans }}</small>
                                </div>
                            </div>
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Update profile'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-password" role="tabpanel">
            <div class="p-3">
                <form method="post" action="{{ 'profile/change_password'|api_url }}" {{ fb_api_form({message: 'Password Changed'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Change Password'|trans,
                        subtitle: 'Enter your current password and choose a new one for this staff account.'|trans
                    } %}
                        {% block form_content %}
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <label for="current_password" class="form-label">{{ 'Current Password'|trans }}</label>
                                    <input class="form-control" type="password" name="current_password" id="current_password" required>
                                </div>
                                <div class="col-lg-4">
                                    <label for="new_password" class="form-label">{{ 'New Password'|trans }}</label>
                                    <input class="form-control" type="password" name="new_password" id="new_password" required>
                                </div>
                                <div class="col-lg-4">
                                    <label for="confirm_password" class="form-label">{{ 'Confirm Password'|trans }}</label>
                                    <input class="form-control" type="password" name="confirm_password" id="confirm_password" required>
                                </div>
                            </div>
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Change Password'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>

        {% set twofactor = admin.profile_twofactor_get %}
        <div class="tab-pane fade" id="tab-twofactor" role="tabpanel">
            <div class="p-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{ 'Two-factor sign-in'|trans }}</h3>
                        <p class="text-secondary">{{ 'After your password, enter a code from an authenticator app such as Google Authenticator, Microsoft Authenticator or 1Password. The email PIN is always offered instead when you sign in.'|trans }}</p>
                        {% if twofactor.enabled %}
                            <p>
                                <span class="badge bg-success-lt">{{ 'On'|trans }}</span>
                                {{ 'Since %date%.'|trans({ '%date%': twofactor.enabled_at|format_datetime }) }}
                                {% if not twofactor.backup %}<span class="text-warning">{{ 'Your backup code was used: make a new one.'|trans }}</span>{% endif %}
                            </p>
                            <div class="row g-4" data-cf-2fa-forms>
                                <form class="col-lg-6" method="post" action="{{ 'profile/twofactor_backup'|api_url }}" {{ fb_api_form({ callback: 'cfTwoFactorBackup' }) }}>
                                    <h4>{{ 'New backup code'|trans }}</h4>
                                    <label class="form-label" for="cf-2fa-backup-password">{{ 'Password'|trans }}</label>
                                    <input class="form-control mb-3" type="password" name="password" id="cf-2fa-backup-password" autocomplete="current-password" required>
                                    <button class="btn" type="submit">{{ 'Make a new backup code'|trans }}</button>
                                </form>
                                <form class="col-lg-6" method="post" action="{{ 'profile/twofactor_disable'|api_url }}" {{ fb_api_form({ message: 'Two-factor sign-in is off.'|trans, reload: true }) }}>
                                    <h4>{{ 'Switch off'|trans }}</h4>
                                    <label class="form-label" for="cf-2fa-off-password">{{ 'Password'|trans }}</label>
                                    <input class="form-control mb-2" type="password" name="password" id="cf-2fa-off-password" autocomplete="current-password" required>
                                    <label class="form-label" for="cf-2fa-off-code">{{ 'Code from the app or the backup code'|trans }}</label>
                                    <input class="form-control mb-3" type="text" name="code" id="cf-2fa-off-code" inputmode="numeric" autocomplete="one-time-code" dir="ltr" required>
                                    <button class="btn btn-outline-danger" type="submit">{{ 'Switch off two-factor sign-in'|trans }}</button>
                                </form>
                            </div>
                        {% else %}
                            <div data-cf-2fa-start>
                                <a class="btn btn-primary" href="{{ 'profile/twofactor_setup'|api_url }}" {{ fb_api_link({ callback: 'cfTwoFactorSetup' }) }}>{{ 'Set up two-factor sign-in'|trans }}</a>
                            </div>
                            <div class="row g-4" data-cf-2fa-forms data-cf-2fa-setup hidden>
                                <div class="col-lg-5">
                                    <p>{{ 'Scan this QR code with your authenticator app, or type in the key.'|trans }}</p>
                                    <div class="cf-2fa-qr border rounded p-2 bg-white mb-2" data-cf-2fa-qr></div>
                                    <code class="d-inline-block" dir="ltr" data-cf-2fa-secret></code>
                                </div>
                                <form class="col-lg-7" method="post" action="{{ 'profile/twofactor_enable'|api_url }}" {{ fb_api_form({ callback: 'cfTwoFactorBackup' }) }}>
                                    <label class="form-label" for="cf-2fa-code">{{ 'Code from the app'|trans }}</label>
                                    <input class="form-control mb-2" type="text" name="code" id="cf-2fa-code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" dir="ltr" required>
                                    <label class="form-label" for="cf-2fa-password">{{ 'Password'|trans }}</label>
                                    <input class="form-control mb-3" type="password" name="password" id="cf-2fa-password" autocomplete="current-password" required>
                                    <button class="btn btn-primary" type="submit">{{ 'Switch on two-factor sign-in'|trans }}</button>
                                </form>
                            </div>
                        {% endif %}
                        <div class="alert alert-warning mt-3 mb-0" role="alert" data-cf-2fa-backup hidden>
                            <h4 class="alert-title">{{ 'Your backup code'|trans }}</h4>
                            <p><code class="fs-3" dir="ltr" data-cf-2fa-backup-code></code></p>
                            <p>{{ 'Keep it somewhere safe: it signs you in once if you lose your phone. It is shown only now.'|trans }}</p>
                            <a class="btn" href="{{ 'staff/profile'|url }}#tab-twofactor">{{ 'Done'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-api" role="tabpanel">
            <div class="p-3">
                <form method="post" action="{{ 'profile/generate_api_key'|api_url }}" {{ fb_api_form({callback: 'onAfterKeyUpdate'}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'API Key'|trans,
                        subtitle: 'Use this token for external integrations. Rotating it will immediately invalidate existing API clients.'|trans
                    } %}
                        {% block form_content %}
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">{{ 'API Key'|trans }}</label>
                                    <input class="form-control" id="apikey" type="text" value="{{ admin.profile_get.api_token }}" readonly>
                                </div>
                            </div>
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Generate New Key'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block js %}
<script nonce="{{ csp_nonce }}">
    // ClientFence core patch: two-factor sign-in setup (the QR code comes from the admin bundle, ClientFenceQr).
    function cfTwoFactorSetup(result) {
        document.querySelector('[data-cf-2fa-start]').hidden = true;
        document.querySelector('[data-cf-2fa-setup]').hidden = false;
        document.querySelector('[data-cf-2fa-secret]').textContent = result.secret;
        globalThis.ClientFenceQr?.(result.uri).then((svg) => document.querySelector('[data-cf-2fa-qr]').replaceChildren(svg));
    }

    function cfTwoFactorBackup(result) {
        document.querySelectorAll('[data-cf-2fa-forms]').forEach((el) => { el.hidden = true; });
        document.querySelector('[data-cf-2fa-backup-code]').textContent = result.backup_code;
        document.querySelector('[data-cf-2fa-backup]').hidden = false;
    }

    function onAfterKeyUpdate(result) {
        ClientFence.api.admin.post('profile/get', {},
            (result) => {
                document.getElementById('apikey').value = result.api_token;
                ClientFence.message("{{ 'New API key generated. Applications using old key are now not working.'|trans }}");
            });
    }
</script>
{% endblock %}
