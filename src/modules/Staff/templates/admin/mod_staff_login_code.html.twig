{# ClientFence: the authenticator code step of a staff sign-in (Client/TwoFactor.php; Staff guest API
   login_code). The email PIN is offered instead: either one signs in. `trust_days`. #}
{% extends 'layout_login.html.twig' %}

{% block meta_title %}{{ 'Two-factor sign-in'|trans }}{% endblock %}

{% block content %}
{% embed 'partial_admin_auth_card.html.twig' with {
    title: 'Two-factor sign-in'|trans
} %}
    {% block auth_form %}
                <p class="text-secondary">{{ 'Enter the 6-digit code from your authenticator app, or your backup code.'|trans }}</p>
                <form method="post" action="{{ 'staff/login_code'|api_url(role: 'guest') }}" {{ fb_api_form({redirect: redirect_uri|default('/')|url}) }} autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="inputCode">{{ 'Code'|trans }}</label>
                        <input class="form-control form-control-lg text-center"
                            id="inputCode"
                            type="text"
                            name="code"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            maxlength="19"
                            dir="ltr"
                            required
                            autofocus>
                    </div>
                    <label class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="trust" value="1">
                        <span class="form-check-label">{{ 'Trust this browser for %days% days'|trans({'%days%': trust_days|default(30)}) }}</span>
                    </label>
                    <div class="form-footer d-flex justify-content-center">
                        <button class="btn btn-primary px-5" type="submit">{{ 'Sign in'|trans }}</button>
                    </div>
                </form>
                <div class="d-flex flex-wrap justify-content-between gap-2 mt-3 small">
                    <a href="{{ 'staff/login_code_email'|api_url(role: 'guest') }}" {{ fb_api_link({ redirect: 'staff/login/pin'|url }) }}>{{ 'Email me a PIN instead'|trans }}</a>
                    <a href="{{ 'staff/login'|url }}">{{ 'Back to Login'|trans }}</a>
                </div>
    {% endblock %}
{% endembed %}
{% endblock %}
