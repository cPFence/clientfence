{% block subject %}[{{ guest.system_company.name }}] {{ order.title|default('') }} is ready{% endblock %}
{% block content %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>Your hosting account is ready</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f4f8;">
<div style="display:none; max-height:0; overflow:hidden;">Your hosting account is set up and ready to use.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f4f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
	<tr><td style="padding:20px 32px; border-bottom:3px solid #2563eb;">
		{% if guest.system_company.logo_url|default('') %}
		<img src="{{ guest.system_company.logo_url }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;">
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#0f172a;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:22px; line-height:30px; color:#0f172a;">Your hosting account is ready</h1>
		<p style="margin:0 0 16px;">Dear {{ c.first_name|default('') }} {{ c.last_name|default('') }},</p>
		<p style="margin:0 0 16px;">Thank you for choosing {{ guest.system_company.name }}. Your hosting account <strong>{{ order.title|default('') }}</strong> has been set up. This email holds everything you need to start using it: please keep it for your records.</p>
		<p style="margin:0 0 16px; padding:12px 16px; background-color:#fff7ed; border:1px solid #fed7aa; border-radius:6px; font-size:14px; line-height:22px; color:#9a3412;">If you ordered a domain with this account, it can take up to 48 hours to be visible everywhere on the internet while DNS changes propagate.</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Service</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ order.title|default('') }}</td></tr>
					{% if order.activated_at|default(false) %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Activated</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ order.activated_at|default('')|format_date }}</td></tr>{% endif %}
					{% if order.expires_at|default(false) %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Next due date</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ order.expires_at|default('')|format_date }}</td></tr>{% endif %}
					{% if order.period|default(false) %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Billing</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ order.total|default(0)|format_currency(order.currency|default(default_currency)) }} {{ order.period|default('')|period_title }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<h2 style="margin:8px 0 12px; font-size:16px; line-height:24px; color:#0f172a;">Account details</h2>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					{% if service.hosting_plan.name|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Hosting plan</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.hosting_plan.name|default('') }}</td></tr>{% endif %}
					{% if service.domain|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Domain</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.domain|default('') }}</td></tr>{% endif %}
					{% if service.username|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Username</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ service.username|default('') }}</td></tr>{% endif %}
					{% if service.server.ip|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">IP address</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ip|default('') }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<h2 style="margin:8px 0 12px; font-size:16px; line-height:24px; color:#0f172a;">Control panel</h2>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					{% if service.server.cpanel_url|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Control panel</td><td align="right" style="padding:4px 0; vertical-align:top;"><a href="{{ service.server.cpanel_url }}" target="_blank" style="color:#2563eb;">{{ service.server.cpanel_url }}</a></td></tr>{% endif %}
					{% if service.username|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Username</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.username|default('') }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">For your security, passwords are never sent by email. Sign in to the client area to open your control panel directly or to set a new hosting password.</p>
		<h2 style="margin:8px 0 12px; font-size:16px; line-height:24px; color:#0f172a;">Server and nameservers</h2>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					{% if service.server.name|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Server</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.name|default('') }}</td></tr>{% endif %}
					{% if service.server.ip|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Server IP</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ip|default('') }}</td></tr>{% endif %}
					{% if service.server.ns1|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Nameserver 1</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ns1|default('') }}</td></tr>{% endif %}
					{% if service.server.ns2|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Nameserver 2</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ns2|default('') }}</td></tr>{% endif %}
					{% if service.server.ns3|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Nameserver 3</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ns3|default('') }}</td></tr>{% endif %}
					{% if service.server.ns4|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">Nameserver 4</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.server.ns4|default('') }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td style="border-radius:6px; background-color:#2563eb;">
				<a href="{{ "order/service/manage/#{order.id|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none;">Manage hosting</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
	</td></tr>
	<tr><td style="padding:20px 32px; border-top:1px solid #e2e8f0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		<a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank" style="color:#64748b;">Client area</a> &middot; <a href="{{ 'client/profile'|url(area: 'client') }}" target="_blank" style="color:#64748b;">Profile</a>{% if guest.system_company.email|default('') %} &middot; {% endif %}{% if guest.system_company.email|default('') %}<a href="mailto:{{ guest.system_company.email }}" style="color:#64748b;">{{ guest.system_company.email }}</a>{% endif %}
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
