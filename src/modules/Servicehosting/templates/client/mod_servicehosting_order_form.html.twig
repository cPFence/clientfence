{# ClientFence core patch (CF-146): the hosting plan's domain as a section of the one-page checkout (mod_order_product.html.twig), as WHMCS's one-step order form: the choices the product allows in one segmented row like the billing cycles, the availability or transfer check, the years, the transfer code, an own domain or a free subdomain. hosting-domain.js runs it; the domain[...] fields are the ones the cart reads. #}
{% set tlds = guest.serviceDomain_tlds({"allow_register":1}) %}
{% set transfer_tlds = guest.serviceDomain_tlds({"allow_transfer":1}) %}

{# Domain configuration settings default to enabled when unset. #}
{% set allow_register = product.config.allow_domain_register ?? true %}
{% set allow_transfer = product.config.allow_domain_transfer ?? true %}
{% set allow_own = product.config.allow_domain_own ?? true %}
{% set allow_subdomain = product.config.allow_subdomain ?? false %}
{% set subdomain_base_domain = product.config.subdomain_base_domain ?? null %}

{# Determine which options are actually available #}
{% set can_register = allow_register and tlds is not empty %}
{% set can_transfer = allow_transfer and transfer_tlds is not empty %}
{% set can_own = allow_own %}
{% set can_subdomain = allow_subdomain and subdomain_base_domain %}

{# The first available choice is the default one. #}
{% set choices = {register: can_register ? 'Register'|trans : null, transfer: can_transfer ? 'Transfer'|trans : null, owndomain: can_own ? 'Own domain'|trans : null, subdomain: can_subdomain ? 'Free subdomain'|trans : null}|filter(v => v) %}
{% set default_action = choices|keys|first %}

{% if choices %}
<section class="card bf-card bf-section cf-order-domain" aria-labelledby="bf-h-domain" data-cf-hosting-domain>
    <h2 id="bf-h-domain">{{ 'Domain'|trans }}</h2>
    <div class="bf-seg cf-dc-choice" role="group" aria-label="{{ 'Domain'|trans }}">
        {% for action, label in choices %}
            <button type="button" class="bf-seg-item{{ action == default_action ? ' is-on' : '' }}" aria-pressed="{{ action == default_action ? 'true' : 'false' }}" data-domain-action="{{ action }}">{{ label }}</button>
        {% endfor %}
    </div>

    <div class="cf-dc-panel">
        {% if can_register %}
            <div data-domain-pane="register"{% if default_action != 'register' %} hidden{% endif %}>
                <label class="form-label" for="cf-dc-register">{{ 'Register a new domain'|trans }}</label>
                <div class="d-flex flex-wrap gap-2">
                    <div class="input-group cf-dc-input">
                        <input class="form-control" type="text" id="cf-dc-register" name="domain[register_sld]" autocomplete="off"
                               value="{{ request.register_sld }}"
                               placeholder="{{ 'Enter new domain name to register'|trans }}">
                        <select class="form-select cf-dc-tld" name="domain[register_tld]" dir="ltr" aria-label="{{ 'Register a new domain'|trans }}">
                            {% for tld in tlds %}
                                <option value="{{ tld.tld }}">{{ tld.tld }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button class="btn btn-primary" type="button" data-domain-check>{{ 'Check'|trans }}</button>
                </div>
                <div class="mt-3" data-domain-config hidden>
                    <label class="form-label" for="registration-years">{{ 'Registration period'|trans }}</label>
                    <select class="form-select cf-dc-years" name="domain[register_years]" id="registration-years"></select>
                    {{ include('mod_servicedomain_domain_fields.html.twig', {prefix: 'domain[domain_fields]', tld_select: 'domain[register_tld]'}) }}
                </div>
            </div>
        {% endif %}

        {% if can_transfer %}
            <div data-domain-pane="transfer"{% if default_action != 'transfer' %} hidden{% endif %}>
                <label class="form-label" for="cf-dc-transfer">{{ 'Transfer your existing domain'|trans }}</label>
                <div class="d-flex flex-wrap gap-2">
                    <div class="input-group cf-dc-input">
                        <input class="form-control" type="text" id="cf-dc-transfer" name="domain[transfer_sld]" autocomplete="off"
                               value="{{ request.transfer_sld }}"
                               placeholder="{{ 'Enter your domain name to transfer'|trans }}">
                        <select class="form-select cf-dc-tld" name="domain[transfer_tld]" dir="ltr" aria-label="{{ 'Transfer your existing domain'|trans }}">
                            {% for tld in transfer_tlds %}
                                <option value="{{ tld.tld }}" data-require-transfer-code="{{ tld.require_transfer_code ? '1' : '0' }}">{{ tld.tld }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button class="btn btn-primary" type="button" data-domain-check>{{ 'Check'|trans }}</button>
                </div>
                <div class="mt-3" data-domain-config hidden>
                    <p class="fs-7 mb-2">{{ 'Transfer price is'|trans }}&nbsp;<span class="fw-bold" id="transfer-price"></span></p>
                    <input class="form-control cf-dc-code" type="text" name="domain[transfer_code]" id="transfer-code" autocomplete="off"
                           value="{{ request.transfer_code }}" placeholder="{{ 'Enter domain transfer code'|trans }}" aria-label="{{ 'Domain transfer code'|trans }}">
                    <div class="form-hint" id="transfer-code-hint" hidden>{{ 'This TLD requires a transfer code (EPP/auth code) to proceed.'|trans }}</div>
                    {{ include('mod_servicedomain_domain_fields.html.twig', {tlds: transfer_tlds, key: 'transfer_fields', prefix: 'domain[transfer_fields]', tld_select: 'domain[transfer_tld]'}) }}
                </div>
            </div>
        {% endif %}

        {% if can_own %}
            <div data-domain-pane="owndomain"{% if default_action != 'owndomain' %} hidden{% endif %}>
                <label class="form-label" for="cf-dc-own">{{ 'Use your existing domain'|trans }}</label>
                <div class="input-group cf-dc-input">
                    <input class="form-control" type="text" id="cf-dc-own" name="domain[owndomain_sld]" autocomplete="off"
                           value="{{ request.owndomain_sld }}"
                           placeholder="{{ 'Your existing domain'|trans }}">
                    <input class="form-control cf-dc-tld" type="text" name="domain[owndomain_tld]" dir="ltr" autocomplete="off"
                           value="{{ request.owndomain_tld|default('.com') }}"
                           placeholder=".com" aria-label="{{ 'Use your existing domain'|trans }}">
                </div>
                <p class="fs-7 text-muted mt-2 mb-0">{{ 'You will need to update your nameservers to point to our servers.'|trans }}</p>
            </div>
        {% endif %}

        {% if can_subdomain %}
            <div data-domain-pane="subdomain"{% if default_action != 'subdomain' %} hidden{% endif %}>
                <label class="form-label" for="cf-dc-subdomain">{{ 'Choose your free subdomain'|trans }}</label>
                <div class="input-group cf-dc-input cf-dc-input-wide">
                    <input class="form-control" type="text" id="cf-dc-subdomain" name="domain[subdomain_sld]" autocomplete="off"
                           value="{{ request.subdomain_sld }}"
                           placeholder="{{ 'Subdomain'|trans }}">
                    <span class="input-group-text input-group-text-sm" dir="ltr">.{{ subdomain_base_domain|trim('.') }}</span>
                </div>
                <p class="fs-7 text-muted mt-2 mb-0">{{ 'This free subdomain is provided by us. No domain registration or transfer will be added to this order.'|trans }}</p>
            </div>
        {% endif %}
    </div>

    {# ClientFence core patch: domain searches show the guest CAPTCHA (once an hour). #}
    {% if can_register or can_transfer %}{{ include('mod_servicedomain_lookup_captcha.html.twig') }}{% endif %}
    <input type="hidden" name="domain[action]" value="{{ default_action }}" id="domain-action">
</section>
{% endif %}
