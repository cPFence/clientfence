{# ClientFence: hosting plans from a panel server, on the Hosting Plans tab of the Hosting Plans
   and Servers page (shown while a panel with servers is on). `panels`: as for
   mod_servicehosting_settings_panels. #}
{% set is_rtl = (active_locale|default('en_US'))|lower starts with 'ar' %}
{{ include('mod_clientfence_settings_style.html.twig') }}
{% set plan_servers = [] %}
{% for panel in panels %}
	{% if panel.on %}
		{% for server in panel.servers %}
			{% set plan_servers = plan_servers|merge([{ 'panel': panel.id, 'label': panel.label, 'id': server.id, 'name': server.name, 'hostname': server.hostname }]) %}
		{% endfor %}
	{% endif %}
{% endfor %}
{% if plan_servers is not empty %}
	<div class="clientfence-settings border-top" id="hosting-plans-from-panel" dir="{{ is_rtl ? 'rtl' : 'ltr' }}">
		<div class="clientfence-settings-intro">
			<h3>{{ 'Hosting plans from the panel'|trans }}</h3>
			<p>{{ 'The plans of a panel server become hosting plans with the same name and limits, linked by the panel plan ID (custom value plan_id). Hosting plans that already match a panel plan are left unchanged unless you choose to update them.'|trans }}</p>
		</div>
		<div class="clientfence-setting clientfence-setting-row">
			<div class="clientfence-setting-label">
				<label class="form-label" for="hosting-plans-server">{{ 'Server'|trans }}</label>
				<div class="clientfence-setting-hint">{{ 'Load its plans, choose which to make, then make them.'|trans }}</div>
			</div>
			<div class="clientfence-setting-control">
				<div class="input-group">
					<select class="form-select" id="hosting-plans-server">
						{% for server in plan_servers %}
							<option value="{{ server.id }}" data-panel="{{ server.panel }}">{{ server.label }}: {{ server.name }} ({{ server.hostname }})</option>
						{% endfor %}
					</select>
					<button class="btn" type="button" id="hosting-plans-load">
						<svg class="icon" aria-hidden="true"><use href="#download"/></svg>{{ 'Load plans'|trans }}
					</button>
				</div>
			</div>
		</div>
		<div id="hosting-plans-results" hidden>
			<div class="table-responsive">
				<table class="table table-vcenter card-table">
					<thead>
						<tr>
							<th class="w-1"><input class="form-check-input m-0 align-middle" type="checkbox" id="hosting-plans-all" checked aria-label="{{ 'Select all'|trans }}"></th>
							<th>{{ 'Panel plan'|trans }}</th>
							<th>{{ 'Disk quota'|trans }}</th>
							<th>{{ 'Bandwidth'|trans }}</th>
							<th>{{ 'Hosting plan'|trans }}</th>
						</tr>
					</thead>
					<tbody id="hosting-plans-rows"></tbody>
				</table>
			</div>
			<div class="clientfence-setting clientfence-setting-row border-top">
				<div class="clientfence-setting-label">
					<span class="form-label d-block">{{ 'Hosting plans that already match a panel plan'|trans }}</span>
				</div>
				<div class="clientfence-setting-control d-flex flex-wrap gap-3">
					<label class="form-check">
						<input class="form-check-input" type="radio" name="hosting-plans-update" value="0" checked>
						<span class="form-check-label">{{ 'Leave unchanged'|trans }}</span>
					</label>
					<label class="form-check">
						<input class="form-check-input" type="radio" name="hosting-plans-update" value="1">
						<span class="form-check-label">{{ 'Update name and limits'|trans }}</span>
					</label>
				</div>
			</div>
			<div class="clientfence-settings-actions">
				<button type="button" class="btn btn-primary" id="hosting-plans-submit" disabled>{{ 'Make hosting plans'|trans }}</button>
			</div>
		</div>
	</div>
{% endif %}
<script nonce="{{ csp_nonce }}">
	(() => {
		// Hosting plans from a panel server (ClientFence, Hosting panels).
		const serverSelect = document.getElementById('hosting-plans-server');
		if (serverSelect) {
			const results = document.getElementById('hosting-plans-results');
			const rows = document.getElementById('hosting-plans-rows');
			const submit = document.getElementById('hosting-plans-submit');
			const selectAll = document.getElementById('hosting-plans-all');
			const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
			const limit = (value) => (value === null || value === undefined || value === '') ? {{ 'Unlimited'|trans|json_encode|raw }} : escapeHtml(value) + ' MB';
			const chosen = () => ({ panel: serverSelect.selectedOptions[0].dataset.panel, server_id: serverSelect.value });

			document.getElementById('hosting-plans-load').addEventListener('click', () => {
				rows.replaceChildren();
				results.hidden = true;
				submit.disabled = true;
				ClientFence.api.admin.get('servicehosting/panel_plans', chosen(), (plans) => {
					plans.forEach((plan) => {
						let status = '<span class="badge bg-green-lt">' + {{ 'New'|trans|json_encode|raw }} + '</span>';
						if (plan.hosting_plan_id) {
							const label = plan.matched_by === 'config' ? {{ 'Linked to'|trans|json_encode|raw }} : {{ 'Same name as'|trans|json_encode|raw }};
							status = '<span class="badge bg-azure-lt">' + label + ' ' + escapeHtml(plan.hosting_plan_name) + '</span>';
						}
						const row = document.createElement('tr');
						row.innerHTML = '<td><input class="form-check-input m-0 align-middle" type="checkbox" value="' + escapeHtml(plan.id) + '" checked></td>'
							+ '<td>' + escapeHtml(plan.name) + '</td>'
							+ '<td>' + limit(plan.quota) + '</td>'
							+ '<td>' + limit(plan.bandwidth) + '</td>'
							+ '<td>' + status + '</td>';
						rows.appendChild(row);
					});
					results.hidden = plans.length === 0;
					submit.disabled = plans.length === 0;
					selectAll.checked = true;
					if (plans.length === 0) {
						ClientFence.message({{ 'The server has no plans.'|trans|json_encode|raw }}, 'error');
					}
				}, (error) => ClientFence.message(error.message, 'error'));
			});

			selectAll.addEventListener('change', () => {
				rows.querySelectorAll('input[type="checkbox"]').forEach((box) => { box.checked = selectAll.checked; });
			});

			submit.addEventListener('click', () => {
				const ids = Array.from(rows.querySelectorAll('input[type="checkbox"]:checked')).map((box) => box.value);
				if (ids.length === 0) {
					return;
				}
				submit.disabled = true;
				ClientFence.api.admin.post('servicehosting/panel_plans_import', Object.assign(chosen(), {
					plan_ids: ids,
					update: document.querySelector('input[name="hosting-plans-update"]:checked').value,
				}), (done) => {
					ClientFence.message({{ 'Hosting plans made'|trans|json_encode|raw }} + ': ' + done.created + ' ' + {{ 'created'|trans|json_encode|raw }} + ', ' + done.updated + ' ' + {{ 'updated'|trans|json_encode|raw }} + ', ' + done.skipped + ' ' + {{ 'left unchanged'|trans|json_encode|raw }}, 'success');
					document.getElementById('hosting-plans-load').click();
				}, (error) => {
					ClientFence.message(error.message, 'error');
					submit.disabled = false;
				});
			});
		}
	})();
</script>
