{% import 'macro_functions.html.twig' as mf %}

{% set config = product.config|default({}) %}

{# ClientFence core patch: the sections start under ruled headings as on the product page, the plan and server lists show tiles and stay inside the screen on phones (CF-135 redesign). #}
<div class="card-body">
    <form method="post" action="{{ 'product/update_config'|api_url }}" {{ fb_api_form({message: 'Hosting Settings Updated'|trans}) }} id="hosting-settings-form">
        <div class="mb-5">
            <div class="mb-3 cf-section-head border-0 pt-0">
                <h3 class="card-title mb-1">{{ 'Hosting Settings'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Choose the server, hosting plan, and reseller behavior that will be used when provisioning this product.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Server'|trans }}</label>
                    {# ClientFence core patch: staff without the server or plan right see the stored choice and keep it (the lists need those rights; the page failed). #}
                    {% if has_permission('servicehosting', 'view_servers') %}
                    {{ mf.selectbox('config[server_id]', admin.servicehosting_server_get_pairs, config.server_id|default(''), 0, 'Select Server'|trans) }}
                    {% else %}
                    <input type="hidden" name="config[server_id]" value="{{ config.server_id|default('') }}">
                    <input type="text" class="form-control" value="{{ config.server_id|default('') ? '#' ~ config.server_id : '' }}" disabled>
                    {% endif %}
                </div>
                {# ClientFence core patch: new orders of this product go on a server of the group (ServerGroups.php). #}
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Server Group'|trans }}</label>
                    {% if has_permission('servicehosting', 'view_servers') %}
                    {{ mf.selectbox('config[server_group_id]', admin.servicehosting_server_group_get_pairs, config.server_group_id|default(''), 0, 'None'|trans) }}
                    {% else %}
                    <input type="hidden" name="config[server_group_id]" value="{{ config.server_group_id|default('') }}">
                    <input type="text" class="form-control" value="{{ config.server_group_id|default('') ? '#' ~ config.server_group_id : '' }}" disabled>
                    {% endif %}
                    <div class="form-text">{{ 'Optional. New orders go on a server of this group. The Server above is used for imports and moves.'|trans }}</div>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Hosting Plan'|trans }}</label>
                    {% if has_permission('servicehosting', 'manage_plans') %}
                    {{ mf.selectbox('config[hosting_plan_id]', admin.servicehosting_hp_get_pairs, config.hosting_plan_id|default(''), 0, 'Select Hosting Plan'|trans) }}
                    {% else %}
                    <input type="hidden" name="config[hosting_plan_id]" value="{{ config.hosting_plan_id|default('') }}">
                    <input type="text" class="form-control" value="{{ config.hosting_plan_id|default('') ? '#' ~ config.hosting_plan_id : '' }}" disabled>
                    {% endif %}
                </div>
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Reseller Hosting'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioResellerYes" type="radio" name="config[reseller]" value="1"{% if config.reseller|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioResellerNo" type="radio" name="config[reseller]" value="0"{% if not config.reseller|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                {# ClientFence core patch: the account owner may restore the panel's backups (Hosting accounts > Backups). #}
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Clients can restore backups'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[client_backup_restore]" value="1"{% if config.client_backup_restore|default('0') == '1' %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[client_backup_restore]" value="0"{% if config.client_backup_restore|default('0') != '1' %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="form-text">{{ 'Enhance only. The account owner can restore, sub-users only see the backups.'|trans }}</div>
                </div>
            </div>
        </div>

        <div class="mb-5">
            <div class="mb-3 cf-section-head">
                <h3 class="card-title mb-1">{{ 'Domain Configuration'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Select which domain options are available to customers when ordering this product.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Allow Domain Registration'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowRegisterYes" type="radio" name="config[allow_domain_register]" value="1"{% if config.allow_domain_register is not defined or config.allow_domain_register %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowRegisterNo" type="radio" name="config[allow_domain_register]" value="0"{% if config.allow_domain_register is defined and not config.allow_domain_register %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Allow Domain Transfer'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowTransferYes" type="radio" name="config[allow_domain_transfer]" value="1"{% if config.allow_domain_transfer is not defined or config.allow_domain_transfer %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowTransferNo" type="radio" name="config[allow_domain_transfer]" value="0"{% if config.allow_domain_transfer is defined and not config.allow_domain_transfer %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Allow Using Own Domain'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowOwnYes" type="radio" name="config[allow_domain_own]" value="1"{% if config.allow_domain_own is not defined or config.allow_domain_own %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowOwnNo" type="radio" name="config[allow_domain_own]" value="0"{% if config.allow_domain_own is defined and not config.allow_domain_own %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Offer Free Subdomains'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowSubdomainYes" type="radio" name="config[allow_subdomain]" value="1"{% if config.allow_subdomain|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioAllowSubdomainNo" type="radio" name="config[allow_subdomain]" value="0"{% if not config.allow_subdomain|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-6 subdomain-base-row{% if not config.allow_subdomain|default(false) %} d-none{% endif %}">
                    <label class="form-label">{{ 'Free Subdomain Base Domain'|trans }}</label>
                    <input class="form-control" type="text" name="config[subdomain_base_domain]" value="{{ config.subdomain_base_domain|default('') }}" placeholder="example.com">
                    <div class="form-hint">{{ 'Customers can use a free subdomain provided by you, such as username.example.com, without registering or transferring a domain.'|trans }}</div>
                </div>
            </div>

            <div class="alert alert-danger d-none d-flex align-items-center mt-4" id="domain-options-warning" role="alert">
                <svg class="icon me-2">
                    <use href="#alert-triangle" />
                </svg>
                <div>
                    <strong class="me-1">{{ 'Warning:'|trans }}</strong>{{ 'At least one domain option must be enabled. Customers will not be able to order this product if all domain options are disabled.'|trans }}
                </div>
            </div>
        </div>

        <div class="mb-4">
            <div class="mb-3 cf-section-head">
                <h3 class="card-title mb-1">{{ 'Free Domain Options'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Choose when a free domain should be offered and which TLDs and billing periods qualify.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Free Domain Registration'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioFreeRegistrationYes" type="radio" name="config[free_domain]" value="1"{% if config.free_domain|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioFreeRegistrationNo" type="radio" name="config[free_domain]" value="0"{% if not config.free_domain|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                {# ClientFence core patch: free renewals while the hosting lasts, as WHMCS (Product\Service::hasFreeDomainRenewal()). #}
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Free Domain Renewals'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[free_domain_renewals]" value="1"{% if config.free_domain_renewals|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[free_domain_renewals]" value="0"{% if not config.free_domain_renewals|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <small class="form-hint">{{ 'A domain registered or transferred free with this product also renews free while the hosting is active or suspended, and at the TLD price once the hosting ends.'|trans }}</small>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Free Domain Transfer'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="radioFreeTransferYes" type="radio" name="config[free_transfer]" value="1"{% if config.free_transfer|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="radioFreeTransferNo" type="radio" name="config[free_transfer]" value="0"{% if not config.free_transfer|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>

                <div class="col-xl-6 free-tlds-row{% if not config.free_domain|default(false) %} d-none{% endif %}">
                    <label class="form-label">{{ 'Select Free TLDs'|trans }}</label>
                    <div class="table-responsive border rounded-2">
                        <table class="table card-table table-vcenter table-striped mb-0">
                            <tbody>
                                {% set tlds = guest.serviceDomain_tlds({ 'allow_register': 1 }) %}
                                {% for id, tld in tlds %}
                                    <tr>
                                        <td class="w-1">
                                            <input type="checkbox" name="config[free_tlds][]" value="{{ tld.tld }}"{% if tld.tld in config.free_tlds|default([]) %} checked{% endif %}>
                                        </td>
                                        <td>{{ tld.tld }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-xl-6 free-periods-row{% if not config.free_domain|default(false) %} d-none{% endif %}">
                    <label class="form-label">{{ 'Select Free Periods'|trans }}</label>
                    <div class="table-responsive border rounded-2">
                        <table class="table card-table table-vcenter table-striped mb-0">
                            <tbody>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="1M"{% if '1M' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>1 {{ 'Month'|trans }}</td></tr>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="2M"{% if '2M' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>2 {{ 'Months'|trans }}</td></tr>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="3M"{% if '3M' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>3 {{ 'Months'|trans }}</td></tr>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="1Y"{% if '1Y' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>1 {{ 'Year'|trans }}</td></tr>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="2Y"{% if '2Y' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>2 {{ 'Years'|trans }}</td></tr>
                                <tr><td class="w-1"><input type="checkbox" name="config[free_domain_periods][]" value="3Y"{% if '3Y' in config.free_domain_periods|default([]) %} checked{% endif %}></td><td>3 {{ 'Years'|trans }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" name="id" value="{{ product.id }}">
        {# ClientFence core patch: staff who may only view products get no save buttons (the API refuses them). #}
        {% if has_permission('product', 'manage_products') %}
        <div class="d-flex justify-content-end">
            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
        </div>
        {% endif %}
    </form>

    {% if has_permission('servicehosting', 'manage_plans') %}
    <div class="d-flex align-items-center mt-5 mb-3 cf-section-head">
        <h3 class="card-title mb-0">{{ 'Hosting Plans'|trans }}</h3>
        <a href="{{ 'servicehosting#tab-new-plan'|url }}" class="ms-auto btn btn-primary">
            <svg class="icon me-2">
                <use href="#plus" />
            </svg>
            {{ 'New Hosting Plan'|trans }}
        </a>
    </div>
    <div class="table-responsive">
    <table class="table card-table table-vcenter table-striped text-nowrap">
        <thead>
            <tr>
                <th>{{ 'Title'|trans }}</th>
                <th class="w-1"></th>
            </tr>
        </thead>
        <tbody>
            {% for id, plan in admin.servicehosting_hp_get_pairs %}
                <tr>
                    <td>
                        <a class="cf-tile-link" href='{{ "servicehosting/plan/#{id}"|url }}'>
                            <span class="cf-avatar cf-avatar-sm cf-tile" aria-hidden="true"><svg class="icon"><use href="#package" /></svg></span>
                            <span>{{ plan }}</span>
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-icon" href='{{ "servicehosting/plan/#{id}"|url }}'>
                            <svg class="icon">
                                <use href="#edit" />
                            </svg>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="text-muted" colspan="2">{{ 'The list is empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    {% if has_permission('servicehosting', 'view_servers') %}
    <div class="d-flex align-items-center mt-5 mb-3 cf-section-head">
        <h3 class="card-title mb-0">{{ 'Servers'|trans }}</h3>
        <a href="{{ 'servicehosting'|url }}#tab-new-server" class="ms-auto btn btn-primary">
            <svg class="icon me-2">
                <use href="#plus" />
            </svg>
            {{ 'New Server'|trans }}
        </a>
    </div>
    <div class="table-responsive">
    <table class="table card-table table-vcenter table-striped text-nowrap">
        <thead>
            <tr>
                <th>{{ 'Title'|trans }}</th>
                <th class="w-1"></th>
            </tr>
        </thead>
        <tbody>
            {% for id, server in admin.servicehosting_server_get_pairs %}
                <tr>
                    <td>
                        <a class="cf-tile-link" href='{{ "servicehosting/server/#{id}"|url }}'>
                            <span class="cf-avatar cf-avatar-sm cf-tile" aria-hidden="true"><svg class="icon"><use href="#server" /></svg></span>
                            <span>{{ server }}</span>
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-icon" href='{{ "servicehosting/server/#{id}"|url }}'>
                            <svg class="icon">
                                <use href="#edit" />
                            </svg>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="text-muted" colspan="7">{{ 'The list is empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}
</div>

<script nonce="{{ csp_nonce }}">
    const freeDomainRadios = document.querySelectorAll('input[type="radio"][name="config[free_domain]"]');
    const freeTldsRow = document.querySelector('.free-tlds-row');
    const freePerdsRow = document.querySelector('.free-periods-row');
    const freeDomainPeriodInputs = document.querySelectorAll('input[name="config[free_domain_periods][]"]');
    const freeTldsInputs = document.querySelectorAll('input[name="config[free_tlds][]"]');
    const domainOptionsWarning = document.getElementById('domain-options-warning');
    const hostingSettingsForm = document.getElementById('hosting-settings-form');
    const subdomainBaseRow = document.querySelector('.subdomain-base-row');
    const subdomainBaseInput = document.querySelector('input[name="config[subdomain_base_domain]"]');
    const domainOptionRadios = document.querySelectorAll(
        'input[name="config[allow_domain_register]"], ' +
        'input[name="config[allow_domain_transfer]"], ' +
        'input[name="config[allow_domain_own]"], ' +
        'input[name="config[allow_subdomain]"]'
    );

    function syncFreeDomainFields(isFree) {
        freeTldsRow.classList.toggle('d-none', !isFree);
        freePerdsRow.classList.toggle('d-none', !isFree);

        freeDomainPeriodInputs.forEach((element) => {
            element.required = isFree;
            if (!isFree) {
                element.checked = false;
            }
        });

        freeTldsInputs.forEach((element) => {
            element.required = isFree;
            if (!isFree) {
                element.checked = false;
            }
        });
    }

    function checkDomainOptions() {
        const registerEnabled = document.querySelector('input[name="config[allow_domain_register]"][value="1"]').checked;
        const transferEnabled = document.querySelector('input[name="config[allow_domain_transfer]"][value="1"]').checked;
        const ownEnabled = document.querySelector('input[name="config[allow_domain_own]"][value="1"]').checked;
        const subdomainEnabled = document.querySelector('input[name="config[allow_subdomain]"][value="1"]').checked;

        const allDisabled = !registerEnabled && !transferEnabled && !ownEnabled && !subdomainEnabled;
        domainOptionsWarning.classList.toggle('d-none', !allDisabled);
        subdomainBaseRow.classList.toggle('d-none', !subdomainEnabled);
        subdomainBaseInput.required = subdomainEnabled;

        return !allDisabled;
    }

    freeDomainRadios.forEach((radio) => {
        radio.addEventListener('change', function() {
            syncFreeDomainFields(this.value === '1');
        });
    });

    freeTldsInputs.forEach((checkbox) => {
        checkbox.addEventListener('change', function() {
            const anyChecked = Array.from(freeTldsInputs).some((element) => element.checked);
            freeTldsInputs.forEach((element) => {
                element.required = !anyChecked;
            });
        });
    });

    freeDomainPeriodInputs.forEach((checkbox) => {
        checkbox.addEventListener('change', function() {
            const anyChecked = Array.from(freeDomainPeriodInputs).some((element) => element.checked);
            freeDomainPeriodInputs.forEach((element) => {
                element.required = !anyChecked;
            });
        });
    });

    domainOptionRadios.forEach((radio) => {
        radio.addEventListener('change', checkDomainOptions);
    });

    hostingSettingsForm.addEventListener('submit', function(event) {
        if (!checkDomainOptions()) {
            event.preventDefault();
            event.stopImmediatePropagation();
            domainOptionsWarning.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    syncFreeDomainFields(document.querySelector('input[name="config[free_domain]"][value="1"]:checked') !== null);
    checkDomainOptions();
</script>
