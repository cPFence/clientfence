{% import 'macro_functions.html.twig' as mf %}

{% set server = service.server %}
{% set hp = service.hosting_plan %}

{# ClientFence core patch: the hosting account reads first: its domain, plan and status, then the server and limits as a grid; the change forms follow under ruled headings (CF-135 redesign). #}
<div class="card-body">
    <div class="card mb-4">
        <div class="cf-inv cf-dom">
            <div class="cf-inv-hero">
                <div class="min-w-0">
                    <div class="cf-client-name"><a target="_blank" href="https://{{ service.domain }}"><bdi>{{ service.domain }}</bdi></a></div>
                    <div class="text-secondary">{{ 'Hosting Plan'|trans }}: <a href='{{ "servicehosting/plan/#{hp.id}"|url }}'>{{ hp.name }}</a></div>
                </div>
                <div class="cf-inv-chips">
                    {{ mf.status_badge(order.status, 'order') }}
                    {% if service.reseller %}<span class="badge bg-azure-lt">{{ 'Reseller Hosting'|trans }}</span>{% endif %}
                </div>
            </div>
            <dl class="cf-facts">
                {% if server %}
                <div><dt>{{ 'Server Name'|trans }}</dt><dd><a href='{{ "servicehosting/server/#{server.id}"|url }}'>{{ server.name }}</a></dd></div>
                <div><dt>{{ 'Server IP'|trans }}</dt><dd><bdi class="font-monospace">{{ server.ip }}</bdi></dd></div>
                {% endif %}
                <div><dt>{{ 'Account IP'|trans }}</dt><dd><bdi class="font-monospace">{{ service.ip|default('-') }}</bdi></dd></div>
                <div><dt>{{ 'Username'|trans }}</dt><dd><bdi>{{ service.username|default('-') }}</bdi></dd></div>
                <div><dt>{{ 'Bandwidth'|trans }}</dt><dd>{% if hp.bandwidth == 'unlimited' %}{{ 'Unlimited'|trans }}{% else %}{{ hp.bandwidth }} MB / {{ 'per month'|trans }}{% endif %}</dd></div>
                <div><dt>{{ 'Disk Quota'|trans }}</dt><dd>{% if hp.quota == 'unlimited' %}{{ 'Unlimited'|trans }}{% else %}{{ hp.quota }} MB{% endif %}</dd></div>
                {% if server %}
                <div><dt>{{ 'Nameserver 1'|trans }}</dt><dd><bdi>{{ server.ns1|default('-') }}</bdi></dd></div>
                <div><dt>{{ 'Nameserver 2'|trans }}</dt><dd><bdi>{{ server.ns2|default('-') }}</bdi></dd></div>
                {% if server.ns3 %}<div><dt>{{ 'Nameserver 3'|trans }}</dt><dd><bdi>{{ server.ns3 }}</bdi></dd></div>{% endif %}
                {% if server.ns4 %}<div><dt>{{ 'Nameserver 4'|trans }}</dt><dd><bdi>{{ server.ns4 }}</bdi></dd></div>{% endif %}
                {% endif %}
            </dl>
        </div>

        {# ClientFence core patch: Login to Control Panel, Sync, Change Package and Change Password are Module Commands on the Details tab (mod_servicehosting_commands.html.twig). #}
        {% if server and service.reseller %}
        <div class="card-footer text-center">
            <div class="btn-list justify-content-center">
                    <a class="btn btn-primary" href="{{ server.reseller_cpanel_url }}" target="_blank">
                        <svg class="icon">
                            <use href="#server" />
                        </svg>
                        <span>{{ 'Reseller control panel'|trans }}</span>
                    </a>
            </div>
        </div>
        {% endif %}
    </div>

    {# ClientFence core patch: link an account on an Enhance server to its panel organization and subscription by hand (GitHub #47). #}
    {% if server and server.manager == 'Enhance' %}
    <div class="mb-5">
        <div class="mb-3 cf-section-head border-0 pt-0">
            <h3 class="card-title mb-1">{{ 'Enhance Link'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'Set the Enhance organization and subscription of this account when the panel cannot find it by the client email. They are checked on the server before they are saved, and every action then uses them. Leave both empty to remove the link.'|trans }}</p>
        </div>

        <form method="post" action="{{ 'servicehosting/panel_link'|api_url }}" {{ fb_api_form({reload: true}) }}>
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Organization ID'|trans }}</label>
                    <input class="form-control font-monospace" type="text" name="panel_org_id" value="{{ service.panel_org_id }}" maxlength="64" pattern="[A-Za-z0-9\-]+">
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Subscription ID'|trans }}</label>
                    <input class="form-control" type="number" name="panel_subscription_id" value="{{ service.panel_subscription_id }}" min="1" step="1">
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Control panel login'|trans }}</label>
                    <input class="form-control" type="email" name="username" value="{{ '@' in service.username|default('') ? service.username }}">
                </div>
            </div>

            <input type="hidden" name="order_id" value="{{ order.id }}">
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
            </div>
        </form>
    </div>
    {% endif %}

    {# ClientFence core patch: staff set the server and login of an account that already exists, in ClientFence only (servicehosting/update). The Enhance login is in the Enhance Link section. #}
    {% set is_enhance = server and server.manager == 'Enhance' %}
    {% set can_pick_server = has_permission('servicehosting', 'view_servers') %}
    {% set show_account_form = has_permission('servicehosting', 'manage_accounts') and (can_pick_server or not is_enhance) %}
    {% if show_account_form %}
    <div class="mb-5">
        <div class="mb-3 cf-section-head{% if not is_enhance %} border-0 pt-0{% endif %}">
            <h3 class="card-title mb-1">{{ 'Server and Username'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'Saved in ClientFence only, nothing changes on the server. Use it for accounts that already exist, for example after an import or a move.'|trans }}</p>
        </div>

        {# A new server empties the username (clientfence-admin.js): the account may have another username there. #}
        <form method="post" action="{{ 'servicehosting/update'|api_url }}" {{ fb_api_form({reload: true}) }}{% if not is_enhance %} data-cf-account-form data-cf-saved-server="{{ server.id|default('') }}"{% endif %}>
            <div class="row g-3">
                {% if can_pick_server %}
                <div class="col-lg-6">
                    <label class="form-label" for="service-server-id">{{ 'Server'|trans }}</label>
                    {{ mf.selectbox('server_id', admin.servicehosting_server_get_pairs, server.id|default(''), 1, 'Select Server'|trans, 'service-server-id') }}
                </div>
                {% endif %}
                {# On Enhance the login is set under Enhance Link; here the field is only for a move to another panel. #}
                <div class="col-lg-6">
                    <label class="form-label" for="service-username">{{ 'Username'|trans }}</label>
                    {% if is_enhance %}
                    <input class="form-control" id="service-username" type="text" name="username" value="">
                    <div class="form-text">{{ 'Only when you move this account to a server with another panel.'|trans }}</div>
                    {% else %}
                    <input class="form-control" id="service-username" type="text" name="username" value="{{ service.username }}" data-cf-saved-username="{{ service.username }}" required>
                    {% endif %}
                </div>
            </div>

            <input type="hidden" name="order_id" value="{{ order.id }}">
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
            </div>
        </form>
    </div>
    {% endif %}

    <div class="mb-5">
        <div class="mb-3 cf-section-head{% if not is_enhance and not show_account_form %} border-0 pt-0{% endif %}">
            <h3 class="card-title mb-1">{{ 'Change IP'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'Update the primary IP address assigned to the hosting account.'|trans }}</p>
        </div>

        <form method="post" action="{{ 'servicehosting/change_ip'|api_url }}" {{ fb_api_form({message: 'Account IP Changed'|trans}) }}>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">{{ 'IP'|trans }}</label>
                    <input class="form-control" type="text" name="ip" value="{{ request.ip|default(service.ip) }}" pattern="^\S+$" title="{{ 'Enter a valid IPv4 or IPv6 address'|trans }}" required>
                </div>
            </div>

            <input type="hidden" name="order_id" value="{{ order.id }}">
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">{{ 'Change'|trans }}</button>
            </div>
        </form>
    </div>

    <div class="mb-5">
        <div class="mb-3 cf-section-head">
            <h3 class="card-title mb-1">{{ 'Change Username'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'Rename the hosting account username on the remote server.'|trans }}</p>
        </div>

        <form method="post" action="{{ 'servicehosting/change_username'|api_url }}" {{ fb_api_form({message: 'Account Username Changed'|trans}) }}>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Username'|trans }}</label>
                    <input class="form-control" type="text" name="username" value="{{ request.username|default(service.username) }}" required>
                </div>
            </div>

            <input type="hidden" name="order_id" value="{{ order.id }}">
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">{{ 'Change'|trans }}</button>
            </div>
        </form>
    </div>

    <div>
        <div class="mb-3 cf-section-head">
            <h3 class="card-title mb-1">{{ 'Change Domain'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'Update the domain assigned to the hosting account.'|trans }}</p>
        </div>

        <form method="post" action="{{ 'servicehosting/change_domain'|api_url }}" {{ fb_api_form({message: 'Account Domain Changed'|trans}) }}>
            <div class="row g-3">
                <div class="col-lg-8">
                    <label class="form-label">{{ 'Domain'|trans }}</label>
                    <div class="input-group">
                        <input class="form-control" type="text" dir="ltr" name="sld" value="{{ request.domain|default(service.sld) }}" required>
                        <input class="form-control" type="text" dir="ltr" name="tld" value="{{ request.tld|default(service.tld) }}" required>
                    </div>
                </div>
            </div>

            <input type="hidden" name="order_id" value="{{ order.id }}">
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">{{ 'Change'|trans }}</button>
            </div>
        </form>
    </div>
</div>
