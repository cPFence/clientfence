{% extends 'layout_default.html.twig' %}

{% set active_menu = 'products' %}

{% block meta_title %}{{ category.title }}{% endblock %}

{% block breadcrumbs %}
<ul class="breadcrumb">
    <li class="breadcrumb-item">
        <a href="{{ '/'|url }}">
            <svg class="icon">
                <use href="#home" />
            </svg>
        </a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ 'product'|url }}">{{ 'Products'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ 'product'|url }}#tab-categories">{{ 'Categories'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ category.title}}</li>
</ul>
{% endblock %}

{% block content %}
{# ClientFence core patch: the category reads first: its name and the products in it with their status, then the form (CF-135 redesign). #}
<div class="card cf-hero-card mb-3">
    <div class="cf-inv">
        <div class="cf-inv-client cf-client-hero">
            <span class="cf-avatar cf-avatar-lg cf-tile" aria-hidden="true"><svg class="icon"><use href="#package" /></svg></span>
            <div class="cf-inv-who">
                <span class="cf-client-name">{{ category.title }}</span>
                <span class="text-secondary">{{ 'Products'|trans }} · <bdi>{{ category.products|length }}</bdi></span>
            </div>
        </div>
        {% if category.products|length > 0 %}
        <dl class="cf-facts">
            <div class="cf-facts-wide"><dt>{{ 'Products'|trans }}</dt><dd class="cf-inv-chips">
                {% for p in category.products %}
                    <a class="badge {{ p.status|default('') == 'enabled' ? 'bg-green-lt' : 'bg-secondary-lt' }}" href='{{ "product/manage/#{p.id}"|url }}'>{{ p.title }}</a>
                {% endfor %}
            </dd></div>
        </dl>
        {% endif %}
    </div>
</div>
<div class="card">
    <form method="post" action="{{ 'product/category_update'|api_url }}" {{ fb_api_form({message: 'Category Updated'|trans}) }}>
        {% embed 'partial_admin_form_card.html.twig' with {
            title: 'Category Details'|trans,
            body_class: 'pt-4',
            footer_align: 'between'
        } %}
            {% block form_content %}
                {# ClientFence: the language bar of the name and description (mod_product_translations.html.twig). #}
                {{ include('mod_product_translations.html.twig', { part: 'bar', kind: 'category', item: category }) }}
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div data-cf-text-pane="">
                            <label class="form-label">{{ 'Title'|trans }}</label>
                            <input class="form-control" type="text" name="title" value="{{ category.title }}" required>
                        </div>
                        {{ include('mod_product_translations.html.twig', { part: 'title', kind: 'category', item: category }) }}
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Icon'|trans }}</label>
                        <input class="form-control" type="text" name="icon_url" id="bb-icon" value="{{ category.icon_url }}">
                    </div>
                    <div class="col-12">
                        <div data-cf-text-pane="">
                            <label class="form-label">{{ 'Description'|trans }}</label>
                            <textarea class="editor-textarea" name="description" rows="5">{{ category.description }}</textarea>
                        </div>
                        {{ include('mod_product_translations.html.twig', { part: 'description', kind: 'category', item: category }) }}
                    </div>
                </div>
                <input type="hidden" name="id" value="{{ category.id }}">
            {% endblock %}

            {% block form_actions %}
                <a href="{{ 'product'|url }}" class="btn btn-secondary">
                    <svg class="icon">
                        <use href="#arrow-left" />
                    </svg>
                    {{ 'Go Back'|trans }}
                </a>
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}

{% block head %}{{ wysiwyg('.editor-textarea') }}{% endblock %}
