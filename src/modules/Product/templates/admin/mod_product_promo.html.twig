{% extends 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Product Promotions'|trans }} - {{ promo.code }}{% endblock %}

{% set active_menu = 'products' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'product'|url }}">{{ 'Products'|trans }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'product/promos'|url }}">{{ 'Product Promotions'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ promo.code }}</li>
    </ol>
{% endblock %}

{% block content %}
{# ClientFence core patch: the promotion reads first: code, discount and status chips, then every usage figure as facts (CF-135 redesign). #}
{% set stats = promo.usage_stats %}
{% set promo_start = promo.start_at ? promo.start_at|format_date : 'now'|trans %}
<div class="card cf-hero-card">
    <div class="cf-inv">
        <div class="cf-inv-client cf-client-hero">
            <span class="cf-avatar cf-avatar-lg cf-tile" aria-hidden="true"><svg class="icon"><use href="#currency-dollar" /></svg></span>
            <div class="cf-inv-who">
                <span class="cf-client-name cf-code-lg">{{ promo.code }}</span>
                <div class="cf-inv-chips mt-1">
                    <span class="badge {{ promo.active ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ promo.active ? 'Active'|trans : 'Inactive'|trans }}</span>
                    {% if promo.auto_apply|default(false) %}<span class="badge bg-blue-lt">{{ 'Automatic'|trans }}</span>{% endif %}
                    {% if promo.recurring %}<span class="badge bg-azure-lt">{{ 'Recurring'|trans }}</span>{% endif %}
                    {% if promo.freesetup %}<span class="badge bg-azure-lt">{{ 'Free Setup'|trans }}</span>{% endif %}
                    <span class="badge bg-secondary-lt">{% if promo.end_at %}{{ 'From :start until :end'|trans({ ':start': promo_start, ':end': promo.end_at|format_date }) }}{% else %}{{ 'From :start until disabled'|trans({ ':start': promo_start }) }}{% endif %}</span>
                </div>
            </div>
            <div class="cf-hero-price">
                <div class="cf-inv-figure">{% if promo.type == 'percentage' %}{{ promo.value }}%{% else %}{{ promo.value|format_currency(guest.currency_get.code) }}{% endif %}</div>
                <div class="text-secondary">{{ 'Discount'|trans }}</div>
            </div>
        </div>
        {% if not promo.can_be_deleted %}
            <div class="cf-inv-note">
                <div class="alert alert-info mb-0" role="alert">
                    {{ 'This promotion has redemption history and can no longer be deleted. Disable it to archive it.'|trans }}
                </div>
            </div>
        {% endif %}
        <dl class="cf-facts">
            <div><dt>{{ 'Recorded Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.recorded_applications }}</dd></div>
            <div><dt>{{ 'Checkout Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.checkout_applications }}</dd></div>
            <div><dt>{{ 'Renewal Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.renewal_applications }}</dd></div>
            <div><dt>{{ 'Reserved Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.reserved_applications }}</dd></div>
            <div><dt>{{ 'Committed Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.committed_applications }}</dd></div>
            <div><dt>{{ 'Released Applications'|trans }}</dt><dd class="cf-fact-num">{{ stats.released_applications }}</dd></div>
            <div><dt>{{ 'Distinct Clients'|trans }}</dt><dd class="cf-fact-num">{{ stats.distinct_clients }}</dd></div>
            <div><dt>{{ 'Orders Using Promo'|trans }}</dt><dd class="cf-fact-num">{{ stats.orders_using_promo }}</dd></div>
            <div class="cf-facts-wide"><dt>{{ 'Operational Counter'|trans }}</dt>
                <dd>
                    <span class="cf-fact-num">{{ stats.operational_use_count }} {% if stats.max_uses is not null %}/ {{ stats.max_uses }}{% else %}/ &#8734;{% endif %}</span>
                    {% if stats.max_uses %}<progress class="cf-meter d-block" value="{{ min(stats.operational_use_count, stats.max_uses) }}" max="{{ stats.max_uses }}" aria-hidden="true"></progress>{% endif %}
                    <div class="text-secondary small">{{ 'Used only for max-use enforcement, not historical reporting.'|trans }}</div>
                    <div class="text-secondary small">{{ 'Active checkout applications'|trans }}: {{ stats.active_checkout_applications }}</div>
                    <div class="text-secondary small">
                        {% if stats.remaining_operational_uses is null %}
                            {{ 'Remaining operational uses'|trans }}: {{ 'Unlimited'|trans }}
                        {% else %}
                            {{ 'Remaining operational uses'|trans }}: {{ stats.remaining_operational_uses }}
                        {% endif %}
                    </div>
                </dd>
            </div>
        </dl>
    </div>
</div>

<div class="card mt-4" id="promo-redemptions">
    <div class="card-header">
        <div>
            <h3 class="card-title">{{ 'Redemption History'|trans }}</h3>
            <p class="card-subtitle">{{ 'The individual clients, orders, and invoices where this promotion has been applied.'|trans }}</p>
        </div>
    </div>
    <div class="card-body p-0">
        {% set redemption_pagination_url = "product/promo/#{promo.id}" %}
        {% set redemptions = admin.product_promo_redemption_get_list({ 'per_page': 10, 'page': request.page }|merge(request)|merge({ 'promo_id': promo.id })) %}
        <div class="table-responsive">
            <table class="table card-table table-vcenter table-striped text-nowrap">
                <thead>
                    <tr>
                        <th>{{ 'Client'|trans }}</th>
                        <th>{{ 'Order'|trans }}</th>
                        <th>{{ 'Invoice'|trans }}</th>
                        <th>{{ 'Phase'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Discount'|trans }}</th>
                        <th>{{ 'Redeemed At'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for redemption in redemptions.list %}
                    <tr>
                        <td>
                            {% if redemption.client %}
                                <a href='{{ "client/manage/#{redemption.client.id}"|url }}'>{{ redemption.client.first_name }} {{ redemption.client.last_name }}</a>
                                <div class="text-secondary small">{{ redemption.client.email }}</div>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                            {% if redemption.order %}
                                <a href='{{ "order/manage/#{redemption.order.id}"|url }}'>{{ redemption.order.title|default("Order ##{redemption.order.id}") }}</a>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                            {% if redemption.invoice %}
                                <a href='{{ "invoice/manage/#{redemption.invoice.id}"|url }}'>{{ redemption.invoice.serie_nr|default("##{redemption.invoice.id}") }}</a>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                            {% if redemption.phase == 'renewal' %}
                                <span class="badge text-bg-info">{{ 'Renewal'|trans }}</span>
                            {% else %}
                                <span class="badge text-bg-primary">{{ 'Checkout'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if redemption.status == 'committed' %}
                                <span class="badge text-bg-success">{{ 'Committed'|trans }}</span>
                            {% elseif redemption.status == 'reserved' %}
                                <span class="badge text-bg-warning">{{ 'Reserved'|trans }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">{{ 'Released'|trans }}</span>
                                {% if redemption.release_reason %}
                                    <div class="text-secondary small">{{ redemption.release_reason }}</div>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td>
                            {% if redemption.discount_amount is not null %}
                                {{ redemption.discount_amount|format_currency(redemption.currency) }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>{{ redemption.created_at|format_date }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-muted" colspan="7">{{ 'No clients have redeemed this promotion yet.'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex align-items-center">
            {{ include('partial_pagination.html.twig', { 'list': redemptions, 'url': redemption_pagination_url, 'hash': '#promo-redemptions', 'split_footer_controls': true }) }}
        </div>
    </div>
</div>

<div class="card mt-4">
    <form method="post" action="{{ 'product/promo_update'|api_url }}" {{ fb_api_form({redirect: 'product/promos'|url}) }}>
        {% embed 'partial_admin_form_card.html.twig' with {
            title: 'Manage Promotion'|trans,
            subtitle: 'Update the offer, recurring behavior, eligibility rules, and applicability of this promotion.'|trans,
            body_class: 'pt-4'
        } %}
            {% block form_content %}
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Promo Code'|trans }}</label>
                        <input class="form-control" type="text" name="code" value="{{ promo.code }}" required>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label d-block">{{ 'Discount Type'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" id="radioTypeAbsolute" type="radio" name="type" value="absolute"{% if promo.type == 'absolute' %} checked{% endif %}><span class="form-check-label">{{ 'Absolute'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" id="radioTypePercentage" type="radio" name="type" value="percentage"{% if promo.type == 'percentage' %} checked{% endif %}><span class="form-check-label">{{ 'Percentage'|trans }}</span></label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Discount Value'|trans }}</label>
                        <input class="form-control" type="text" name="value" value="{{ promo.value }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label d-block">{{ 'Recurring'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" id="radioApplyAll" type="radio" name="recurring" value="0"{% if not promo.recurring %} checked{% endif %}><span class="form-check-label">{{ 'Apply to First Order Only'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" id="radioApplyFirst" type="radio" name="recurring" value="1"{% if promo.recurring %} checked{% endif %}><span class="form-check-label">{{ 'Apply to First Order and Renewals'|trans }}</span></label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label d-block">{{ 'Active'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" id="radioActiveYes" type="radio" name="active" value="1"{% if promo.active %} checked{% endif %}><span class="form-check-label">{{ 'Yes'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" id="radioActiveNo" type="radio" name="active" value="0"{% if not promo.active %} checked{% endif %}><span class="form-check-label">{{ 'No'|trans }}</span></label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label d-block">{{ 'Free Setup'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" id="radioFreeSetupYes" type="radio" name="freesetup" value="1"{% if promo.freesetup %} checked{% endif %}><span class="form-check-label">{{ 'Yes'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" id="radioFreeSetupNo" type="radio" name="freesetup" value="0"{% if not promo.freesetup %} checked{% endif %}><span class="form-check-label">{{ 'No'|trans }}</span></label>
                        </div>
                    </div>
                    {# ClientFence core patch: configurable options (Product/Options.php). #}
                    <div class="col-lg-3">
                        <label class="form-label d-block">{{ 'Also discount configurable options'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" type="radio" name="include_options" value="1"{% if promo.include_options|default(false) %} checked{% endif %}><span class="form-check-label">{{ 'Yes'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" type="radio" name="include_options" value="0"{% if not promo.include_options|default(false) %} checked{% endif %}><span class="form-check-label">{{ 'No'|trans }}</span></label>
                        </div>
                    </div>
                    {# ClientFence core patch: a promotion that applies without a code (Product\Service::findAutoPromo()). #}
                    <div class="col-lg-6">
                        <label class="form-label d-block">{{ 'Apply automatically'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" type="radio" name="auto_apply" value="1"{% if promo.auto_apply|default(false) %} checked{% endif %}><span class="form-check-label">{{ 'Yes'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" type="radio" name="auto_apply" value="0"{% if not promo.auto_apply|default(false) %} checked{% endif %}><span class="form-check-label">{{ 'No'|trans }}</span></label>
                        </div>
                        <small class="form-hint">{{ 'Without a code, on every order its rules allow. A code the client enters replaces it.'|trans }}</small>
                    </div>
                </div>

                <hr class="my-4">
                <h6 class="card-title text-secondary mb-3">{{ 'Promotion Limitations'|trans }}</h6>
                <div class="row g-3">
                    <div class="col-lg-4">
                        <label class="form-label d-block">{{ 'Once per Client'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check"><input class="form-check-input" id="radioOncePerClientYes" type="radio" name="once_per_client" value="1"{% if promo.once_per_client %} checked{% endif %}><span class="form-check-label">{{ 'Yes'|trans }}</span></label>
                            <label class="form-check"><input class="form-check-input" id="radioOncePerClientNo" type="radio" name="once_per_client" value="0"{% if not promo.once_per_client %} checked{% endif %}><span class="form-check-label">{{ 'No'|trans }}</span></label>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label">{{ 'Max Uses (Zero for Unlimited)'|trans }}</label>
                        <input class="form-control" type="text" name="maxuses" value="{{ promo.maxuses }}" title="{{ 'Leave blank for unlimited uses'|trans }}" placeholder="0">
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label" for="validity">{{ 'Validity Period (Blank for Indefinite)'|trans }}</label>
                        <div class="input-icon w-100">
                            <input class="form-control datepicker"
                                   id="validity"
                                   value="{% if promo.start_at %}{{ promo.start_at|date('Y-m-d') }}{% endif %}{% if promo.end_at %} to {{ promo.end_at|date('Y-m-d') }}{% endif %}"
                                   data-name-from="start_at"
                                   data-name-to="end_at">
                            <span class="input-icon-addon">
                                <svg class="icon"><use href="#calendar" /></svg>
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <label class="form-label">{{ 'Applicable Products (Select None to Apply to All)'|trans }}</label>
                        <input type="hidden" name="products[]" value=""/>
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <tbody>{% set products = admin.product_get_pairs %}{% for id,product in products %}<tr><td class="w-1"><input type="checkbox" name="products[]" value="{{ id }}" {% if id in promo.products %} checked{% endif %} /></td><td>{{ product }}</td></tr>{% endfor %}</tbody>
                        </table>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label">{{ 'Applicable Periods (Select None to Apply to All)'|trans }}</label>
                        <input type="hidden" name="periods[]" value=""/>
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <tbody>{% set periods = guest.system_periods %}{% for id, period in periods %}<tr><td class="w-1"><input type="checkbox" name="periods[]" value="{{ id }}" {% if id in promo.periods %} checked{% endif %} /></td><td>{{ period }}</td></tr>{% endfor %}</tbody>
                        </table>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label">{{ 'Applicable Client Groups (Select None to Apply to All)'|trans }}</label>
                        <input type="hidden" name="client_groups[]" value=""/>
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <tbody>{% set client_groups = admin.client_group_get_pairs %}{% for id, client_group in client_groups %}<tr><td class="w-1"><input type="checkbox" name="client_groups[]" value="{{ id }}" {% if id in promo.client_groups %} checked{% endif %} /></td><td>{{ client_group }}</td></tr>{% endfor %}</tbody>
                        </table>
                    </div>
                </div>
                <input type="hidden" name="id" value="{{ promo.id }}">
            {% endblock %}

            {% block form_actions %}
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}
{# ClientFence core patch: Bootstrap Icons from the sprite instead of an inline Tabler drawing. #}
