{# ClientFence core patch (0.8.9 port): explicit zero and false formatting choices must survive rendering. #}
{# ClientFence core patch (ext serviceapikey): the key with copy and regenerate, its usage and allowed IPs, without page reloads. #}
{% import 'macro_functions.html.twig' as mf %}

<div class="card-body">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div>
            <h3 class="card-title mb-1">{{ 'API Key'|trans }} {{ mf.status_badge(order.status, 'order') }}</h3>
            <p class="text-secondary mb-0">{{ 'Review the current key and adjust how this service generates replacement API keys.'|trans }}</p>
        </div>
        <a class="btn btn-outline-danger" href="{{ 'serviceapikey/reset'|api_url(query: { 'order_id': order.id }) }}"
            {{ fb_api_link({modal: {type: 'confirm', title: 'Regenerate API key?'|trans, content: 'The old key stops working at once. Programs that use it need the new key.'|trans, button: 'Regenerate'|trans, buttonColor: 'danger'}, callback: 'cfApiKeyRegenerated'}) }}>
            <svg class="icon"><use href="#refresh" /></svg>
            <span>{{ 'Regenerate'|trans }}</span>
        </a>
    </div>
    <div class="input-group mb-3">
        <input type="text" class="form-control font-monospace" id="cf-apikey-value" value="{{ service.api_key }}" readonly dir="ltr" aria-label="{{ 'API Key'|trans }}">
        <button class="btn" type="button" id="cf-apikey-copy">{{ 'Copy'|trans }}</button>
    </div>
    <div class="datagrid">
        <div class="datagrid-item">
            <div class="datagrid-title">{{ 'Last used'|trans }}</div>
            <div class="datagrid-content">{{ service.last_used_at ? service.last_used_at|format_datetime : 'Never'|trans }}</div>
        </div>
        <div class="datagrid-item">
            <div class="datagrid-title">{{ 'Times used'|trans }}</div>
            <div class="datagrid-content">{{ service.use_count }}</div>
        </div>
    </div>
</div>

<div class="card-body border-top">
    <form method="post" action="{{ 'serviceapikey/update_ips'|api_url }}" {{ fb_api_form({message: 'Saved'|trans}) }}>
        <h3 class="card-title mb-1">{{ 'Allowed IPs'|trans }}</h3>
        <p class="text-secondary">{{ 'One IP address or CIDR range per line, at most 20. A check from any other IP answers as invalid. Leave empty to allow all IPs.'|trans }}</p>
        <textarea class="form-control font-monospace" name="allowed_ips" rows="4" dir="ltr" placeholder="203.0.113.10&#10;2001:db8::/32" aria-label="{{ 'Allowed IPs'|trans }}">{{ service.allowed_ips|join("\n") }}</textarea>
        <input type="hidden" name="order_id" value="{{ order.id }}">
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
        </div>
    </form>
</div>

<script nonce="{{ csp_nonce }}">
    document.getElementById('cf-apikey-copy').addEventListener('click', () => {
        navigator.clipboard?.writeText(document.getElementById('cf-apikey-value').value)
            .then(() => ClientFence.message({{ 'Copied'|trans|json_encode|raw }}, 'success'));
    });
    window.cfApiKeyRegenerated = () => {
        ClientFence.api.admin.get('order/service', { id: {{ order.id }} }, (service) => {
            document.getElementById('cf-apikey-value').value = service.api_key;
            ClientFence.message({{ 'API key regenerated'|trans|json_encode|raw }}, 'success');
        });
    };
</script>

<div class="card-body">
    <form method="post" action="{{ 'serviceapikey/update'|api_url }}" {{ fb_api_form({message: 'API Key Updated'|trans}) }}>
        <div class="mb-5">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'API Key Configuration'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Changing the generation options will not automatically regenerate the current API key. Use the reset action if you want the live key replaced.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Length'|trans }}</label>
                    <input type="number" class="form-control" name="config[length]" min="16" max="128" value="{{ (request.config.length ?? service.config.length ?? 32) }}">
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-5">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Formatting'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Control whether the generated key uses dash separators and how each segment is cased.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Split API Key with Dashes'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[split]" id="split_yes" value="1"{% if (request.config.split ?? service.config.split ?? 1) == 1 %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[split]" id="split_no" value="0"{% if (request.config.split ?? service.config.split ?? 1) == 0 %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Split Interval'|trans }}</label>
                    <input type="number" class="form-control" name="config[split_interval]" min="1" value="{{ (request.config.split_interval ?? service.config.split_interval ?? 8) }}">
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'API Key Capitalization'|trans }}</label>
                    <select class="form-select" aria-label="{{ 'API Key Capitalization Options'|trans }}" name="config[case]">
                        <option{% if (request.config.case ?? service.config.case ?? 'upper') == 'upper' %} selected{% endif %} value="upper">{{ 'Uppercase'|trans }}</option>
                        <option{% if (request.config.case ?? service.config.case ?? 'upper') == 'lower' %} selected{% endif %} value="lower">{{ 'Lowercase'|trans }}</option>
                        <option{% if (request.config.case ?? service.config.case ?? 'upper') == 'mixed' %} selected{% endif %} value="mixed">{{ 'Mixed'|trans }}</option>
                    </select>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Custom Parameters'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Define additional values your application can retrieve from the API for this key, such as plan-specific limits or feature flags.'|trans }}</p>
            </div>

            <div class="d-flex justify-content-start mb-3">
                <button class="btn btn-outline-primary" type="button" data-cf-add-field>{{ 'Add New Field'|trans }}</button>
            </div>

            <div class="row g-3" id="customParameters">
                {% for key, value in service.config %}
                    {% if key starts with 'custom_' %}
                        <div class="field-container col-12" id="{{ key }}">
                            <label class="form-label">{{ key }}</label>
                            <div class="d-flex gap-2 align-items-start">
                                <input type="text" class="form-control" value="{{ value }}" name="config[{{ key }}]">
                                <button class="btn btn-outline-danger flex-shrink-0" type="button" data-cf-delete-field="{{ key }}">{{ 'Delete'|trans }}</button>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <input type="hidden" name="order_id" value="{{ order.id }}">
        <div class="d-flex justify-content-end">
            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
        </div>
    </form>
</div>

<script nonce="{{ csp_nonce }}">
    document.querySelector('[data-cf-add-field]')?.addEventListener('click', () => addNewField());
    document.querySelectorAll('[data-cf-delete-field]').forEach((button) => button.addEventListener('click', () => deleteField(button.dataset.cfDeleteField)));
    function buildCustomField(name, value) {
        const fieldContainer = document.createElement('div');
        fieldContainer.classList.add('field-container', 'col-12');
        fieldContainer.setAttribute('id', name);

        const label = document.createElement('label');
        label.classList.add('form-label');
        label.textContent = name;

        const wrapper = document.createElement('div');
        wrapper.classList.add('d-flex', 'gap-2', 'align-items-start');

        const input = document.createElement('input');
        input.setAttribute('type', 'text');
        input.classList.add('form-control');
        input.setAttribute('name', 'config[' + name + ']');
        input.value = value || '';

        const button = document.createElement('button');
        button.classList.add('btn', 'btn-outline-danger', 'flex-shrink-0');
        button.setAttribute('type', 'button');
        button.textContent = {{ 'Delete'|trans|json_encode|raw }};
        button.addEventListener('click', function() {
            deleteField(name);
        });

        wrapper.appendChild(input);
        wrapper.appendChild(button);
        fieldContainer.appendChild(label);
        fieldContainer.appendChild(wrapper);

        return fieldContainer;
    }

    function addNewField() {
        Modals.create({
            type: 'prompt',
            title: {{ 'New field'|trans|json_encode|raw }},
            label: {{ 'Give the new field a name'|trans|json_encode|raw }},
            value: 'monthlyLimit',
            promptConfirmButton: {{ 'Create'|trans|json_encode|raw }},
            promptConfirmCallback: function(name) {
                name = 'custom_' + toCamelCase(name);
                const container = document.getElementById('customParameters');
                container.appendChild(buildCustomField(name, ''));
            }
        });
    }

    function deleteField(id) {
        const element = document.getElementById(id);
        if (element) {
            element.remove();
        }
    }

    function toCamelCase(str) {
        str = str.replace(/[^a-zA-Z0-9]/g, ' ');
        const words = str.split(' ').filter(Boolean);

        for (let i = 1; i < words.length; i++) {
            words[i] = words[i].charAt(0).toUpperCase() + words[i].slice(1);
        }

        return words.join('');
    }
</script>
