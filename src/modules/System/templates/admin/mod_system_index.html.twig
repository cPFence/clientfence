{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}
{% set settings_extensions = admin.extension_get_list({ 'active': true, 'has_settings': 1 }|merge(request)) %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Settings'|trans }}</h3>
            {# ClientFence core patch: setup wizard link (Clientfence Setup.php), for Super Administrators. #}
            {% if admin.clientfence_setup_allowed %}
                <div class="card-actions">
                    <a class="btn btn-primary" href="{{ 'clientfence/setup'|url }}">
                        <svg class="icon" aria-hidden="true"><use href="#settings-bolt" /></svg>
                        {{ 'Quick setup'|trans }}
                    </a>
                </div>
            {% endif %}
        </div>
        <div class="card-body">
            {# ClientFence core patch: the settings cards in groups, each with an icon tile in its group's shade (CF-135 redesign). #}
            {% set hub_group = { 'invoice': 'billing', 'currency': 'billing', 'order': 'billing', 'formbuilder': 'billing', 'client': 'clients', 'support': 'clients', 'email': 'clients', 'security': 'security', 'antispam': 'security' } %}
            {% set hub_groups = { 'billing': { 'title': 'Billing'|trans, 'shade': 'teal' }, 'clients': { 'title': 'Clients'|trans, 'shade': 'blue' }, 'security': { 'title': 'Security'|trans, 'shade': 'amber' }, 'system': { 'title': 'System'|trans, 'shade': 'violet' } } %}
            {% for key, group in hub_groups %}
                {% set exts = settings_extensions|filter(e => (hub_group[e.id] ?? 'system') == key) %}
                {% if exts is not empty %}
                    <section class="cf-hub-group">
                        <h4 class="cf-label">{{ group.title }}</h4>
                        <div class="row row-cards">
                            {% for ext in exts %}
                                <div class="col-md-6 col-xl-4">
                                    <a class="card card-sm card-link h-100 text-reset cf-hub-card" href='{{ "extension/settings/#{ext.id}"|url }}'>
                                        <div class="card-body d-flex align-items-center gap-3">
                                            {% set icon_filename = ext.icon_url|split('/')|last %}
                                            <span class="bf-tile cf-tile-{{ group.shade }}" aria-hidden="true">
                                                {% if (icon_filename != 'cog.svg') and (icon_filename|split('.')|last == 'svg' and ext.icon_path) %}
                                                    {{ source(ext.icon_path, ignore_missing = true) }}
                                                {% else %}
                                                    <img src="{{ ext.icon_url }}" alt="">
                                                {% endif %}
                                            </span>
                                            <div class="flex-fill min-w-0">
                                                <div class="fw-semibold">{{ ext.name|trans }}</div>
                                                <div class="text-secondary small">{{ ext.description ? ext.description|trans : 'Manage module settings and operational defaults.'|trans }}</div>
                                            </div>
                                            <svg class="icon text-secondary flex-shrink-0 bf-flip" aria-hidden="true">
                                                <use href="#chevron-right" />
                                            </svg>
                                        </div>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endfor %}
            {% if settings_extensions is empty %}
                <div class="text-muted text-center py-3">{{ 'No configurable modules were found.'|trans }}</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
