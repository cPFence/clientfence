{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'System Settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|url }}">{{ 'Settings'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'System Settings'|trans }}</li>
    </ol>
{% endblock %}

{% set can_manage_network_interface = has_permission('system', 'manage_network_interface') %}

{% block content %}
    {% set new_params = admin.extension_config_get({ 'ext': 'mod_system' }) %}
    {% set params = admin.system_get_params %}
    {% set localization = admin.system_localization_settings %}
    {% set cache_settings = admin.system_cache_settings %}
    {% set can_update_params = has_permission('system', 'update_params') %}
    {% set can_invalidate_cache = has_permission('system', 'invalidate_cache') %}
    {# ClientFence core patch: database backups as a tab here (Clientfence Backups.php; Super Administrators, ClientFence on). #}
    {% set bf_backups = guest.extension_is_on({ 'mod': 'clientfence' }) and admin.clientfence_backup_access ? admin.clientfence_backup_get : null %}
    {# ClientFence core patch: the WHMCS import as a tab here (Clientfence Whmcs/Import.php; Super Administrators, ClientFence on). #}
    {% set bf_whmcs = bf_backups ? admin.clientfence_whmcs_import_get : null %}
    {# ClientFence core patch: system health as a tab here (Clientfence Health.php; System settings permission, ClientFence on). #}
    {% set bf_health = guest.extension_is_on({ 'mod': 'clientfence' }) and has_permission('system', 'manage_settings') ? admin.clientfence_health_page : null %}
    {# ClientFence core patch: the licence check log and bans as a tab here (Servicelicense CheckLog.php, Bans.php; licence managers). #}
    {% set bf_licences = has_permission('servicelicense', 'manage') ? admin.servicelicense_settings_get : null %}
    {# ClientFence core patch: maintenance mode as WHMCS (System Api maintenance_get/maintenance_update). #}
    {% set bf_maintenance = has_permission('system', 'manage_settings') ? admin.system_maintenance_get : null %}
    {# ClientFence core patch: sign-in security moved to Security > Settings; old #tab-signin links land there (clientfence-admin.js). #}
    <div class="card" data-cf-moved-tabs="{{ { 'tab-signin': 'extension/settings/security'|url ~ '#tab-signin' }|json_encode }}">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'System Settings'|trans }}</h3>
                <p class="card-subtitle">{{ 'Manage company information, localization, system maintenance, and environment-level controls.'|trans }}</p>
            </div>
        </div>
        <div class="card-body pt-3 pb-0 px-0">
            <ul class="nav nav-pills mb-3 px-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" href="#tab-index" data-bs-toggle="tab" role="tab">{{ 'Company Details'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#company-legal" data-bs-toggle="tab" role="tab">{{ 'Company Legal'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-localization" data-bs-toggle="tab" role="tab">{{ 'Localization'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-countries" data-bs-toggle="tab" role="tab">{{ 'Countries'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-cache" data-bs-toggle="tab" role="tab">{{ 'Cache'|trans }}</a>
                </li>
                {% if bf_maintenance %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-maintenance" data-bs-toggle="tab" role="tab">{{ 'Maintenance'|trans }}</a>
                </li>
                {% endif %}
                {% if bf_health %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-health" data-bs-toggle="tab" role="tab">{{ 'System Health'|trans }}</a>
                </li>
                {% endif %}
                {% if bf_backups %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-backups" data-bs-toggle="tab" role="tab">{{ 'Database Backups'|trans }}</a>
                </li>
                {% endif %}
                {% if bf_licences %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-licences" data-bs-toggle="tab" role="tab">{{ 'Licences'|trans }}</a>
                </li>
                {% endif %}
                {% if bf_whmcs %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-whmcs" data-bs-toggle="tab" role="tab">{{ 'Migration'|trans }}</a>
                </li>
                {% endif %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-about" data-bs-toggle="tab" role="tab">{{ 'About'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#network-interface" data-bs-toggle="tab" role="tab">{{ 'Network Interface'|trans }}</a>
                </li>
            </ul>

            <div class="tab-content border-top">
                <div class="tab-pane fade show active" id="tab-index" role="tabpanel">
                    <form method="post" action="{{ 'system/update_params'|api_url }}" {{ fb_api_form({ message: 'Company Updated'|trans}) }}>
                        <div class="card-body">
                            <div class="alert alert-info" role="alert">
                                <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ 'These settings define the company details shown throughout invoices, public pages, and client-facing documents.'|trans }}
                            </div>

                            <h4 class="card-title mb-2">{{ 'Contact and Branding'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Set the primary contact details and branding assets used across the system.'|trans }}</p>
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label" for="company_name">{{ 'Name'|trans }}</label>
                                    <input class="form-control" id="company_name" type="text" name="company_name" value="{{ params.company_name|default('') }}">
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="company_email">{{ 'Email'|trans }}</label>
                                    <input class="form-control" id="company_email" type="text" name="company_email" value="{{ params.company_email|default('') }}">
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="company_tel">{{ 'Phone'|trans }}</label>
                                    <input class="form-control" id="company_tel" type="text" name="company_tel" value="{{ params.company_tel|default('') }}">
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="company_address_1">{{ 'Address'|trans }}</label>
                                    <input class="form-control mb-2" id="company_address_1" type="text" name="company_address_1" value="{{ params.company_address_1|default('') }}" placeholder="{{ 'Address line 1'|trans }}">
                                    <input class="form-control mb-2" type="text" name="company_address_2" value="{{ params.company_address_2|default('') }}" placeholder="{{ 'Address line 2'|trans }}">
                                    <input class="form-control" type="text" name="company_address_3" value="{{ params.company_address_3|default('') }}" placeholder="{{ 'Address line 3'|trans }}">
                                </div>
                                {# ClientFence core patch: the setup wizard's logo upload zones (Clientfence setup_brand_asset, Super Administrators); each upload saves its setting, so the paths stay out of this form. #}
                                {% if guest.extension_is_on({ 'mod': 'clientfence' }) and admin.clientfence_setup_allowed %}
                                {% set bf_company = guest.system_company %}
                                <div class="col-12 cf-brand-drops" data-cf-brand-drops
                                     data-text-saved="{{ 'Saved'|trans }}"
                                     data-text-not-image="{{ 'Choose a PNG, JPEG, GIF or WebP image.'|trans }}"
                                     data-text-too-big="{{ 'The image is larger than 2 MB.'|trans }}">
                                    {% include 'mod_clientfence_brand_drops.html.twig' with { urls: {
                                        logo: params.company_logo|default('') ? bf_company.logo_url : null,
                                        logo_dark: params.company_logo_dark|default('') ? bf_company.logo_url_dark : null,
                                        icon: params.company_favicon|default('') ? bf_company.favicon_url : null,
                                    } } %}
                                </div>
                                {% else %}
                                    <div class="col-lg-6">
                                        <label class="form-label" for="company_favicon">{{ 'Favicon'|trans }}</label>
                                        <input class="form-control" id="company_favicon" type="text" name="company_favicon" value="{{ params.company_favicon|default('') }}">
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="company_logo">{{ 'Logo URL'|trans }}</label>
                                        <input class="form-control" id="company_logo" type="text" name="company_logo" value="{{ params.company_logo|default('') }}">
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="company_logo_dark">{{ 'Logo URL (dark mode)'|trans }}</label>
                                        <input class="form-control" id="company_logo_dark" type="text" name="company_logo_dark" value="{{ params.company_logo_dark|default('') }}">
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Registration and Banking'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Store company identifiers and optional bank details for use on invoices and documents.'|trans }}</p>
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label" for="company_number">{{ 'Company Number'|trans }}</label>
                                    <input class="form-control" id="company_number" type="text" name="company_number" value="{{ params.company_number|default('') }}">
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="company_vat_number">{{ 'VAT Number'|trans }}</label>
                                    <input class="form-control" id="company_vat_number" type="text" name="company_vat_number" value="{{ params.company_vat_number|default('') }}">
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="company_bank_name">{{ 'Bank Name'|trans }}</label>
                                    <input class="form-control" id="company_bank_name" type="text" name="company_bank_name" value="{{ params.company_bank_name|default('') }}">
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="company_bic">{{ 'BIC / SWIFT Code'|trans }}</label>
                                    <input class="form-control" id="company_bic" type="text" name="company_bic" value="{{ params.company_bic|default('') }}">
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="company_account_number">{{ 'Bank Account Number'|trans }}</label>
                                    <input class="form-control" id="company_account_number" type="text" name="company_account_number" value="{{ params.company_account_number|default('') }}">
                                </div>
                            </div>
                            <div class="mt-4 d-flex flex-column gap-3">
                                <label class="form-check form-switch form-switch-2">
                                    <input type="hidden" name="company_display_bank_info" value="0">
                                    <input class="form-check-input" type="checkbox" name="company_display_bank_info" value="1" {% if params.company_display_bank_info|default('') == '1' %}checked{% endif %}>
                                    <span class="form-check-label">{{ 'Display Bank Account Information on Documents'|trans }}</span>
                                </label>
                                <label class="form-check form-switch form-switch-2">
                                    <input type="hidden" name="company_bank_info_pagebottom" value="0">
                                    <input class="form-check-input" type="checkbox" name="company_bank_info_pagebottom" value="1" {% if params.company_bank_info_pagebottom|default('') == '1' %}checked{% endif %}>
                                    <span class="form-check-label">{{ 'Display Bank Account Information at the Bottom of Every Page'|trans }}</span>
                                </label>
                                <label class="form-check form-switch form-switch-2">
                                    <input type="hidden" name="hide_company_public" value="0">
                                    <input class="form-check-input" id="hide_company_public" type="checkbox" name="hide_company_public" value="1" {% if params.hide_company_public|default('') == '1' %}checked{% endif %}>
                                    <span class="form-check-label">{{ 'Hide Some Company Information in the Guest API'|trans }}</span>
                                </label>
                                <small class="form-hint">{{ 'Enabling this hides some information from the company guest API endpoint, including address, phone number, email, VAT number, and more.'|trans }}</small>
                            </div>
                        </div>
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Signature'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Set a default company signature for use in documents and communications.'|trans }}</p>
                            <textarea class="form-control" name="company_signature" rows="3">{{ params.company_signature|default('') }}</textarea>
                        </div>
                        <div class="card-footer text-end">
                            <button class="btn btn-primary" type="submit"{% if not can_update_params %} disabled aria-disabled="true"{% endif %}>{{ 'Update Settings'|trans }}</button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="company-legal" role="tabpanel">
                    <form method="post" action="{{ 'system/update_params'|api_url }}" {{ fb_api_form({ message: 'Company Updated'|trans}) }}>
                        <div class="card-body">
                            <div class="alert alert-info" role="alert">
                                <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ 'These text blocks appear on legal and informational pages and may also be referenced from other client-facing areas.'|trans }}
                            </div>
                            <div class="mb-3">
                                <h4 class="card-title mb-2">{{ 'Company Terms of Service, Legal Regulation'|trans }}</h4>
                                <textarea class="form-control editor-textarea" name="company_tos" rows="5">{{ params.company_tos|default('') }}</textarea>
                            </div>
                            <div class="mb-3">
                                <h4 class="card-title mb-2">{{ 'Company Privacy Policy'|trans }}</h4>
                                <textarea class="form-control editor-textarea" name="company_privacy_policy" rows="5">{{ params.company_privacy_policy|default('') }}</textarea>
                            </div>
                            <div class="mb-3">
                                <h4 class="card-title mb-2">{{ 'Notes'|trans }}</h4>
                                <textarea class="form-control editor-textarea" name="company_note" rows="5">{{ params.company_note|default('') }}</textarea>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <button class="btn btn-primary" type="submit"{% if not can_update_params %} disabled aria-disabled="true"{% endif %}>{{ 'Update Settings'|trans }}</button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="tab-localization" role="tabpanel">
                    <form method="post" action="{{ 'system/update_localization_settings'|api_url }}" {{ fb_api_form({ message: 'Localization settings updated'|trans }) }}>
                        <div class="card-body">
                            <div class="alert alert-info" role="alert">
                                <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ 'Localization controls the default language shown to guests and whether browser language detection should override it before a user chooses a preference.'|trans }}
                            </div>
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label" for="default_locale">{{ 'Default Locale'|trans }}</label>
                                    <select class="form-select" id="default_locale" name="locale">
                                        {% set enabled_locales = guest.extension_languages(true) %}
                                        {% for lang in enabled_locales %}
                                            <option value="{{ lang.locale }}" {% if localization.locale == lang.locale %}selected{% endif %}>{{ lang.name }} ({{ lang.locale }})</option>
                                        {% endfor %}
                                    </select>
                                    <input type="hidden" name="current_locale" value="{{ localization.locale }}">
                                    <div class="form-hint">{{ 'Used when browser language detection is disabled or no suitable browser language match is found.'|trans }}</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-check form-switch form-switch-2">
                                    <input type="hidden" name="auto_detect_locale" value="0">
                                    <input class="form-check-input" type="checkbox" name="auto_detect_locale" id="auto_detect_locale_yes" value="1" {% if localization.auto_detect_locale %}checked{% endif %}>
                                    <span class="form-check-label">{{ 'Automatic Browser Language Detection'|trans }}</span>
                                </label>
                                <small class="form-hint">{{ 'When enabled, guests without a saved language preference start in the best match from their browser. When disabled, ClientFence uses the configured default locale until the user explicitly selects a language.'|trans }}</small>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <button class="btn btn-primary" type="submit"{% if not can_update_params %} disabled aria-disabled="true"{% endif %}>{{ 'Update Settings'|trans }}</button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="tab-countries" role="tabpanel">
                    <form method="post" action="{{ 'extension/config_save'|api_url }}" {{ fb_api_form({ message: 'Countries Updated'|trans}) }}>
                        <input type="hidden" name="ext" value="mod_system">
                        <div class="card-body">
{% set default_countries = country_names()|map((name, code) => code ~ '=' ~ name)|join('\n') %}
                            <div class="alert alert-info" role="alert">
                                <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ 'This list controls which countries appear in signup and profile forms, and which one is preselected for new users.'|trans }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="default_country">{{ 'Default Country for New Users'|trans }}</label>
                                <div class="col-12 col-xl-6 ps-0">
                                    <select class="form-select" id="default_country" name="default_country">
                                        <option value="" {% if new_params.default_country is not defined or new_params.default_country == '' %}selected{% endif %}>
                                            {{ 'No Default Country'|trans }}
                                        </option>
                                        {% for line in (new_params.countries|default(default_countries))|split('\n') %}
                                            {% set parts = line|split('=') %}
                                            {% if parts|length == 2 %}
                                                <option value="{{ parts[0] }}" {% if new_params.default_country is defined and new_params.default_country == parts[0] %}selected{% endif %}>
                                                    {{ parts[1] }}
                                                </option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <label class="form-label" for="countries">{{ 'List of Countries'|trans }}</label>
                            <textarea class="form-control col-12 col-xl-8" id="countries" name="countries" rows="25" placeholder="US=United States">{{ new_params.countries|default(default_countries) }}</textarea>
                        </div>
                        <div class="card-footer text-end">
                            <button class="btn btn-primary" type="submit">{{ 'Update Settings'|trans }}</button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="tab-cache" role="tabpanel">
                    <div class="card-body">
                        <h4 class="card-title mb-2">{{ 'Cache Backend'|trans }}</h4>
                        <p class="text-secondary">{{ 'Choose the backend used for the application cache, rate limiter, and Doctrine ORM cache. Redis and Memcached require the corresponding PHP extension to be installed on the server.'|trans }}</p>
                        {# ClientFence core patch: only Super Administrators change the cache backend (cached settings hold decrypted secrets). #}
                        <p class="form-hint">{{ 'Only Super Administrators can change the cache settings.'|trans }}</p>
                        <form method="post" action="{{ 'system/update_cache_settings'|api_url }}" {{ fb_api_form({ message: 'Cache settings updated'|trans }) }}>
                            <div class="d-flex flex-wrap gap-3 mb-3" id="cache-driver">
                                <div class="form-check">
                                    <input class="form-check-input" id="radioCacheFilesystem" type="radio" name="driver" value="filesystem"{% if cache_settings.driver == 'filesystem' %} checked{% endif %}>
                                    <label class="form-check-label" for="radioCacheFilesystem">{{ 'Filesystem'|trans }}</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" id="radioCacheRedis" type="radio" name="driver" value="redis"{% if cache_settings.driver == 'redis' %} checked{% endif %}>
                                    <label class="form-check-label" for="radioCacheRedis">{{ 'Redis'|trans }}</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" id="radioCacheMemcached" type="radio" name="driver" value="memcached"{% if cache_settings.driver == 'memcached' %} checked{% endif %}>
                                    <label class="form-check-label" for="radioCacheMemcached">{{ 'Memcached'|trans }}</label>
                                </div>
                            </div>

                            <fieldset class="cache-redis"{% if cache_settings.driver != 'redis' %} style="display:none;"{% endif %}>
                                <legend class="h5 mb-3">{{ 'Redis Settings'|trans }}</legend>
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <label class="form-label" for="redis_host">{{ 'Host'|trans }}</label>
                                        <input class="form-control" id="redis_host" type="text" name="redis_host" value="{{ cache_settings.redis_host }}" placeholder="127.0.0.1">
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="redis_port">{{ 'Port'|trans }}</label>
                                        <input class="form-control" id="redis_port" type="text" name="redis_port" value="{{ cache_settings.redis_port }}" placeholder="6379">
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="redis_password">{{ 'Password'|trans }}</label>
                                        <input class="form-control" id="redis_password" type="password" name="redis_password" placeholder="{% if cache_settings.redis_password_set %}{{ '(unchanged)'|trans }}{% endif %}">
                                        <div class="form-hint">{{ 'Leave blank to keep the current password.'|trans }}</div>
                                        {% if cache_settings.redis_password_set %}
                                            <label class="form-check mt-1">
                                                <input type="hidden" name="redis_password_clear" value="0">
                                                <input class="form-check-input" type="checkbox" name="redis_password_clear" value="1">
                                                <span class="form-check-label">{{ 'Clear the saved password'|trans }}</span>
                                            </label>
                                        {% endif %}
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="redis_database">{{ 'Database Index'|trans }}</label>
                                        <input class="form-control" id="redis_database" type="text" name="redis_database" value="{{ cache_settings.redis_database }}" placeholder="0">
                                    </div>
                                </div>
                                <div class="form-hint mt-2">{{ 'Requires the PHP redis (or relay) extension.'|trans }}</div>

                                <hr>

                                <div class="form-check form-switch mb-2">
                                    <input type="hidden" name="redis_tls_enabled" value="0">
                                    <input class="form-check-input" id="redis_tls_enabled" type="checkbox" name="redis_tls_enabled" value="1"{% if cache_settings.redis_tls_enabled %} checked{% endif %}>
                                    <label class="form-check-label" for="redis_tls_enabled">{{ 'Use TLS'|trans }}</label>
                                </div>
                                <p class="text-secondary">{{ 'Required whenever a password is set above and the host isn\'t a loopback address (127.0.0.1, ::1, localhost) - otherwise the password and cached data would be sent in plain text.'|trans }}</p>

                                <div class="row g-3" id="redis-tls-options"{% if not cache_settings.redis_tls_enabled %} style="display:none;"{% endif %}>
                                    <div class="col-lg-6">
                                        <label class="form-check form-switch">
                                            <input type="hidden" name="redis_tls_verify_peer" value="0">
                                            <input class="form-check-input" type="checkbox" name="redis_tls_verify_peer" value="1"{% if cache_settings.redis_tls_verify_peer %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Verify server certificate'|trans }}</span>
                                        </label>
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-check form-switch">
                                            <input type="hidden" name="redis_tls_verify_peer_name" value="0">
                                            <input class="form-check-input" type="checkbox" name="redis_tls_verify_peer_name" value="1"{% if cache_settings.redis_tls_verify_peer_name %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Verify certificate hostname'|trans }}</span>
                                        </label>
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="redis_tls_cafile">{{ 'CA Bundle Path'|trans }}</label>
                                        <input class="form-control" id="redis_tls_cafile" type="text" name="redis_tls_cafile" value="{{ cache_settings.redis_tls_cafile }}" placeholder="{{ '(system default)'|trans }}">
                                        <div class="form-hint">{{ 'Only needed if the Redis server\'s certificate isn\'t signed by a CA your system already trusts.'|trans }}</div>
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-check form-switch mt-4 mt-lg-0">
                                            <input type="hidden" name="redis_tls_allow_self_signed" value="0">
                                            <input class="form-check-input" type="checkbox" name="redis_tls_allow_self_signed" value="1"{% if cache_settings.redis_tls_allow_self_signed %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Allow self-signed certificate'|trans }}</span>
                                        </label>
                                        <div class="form-hint">{{ 'Development/testing only - never enable this in production.'|trans }}</div>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset class="cache-memcached"{% if cache_settings.driver != 'memcached' %} style="display:none;"{% endif %}>
                                <legend class="h5 mb-3">{{ 'Memcached Settings'|trans }}</legend>
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <label class="form-label" for="memcached_host">{{ 'Host'|trans }}</label>
                                        <input class="form-control" id="memcached_host" type="text" name="memcached_host" value="{{ cache_settings.memcached_host }}" placeholder="127.0.0.1">
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="memcached_port">{{ 'Port'|trans }}</label>
                                        <input class="form-control" id="memcached_port" type="text" name="memcached_port" value="{{ cache_settings.memcached_port }}" placeholder="11211">
                                    </div>
                                </div>
                                <div class="form-hint mt-2">{{ 'Requires the PHP memcached extension.'|trans }}</div>
                            </fieldset>

                            <div class="mt-3">
                                <button class="btn btn-primary" type="submit"{% if not can_update_params %} disabled aria-disabled="true"{% endif %}>{{ 'Update Settings'|trans }}</button>
                            </div>
                        </form>
                    </div>

                    <div class="card-body d-flex align-items-center justify-content-between gap-3 border-top">
                        <div>
                            <h4 class="card-title mb-2">{{ 'Cache Control'|trans }}</h4>
                            <p class="text-secondary mb-0">{{ 'Clear compiled templates and cached system state when you need configuration or theme changes to take effect immediately.'|trans }}</p>
                        </div>
                        <div>
                            <form method="post" action="{{ 'system/clear_cache'|api_url }}" {{ fb_api_form({ message: 'Cache Directory Cleared'|trans}) }}>
                                <button class="btn btn-danger" type="submit"{% if not can_invalidate_cache %} disabled aria-disabled="true"{% endif %}>{{ 'Invalidate cache'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-about" role="tabpanel">
                    <div class="card-body">
                        <h4 class="card-title mb-3">{{ 'About ClientFence'|trans }}</h4>
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'ClientFence version'|trans }}</div>
                                <div class="datagrid-content">{{ ClientFenceVersion }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'PHP version'|trans }}</div>
                                <div class="datagrid-content">{{ constant('PHP_VERSION') }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'Instance ID'|trans }}</div>
                                <div class="datagrid-content">{{ admin.system_instance_id }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'License'|trans }}</div>
                                <div class="datagrid-content"><a href="https://github.com/cPFence/clientfence/blob/main/LICENSE" target="_blank">Apache 2.0</a></div>
                            </div>
                        </div>

                        <div class="accordion mt-4" id="accordion-default">
                            <div class="accordion-item">
                                <div class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1-default" aria-expanded="false">
                                    {{ 'Enabled modules'|trans }}
                                    <div class="accordion-button-toggle">
                                        <svg class="icon">
                                            <use href="#chevron-down" />
                                        </svg>
                                    </div>
                                </button>
                                </div>
                                <div id="collapse-1-default" class="accordion-collapse collapse" data-bs-parent="#accordion-default">
                                    <div class="accordion-body">
                                        <div class="container">
                                            <div style="column-count: 3; column-gap: 2rem;">
                                                {% set modules = admin.extension_get_list({ 'active': true }) %}
                                                {% for module in modules %}
                                                <div class="border rounded px-3 py-2 mb-2 d-flex justify-content-between align-items-center">
                                                    <span>
                                                    {% if module.status == 'core' %}
                                                        <svg class="icon" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'This is a core module included with ClientFence and cannot be disabled.'|trans }}">
                                                            <use href="#settings" />
                                                        </svg>
                                                    {% endif %}
                                                    <span title="Module ID: {{ module.id }}">{{ module.name }}</span>
                                                    </span>
                                                    <span class="badge bg-default text-default-fg">{{ module.version }}</span>
                                                </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                {% if bf_health %}
                <div class="tab-pane fade" id="tab-health" role="tabpanel">
                    <div class="card-body">
                        {% include 'mod_clientfence_health_panel.html.twig' with { 'report': bf_health.report, 'groups': bf_health.groups } %}
                    </div>
                </div>
                {% endif %}

                {% if bf_backups %}
                <div class="tab-pane fade" id="tab-backups" role="tabpanel">
                    <div class="card-body">
                        {% include 'mod_clientfence_backups_panel.html.twig' with { 'backups': bf_backups } %}
                    </div>
                </div>
                {% endif %}

                {% if bf_maintenance %}
                <div class="tab-pane fade" id="tab-maintenance" role="tabpanel">
                    <div class="card-body">
                        {% include 'mod_system_maintenance_panel.html.twig' with { 'maintenance': bf_maintenance, 'can_update': can_update_params } %}
                    </div>
                </div>
                {% endif %}

                {% if bf_licences %}
                <div class="tab-pane fade" id="tab-licences" role="tabpanel">
                    <div class="card-body">
                        {% include 'mod_servicelicense_settings_panel.html.twig' with { 'licences': bf_licences } %}
                    </div>
                </div>
                {% endif %}

                {% if bf_whmcs %}
                <div class="tab-pane fade" id="tab-whmcs" role="tabpanel">
                    <div class="card-body">
                        {% include 'mod_clientfence_whmcs_panel.html.twig' with { 'whmcs': bf_whmcs } %}
                    </div>
                </div>
                {% endif %}

                <div class="tab-pane fade" id="network-interface" role="tabpanel">
                    <div class="card-body">
                        <h4 class="card-title mb-3">{{ 'Network Interface'|trans }}</h4>
                        <div class="alert alert-info" role="alert" id="external-ip">
                            <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ "Checking external IP..."|trans }}
                        </div>
                        {% if can_manage_network_interface %}
                            <form method="post" action="{{ 'system/set_interface_ip'|api_url }}" {{ fb_api_form({ callback: 'onAfterInterfaceSet'}) }}>
                                <p>{{ 'If your server has multiple network interfaces, you may select the default one for ClientFence to use when making requests here.'|trans }}</p>

                                <div class="col-12 col-lg-3">
                                    <label for="interface">{{ 'Select the Default Network Interface:'|trans }}</label>
                                    <select class="form-select" name="interface" id="interface">
                                        <option value="0">{{ 'None (Default PHP Behavior)'|trans }}</option>
                                    </select>
                                </div>

                                <br>

                                <div class="col-12 col-lg-3">
                                    <label for="custom_interface">{{'Enter a Custom Interface to Use:'|trans }}</label>
                                    <input class="form-control mt-1" type="text" name="custom_interface" id="custom_interface">
                                </div>
                                <span class="text-muted">
                                    {{ "If the dropdown menu doesn't have the appropriate network interface, please enter the IP address or name (e.g., eth0) of the correct one above."|trans }}
                                </span>
                                <br>

                                <input type="submit" class="btn btn-primary mt-1" value="{{ 'Update'|trans }}">
                            </form>
                        {% else %}
                            <div class="alert alert-warning" role="alert">
                                <strong class="me-1">{{ 'Warning:'|trans }}</strong>{{ 'You do not have permission to manage the network interface.'|trans }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script nonce="{{ csp_nonce }}">
    const bindTo = "{{ constant('BIND_TO') }}";
    const canManageNetworkInterface = {{ can_manage_network_interface ? 'true' : 'false' }};

    function updateExternalIP() {
        const el = document.getElementById('external-ip');
        // Always show a loading state first
        el.innerHTML = `<strong class="me-1">{{ 'Information:'|trans }}</strong>{{ "Checking external IP..."|trans }}`;
        el.className = 'alert alert-info';

        ClientFence.api.admin.get('system/env', { ip: true }, function (ip) {
            if (ip) {
                el.innerHTML = `<strong class="me-1">{{ 'Success:'|trans }}</strong>{{ 'With the current settings, your ClientFence instance will have an external IP address of: '|trans }}`;
                el.appendChild(document.createTextNode(ip));
                el.className = 'alert alert-success';
            } else {
                el.innerHTML = `<strong class="me-1">{{ 'Warning:'|trans }}</strong>{{ 'The currently selected network interface does not appear to be able to reach the internet!'|trans }}`;
                el.className = 'alert alert-danger';
            }
        });
    }

    function loadInterfaceIPs() {
        const select = document.getElementById('interface');
        if (!select) {
            return;
        }

        // Show loading state first
        select.innerHTML = `<option disabled selected>{{ "Loading interfaces..."|trans }}</option>`;

        ClientFence.api.admin.get('system/get_interface_ips', {}, function (interfaces) {
            select.innerHTML = `<option value="0">{{ 'None (Default PHP Behavior)'|trans }}</option>`;

            interfaces.forEach(interface => {
                const opt = document.createElement('option');
                opt.value = interface;
                opt.textContent = interface;
                if (interface === bindTo) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });

            // Handle custom interface
            const custom = document.getElementById('custom_interface');
            if (bindTo !== "0" && !interfaces.includes(bindTo)) {
                custom.value = bindTo;
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const networkTab = document.querySelector('a[href="#network-interface"]');
        networkTab.addEventListener("shown.bs.tab", function () {
            updateExternalIP();
            if (canManageNetworkInterface) {
                loadInterfaceIPs();
            }
        });
    });

    function onAfterInterfaceSet(result) {
        ClientFence.message(`{{ 'Network interface updated.'|trans }}`);
        updateExternalIP();
    }

    const cacheDriverInputs = document.querySelectorAll('#cache-driver input');

    cacheDriverInputs.forEach(input => {
        input.addEventListener('click', function() {
            const redisFieldset = document.querySelector('fieldset.cache-redis');
            const memcachedFieldset = document.querySelector('fieldset.cache-memcached');

            redisFieldset.style.display = this.value === 'redis' ? 'block' : 'none';
            memcachedFieldset.style.display = this.value === 'memcached' ? 'block' : 'none';
        });
    });

    document.getElementById('redis_tls_enabled').addEventListener('change', function() {
        document.getElementById('redis-tls-options').style.display = this.checked ? 'flex' : 'none';
    });
</script>
{% endblock %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
    {# ClientFence core patch: the logo upload zones' style and script (Contact and Branding). #}
    <link rel="stylesheet" href="{{ 'clientfence/clientfence-setup.css'|asset_url }}?v={{ include('partial_clientfence_asset_version.html.twig')|trim }}">
    <script nonce="{{ csp_nonce }}" type="module" src="{{ 'clientfence/clientfence-setup.js'|asset_url }}?v={{ include('partial_clientfence_asset_version.html.twig')|trim }}"></script>
{% endblock %}
