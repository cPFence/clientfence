{% block subject %}[{{ guest.system_company.name }}] [Ticket #{{ ticket.id|default('') }}] {{ ticket.subject|default('') }}{% endblock %}
{% block content %}
{% set is_guest_ticket = ticket.author.role|default('') == 'guest' %}
{% set ticket_url = is_guest_ticket ? "support/ticket/#{ticket.hash|default('')}"|url(area: 'client') : "support/ticket/#{ticket.id|default('')}"|url(area: 'client') %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ 'Ticket #%id%'|trans({'%id%': ticket.id|default('')}) }}</title>
</head>
<body style="margin:0; padding:0; background-color:#eef3f6;">
{# ClientFence core patch: email restyled: header band, rounded card, panel strip, pill button, status chips (CF-135 redesign). #}
{# ClientFence: replies by email go to the ticket (Support/MailImport.php): [Ticket #id] in the subject; text from this line on is cut. #}
<p class="reply-line" style="margin:0; padding:8px 12px; font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#94a3b8; text-align:center;">====== Please reply above this line ======</p>
<div style="display:none; max-height:0; overflow:hidden;">{{ 'There is a new reply on your ticket "%subject%".'|trans({'%subject%': ticket.subject|default('')}) }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef3f6" style="background-color:#eef3f6; background-image:linear-gradient(180deg, #d7eeec 0px, #eef3f6 360px);">
<tr><td align="center" style="padding:12px 12px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width:600px; background-color:#ffffff; border:1px solid #e4eaee; border-radius:16px; box-shadow:0 8px 28px rgba(12,39,56,0.10);">
	<tr><td bgcolor="#0c2738" style="padding:24px 32px; background-color:#0c2738; background-image:linear-gradient(135deg, #0c2738 0%, #11334a 55%, #0e5a7a 100%); border-radius:16px 16px 0 0; border-bottom:3px solid {{ guest.system_company.brand_color|default('#2563eb') }};">
		{% if guest.system_company.logo_url_email|default('') %}
		<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#ffffff" style="padding:8px 14px; background-color:#ffffff; border-radius:12px;"><img src="{{ guest.system_company.logo_url_email }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;"></td></tr></table>
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#ffffff;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'We have replied to your ticket'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %name%,'|trans({'%name%': ticket.author.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Our support team has posted a new reply to your ticket %subject%. You can read the reply and answer it from the link below.'|trans_html({}, {'%subject%': '<strong>' ~ (ticket.subject|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Ticket'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">#{{ ticket.id|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Subject'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ ticket.subject|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Department'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ ticket.helpdesk|default({}).name|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Status'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;"><span style="display:inline-block; padding:2px 10px; border-radius:999px; background-color:#d9f2ef; color:#0e5a7a; font-size:12px; font-weight:bold; line-height:18px;">{{ ticket.status|default('') == 'on_hold' ? 'Answered'|trans : ticket.status|default('')|title }}</span></td></tr>
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ticket_url }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'View ticket'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
	</td></tr>
	<tr><td bgcolor="#f7fafb" style="padding:20px 32px; background-color:#f7fafb; border-top:1px solid #eef2f5; border-radius:0 0 16px 16px; text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		{% if not is_guest_ticket %}<a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Client area'|trans }}</a> &middot; <a href="{{ 'client/profile'|url(area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Profile'|trans }}</a> &middot; {% endif %}{% if guest.system_company.email|default('') %}<a href="mailto:{{ guest.system_company.email }}" style="color:#64748b;">{{ guest.system_company.email }}</a>{% endif %}
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
