{% block subject %}[{{ guest.system_company.name }}] Your email was not added to a ticket: {{ rejected.subject|default('') }}{% endblock %}
{% block content %}
{# ClientFence: sent by the ticket email import (Support/MailImport.php) when an email is refused. #}
{% set rejected = rejected|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Email Not Added</h1>
	<p>Hello,</p>
	<p>Your email "{{ rejected.subject|default('') }}" to {{ rejected.helpdesk|default('our support team') }} was not added to a support ticket.</p>
	{% if rejected.reason|default('') == 'rejected_closed' %}
	<p>Ticket #{{ rejected.ticket_id|default('') }} is closed. Please open a new ticket, or sign in to our client area to see it.</p>
	{% elseif rejected.reason|default('') == 'rejected_replies_only' %}
	<p>This address only takes replies to existing tickets. Please open a new ticket from our client area.</p>
	{% elseif rejected.reason|default('') == 'rejected_clients_only' %}
	<p>This address only takes emails from registered clients. If you are a client, please write from the email address of your account, or open a ticket from our client area.</p>
	{% elseif rejected.reason|default('') == 'rejected_refused' %}
	<p>{{ rejected.note|default('') }}</p>
	{% elseif rejected.reason|default('') == 'rejected_too_large' %}
	<p>The email was too large. Please send it again with smaller attachments, or attach the files from our client area.</p>
	{% endif %}
	<p><a href="{{ 'support'|url(area: 'client') }}" target="_blank">Open the client area</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
