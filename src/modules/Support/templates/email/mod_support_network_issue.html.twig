{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ issue.status_title|default('') }}: {{ issue.title|default('') }}{% endblock %}
{% block content %}
{% set email_title %}{{ issue.title|default('') }}{% endset %}
{% set email_preheader %}{{ issue.status_title|default('') }}: {{ issue.title|default('') }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ issue.title|default('') }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name%,'|trans({'%first_name%': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We would like to keep you informed about our network: %status_title% (%priority_title% priority).'|trans_html({'%priority_title%': issue.priority_title|default('')}, {'%status_title%': '<strong>' ~ (issue.status_title|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Affects'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ issue.about|default('') }}</td></tr>
					{% if issue.start_at|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Starts'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ issue.start_at|default('') ? issue.start_at|format_datetime : '' }}</td></tr>{% endif %}
					{% if issue.end_at|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Ends'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ issue.end_at|default('') ? issue.end_at|format_datetime : '' }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
{% if issue.description|default('') %}
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f3f6f8; border-left:3px solid #14a39a; border-radius:8px; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ issue.description }}</div>
{% endif %}
		<p style="margin:0 0 16px;">{{ 'We apologise for any inconvenience and will keep you updated.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ status_url|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'See the network status'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
