{% block subject %}[{{ guest.system_company.name }}] {{ 'How did we do? Your feedback on ticket #%id%'|trans({'%id%': ticket.id|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'How did we do?'|trans }}{% endset %}
{% set email_preheader %}{{ 'Tell us how we handled your ticket.'|trans }}{% endset %}
{% set email_audience = 'guest' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'How did we do?'|trans }}</h1>
		<p style="margin:0 0 16px;">{% if c.first_name|default(name|default('')) %}{{ 'Hello %name%,'|trans({'%name%': c.first_name|default(name|default(''))}) }}{% else %}{{ 'Hello,'|trans }}{% endif %}</p>
		<p style="margin:0 0 16px;">{{ 'Your ticket %ticket% is now closed. We would love to know how we handled it.'|trans_html({}, {'%ticket%': '<strong>#' ~ (ticket.id|default(''))|e ~ ' ' ~ (ticket.subject|default(''))|e ~ '</strong>'}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Please take a minute to rate the staff who helped you and tell us how we can improve. It takes no sign-in.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ feedback_url|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Give feedback'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'Thank you for helping us improve our service.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
