{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Support Settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|url }}">{{ 'Settings'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Support'|trans }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Support Settings'|trans }}</h3>
                <p class="card-subtitle">{{ 'Manage support automation, knowledge base availability, guest tickets, and helpdesk configuration.'|trans }}</p>
            </div>
        </div>
        <div class="card-body pt-3 pb-0 px-0">
                    <ul class="nav nav-pills mb-3 px-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" href="#tab-index" data-bs-toggle="tab" role="tab">{{ 'General'|trans }}</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" href="#tab-helpdesks" data-bs-toggle="tab" role="tab">{{ 'Helpdesks'|trans }}</a>
                        </li>
                        {# ClientFence core patch: escalation rules, as WHMCS (Support/TicketEscalation.php). #}
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" href="#tab-escalation" data-bs-toggle="tab" role="tab">{{ 'Escalation Rules'|trans }}</a>
                        </li>
                        {# ClientFence core patch: network status, as WHMCS's Network Issues (Support/NetworkIssues.php). #}
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" href="#tab-network" data-bs-toggle="tab" role="tab">{{ 'Network Status'|trans }}</a>
                        </li>
                    </ul>

            <div class="tab-content border-top">
                <div class="tab-pane fade show active" id="tab-index" role="tabpanel">
                    <form method="post" action="{{ 'extension/config_save'|api_url }}" {{ fb_api_form({ message: 'Configuration Updated'|trans }) }}>
                        {% set params = admin.extension_config_get({ 'ext': 'mod_support' }) %}
                        <div class="card-body">
                            <div class="alert alert-info" role="alert">
                                <strong class="me-1">{{ 'Information:'|trans }}</strong>{{ 'Use these settings to automate default ticket responses, control submission throttling, and manage public support visibility.'|trans }}
                            </div>

                            {# ClientFence core patch: tickets on or off, as Blesta's Support Manager, and the outside help desk (Support\Service::ticketsEnabled()). #}
                            {% set tickets_on = params.tickets_enable is not defined or params.tickets_enable is same as(true) or params.tickets_enable in [1, '1', 'true', 'on', 'yes'] %}
                            <h4 class="card-title mb-2">{{ 'Tickets'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Turn tickets off when you use another help desk: clients and visitors then open, reply to and email no tickets, and the ticket pages, menus and boxes are hidden. The tickets you have are kept and come back when you turn tickets on. The knowledge base and network status have their own switches.'|trans }}</p>
                            <label class="form-check form-switch form-switch-2">
                                <input name="tickets_enable" type="hidden" value="false">
                                <input class="form-check-input" name="tickets_enable" type="checkbox" value="true" {% if tickets_on %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Enable tickets'|trans }}</span>
                            </label>
                            <div class="mb-4 mt-2">
                                <label class="form-label" for="support_url">{{ 'Outside help desk address (optional)'|trans }}</label>
                                <input class="form-control col-12 col-xl-8" id="support_url" type="url" name="support_url" maxlength="500" placeholder="https://" value="{{ params.support_url|default('') }}">
                                <small class="form-hint">{{ 'While tickets are off, the Support menu opens this address, for example your FreeScout portal. Empty: no Support menu.'|trans }}</small>
                            </div>

                            <h4 class="card-title mb-2">{{ 'Auto Responder'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Automatically send a canned response when a new ticket is created.'|trans }}</p>
                            <label class="form-check form-switch form-switch-2 mb-3">
                                <input class="form-check-input" name="autorespond_enable" type="checkbox" {% if params.autorespond_enable|default(false) %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Enable Auto Responder'|trans }}</span>
                            </label>
                            <div id="autorespond_enable"{% if not params.autorespond_enable|default(false) %} style="display:none;"{% endif %}>
                                <label class="form-label" for="autorespond_message_id">{{ 'Auto Response Message'|trans }}</label>
                                <select class="form-select col-12 col-xl-8 canned_response_select" id="autorespond_message_id" name="autorespond_message_id">
                                    {% for category_title, responses in admin.support_canned_pairs %}
                                        <optgroup label="{{ category_title }}">
                                            {% for response_id, response_title in responses %}
                                                <option value="{{ response_id }}"{% if params.autorespond_message_id|default('') == response_id %} selected{% endif %}>{{ response_title }}</option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Ticket Delay'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Optionally add a canned response when a ticket remains unanswered for a configured number of hours.'|trans }}</p>
                            <label class="form-check form-switch form-switch-2 mb-2">
                                <input class="form-check-input" name="delay_enable" type="checkbox" {% if params.delay_enable|default(false) %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Enable Delay Message'|trans }}</span>
                            </label>
                            <small class="form-hint d-block mb-3">{{ 'If enabled, the selected canned response will be added to the default reply message.'|trans }}</small>
                            <div id="delay_enable"{% if not params.delay_enable|default(false) %} style="display:none;"{% endif %}>
                                <div class="row g-3">
                                    <div class="col-lg-4">
                                        <label class="form-label" for="delay_hours">{{ 'Delay'|trans }}</label>
                                        <div class="input-group">
                                            <input class="form-control" id="delay_hours" type="number" min="0" name="delay_hours" value="{{ params.delay_hours|default(24) }}" placeholder="24">
                                            <span class="input-group-text">{{ 'hours'|trans }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-8">
                                        <label class="form-label" for="delay_message_id">{{ 'Delay Message'|trans }}</label>
                                        <select class="form-select canned_response_select" id="delay_message_id" name="delay_message_id">
                                            {% for category_title, responses in admin.support_canned_pairs %}
                                                <optgroup label="{{ category_title }}">
                                                    {% for response_id, response_title in responses %}
                                                        <option value="{{ response_id }}"{% if params.delay_message_id|default('') == response_id %} selected{% endif %}>{{ response_title }}</option>
                                                    {% endfor %}
                                                </optgroup>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label" for="wait_hours">{{ 'Wait Time Between Ticket Submissions'|trans }}</label>
                                <div class="input-group col-12 col-xl-8">
                                    <input class="form-control" id="wait_hours" type="number" min="0" name="wait_hours" value="{{ params.wait_hours|default('') }}">
                                    <span class="input-group-text">{{ 'hours'|trans }}</span>
                                </div>
                                <small class="form-hint">{{ 'If set, users must wait this many hours between consecutive ticket submissions.'|trans }}</small>
                            </div>
                            <input type="hidden" name="ext" value="mod_support">
                        </div>
                        {# ClientFence core patch: a ticket limit per client, as WHMCS hosts add (Support/TicketLimit.php). #}
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Ticket Limit'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Limit the new tickets a client opens from the client area. Every ticket of the client in the period counts, but tickets staff open, tickets from email or the contact form and all replies are never refused. 0 or empty: no limit.'|trans }}</p>
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <label class="form-label" for="ticket_limit_max">{{ 'Tickets a client may open'|trans }}</label>
                                    <input class="form-control" id="ticket_limit_max" type="number" min="0" name="ticket_limit_max" value="{{ params.ticket_limit_max|default('') }}">
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="ticket_limit_days">{{ 'in this many days'|trans }}</label>
                                    <div class="input-group">
                                        <input class="form-control" id="ticket_limit_days" type="number" min="0" name="ticket_limit_days" value="{{ params.ticket_limit_days|default('') }}">
                                        <span class="input-group-text">{{ 'days'|trans }}</span>
                                    </div>
                                </div>
                                {% if has_permission('client', 'view') %}
                                <div class="col-lg-4">
                                    <label class="form-label" for="ticket_limit_exempt_groups">{{ 'Client groups without a limit'|trans }}</label>
                                    <select class="form-select" id="ticket_limit_exempt_groups" name="ticket_limit_exempt_groups[]" multiple>
                                        {% for group_id, group_title in admin.client_group_get_pairs %}
                                            <option value="{{ group_id }}"{% if group_id in params.ticket_limit_exempt_groups|default([]) %} selected{% endif %}>{{ group_title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                {% else %}
                                    {# Staff who cannot list client groups keep the saved ones. #}
                                    {% for group_id in params.ticket_limit_exempt_groups|default([]) %}<input type="hidden" name="ticket_limit_exempt_groups[]" value="{{ group_id }}">{% endfor %}
                                {% endif %}
                            </div>
                        </div>
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Knowledge Base'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Control whether the knowledge base is visible to clients and available throughout the support area.'|trans }}</p>
                            {% set kb_enabled = params.kb_enable is not defined or params.kb_enable is same as(true) or params.kb_enable in [1, '1', 'true', 'on', 'yes'] %}
                            <label class="form-check form-switch form-switch-2">
                                <input name="kb_enable" type="hidden" value="false">
                                <input class="form-check-input" name="kb_enable" type="checkbox" value="true" {% if kb_enabled %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Enable Knowledge Base'|trans }}</span>
                            </label>
                            <label class="form-check form-switch form-switch-2">
                                <input class="form-check-input" name="kb_suggestions_ticket" type="checkbox" {% if params.kb_suggestions_ticket|default(false) %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Show KB suggestions on the client ticket form'|trans }}</span>
                            </label>
                            <label class="form-check form-switch form-switch-2">
                                <input class="form-check-input" name="kb_suggestions_contact" type="checkbox" {% if params.kb_suggestions_contact|default(false) %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Show KB suggestions on the contact form'|trans }}</span>
                            </label>
                            {% set kb_article_views_enabled = params.kb_article_views_enable is not defined or params.kb_article_views_enable is same as(true) or params.kb_article_views_enable in [1, '1', 'true', 'on', 'yes'] %}
                            <label class="form-check form-switch form-switch-2">
                                <input name="kb_article_views_enable" type="hidden" value="false">
                                <input class="form-check-input" name="kb_article_views_enable" type="checkbox" value="true" {% if kb_article_views_enabled %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Show article view counts publicly'|trans }}</span>
                            </label>
                        </div>
                        {# ClientFence core patch: reply ratings, as WHMCS's Support Ticket Rating (Support/TicketFeedback.php). #}
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Ticket Ratings'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Clients rate each staff reply from 1 to 5 stars on the ticket page; Support > Ratings & Feedback shows the results. The feedback email when a ticket closes is set on each help desk.'|trans }}</p>
                            {% set ticket_rating_on = params.ticket_rating is not defined or params.ticket_rating is same as(true) or params.ticket_rating in [1, '1', 'true', 'on', 'yes'] %}
                            <label class="form-check form-switch form-switch-2">
                                <input name="ticket_rating" type="hidden" value="false">
                                <input class="form-check-input" name="ticket_rating" type="checkbox" value="true" {% if ticket_rating_on %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Let clients rate staff replies'|trans }}</span>
                            </label>
                        </div>
                        {# ClientFence core patch: ticket secrets, server access and other details kept encrypted on a ticket (Support/TicketSecrets.php). #}
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Ticket Secrets'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Signed-in clients can add server access or other secrets to an open ticket, outside the messages. They are encrypted, only staff with the "Open ticket secrets" permission can open them, every opening is shown on the ticket, and they are deleted when the ticket closes.'|trans }}</p>
                            <input name="secrets_server" type="hidden" value="0">
                            <label class="form-check form-switch form-switch-2">
                                <input class="form-check-input" name="secrets_server" type="checkbox" value="1"{% if params.secrets_server|default('0') == '1' %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Let clients add server access details'|trans }}</span>
                            </label>
                            <input name="secrets_other" type="hidden" value="0">
                            <label class="form-check form-switch form-switch-2">
                                <input class="form-check-input" name="secrets_other" type="checkbox" value="1"{% if params.secrets_other|default('0') == '1' %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Let clients add other secrets (API keys, logins)'|trans }}</span>
                            </label>
                            <div class="mt-3">
                                <label class="form-label" for="secrets_days">{{ 'Delete secrets after'|trans }}</label>
                                <div class="input-group col-12 col-xl-8">
                                    <input class="form-control" id="secrets_days" type="number" min="1" max="90" name="secrets_days" value="{{ params.secrets_days|default('7') }}" required>
                                    <span class="input-group-text">{{ 'days'|trans }}</span>
                                </div>
                                <small class="form-hint">{{ 'Even when the ticket stays open. Closing the ticket deletes them at once.'|trans }}</small>
                            </div>
                        </div>
                        <div class="card-body border-top">
                            <h4 class="card-title mb-2">{{ 'Guest Tickets'|trans }}</h4>
                            <p class="text-secondary mb-3">{{ 'Control whether non-client visitors may open support tickets.'|trans }}</p>
                            <label class="form-check form-switch form-switch-2">
                                <input class="form-check-input" name="disable_guest_tickets" type="checkbox" {% if params.disable_guest_tickets|default(false) %} checked="checked"{% endif %}>
                                <span class="form-check-label">{{ 'Disable Guest Tickets'|trans }}</span>
                            </label>
                        </div>
                        <div class="card-footer text-end">
                            <input type="submit" class="btn btn-primary" value="{{ 'Update'|trans }}">
                        </div>
                    </form>
                    {# ClientFence: ticket attachments and email import, each saved on its own (kept by Extension\Service::setConfig). #}
                    {{ include('mod_support_settings_ticket_files.html.twig') }}
                    {{ include('mod_support_settings_mail.html.twig') }}
                </div>

                <div class="tab-pane fade" id="tab-escalation" role="tabpanel">
                    {{ include('mod_support_settings_escalation.html.twig') }}
                </div>

                <div class="tab-pane fade" id="tab-network" role="tabpanel">
                    {{ include('mod_support_settings_network.html.twig') }}
                </div>

                <div class="tab-pane fade" id="tab-helpdesks">
                    {# ClientFence core patch: the list is shared with the help desks page (mod_support_helpdesks). #}
                    {{ include('partial_support_helpdesks.html.twig', { back: 'extension/settings/support'|url }) }}
                </div>
            </div>
        </div>
    </div>

{{ include('modal/mod_support_new_helpdesk.html.twig') }}
{% endblock %}

{% block js %}
<script nonce="{{ csp_nonce }}">
    document.addEventListener('DOMContentLoaded', () => {
        let autoRespondToggle = document.querySelector('input[name=autorespond_enable]');
        autoRespondToggle.addEventListener('click', (e) => {
            if (e.target.checked) {
                document.getElementById('autorespond_enable').style.display = 'block';
            } else {
                document.getElementById('autorespond_enable').style.display = 'none';
            }
        })

        let delayToggle = document.querySelector('input[name=delay_enable]');
        delayToggle.addEventListener('click', (e) => {
            if (e.target.checked) {
                document.getElementById('delay_enable').style.display = 'block';
            } else {
                document.getElementById('delay_enable').style.display = 'none';
            }
        })

    });
</script>
{% endblock %}
