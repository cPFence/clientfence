{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}
{# ClientFence: Support > Network Issues, as WHMCS (Support/NetworkIssues.php): open issues, scheduled
   work and resolved issues, newest first. #}

{% set active_menu = 'support' %}
{% set groups = { 'open': 'Open'|trans, 'scheduled': 'Scheduled'|trans, 'resolved': 'Resolved'|trans } %}
{% set group = request.group|default('open') in groups|keys ? request.group|default('open') : 'open' %}
{% set issues = admin.support_network_issue_get_list({ 'group': group, 'page': request.page|default(1), 'per_page': 25 }) %}
{% set badges = { 'reported': 'bg-yellow-lt', 'investigating': 'bg-orange-lt', 'in_progress': 'bg-blue-lt', 'outage': 'bg-red-lt', 'scheduled': 'bg-purple-lt', 'resolved': 'bg-green-lt' } %}
{% set priority_badges = { 'critical': 'bg-red', 'high': 'bg-orange', 'medium': 'bg-yellow', 'low': 'bg-secondary' } %}

{% block meta_title %}{{ 'Network Issues'|trans }}{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <div>
            <h3 class="card-title">{{ 'Network Issues'|trans }}</h3>
            <p class="card-subtitle">{{ 'Outages and planned work, shown to clients on the Network Status page. Clients with services on an affected server see a banner while an issue is open or the work is scheduled; you can also email them when you save an issue.'|trans }}</p>
        </div>
        <div class="card-actions btn-list">
            <a class="btn" href="{{ ('network-status')|url(area: 'client') }}" target="_blank">{{ 'Client page'|trans }}</a>
            <a class="btn btn-primary" href="{{ 'support/network-issue/0'|url }}"><svg class="icon"><use href="#plus" /></svg> {{ 'New Issue'|trans }}</a>
        </div>
    </div>
    <div class="card-header">
        <ul class="nav nav-pills card-header-pills">
            {% for key, label in groups %}
                <li class="nav-item">
                    <a class="nav-link{% if group == key %} active{% endif %}" href="{{ 'support/network-issues'|url(query: { 'group': key }) }}">
                        {{ label }}{% if issues.counts[key]|default(0) %} <span class="badge bg-secondary-lt ms-1">{{ issues.counts[key] }}</span>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter text-nowrap">
            <thead>
                <tr>
                    <th class="w-1">#</th>
                    <th>{{ 'Title'|trans }}</th>
                    <th>{{ 'Affects'|trans }}</th>
                    <th>{{ 'Priority'|trans }}</th>
                    <th>{{ 'Status'|trans }}</th>
                    <th>{{ 'Start'|trans }}</th>
                    <th>{{ 'End'|trans }}</th>
                    <th>{{ 'Emailed'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for issue in issues.list %}
                    <tr>
                        <td><a href="{{ ('support/network-issue/' ~ issue.id)|url }}">{{ issue.id }}</a></td>
                        <td class="text-wrap" dir="auto"><a href="{{ ('support/network-issue/' ~ issue.id)|url }}">{{ issue.title }}</a></td>
                        <td dir="auto">{{ issue.about }}</td>
                        <td><span class="badge {{ priority_badges[issue.priority]|default('bg-secondary') }} text-white">{{ issue.priority_title }}</span></td>
                        <td><span class="badge {{ badges[issue.status]|default('bg-secondary-lt') }}">{{ issue.status_title }}</span></td>
                        <td>{{ issue.start_at|format_datetime }}</td>
                        <td>{{ issue.end_at ? issue.end_at|format_datetime : '-' }}</td>
                        <td class="text-secondary">{{ issue.emailed_at ? 'To %count% clients'|trans({ '%count%': issue.emailed_count }) : '-' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-secondary">{{ 'No issues here.'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if issues.total > issues.per_page %}
        <div class="card-footer">
            {% include 'partial_pagination.html.twig' with { 'list': issues, 'url': 'support/network-issues' } %}
        </div>
    {% endif %}
</div>
{% endblock %}
