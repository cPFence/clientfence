{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}
{# ClientFence core patch: staff without the Support settings go back to the help desks page. #}
{% set helpdesks_url = has_permission('support', 'manage_settings') ? 'extension/settings/support'|url : 'support/helpdesks'|url %}

{% block meta_title %}{{ helpdesk.name }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|url }}">{{ 'Settings'|trans }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ helpdesks_url }}#tab-helpdesks">{{ 'Support'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Helpdesk -'|trans }} {{ helpdesk.name }}</li>
    </ol>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <div>
            <h3 class="card-title">{{ helpdesk.name }}</h3>
            <p class="card-subtitle">{{ 'Helpdesk name will be visible for clients when submitting a new ticket.'|trans }}</p>
        </div>
    </div>
    <form method="post" action="{{ 'support/helpdesk_update'|api_url }}" {{ fb_api_form({ message: 'Helpdesk Updated'|trans }) }}>
        {% embed 'partial_admin_form_card.html.twig' with {
            title: 'Helpdesk Settings'|trans,
            subtitle: 'Configure the inbox identity, auto-close timing, and whether tickets can be reopened.'|trans,
            body_class: 'pt-4'
        } %}
            {% block form_content %}
                {# ClientFence core patch: the name per language, as WHMCS's department translations (mod_product_translations.html.twig). #}
                {% set cf_item = { id: helpdesk.id, title: helpdesk.name, description: '' } %}
                {{ include('mod_product_translations.html.twig', { part: 'bar', kind: 'helpdesk', item: cf_item }) }}
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div data-cf-text-pane="">
                        <label class="form-label">{{ 'Title'|trans }}</label>
                        <input class="form-control" type="text" name="name" value="{{ helpdesk.name }}" required>
                        </div>
                        {{ include('mod_product_translations.html.twig', { part: 'title', kind: 'helpdesk', item: cf_item }) }}
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Email'|trans }}</label>
                        <input class="form-control" type="email" name="email" value="{{ helpdesk.email }}" required>
                    </div>
                    {# ClientFence core patch: help desk greeting field (ClientFence; only with the module active). #}
                    {% if helpdesk.greeting is defined %}
                    <div class="col-12">
                        <label class="form-label">{{ 'Greeting'|trans }}</label>
                        <textarea class="form-control" name="greeting" rows="2" maxlength="500">{{ helpdesk.greeting }}</textarea>
                        <div class="form-text">{{ 'Starts every staff reply in this help desk. {name} is the client\'s first name. Leave empty for no greeting.'|trans }}</div>
                    </div>
                    {% endif %}
                    <div class="col-12">
                        <label class="form-label">{{ 'Signature'|trans }}</label>
                        <textarea class="form-control" name="signature" rows="3">{{ helpdesk.signature }}</textarea>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Close Tickets After (in hours)'|trans }}</label>
                        <input class="form-control" type="text" name="close_after" value="{{ helpdesk.close_after }}" required>
                        <div class="form-text">{{ 'Define a very large number of hours to disable auto close ticket option.'|trans }}</div>
                    </div>
                    {# ClientFence core patch: the feedback email when a ticket closes, as WHMCS's Feedback Request (Support/TicketFeedback.php). #}
                    {# ClientFence core patch: hidden from clients, as WHMCS's "Hide from clients" (Support/HiddenHelpdesks.php). #}
                    {% if helpdesk.hidden is defined %}
                    <div class="col-12">
                        <label class="form-check form-switch form-switch-2 mb-0">
                            <input name="hidden" type="hidden" value="0">
                            <input class="form-check-input" name="hidden" type="checkbox" value="1"{% if helpdesk.hidden %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Hidden from clients: clients and guests cannot choose it for a new ticket; staff, replies and its mailbox still use it'|trans }}</span>
                        </label>
                    </div>
                    {% endif %}
                    {% if helpdesk.feedback_request is defined %}
                    <div class="col-12">
                        <label class="form-check form-switch form-switch-2 mb-0">
                            <input name="feedback_request" type="hidden" value="0">
                            <input class="form-check-input" name="feedback_request" type="checkbox" value="1"{% if helpdesk.feedback_request %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Feedback request: when a ticket closes, email the client a link to rate the staff and comment'|trans }}</span>
                        </label>
                    </div>
                    {% endif %}
                    <div class="col-lg-6">
                        <label class="form-label d-block">{{ 'Tickets Can Be Reopened?'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="radioCanReopenYes" type="radio" name="can_reopen" value="1"{% if helpdesk.can_reopen %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="radioCanReopenNo" type="radio" name="can_reopen" value="0"{% if not helpdesk.can_reopen %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="id" value="{{ helpdesk.id }}">
            {% endblock %}

            {% block form_actions %}
                <a href="{{ helpdesks_url }}" class="btn btn-secondary">
                    <svg class="icon">
                        <use href="#arrow-left" />
                    </svg>
                    {{ 'Go Back'|trans }}
                </a>
                <a class="btn btn-danger" href="{{ 'support/helpdesk_delete'|api_url(query: { 'id': helpdesk.id }) }}"
                    {{ fb_api_link({ message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: helpdesks_url }) }}>
                    <svg class="icon">
                        <use href="#trash" />
                    </svg>
                    {{ 'Delete'|trans }}
                </a>
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            {% endblock %}
        {% endembed %}
    </form>
</div>
{# ClientFence core patch: the help desk's mailbox for ticket email import (staff who manage help desks). #}
{% if admin.system_is_allowed({ 'mod': 'support', 'f': 'manage_helpdesk' }) %}
{{ include('mod_support_helpdesk_mail.html.twig') }}
{% endif %}
{% endblock %}
