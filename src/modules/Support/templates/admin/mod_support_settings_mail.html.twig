{# ClientFence: ticket email import rules (Support/MailImport.php), on the General tab of the Support
   settings page under the ticket attachments. Kept in mod_support; saved with
   support/mail_settings_update, never with the tab's main form. Mailboxes are set per help desk. #}
{% set mail = admin.extension_config_get({ 'ext': 'mod_support' }) %}
{% set is_rtl = active_locale|default('en_US')|lower|slice(0, 2) in ['ar', 'fa', 'he'] %}
<div class="clientfence-settings border-top" id="email-import" dir="{{ is_rtl ? 'rtl' : 'ltr' }}">
	<form method="post" action="{{ 'support/mail_settings_update'|api_url }}" {{ fb_api_form({ message: 'Settings Updated'|trans, reload: true }) }}>
		<div class="clientfence-settings-intro">
			<h3>{{ 'Email importing'|trans }}</h3>
			<p>{{ 'Rules for emails read from the help desk mailboxes (each help desk page sets its mailbox). See what happened to each email in Support > Email import log.'|trans }}</p>
		</div>
		<div class="clientfence-setting clientfence-setting-row">
			<div class="clientfence-setting-label">
				<label class="form-label" for="mail_reply_limit">{{ 'Emails per sender in 15 minutes'|trans }}</label>
				<div class="clientfence-setting-hint">{{ 'More from one address are blocked, which stops loops with auto-responders.'|trans }}</div>
			</div>
			<div class="clientfence-setting-control">
				<input class="form-control" type="number" min="1" max="1000" id="mail_reply_limit" name="mail_reply_limit" value="{{ mail.mail_reply_limit|default('10') }}" required>
			</div>
		</div>
		<div class="clientfence-setting clientfence-setting-row">
			<div class="clientfence-setting-label">
				<label class="form-label" for="mail_max_mb">{{ 'Largest email'|trans }}</label>
				<div class="clientfence-setting-hint">{{ 'Larger emails are not imported; the sender is told.'|trans }}</div>
			</div>
			<div class="clientfence-setting-control">
				<div class="input-group">
					<input class="form-control" type="number" min="1" max="25" id="mail_max_mb" name="mail_max_mb" value="{{ mail.mail_max_mb|default('10') }}" required>
					<span class="input-group-text">MB</span>
				</div>
			</div>
		</div>
		<div class="clientfence-setting clientfence-setting-row">
			<div class="clientfence-setting-label">
				<label class="form-label" for="mail_log_days">{{ 'Keep the email import log for'|trans }}</label>
				<div class="clientfence-setting-hint">{{ 'Copies of emails that were not imported go with their log entry.'|trans }}</div>
			</div>
			<div class="clientfence-setting-control">
				<div class="input-group">
					<input class="form-control" type="number" min="1" max="3650" id="mail_log_days" name="mail_log_days" value="{{ mail.mail_log_days|default('30') }}" required>
					<span class="input-group-text">{{ 'days'|trans }}</span>
				</div>
			</div>
		</div>
		<div class="clientfence-setting">
			<input type="hidden" name="mail_insecure_imports" value="0">
			<label class="form-check form-switch">
				<input class="form-check-input" type="checkbox" name="mail_insecure_imports" value="1"{% if mail.mail_insecure_imports|default('0') == '1' %} checked{% endif %}>
				<span class="form-check-label">{{ 'Allow insecure imports'|trans }}</span>
			</label>
			<div class="clientfence-setting-hint">{{ 'Add replies from any address to a ticket. Off: only the ticket\'s client, its authorized users with ticket access or the guest who opened it; other replies wait in the log.'|trans }}</div>
		</div>
		<div class="clientfence-setting">
			<input type="hidden" name="mail_prevent_reopen" value="0">
			<label class="form-check form-switch">
				<input class="form-check-input" type="checkbox" name="mail_prevent_reopen" value="1"{% if mail.mail_prevent_reopen|default('0') == '1' %} checked{% endif %}>
				<span class="form-check-label">{{ 'Prevent email reopening'|trans }}</span>
			</label>
			<div class="clientfence-setting-hint">{{ 'A reply to a closed ticket is refused and the sender told. Help desks where clients cannot reopen tickets always refuse them.'|trans }}</div>
		</div>
		<div class="clientfence-setting">
			<label class="form-label" for="mail_break_lines">{{ 'Break lines'|trans }}</label>
			<div class="clientfence-setting-hint">{{ 'One per line. Text from the first of these on is an earlier, quoted message and is left out ("On ... wrote:" lines are always cut). Empty: the standard list.'|trans }}</div>
			<textarea class="form-control" id="mail_break_lines" name="mail_break_lines" rows="4" placeholder="====== Please reply above this line ======">{{ mail.mail_break_lines|default('') }}</textarea>
		</div>
		<div class="clientfence-setting">
			<label class="form-label" for="mail_block_senders">{{ 'Blocked senders'|trans }}</label>
			<div class="clientfence-setting-hint">{{ 'Addresses or domains (@example.com), one per line.'|trans }}</div>
			<textarea class="form-control" id="mail_block_senders" name="mail_block_senders" rows="3">{{ mail.mail_block_senders|default('') }}</textarea>
		</div>
		<div class="clientfence-setting">
			<label class="form-label" for="mail_block_subjects">{{ 'Blocked subjects'|trans }}</label>
			<div class="clientfence-setting-hint">{{ 'Emails whose subject contains one of these, one per line.'|trans }}</div>
			<textarea class="form-control" id="mail_block_subjects" name="mail_block_subjects" rows="3">{{ mail.mail_block_subjects|default('') }}</textarea>
		</div>
		<div class="clientfence-setting">
			<label class="form-label" for="mail_block_phrases">{{ 'Blocked phrases'|trans }}</label>
			<div class="clientfence-setting-hint">{{ 'Emails whose text contains one of these, one per line.'|trans }}</div>
			<textarea class="form-control" id="mail_block_phrases" name="mail_block_phrases" rows="3">{{ mail.mail_block_phrases|default('') }}</textarea>
		</div>
		<div class="clientfence-settings-actions">
			<button type="submit" class="btn btn-primary">{{ 'Save email import settings'|trans }}</button>
		</div>
	</form>
</div>
