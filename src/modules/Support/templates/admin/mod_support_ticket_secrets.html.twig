{# ClientFence: the ticket's secrets on the staff ticket page (Support/TicketSecrets.php). Values
   stay hidden until Show (support/ticket_secret_open, the "Open ticket secrets" permission), which
   is recorded and listed here and on the client's page. #}
{% set secrets = admin.support_ticket_secret_list({ 'ticket_id': ticket.id }) %}
{% if secrets.secrets is not empty or secrets.events is not empty %}
<div class="card mb-3" id="ticket-secrets">
    <div class="card-body">
        <h5 class="card-title mb-1">{{ 'Server access and secrets'|trans }}</h5>
        <p class="text-secondary mb-3">{{ 'Added by the client, encrypted. Opening one is recorded and shown to the client; all are deleted when the ticket closes.'|trans }}</p>
        {% for secret in secrets.secrets %}
            <div class="border rounded p-2 mb-2" data-cf-secret="{{ secret.id }}">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>
                        <strong dir="auto">{{ secret.label }}</strong>
                        <span class="text-secondary small ms-1">{{ secret.kind == 'server' ? 'Server access'|trans : 'Other secret'|trans }} · {{ secret.created_at|format_datetime }}</span>
                    </span>
                    <span class="d-flex gap-2">
                        {% if secrets.can_open %}
                            <button type="button" class="btn btn-sm btn-primary" data-cf-secret-open>{{ 'Show'|trans }}</button>
                        {% endif %}
                        {% if secrets.can_delete %}
                            <button type="button" class="btn btn-sm btn-outline-danger" data-cf-secret-delete>{{ 'Delete'|trans }}</button>
                        {% endif %}
                    </span>
                </div>
                <dl class="row small mb-0 mt-2" data-cf-secret-values hidden></dl>
            </div>
        {% endfor %}
        {% if not secrets.can_open and secrets.secrets is not empty %}
            <p class="small text-secondary mb-2">{{ 'You need the "Open ticket secrets" permission to see the values.'|trans }}</p>
        {% endif %}
        {% if secrets.events is not empty %}
            <details class="small mt-2">
                <summary>{{ 'History'|trans }}</summary>
                <ul class="list-unstyled mt-2 mb-0">
                    {% for event in secrets.events %}
                        <li>
                            {{ event.created_at|format_datetime }} ·
                            {% if event.action == 'opened' %}
                                {{ ':label opened by :name'|trans({ ':label': event.label, ':name': event.staff_name|default('Support'|trans) }) }}
                            {% elseif event.action == 'deleted' %}
                                {{ ':label deleted'|trans({ ':label': event.label }) }}
                            {% else %}
                                {{ ':label deleted after the time limit'|trans({ ':label': event.label }) }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}
    </div>
</div>
<script nonce="{{ csp_nonce }}">
    document.addEventListener('DOMContentLoaded', () => {
        const notify = (text) => (window.ClientFence && ClientFence.ui && ClientFence.ui.notify ? ClientFence.ui.notify(text, 'error') : window.alert(text));
        const names = {
            type: {{ 'Access type'|trans|json_encode|raw }}, host: {{ 'Host or IP address'|trans|json_encode|raw }}, port: {{ 'Port'|trans|json_encode|raw }},
            username: {{ 'Username'|trans|json_encode|raw }}, password: {{ 'Password'|trans|json_encode|raw }}, ssh_key: {{ 'SSH private key'|trans|json_encode|raw }},
            note: {{ 'Note'|trans|json_encode|raw }}, label: {{ 'What is it?'|trans|json_encode|raw }}, value: {{ 'Secret'|trans|json_encode|raw }},
        };
        const copyText = {{ 'Copy'|trans|json_encode|raw }};
        document.querySelectorAll('#ticket-secrets [data-cf-secret]').forEach((box) => {
            const id = box.dataset.cfSecret;
            box.querySelector('[data-cf-secret-open]')?.addEventListener('click', (event) => {
                const list = box.querySelector('[data-cf-secret-values]');
                if (!list.hidden) { list.hidden = true; list.replaceChildren(); return; }
                ClientFence.api.admin.post('support/ticket_secret_open', { id }, (fields) => {
                    Object.entries(fields).forEach(([key, value]) => {
                        if (value === null || value === '') return;
                        const term = document.createElement('dt');
                        term.className = 'col-sm-3';
                        term.textContent = names[key] || key;
                        const detail = document.createElement('dd');
                        detail.className = 'col-sm-9 d-flex gap-2 align-items-start';
                        const text = document.createElement(key === 'ssh_key' || key === 'value' ? 'pre' : 'code');
                        text.className = 'mb-0 text-wrap user-select-all';
                        text.dir = 'ltr';
                        text.textContent = String(value);
                        const copy = document.createElement('button');
                        copy.type = 'button';
                        copy.className = 'btn btn-sm btn-outline-secondary py-0';
                        copy.textContent = copyText;
                        copy.addEventListener('click', () => navigator.clipboard?.writeText(String(value)));
                        detail.append(text, copy);
                        list.append(term, detail);
                    });
                    list.hidden = false;
                }, (e) => notify(e.message), false);
            });
            box.querySelector('[data-cf-secret-delete]')?.addEventListener('click', () => {
                ClientFence.api.admin.post('support/ticket_secret_delete', { id }, () => window.location.reload(), (e) => notify(e.message), false);
            });
        });
    });
</script>
{% endif %}
