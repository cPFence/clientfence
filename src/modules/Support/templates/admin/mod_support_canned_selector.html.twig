{# ClientFence: form-select, so the canned responses look like the other fields. #}
<select
    name="canned_response"
    placeholder="Canned Responses"
    class="form-select canned_response_select canned_ticket_response"
    data-resturl="/api/admin/support/canned_get"
>
    {% for ctitle, cat in admin.support_canned_pairs %}
        <optgroup label="{{ ctitle }}">
            {% for mid, mtitle in cat %}
                <option value="{{ mid }}">{{ mtitle }}</option>
            {% endfor %}
        </optgroup>
    {% endfor %}
</select>
