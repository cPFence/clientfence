{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ category.title }}{% endblock %}
{% block meta_description %}{{ category.description|default('Browse support articles in this knowledge base category.'|trans) }}{% endblock %}

{% block body_class %}kb-category{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
<li class="breadcrumb-item active" aria-current="page">{{ category.title }}</li>
{% endblock %}

{% block content %}
{# ClientFence core patch: a Back link to the list this page belongs to. #}
<a class="bf-linkbtn" href="{{ 'support/kb'|url }}"><span class="flip-rtl d-inline-block" aria-hidden="true">←</span> {{ 'Back'|trans }}</a>
{# ClientFence core patch: a short hero with the category, then its articles in a glass card (CF-135 redesign). #}
<header class="bf-store-head cf-pub-head mb-4">
    <h1>{{ category.title }}</h1>
    {% if category.description %}<p>{{ category.description }}</p>{% endif %}
</header>
<div class="card bf-card mb-4">
    {% if category.articles %}
        <div class="cf-kb-list cf-kb-list-page">
            {% for article in category.articles %}
                <a href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'><svg class="icon" aria-hidden="true"><use href="#book"/></svg><span>{{ article.title }}</span></a>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <p class="mb-3">{{ 'No articles in this category yet.'|trans }}</p>
            <a class="btn btn-outline-secondary" href="{{ 'support/kb'|url }}">{{ 'Browse all articles'|trans }}</a>
        </div>
    {% endif %}
</div>
{% endblock %}
