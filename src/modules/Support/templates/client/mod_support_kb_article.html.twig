{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ article.title }}{% endblock %}
{% block meta_description %}{{ (article.content ?? '')|markdown_to_html|striptags|trim|truncate(160) }}{% endblock %}

{% block body_class %}kb-article{% endblock %}
{% block head %}{{ 'css/markdown.css' | public_asset_url | stylesheet_tag }}{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item">
    <a href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
</li>
<li class="breadcrumb-item">
    <a href='{{ "support/kb/#{article.category.slug}"|url }}'>{{ article.category.title }}</a>
</li>
<li class="breadcrumb-item active" aria-current="page">{{ article.title }}</li>
{% endblock %}

{% block content %}
{% set related_articles = guest.support_kb_article_get_list({ 'kb_article_category_id': article.category.id, 'per_page': 6 }).list|filter(related_article => related_article.id != article.id)|slice(0, 5) %}
{# ClientFence core patch: the article title in a short hero, the article and the help panel as glass cards, the category and related articles beside them (CF-135 redesign). #}
<header class="bf-store-head cf-pub-head mb-4">
    <a class="bf-chip bf-chip-muted align-self-start text-decoration-none" href='{{ "support/kb/#{article.category.slug}"|url }}'><svg class="icon" aria-hidden="true"><use href="#folder"/></svg>{{ article.category.title }}</a>
    <h1>{{ article.title }}</h1>
    {% if article.updated_at or guest.support_kb_article_views_enabled %}
        <p class="cf-pub-meta">
            {% if article.updated_at %}
                <span>{{ 'Updated'|trans }} {{ '%time% ago'|trans({ '%time%': article.updated_at|timeago }) }}</span>
            {% endif %}
            {% if guest.support_kb_article_views_enabled %}
                <span><svg class="icon" aria-hidden="true"><use href="#eye"/></svg>{{ article.views }} {{ 'views'|trans }}</span>
            {% endif %}
        </p>
    {% endif %}
</header>
<div class="row g-4">
    <article class="col-lg-9">
        <div class="card bf-card mb-4">
            <div class="card-body p-4 p-lg-5">
                <article class="kb-article-content markdown-body bg-transparent text-reset">
                    {{ (article.content ?? '')|markdown_to_html }}
                </article>
            </div>
        </div>

        <div class="card bf-card cf-quote-answer mb-4">
            <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="bf-cart-item-icon" aria-hidden="true"><svg class="icon"><use href="#headset"/></svg></span>
                    <div>
                        <h2 class="h5 mb-1">{{ 'Still need help?'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'If this article did not answer your question, our support team can help.'|trans }}</p>
                    </div>
                </div>
                <a href="{{ 'support/contact-us'|url }}" class="btn btn-primary flex-shrink-0">{{ 'Contact support'|trans }}</a>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a href="{{ 'support/kb'|url }}" class="btn btn-outline-secondary">{{ 'Browse all articles'|trans }}</a>
            <a href='{{ "support/kb/#{article.category.slug}"|url }}' class="btn btn-outline-secondary">{{ 'More in this category'|trans }}</a>
        </div>
    </article>

    <aside class="col-lg-3">
        <div class="cf-kb-aside">
            <div class="card bf-card mb-4">
                <div class="card-body">
                    <div class="text-muted small mb-1">{{ 'Category'|trans }}</div>
                    <a class="h5 d-block mb-3 text-decoration-none" href='{{ "support/kb/#{article.category.slug}"|url }}'>{{ article.category.title }}</a>
                    <a class="btn btn-outline-secondary btn-sm w-100" href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
                </div>
            </div>

            <div class="card bf-card mb-4">
                <div class="card-header py-3">
                    <h2 class="h5 mb-0">{{ 'Related articles'|trans }}</h2>
                </div>
                {% if related_articles %}
                    <div class="cf-kb-list cf-kb-list-page">
                        {% for related_article in related_articles %}
                            <a href='{{ "support/kb/#{related_article.category.slug}/#{related_article.slug}"|url }}'><svg class="icon" aria-hidden="true"><use href="#book"/></svg><span>{{ related_article.title }}</span></a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="card-body text-muted">{{ 'No related articles yet.'|trans }}</div>
                {% endif %}
            </div>
        </div>
    </aside>
</div>
{% endblock %}
