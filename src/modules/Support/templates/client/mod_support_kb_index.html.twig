{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ 'Knowledge Base Categories'|trans }}{% endblock %}
{% block meta_description %}{{ 'Browse help articles, tutorials, and answers to common questions in our knowledge base.'|trans }}{% endblock %}

{% block body_class %}kb-index{% endblock %}
{% block breadcrumb %}
    {% if request.q %}
        <li class="breadcrumb-item">
            <a href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ request.q }}</li>
    {% else %}
        <li class="breadcrumb-item active" aria-current="page">{{ 'Knowledge Base'|trans }}</li>
    {% endif %}
{% endblock %}

{% block content %}
    {% if request.q %}
        {% set kbcategories = guest.support_kb_category_get_list({ "q": request.q }) %}
        {% set kbarticles = guest.support_kb_article_get_list({ "search": request.q, "per_page": 10 }) %}
    {% else %}
        {% set kbcategories = guest.support_kb_category_get_list %}
        {% set kbarticles = null %}
    {% endif %}

    {# ClientFence core patch: the store's search hero, then the matching articles and the categories as glass cards (CF-135 redesign). #}
    <header class="bf-store-head has-search mb-4">
        <h1>{{ 'Knowledge Base'|trans }}</h1>
        <p>{{ 'Explore our knowledge base categories and their associated articles below.'|trans }}</p>
        <form class="bf-domain-search" method="get" action="" role="search">
            <input class="form-control" name="q" type="text" value="{{ request.q }}" placeholder="{{ 'What are you looking for?'|trans }}" aria-label="{{ 'What are you looking for?'|trans }}">
            <button class="btn btn-primary" type="submit"><svg class="icon" aria-hidden="true"><use href="#search"/></svg>{{ 'Search'|trans }}</button>
        </form>
    </header>

    {% if kbarticles and kbarticles.list %}
        <section class="card bf-card bf-section mb-4" aria-labelledby="cf-kb-h-articles">
            <h2 id="cf-kb-h-articles">{{ 'Matching articles'|trans }}</h2>
            <div class="cf-kb-list">
                {% for article in kbarticles.list %}
                    <a href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'><svg class="icon" aria-hidden="true"><use href="#book"/></svg><span>{{ article.title }}</span></a>
                {% endfor %}
            </div>
        </section>
        <h2 class="cf-pub-title">{{ 'Matching categories'|trans }}</h2>
    {% endif %}

    <div class="cf-kb-grid mb-4">
    {% for category in kbcategories.list %}
        <article class="card bf-card cf-kb-cat">
            <div class="cf-kb-cat-head">
                <span class="bf-cart-item-icon" aria-hidden="true"><svg class="icon"><use href="#folder"/></svg></span>
                <h2><a href='{{ "support/kb/#{category.slug}"|url }}'>{{ category.title }}</a></h2>
            </div>
            {% if category.description %}<p class="bf-hint mb-0">{{ category.description }}</p>{% endif %}
            {% if category.articles %}
                <div class="cf-kb-list">
                    {% for article in category.articles|slice(0, 3) %}
                        <a href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'><svg class="icon" aria-hidden="true"><use href="#book"/></svg><span>{{ article.title }}</span></a>
                    {% endfor %}
                </div>
            {% endif %}
            <a class="bf-linkbtn mt-auto" href='{{ "support/kb/#{category.slug}"|url }}'>{{ 'View all articles'|trans }} <svg class="icon flip-rtl" aria-hidden="true"><use href="#chevron-right"/></svg></a>
        </article>
    {% else %}
        <div class="card bf-card cf-kb-empty">
            <div class="empty-state">
                <svg class="icon" aria-hidden="true"><use href="#book"/></svg>
                {% if request.q %}
                    <h2 class="h5">{{ 'No results found'|trans }}</h2>
                    <p class="mb-3">{{ 'No articles or categories matched your search for:'|trans }} <strong>{{ request.q }}</strong></p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a class="btn btn-primary" href="{{ 'support/contact-us'|url }}">{{ 'Contact support'|trans }}</a>
                        <a class="btn btn-outline-secondary" href="{{ 'support/kb'|url }}">{{ 'Browse all articles'|trans }}</a>
                    </div>
                {% else %}
                    <p class="mb-0">{{ 'No knowledge base categories are available yet.'|trans }}</p>
                {% endif %}
            </div>
        </div>
    {% endfor %}
    </div>
{% endblock %}
