{% extends "layout_default.html.twig" %}

{% set company = guest.system_company %}

{% block meta_title %}{{ 'Privacy Policy'|trans }}{% endblock %}
{% block meta_description %}{{ 'Learn how %company% collects, uses, and protects personal information.'|trans({'%company%': company.name}) }}{% endblock %}

{% block body_class %}privacy-policy{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Privacy'|trans }}</li>
{% endblock %}

{% block content %}
    {# ClientFence core patch: a short hero with the title, the policy in a glass card (CF-135 redesign). #}
    <header class="bf-store-head cf-pub-head mb-4">
        {% if company is defined and company %}
            <h1>{{ company.name }} {{ 'Privacy Policy'|trans }}</h1>
            {% if company.signature %}<p>{{ company.signature }}</p>{% endif %}
        {% else %}
            <h1>{{ 'Privacy Policy'|trans }}</h1>
        {% endif %}
    </header>
    <div class="card bf-card mb-4">
        <div class="card-body p-4 p-lg-5">
            {% if company is defined and company %}
                {{ (company.privacy_policy ?? '')|markdown_to_html }}
            {% endif %}
        </div>
    </div>
{% endblock %}
