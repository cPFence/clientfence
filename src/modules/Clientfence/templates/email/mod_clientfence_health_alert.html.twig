{% block subject %}[{{ guest.system_company.name }}] System health: {{ count|default(1) == 1 ? '1 check needs attention' : (count ~ ' checks need attention') }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
		h1 { font-size: 22px; font-weight: bold; margin: 0 0 16px; }
		p { margin: 0 0 10px; }
		li { margin: 0 0 10px; }
		.muted { color: #777777; }
		.signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
	</style>
</head>
<body>
	<h1>System health</h1>
	<p>Hello {{ c.name|default('') }},</p>
	<p>The hourly system health checks of the billing portal found {{ count|default(1) == 1 ? 'a check that needs' : 'checks that need' }} attention:</p>
	<ul>
	{% for check in checks|default([]) %}
		<li><strong>{{ check.title }}</strong> <span class="muted">({{ check.group }})</span><br>{{ check.detail }}</li>
	{% endfor %}
	</ul>
	<p>You get this email once per problem: the next one comes only if a check passes and breaks again.</p>
	<p><a href='{{ "clientfence/health"|url(area: 'admin') }}' target="_blank">Open System health</a></p>
	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
