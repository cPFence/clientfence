{% block subject %}[{{ guest.system_company.name }}] {{ count|default(1) == 1 ? 'System health: 1 check needs attention'|trans : 'System health: %count% checks need attention'|trans({'%count%': count}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'System health'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'System health'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ count|default(1) == 1 ? 'The hourly system health checks of the billing portal found a check that needs attention:'|trans : 'The hourly system health checks of the billing portal found checks that need attention:'|trans }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					{% for check in checks|default([]) %}
					{% if not loop.first %}<tr><td style="padding:8px 0 0; border-top:1px solid #e4eaee;"></td></tr>{% endif %}
					<tr><td style="padding:4px 0;"><strong>{{ check.title }}</strong> <span style="color:#64748b;">({{ check.group }})</span><br>{{ check.detail }}</td></tr>
					{% endfor %}
				</table>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'You get this email once per problem: the next one comes only if a check passes and breaks again.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "clientfence/health"|url(area: 'admin') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open System health'|trans }}</a>
			</td></tr>
		</table>
{% endblock %}
