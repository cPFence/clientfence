{# ClientFence: the "Sign-in" tab of Security > Settings (mod_security_settings; SignInSecurity.php): an email
   PIN at sign-in for staff, clients or both (every sign-in or only from a new place), two-factor sign-in required
   of all clients or chosen client groups (Client/TwoFactor.php checkRequired()), passkeys (Client/Passkeys.php), the sign-in history
   (SignInHistory.php), staff sign-in from listed IP addresses only and staff password
   reset (both stored in the Staff settings), the failed staff sign-in email, and staff sign-in from chosen countries only. Super Administrators only.
   `signin` is clientfence/signin_security_get. Turning the staff PIN on answers {confirm, email}:
   clientfenceSigninSaved (clientfence-admin.js) shows the PIN field and the form is saved again. #}
{% set countries_names = signin.all_countries %}
{# The saved state of each protection first, as a facts grid (CF-135). #}
{% set who = { 'off': 'Off'|trans, 'staff': 'Staff only'|trans, 'clients': 'Clients only'|trans, 'both': 'Staff and clients'|trans, 'all': 'All clients'|trans, 'groups': 'Chosen client groups'|trans } %}
<div class="card mb-3 cf-signin-sum">
    <dl class="cf-facts">
        {% for fact in [
            { 'label': 'Email PIN at sign-in'|trans, 'on': signin.pin != 'off', 'value': who[signin.pin] ?? signin.pin },
            { 'label': 'Two-factor sign-in for clients'|trans, 'on': signin.twofactor != 'off', 'value': who[signin.twofactor] ?? signin.twofactor },
            { 'label': 'Passkeys'|trans, 'on': signin.passkeys != 'off', 'value': who[signin.passkeys] ?? signin.passkeys },
            { 'label': 'Sign-in history'|trans, 'on': signin.history },
            { 'label': 'Staff sign-in from these IP addresses only'|trans, 'on': signin.ips_on },
            { 'label': 'Staff password reset'|trans, 'on': signin.staff_reset },
            { 'label': 'Failed staff sign-in email'|trans, 'on': signin.failed_alert },
            { 'label': 'Staff sign-in from chosen countries only'|trans, 'on': signin.countries_on },
        ] %}
            <div><dt>{{ fact.label }}</dt><dd><span class="bf-chip{{ fact.on ? ' bf-tone-ok' }}">{{ fact.value ?? (fact.on ? 'On'|trans : 'Off'|trans) }}</span></dd></div>
        {% endfor %}
    </dl>
</div>
<form method="post" action="{{ 'clientfence/signin_security_save'|api_url }}" {{ fb_api_form({ callback: 'clientfenceSigninSaved' }) }}
      data-cf-signin-form data-saved-text="{{ 'Sign-in security saved.'|trans }}" data-sent-text="{{ 'We emailed you a PIN: enter it and save again.'|trans }}">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Email PIN at sign-in'|trans }}</h3>
                <p class="card-subtitle">{{ 'After the right password, a 6-digit PIN goes to the email of the login, and signing in needs it. It works once, for 10 minutes. Clients who sign in with an authenticator app or with Google are not asked. Staff who set up an authenticator app on their Profile page can enter its code instead. "Trust this browser for 30 days" skips the PIN on a known browser until the password changes.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <label class="form-label" for="cf-signin-pin">{{ 'Ask for an email PIN'|trans }}</label>
            <select class="form-select" id="cf-signin-pin" name="pin">
                {% for mode, label in { 'off': 'Off'|trans, 'staff': 'Staff only'|trans, 'clients': 'Clients only'|trans, 'both': 'Staff and clients'|trans } %}
                    <option value="{{ mode }}"{% if signin.pin == mode %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <div class="form-hint">{{ 'Turning it on for staff first emails you a PIN, to make sure email works before anyone needs it.'|trans }}</div>
            <label class="form-label mt-3" for="cf-signin-pin-when">{{ 'When to ask'|trans }}</label>
            <select class="form-select" id="cf-signin-pin-when" name="pin_when">
                {% for when, label in { 'every': 'Every sign-in'|trans, 'new': 'Only from a new country or network'|trans } %}
                    <option value="{{ when }}"{% if signin.pin_when == when %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <div class="form-hint">{{ 'A new country or network is one the login has not signed in from (with the PIN, the app or a trusted browser) in the last 90 days. A sign-in whose country or network is not known is always asked.'|trans }}</div>
            <div class="mt-3" data-cf-signin-confirm hidden>
                <label class="form-label" for="cf-signin-confirm">{{ 'PIN sent to'|trans }} <span data-cf-signin-email></span></label>
                <input class="form-control" id="cf-signin-confirm" type="text" name="confirm_pin" inputmode="numeric" autocomplete="one-time-code" maxlength="7" dir="ltr">
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Two-factor sign-in for clients'|trans }}</h3>
                <p class="card-subtitle">{{ 'Clients in scope, and the authorized users of their accounts, must set up an authenticator app: until they do, every client page after sign-in goes to the two-factor setup. Staff "Login to Client Area" is not asked. Staff can still switch the app off for a client who lost a phone: the client sets it up again at the next sign-in.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <label class="form-label" for="cf-signin-twofactor">{{ 'Require two-factor sign-in'|trans }}</label>
            <select class="form-select" id="cf-signin-twofactor" name="twofactor">
                {% for mode, label in { 'off': 'Off'|trans, 'all': 'All clients'|trans, 'groups': 'Chosen client groups'|trans } %}
                    <option value="{{ mode }}"{% if signin.twofactor == mode %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <label class="form-label mt-3" for="cf-signin-twofactor-groups">{{ 'Client groups'|trans }}</label>
            {# The empty input clears the list (Client/Groups.php valid()). #}
            <input type="hidden" name="twofactor_groups[]" value="">
            <select class="form-select js-multi-select" id="cf-signin-twofactor-groups" name="twofactor_groups[]" multiple placeholder="{{ 'Choose groups'|trans }}">
                {% for id, title in admin.client_group_get_pairs %}
                    <option value="{{ id }}"{% if id in signin.twofactor_groups %} selected{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
            <div class="form-hint">{{ 'With "Chosen client groups": a client in any of these groups must use it.'|trans }}</div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Passkeys'|trans }}</h3>
                <p class="card-subtitle">{{ 'A passkey signs in with the fingerprint, face or PIN of the device, instead of the password and the second step (authenticator code or email PIN). Each person adds passkeys on their two-factor sign-in page, and is offered one after signing in with the password. A passkey also meets "Require two-factor sign-in". Staff sign-ins still need an allowed IP address and country.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <label class="form-label" for="cf-signin-passkeys">{{ 'Allow passkeys for'|trans }}</label>
            <select class="form-select" id="cf-signin-passkeys" name="passkeys">
                {% for mode, label in { 'off': 'Off'|trans, 'clients': 'Clients only'|trans, 'staff': 'Staff only'|trans, 'both': 'Staff and clients'|trans } %}
                    <option value="{{ mode }}"{% if signin.passkeys == mode %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <div class="form-hint">{{ 'Passkeys need the portal on HTTPS, and work only on its address: after a move to another domain they stop, and the password signs in.'|trans }}</div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Sign-in history'|trans }}</h3>
                <p class="card-subtitle">{{ 'Clients and staff see their own last sign-ins on their profile (date, country, network, browser and IP address) and can sign out their other sessions. The login history pages show the same details. They are kept as long as the rest of the activity log.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <input type="hidden" name="history" value="0">
            <label class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" name="history" value="1"{% if signin.history %} checked{% endif %}>
                <span class="form-check-label">{{ 'Show the sign-in history on the profile pages'|trans }}</span>
            </label>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Staff sign-in from these IP addresses only'|trans }}</h3>
                <p class="card-subtitle">{{ 'Staff sign-ins from any other address are refused. Use it only with fixed addresses, such as an office or a VPN.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <input type="hidden" name="ips_on" value="0">
            <label class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="ips_on" value="1"{% if signin.ips_on %} checked{% endif %}>
                <span class="form-check-label">{{ 'Allow staff sign-in only from these IP addresses'|trans }}</span>
            </label>
            <label class="form-label" for="cf-signin-ips">{{ 'IP addresses, one per line'|trans }}</label>
            <textarea class="form-control font-monospace" id="cf-signin-ips" name="ips" rows="3" dir="ltr" placeholder="{{ signin.ip }}">{{ signin.ips|join("\n") }}</textarea>
            <div class="form-hint">{{ 'Your address now: %ip%. Save refuses a list without it.'|trans({'%ip%': signin.ip}) }}</div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Staff password reset'|trans }}</h3>
                <p class="card-subtitle">{{ 'The "Forgot your password?" link of the staff login emails a reset link. Turn it off when staff passwords are only reset by a Super Administrator.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <input type="hidden" name="staff_reset" value="0">
            <label class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" name="staff_reset" value="1"{% if signin.staff_reset %} checked{% endif %}>
                <span class="form-check-label">{{ 'Allow staff to reset a forgotten password by email'|trans }}</span>
            </label>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Failed staff sign-in email'|trans }}</h3>
                <p class="card-subtitle">{{ 'A wrong password or unknown email address at the staff sign-in, or a wrong authenticator code or email PIN after the right password, emails every Super Administrator at once: date and time, the email address typed, IP address and hostname. At most 20 of these emails an hour.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <input type="hidden" name="failed_alert" value="0">
            <label class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" name="failed_alert" value="1"{% if signin.failed_alert %} checked{% endif %}>
                <span class="form-check-label">{{ 'Email the Super Administrators when a staff sign-in fails'|trans }}</span>
            </label>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Staff sign-in from chosen countries only'|trans }}</h3>
                <p class="card-subtitle">{{ 'Staff sign-ins from any other country, or from an address whose country is not known, are refused. Addresses on the IP address list above always pass: add a fixed office or server address there as a way back in.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            {% if not signin.geoip_ready %}
                <div class="alert alert-warning">{{ 'The GeoIP country database is missing, so no country can be told. See System Health.'|trans }}</div>
            {% endif %}
            <input type="hidden" name="countries_on" value="0">
            <label class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="countries_on" value="1"{% if signin.countries_on %} checked{% endif %}>
                <span class="form-check-label">{{ 'Allow staff sign-in only from these countries'|trans }}</span>
            </label>
            <label class="form-label" for="cf-signin-countries">{{ 'Countries'|trans }}</label>
            {# An empty list starts with the country of this sign-in, as in Quick setup, so turning the switch on keeps you in. #}
            {% set chosen = signin.countries ?: (signin.ip_country ? [signin.ip_country] : []) %}
            <select class="form-select js-multi-select" id="cf-signin-countries" name="countries[]" multiple placeholder="{{ 'Choose countries'|trans }}">
                {% for code, name in countries_names %}
                    <option value="{{ code }}"{% if code in chosen %} selected{% endif %}>{{ name }}</option>
                {% endfor %}
            </select>
            <div class="form-hint">
                {{ 'You are signing in from %ip%'|trans({'%ip%': signin.ip}) }}{% if signin.ip_country %} ({{ countries_names[signin.ip_country] ?? signin.ip_country }}){% else %} ({{ 'country not known'|trans }}){% endif %}{% if signin.ip_listed %}, {{ 'on the IP address list'|trans }}{% endif %}.
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="text-secondary small">{{ 'Locked out? On the server run: php console.php clientfence:signin-security-off'|trans }}</span>
            <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
        </div>
    </div>
</form>
