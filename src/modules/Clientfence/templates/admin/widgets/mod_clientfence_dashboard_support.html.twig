{# Dashboard of staff who cannot see the statistics but work the help desk (Support Staff,
   Support Lead): ticket counts and the open tickets, while tickets are on (Support settings).
   Slot admin.index.dashboard, added to the admin dashboard by the ClientFence core patch
   "dashboard widget slot". #}
{% if not admin.system_is_allowed({ 'mod': 'stats' }) and admin.system_is_allowed({ 'mod': 'support', 'f': 'view' }) and guest.support_tickets_enabled %}
    {% set ticketStatuses = admin.support_ticket_get_statuses %}
    {% set openTickets = admin.support_ticket_get_list({ 'status': 'open', 'per_page': 10, 'page': 1 }) %}
    {# The ticket counts as the dashboard's key figure cards (CF-135): label, a tinted icon tile and the count. #}
    {% set ticketCards = [
        { status: 'open', label: 'Waiting for Staff Reply'|trans, icon: 'headset', tone: 'bf-tone-warn' },
        { status: 'on_hold', label: 'On Hold'|trans, icon: 'player-pause', tone: 'cf-tile-blue' },
        { status: 'closed', label: 'Closed'|trans, icon: 'circle-check', tone: 'bf-tone-ok' },
    ] %}
    {% for card in ticketCards %}
        <div class="col-sm-6 col-lg-4">
            <a href="{{ 'support'|url(query: { 'status': card.status }) }}" class="bf-card bf-kpi cf-support-kpi">
                <span class="bf-kpi-head">
                    <span class="bf-muted bf-small">{{ card.label }}</span>
                    <span class="bf-tile {{ card.tone }}" aria-hidden="true"><svg class="icon"><use href="#{{ card.icon }}" /></svg></span>
                </span>
                <span class="bf-h bf-kpi-value" dir="ltr" data-bf-count>{{ attribute(ticketStatuses, card.status)|default(0) }}</span>
                <span class="bf-kpi-foot"><span class="bf-muted bf-small">{{ 'Tickets'|trans }}</span></span>
            </a>
        </div>
    {% endfor %}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'Waiting for Staff Reply'|trans }}</h3>
                <div class="card-actions">
                    <a href="{{ 'support'|url(query: { 'status': 'open' }) }}" class="btn-action" title="{{ 'View all'|trans }}">
                        <svg class="icon">
                            <use href="#dots-vertical" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter text-nowrap table-hover">
                    <thead>
                        <tr>
                            <th>{{ 'Ticket'|trans }}</th>
                            <th>{{ 'Client'|trans }}</th>
                            <th>{{ 'Helpdesk'|trans }}</th>
                            <th>{{ 'Last Reply'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for ticket in openTickets.list %}
                        <tr>
                            <td><a href='{{ "support/ticket/#{ticket.id}"|url }}#reply-box'><bdi>#{{ ticket.id }}</bdi> - <bdi>{{ ticket.subject|truncate(50) }}</bdi> ({{ ticket.replies }})</a></td>
                            <td>{{ ticket.author.name|default('-') }}</td>
                            <td>{{ ticket.helpdesk.name|default('-') }}</td>
                            <td class="text-muted">{% if ticket.last_reply_at %}<span title="{{ ticket.last_reply_at|format_datetime }}">{{ ':time ago'|trans({ ':time': ticket.last_reply_at|timeago }) }}</span>{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="text-muted" colspan="4">{{ 'No tickets are waiting for a reply.'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if openTickets.total|default(0) > openTickets.list|length %}
                <div class="card-footer">
                    <a href="{{ 'support'|url(query: { 'status': 'open' }) }}">{{ 'View all'|trans }} ({{ openTickets.total }})</a>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
