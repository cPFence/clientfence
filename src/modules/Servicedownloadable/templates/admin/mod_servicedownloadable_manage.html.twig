{% import 'macro_functions.html.twig' as mf %}
{# ClientFence core patch: the order's file reads first: its name and status, then where it is and how often it was downloaded (CF-135 redesign). #}
<div class="card-body">
    <div class="card mb-4">
        <div class="cf-inv cf-dom">
            <div class="cf-inv-hero">
                <div class="min-w-0">
                    <div class="cf-client-name"><bdi>{{ service.filename|default('-') }}</bdi></div>
                    <div class="text-secondary">{{ 'File Information'|trans }}</div>
                </div>
                <div class="cf-inv-chips">{{ mf.status_badge(order.status, 'order') }}</div>
            </div>
            <dl class="cf-facts">
                <div><dt>{{ 'Location'|trans }}</dt><dd><bdi>{{ service.path|default('-') }}</bdi></dd></div>
                <div><dt>{{ 'Downloads'|trans }}</dt><dd class="cf-fact-num">{{ service.downloads|default(0) }}</dd></div>
            </dl>
        </div>
    </div>

    <div class="mb-3 cf-section-head border-0 pt-0">
        <h3 class="card-title mb-1">{{ 'Upload New File for This Order'|trans }}</h3>
        <p class="text-secondary mb-0">{{ 'Use this function to replace the existing order file. The client will be able to download the new file from the client area.'|trans }}</p>
    </div>

    <form method="post" action="{{ 'servicedownloadable/upload'|api_url }}" enctype="multipart/form-data" id="upload-form">
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label">{{ 'Upload New File'|trans }}</label>
                <input class="form-control" type="file" name="file_data" id="file_data">
            </div>
        </div>

        <input type="hidden" name="order_id" value="{{ order.id }}">
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary submitForm" type="submit" id="upload-button">{{ 'Upload'|trans }}</button>
        </div>
    </form>
</div>

<script nonce="{{ csp_nonce }}">
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('upload-form');
    if (!form) {
        return;
    }

    form.addEventListener('submit', function(event) {
        event.preventDefault();

        const submitButton = form.querySelector('input[type="submit"], button[type="submit"]');
        if (submitButton) {
            submitButton.disabled = true;
        }

        const formData = new FormData(form);
        ClientFence.api.admin.post('servicedownloadable/upload', formData,
            function () {
                if (submitButton) {
                    submitButton.disabled = false;
                }
                ClientFence.message("{{ 'File was uploaded'|trans }}");
            },
            function (error) {
                if (submitButton) {
                    submitButton.disabled = false;
                }
                ClientFence.message(`${error.message} (${error.code})`, 'error');
            }
        );
    });
});
</script>
