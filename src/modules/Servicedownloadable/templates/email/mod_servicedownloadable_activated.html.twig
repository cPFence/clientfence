{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ '%title% is ready to download'|trans({'%title%': order.title|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your download is ready'|trans }}{% endset %}
{% set email_preheader %}{{ 'Your %title% is ready to download.'|trans({'%title%': order.title|default('')}) }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your download is ready'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Thank you for your order. Your %title% is now active and ready to download.'|trans_html({}, {'%title%': '<strong>' ~ (order.title|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Service'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top; font-weight:bold;">{{ order.title|default('') }}</td></tr>
					{% if order.activated_at|default(false) %}<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Activated'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ order.activated_at|default('')|format_date }}</td></tr>{% endif %}
					{% if order.expires_at|default(false) %}<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Next due date'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ order.expires_at|default('')|format_date }}</td></tr>{% endif %}
					{% if order.period|default(false) %}<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Billing'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ order.total|default(0)|format_currency(order.currency|default(default_currency)) }} {{ order.period|default('')|period_title }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "servicedownloadable/get-file/#{order.id|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Download now'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'You can download it again at any time from the %link%service page%link_end% in the client area.'|trans_html({}, {'%link%': '<a href="' ~ ("order/service/manage/#{order.id|default('')}"|url(area: 'client'))|e ~ '" target="_blank" style="color:' ~ (guest.system_company.brand_link|default('#2563eb'))|e ~ ';">', '%link_end%': '</a>'}) }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
