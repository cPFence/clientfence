{% extends "layout_default.html.twig" %}

{% set active_menu = 'support' %}
{% set can_view = has_permission('news', 'view') %}
{% set can_manage = has_permission('news', 'manage') %}

{% block meta_title %}{{ 'News'|trans }}{% endblock %}

{% block content %}
    <div class="card" id="news-posts" data-text-deleted="{{ 'Post deleted.'|trans }}" data-text-saved="{{ 'Saved.'|trans }}" data-text-pin="{{ 'Pin'|trans }}" data-text-unpin="{{ 'Unpin'|trans }}">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'News & Announcements'|trans }}</h3>
                <p class="card-subtitle">{{ 'Posts clients read at /news and on their dashboard. Pinned posts come first.'|trans }}</p>
            </div>
            {% if can_view %}
                <div class="card-actions d-flex flex-wrap gap-2">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <svg class="icon"><use href="#search" /></svg>
                        </span>
                        <input type="search" class="form-control" id="news-search" placeholder="{{ 'Search'|trans }}" aria-label="{{ 'Search'|trans }}">
                    </div>
                    {% if can_manage %}
                        <a class="btn btn-primary" href="{{ 'news/new'|url }}">
                            <svg class="icon"><use href="#plus" /></svg>
                            {{ 'New Announcement'|trans }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if can_view %}
            {% set posts = admin.news_get_list({ per_page: 500 }).list %}
            {% set now = date() %}
            <div class="table-responsive" id="news-table"{% if not posts %} hidden{% endif %}>
                <table class="table card-table table-vcenter">
                    <thead>
                    <tr>
                        <th>{{ 'Title'|trans }}</th>
                        <th class="w-1">{{ 'Status'|trans }}</th>
                        <th>{{ 'Section'|trans }}</th>
                        <th class="w-1">{{ 'Publish date'|trans }}</th>
                        <th class="w-1">{{ 'Updated'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody id="news-rows">
                    {% for post in posts %}
                        {% set scheduled = post.publish_at and date(post.publish_at) > now %}
                        {% set expired = post.expires_at and date(post.expires_at) <= now %}
                        <tr data-id="{{ post.id }}" data-title="{{ post.title }}" data-pinned="{{ post.pinned ? 1 : 0 }}" data-search="{{ (post.title ~ ' ' ~ post.slug ~ ' ' ~ post.section)|lower }}">
                            <td class="text-break">
                                {% if can_manage %}<a href="{{ ('news/post/' ~ post.id)|url }}">{{ post.title }}</a>{% else %}{{ post.title }}{% endif %}
                                <span class="badge bg-azure-lt ms-1" data-pinned-badge{% if not post.pinned %} hidden{% endif %}>{{ 'Pinned'|trans }}</span>
                            </td>
                            <td>
                                {% if post.status == 'draft' %}
                                    <span class="badge bg-secondary-lt">{{ 'Draft'|trans }}</span>
                                {% elseif scheduled %}
                                    <span class="badge bg-blue-lt">{{ 'Scheduled'|trans }}</span>
                                {% elseif expired %}
                                    <span class="badge bg-warning-lt">{{ 'Expired'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-success-lt">{{ 'Published'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-break">{{ post.section ?: '–' }}</td>
                            <td class="text-nowrap text-secondary">{{ (post.publish_at ?? post.created_at)|format_datetime }}</td>
                            <td class="text-nowrap text-secondary">{{ post.updated_at|format_datetime }}</td>
                            <td class="text-end text-nowrap">
                                {% if can_manage %}
                                    <a class="btn btn-icon btn-ghost-secondary" href="{{ ('news/post/' ~ post.id)|url }}" title="{{ 'Edit'|trans }}" aria-label="{{ 'Edit'|trans }}">
                                        <svg class="icon"><use href="#edit" /></svg>
                                    </a>
                                {% endif %}
                                {% if post.status == 'active' and not scheduled and not expired %}
                                    <a class="btn btn-icon btn-ghost-secondary" href="{{ ('news/' ~ post.slug)|url(area: 'client') }}" target="_blank" rel="noopener" title="{{ 'View'|trans }}" aria-label="{{ 'View'|trans }}">
                                        <svg class="icon"><use href="#eye" /></svg>
                                    </a>
                                {% endif %}
                                {% if can_manage %}
                                    <button type="button" class="btn btn-icon btn-ghost-secondary" data-action="pin" title="{{ post.pinned ? 'Unpin'|trans : 'Pin'|trans }}" aria-label="{{ post.pinned ? 'Unpin'|trans : 'Pin'|trans }}">
                                        <svg class="icon"><use href="#pinned" /></svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost-danger" data-action="delete" title="{{ 'Delete'|trans }}" aria-label="{{ 'Delete'|trans }}">
                                        <svg class="icon"><use href="#trash" /></svg>
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-body text-center text-secondary" id="news-no-match" hidden>{{ 'No results'|trans }}</div>
            <div class="empty" id="news-empty"{% if posts %} hidden{% endif %}>
                <div class="empty-icon">
                    <svg class="icon"><use href="#notes" /></svg>
                </div>
                <p class="empty-title">{{ 'No news or announcements'|trans }}</p>
                {% if can_manage %}
                    <div class="empty-action">
                        <a class="btn btn-primary" href="{{ 'news/new'|url }}">
                            <svg class="icon"><use href="#plus" /></svg>
                            {{ 'New Announcement'|trans }}
                        </a>
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="card-body">
                <p class="text-secondary mb-0">{{ 'You do not have permission to view news.'|trans }}</p>
            </div>
        {% endif %}
    </div>

    {% if can_manage %}
        <div class="modal modal-blur fade" id="news-delete-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-status bg-danger"></div>
                    <div class="modal-body text-center py-4">
                        <h3>{{ 'Are you sure?'|trans }}</h3>
                        <div class="text-secondary text-break">{{ 'This post will be deleted:'|trans }} <strong id="news-delete-title"></strong></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="button" class="btn btn-danger" id="news-delete-confirm">{{ 'Delete'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block js %}
{% if can_view %}
<script nonce="{{ csp_nonce }}">
    (() => {
        const text = document.getElementById('news-posts').dataset;
        const rows = document.getElementById('news-rows');
        const search = document.getElementById('news-search');

        const filter = () => {
            const query = search.value.trim().toLowerCase();
            let shown = 0;
            for (const row of rows.children) {
                row.hidden = !row.dataset.search.includes(query);
                shown += row.hidden ? 0 : 1;
            }
            document.getElementById('news-table').hidden = shown === 0;
            document.getElementById('news-empty').hidden = rows.children.length > 0;
            document.getElementById('news-no-match').hidden = rows.children.length === 0 || shown > 0;
        };
        search.addEventListener('input', filter);

        const deleteElement = document.getElementById('news-delete-modal');
        let deleting = null;
        rows.addEventListener('click', (event) => {
            const button = event.target.closest('[data-action]');
            if (!button) {
                return;
            }
            const row = button.closest('tr');
            if (button.dataset.action === 'delete') {
                deleting = row;
                document.getElementById('news-delete-title').textContent = row.dataset.title;
                bootstrap.Modal.getOrCreateInstance(deleteElement).show();
                return;
            }
            const pinned = row.dataset.pinned !== '1';
            button.disabled = true;
            ClientFence.api.admin.post('news/update', { id: row.dataset.id, pinned: pinned ? 1 : 0 }, () => {
                button.disabled = false;
                row.dataset.pinned = pinned ? '1' : '0';
                row.querySelector('[data-pinned-badge]').hidden = !pinned;
                button.title = pinned ? text.textUnpin : text.textPin;
                button.setAttribute('aria-label', button.title);
                ClientFence.message(text.textSaved, 'success');
            }, (error) => {
                button.disabled = false;
                ClientFence.message(error.message, 'error');
            });
        });
        document.getElementById('news-delete-confirm')?.addEventListener('click', () => {
            ClientFence.api.admin.post('news/delete', { id: deleting.dataset.id }, () => {
                bootstrap.Modal.getInstance(deleteElement).hide();
                deleting.remove();
                filter();
                ClientFence.message(text.textDeleted, 'success');
            }, (error) => ClientFence.message(error.message, 'error'));
        });
    })();
</script>
{% endif %}
{% endblock %}
