{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% block meta_title %}{{ 'News'|trans }}{% endblock %}

{% block body_class %}news-index{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'News'|trans }}</li>{% endblock %}

{% block content %}
    {# ClientFence core patch: a short hero, then one glass card per post with its date first (CF-135 redesign). #}
    <header class="bf-store-head cf-pub-head mb-4">
        <h1>{{ 'News & Announcements'|trans }}</h1>
    </header>
    {% set posts = guest.news_get_list({ "page": request.page, "per_page": 5 }) %}
    {% for i, post in posts.list %}
        <article class="card bf-card bf-section cf-news-item mb-3">
            <div class="cf-pub-meta">
                <span>{{ (post.publish_at ?? post.created_at)|format_datetime }}</span>
                {# ClientFence core patch (ext news): pinned posts come first and say so; the date is the publish date. #}
                {% if post.pinned %}<span class="badge text-bg-primary">{{ 'Pinned'|trans }}</span>{% endif %}
            </div>
            <h2 dir="auto"><a href='{{ "news/#{post.slug}"|url }}'>{{ post.title }}</a></h2>
            {# ClientFence core patch: the excerpt as plain text (a heading in the post showed as a second, larger title); raw: striptags leaves Markdown's escaped entities, no tags. #}
            <p class="mb-0" dir="auto">{{ ((post.excerpt ?: post.content ?? '')|markdown_to_html|striptags|trim)|truncate(200)|raw }}</p>
            <a class="bf-linkbtn" href='{{ "news/#{post.slug}"|url }}'>{{ 'Continue reading'|trans }}
                <svg class="icon flip-rtl" aria-hidden="true"><use href="#chevron-right" /></svg>
            </a>
        </article>
    {% else %}
        <div class="card bf-card"><div class="empty-state">
            <svg class="icon" aria-hidden="true"><use href="#news"/></svg>
            <p class="mb-0">{{ 'No news or announcements'|trans }}</p>
        </div></div>
    {% endfor %}
    {# ClientFence core patch (ext news): without page links clients saw only the five newest posts. #}
    {% if posts.pages > 1 %}
        <div class="mt-3">{{ include('partial_pagination.html.twig', { 'list': posts, 'url': 'news' }) }}</div>
    {% endif %}
{% endblock %}
