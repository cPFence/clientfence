{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% block meta_title %}{{ 'News'|trans }}{% endblock %}

{% block body_class %}news-index{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'News'|trans }}</li>{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="bf-page-head mb-4">
                <div>
                    <h1 class="bf-page-title">{{ 'News & Announcements'|trans }}</h1>
                    <span class="bf-hint">{{ 'Track our latest information.'|trans }}</span>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body pb-0">
                    {% set posts = guest.news_get_list({ "page": request.page, "per_page": 5 }) %}
                    {% for i, post in posts.list %}
                        <div class="card mb-3">
                            <div class="card-body">
                                <h3 class="link-body-emphasis mb-1" dir="auto">{{ post.title }}
                                    {# ClientFence core patch (ext news): pinned posts come first and say so; the date is the publish date. #}
                                    {% if post.pinned %}<span class="badge text-bg-primary align-middle fs-6 ms-1">{{ 'Pinned'|trans }}</span>{% endif %}
                                </h3>
                                <span class="text-muted">{{ (post.publish_at ?? post.created_at)|format_datetime }}</span>
                                <p>
                                    {% if post.excerpt %}
                                        {{ (post.excerpt ?? '')|truncate(200)|markdown_to_html }}
                                    {% else %}
                                        {{ (post.content ?? '')|truncate(200)|markdown_to_html }}
                                    {% endif %}
                                </p>
                                <a class="link-offset-2 link-underline" href='{{ "news/#{post.slug}"|url }}'>{{ 'Continue reading'|trans }}
                                    <svg class="icon"><use href="#chevron-right" /></svg>
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div class="empty-state pt-3">{{ 'No news or announcements'|trans }}</div>
                    {% endfor %}
                </div>
                {# ClientFence core patch (ext news): without page links clients saw only the five newest posts. #}
                {% if posts.pages > 1 %}
                    <div class="card-footer">{{ include('partial_pagination.html.twig', { 'list': posts, 'url': 'news' }) }}</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
