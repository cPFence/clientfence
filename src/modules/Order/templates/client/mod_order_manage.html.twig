{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service'|url}}">{{ 'Services'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set upgradables = client.order_upgradables({ 'id': order.id }) %}
{# ClientFence core patch: cancellation requests in their own list, as WHMCS (Order\CancelRequests); the client can withdraw one while it waits. #}
{% set cancel_request = order.status == 'active' ? client.order_cancel_request_get({ 'id': order.id }) : null %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
    {{ render_widgets('client.order.manage.content.start', { 'order': order }) }}

    <div class="row">
        <div class="col-md-12">
            {# Order info #}
            <div class="card mb-4">
                <div class="card-header py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Service Details'|trans }}</h1>
                            <span class="small text-secondary">{{ 'All information about your service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-hover table-bordered table-sm">
                        <tbody>
                        <tr>
                            <td><label>{{ 'Order'|trans }}</label></td>
                            <td>#{{ order.id }}</td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Product Name'|trans }}</label></td>
                            <td><strong>{{ order.title }}</strong></td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Payment Amount'|trans }}</label></td>
                            <td>{{ order.total|format_currency(order.currency ?? default_currency) }}</td>
                        </tr>

                        {% if order.discount and order.discount > 0 %}
                            <tr>
                                <td><label>{{ 'Order Discount'|trans }}</label></td>
                                <td>-{{ order.discount|format_currency(order.currency ?? default_currency) }}</td>
                            </tr>

                            <tr>
                                <td><label>{{ 'Payment Amount After Discount'|trans }}</label></td>
                                <td>{{ (order.total - order.discount)|format_currency(order.currency ?? default_currency) }}</td>
                            </tr>
                        {% endif %}

                        {% if order.period %}
                            <tr>
                                <td><label>{{ 'Billing Cycle'|trans }}</label></td>
                                <td>{{ order.period|period_title }}</td>
                            </tr>
                        {% endif %}

                        <tr>
                            <td><label>{{ 'Order Status'|trans }}</label></td>
                            <td>
                                {{ mf.status_badge(order.status, 'order') }}
                            </td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Order Created'|trans }}</label></td>
                            <td>{{ order.created_at|format_date }}</td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Activated At'|trans }}</label></td>
                            <td>{% if order.activated_at %}{{ order.activated_at|format_date }}{% else %}-{% endif %}</td>
                        </tr>

                        {% if order.period %}
                            <tr>
                                <td><label>{{ 'Renewal Date'|trans }} {% if order.expires_at %} in {{ order.expires_at|daysleft }} day(s) {% endif %}</label></td>
                                <td>{% if order.expires_at %}{{ order.expires_at|format_date }}{% else %}-{% endif %}</td>
                            </tr>
                        {% endif %}

                        {% if order.active_tickets > 0 %}
                            <tr>
                                <td><label>{{ 'Active Support Tickets'|trans }}</label></td>
                                <td>
                                    <div class="num"><a href="{{ 'support'|url }}" class="redNum">{{ order.active_tickets }}</a></div>
                                    {# <div class="num"><a href="{{ 'support'|url }}" class="greenNum">{{ order.active_tickets }}</a></div> #}
                                    {# <div class="num"><a href="{{ 'support'|url }}" class="bludNum">{{ order.active_tickets }}</a></div> #}
                                </td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>
                    {{ render_widgets('client.order.manage.details.after', { 'order': order }) }}
                </div>
                <div class="card-footer">
                    {% if order.period and order.status in ['active', 'suspended'] %}
                        <a class="btn btn-primary btn-sm"
                           {{ fb_api_link({href: 'invoice/renewal_invoice'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Are you sure?'|trans, content: 'This will generate new invoice. Are you sure you want to continue?'|trans}, callback: 'onRenewalInvoiceCreated'}) }}>{{ 'Renew Now'|trans }}</a>
                        <script nonce="{{ csp_nonce|raw }}">window.onRenewalInvoiceCreated = (hash) => { window.location = "{{ 'invoice'|url }}/" + hash; };</script>
                    {% endif %}
                    {% if upgradables %}
                        <button class="btn btn-success btn-sm" type="button" id="request-upgrade" data-bs-toggle="modal" data-bs-target="#upgrade-request-modal">{{ 'Request Upgrade'|trans }}</button>
                    {% endif %}
                    <button class="btn btn-info btn-sm" type="button" id="open-ticket" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">{{ 'Open Ticket'|trans }}</button>
                    {% if cancel_request %}
                        <div class="alert alert-warning mt-2 mb-0" role="status">
                            {{ cancel_request.type == 'end_of_period'
                                ? 'You asked on %date% to cancel this service at the end of its billing period. You can withdraw the request until it is processed.'|trans({ '%date%': cancel_request.created_at|format_date })
                                : 'You asked on %date% to cancel this service immediately. You can withdraw the request until it is processed.'|trans({ '%date%': cancel_request.created_at|format_date }) }}
                            <a class="btn btn-outline-secondary btn-sm ms-2" {{ fb_api_link({href: 'order/cancel_request_withdraw'|api_url(query: {id: order.id}), modal: {type: 'confirm', title: 'Withdraw the cancellation request?'|trans, content: 'The service stays active.'|trans}, reload: true}) }}>{{ 'Withdraw Request'|trans }}</a>
                        </div>
                    {% elseif order.status == 'active' %}
                        <button class="btn btn-danger btn-sm" type="button" id="request-cancel" data-bs-toggle="modal" data-bs-target="#cancel-request-modal">{{ 'Request Cancellation'|trans }}</button>
                    {% endif %}
                    {{ render_widgets('client.order.manage.actions.end', { 'order': order }) }}
                </div>
            </div>

            {# Service management #}
            {% set service = null %}
            {{ render_widgets('client.order.manage.service.before', { 'order': order, 'service': service }) }}
            {% if order.status == 'active' and guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = client.order_service({ 'id': order.id }) %}
                {% if service %}
                    {{ include(service_partial, { 'order': order, 'service': service }) }}
                {% else %}
                    <div class="alert alert-info" role="alert">{{ 'This order has no active service to manage.'|trans }}</div>
                {% endif %}
            {% endif %}
            {{ render_widgets('client.order.manage.service.after', { 'order': order, 'service': service }) }}

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card mb-4">
                <div class="card-header py-3 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Addons'|trans }}</h1>
                            <span class="small text-secondary">{{ 'Addons you have ordered with this service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                        <table class="table table-hover table-bordered table-sm">
                            <thead>
                            <tr>
                                <th>{{ 'Product/Service'|trans }}</th>
                                <th>{{ 'Price'|trans }}</th>
                                <th>{{ 'Billing Cycle'|trans }}</th>
                                <th>{{ 'Next Due Date'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th>{{ 'Actions'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for i, addon in addons %}
                                <tr>
                                    <td>{{ addon.title }}</td>
                                    <td>{{ addon.total|format_currency(addon.currency ?? default_currency) }}</td>
                                    <td>{{ addon.period|period_title }}</td>
                                    <td>{% if addon.expires_at %}{{ addon.expires_at|format_date }}{% else %}-{% endif %}</td>
                                    <td>
                                        {{ mf.status_badge(addon.status, 'order') }}
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-outline-primary btn-sm" href='{{ "order/service/manage/#{addon.id}"|url }}'>{{ 'Manage'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            {# ClientFence core patch: add-ons ordered for this service (Order/AddonOrders.php), through the cart. #}
            {% set addon_offers = client.order_addon_offers({ "id": order.id }) %}
            {% if addon_offers|length > 0 %}
            <div class="card mb-4" id="order-addons">
                <div class="card-header py-3">
                    <h1 class="mb-1">{{ 'Order Add-ons'|trans }}</h1>
                    <span class="small text-secondary">{{ 'Add-ons are charged to this service\'s due date, then renew with it.'|trans }}</span>
                </div>
                <div class="card-body">
                    <table class="table table-hover table-bordered table-sm">
                        <thead>
                        <tr>
                            <th>{{ 'Add-on'|trans }}</th>
                            <th>{{ 'Due now'|trans }}</th>
                            <th>{{ 'Then'|trans }}</th>
                            <th>{{ 'Actions'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for offer in addon_offers %}
                            <tr>
                                <td>{{ offer.title }}{% if offer.description %}<div class="small text-secondary">{{ offer.description|striptags }}</div>{% endif %}</td>
                                <td>{{ (offer.now + offer.setup)|format_currency(order.currency) }}{% if offer.due %}<div class="small text-secondary">{{ 'to :date'|trans({':date': offer.due|format_date}) }}</div>{% endif %}</td>
                                <td>{% if offer.period %}{{ offer.price|format_currency(order.currency) }} {{ offer.period|period_title }}{% else %}{{ 'One time'|trans }}{% endif %}</td>
                                <td class="actions">
                                    <a class="btn btn-primary btn-sm"
                                       {{ fb_api_link({href: 'order/addon_order'|api_url(query: {id: order.id, product_id: offer.id}), redirect: 'cart'|url}) }}>{{ 'Order'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            <div class="modal fade" id="cancel-request-modal" tabindex="-1" role="dialog" aria-labelledby="cancel-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit Cancellation Request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="cancel-request-form" class="request-cancellation">
                            <div class="modal-body">
                                {# ClientFence core patch: cancellation requests in their own list, as WHMCS (Order\CancelRequests). #}
                                <input type="hidden" name="id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="cancel-type" class="form-label">{{ 'Cancellation Type'|trans }}</label>
                                    <select class="form-select" id="cancel-type" name="type">
                                        <option value="immediate">{{ 'Immediate'|trans }}</option>
                                        {% if order.expires_at %}<option value="end_of_period">{{ 'End of billing period'|trans }} ({{ order.expires_at|format_date }})</option>{% endif %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="cancel-reason" class="form-label">{{ 'Reason'|trans }}</label>
                                    <textarea class="form-control" id="cancel-reason" name="reason" rows="5" maxlength="2000" required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="open-ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticket-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit New Support Ticket'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="open-ticket-form" class="open-ticket">
                            <div class="modal-body">
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Message'|trans }}</label>
                                    <textarea class="editor-textarea form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">{{ 'Open Ticket'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="upgrade-request-modal" tabindex="-1" role="dialog" aria-labelledby="upgrade-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit Upgrade Request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="upgrade-request-form" class="request-upgrade">
                            <div class="modal-body">
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="upgrade">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="subject" value="{{ request.subject|e }}" required />
                                </div>
                                <div class="mb-3">
                                    <label for="rel_new_value" class="form-label">{{ 'Upgrade To'|trans }}</label>
                                    {{ mf.selectbox('rel_new_value', upgradables, '', 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Notes'|trans }}</label>
                                    <textarea id="content" name="content" rows="5" required class="form-control" placeholder="{{ 'Your comment'|trans }}">{{ 'I would like to upgrade'|trans }} {{ order.title }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary" id="open-ticket-submit">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block js %}
{% autoescape "js" %}
    <script nonce="{{ csp_nonce|raw }}">
        document.addEventListener("DOMContentLoaded", function() {
            const cancelRequestForm = document.getElementById('cancel-request-form');
            const upgradeRequestForm = document.getElementById('upgrade-request-form');
            const openTicketForm = document.getElementById('open-ticket-form');

            cancelRequestForm.addEventListener('submit', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('order/cancel_request', ClientFence.tools.serializeFormDataToObject(new FormData(cancelRequestForm)),
                    () => {
                        ClientFence.message('Service cancellation request received');
                        const cancelRequestModal = bootstrap.Modal.getInstance(document.getElementById('cancel-request-modal'))
                        cancelRequestModal.hide();
                    },
                    (res) => {
                        ClientFence.message(`${res.message} (${res.code})`, 'error');
                    });
            });

            upgradeRequestForm.addEventListener('submit', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('support/ticket_create', ClientFence.tools.serializeFormDataToObject(new FormData(upgradeRequestForm)),
                    () => {
                        ClientFence.message('Service upgrade request received');
                        const upgradeRequestModal = bootstrap.Modal.getInstance(document.getElementById('upgrade-request-modal'))
                        upgradeRequestModal.hide();
                    },
                    (res) => {
                        ClientFence.message(`${res.message} (${res.code})`, 'error')
                    });
            });

            openTicketForm.addEventListener('submit', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('support/ticket_create', ClientFence.tools.serializeFormDataToObject(new FormData(openTicketForm)),
                    () => {
                        ClientFence.message('Ticket was submitted. If you want to track conversation please go to support section');
                        let openTicketModal = bootstrap.Modal.getInstance(document.getElementById('open-ticket-modal'));
                        openTicketModal.hide();
                    },
                    (res) => {
                        ClientFence.message(`${res.message} (${res.code})`, 'error')
                    });
            });

        });

    </script>
{% endautoescape %}
{% endblock %}
