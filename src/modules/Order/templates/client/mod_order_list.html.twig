{# ClientFence core patch (0.8.9 port): pagination stays on the service list. #}
{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'My Products & Services'|trans }}{% endblock %}

{% block body_class %}order-list{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Services'|trans }}</li>
{% endblock %}

{% block content %}
    <div class="bf-page-head mb-4">
        <div>
            <h1 class="bf-page-title">{{ 'Services'|trans }}</h1>
            {# ClientFence core patch: a client's services are called services, not orders, as in WHMCS. #}
            <span class="bf-hint">{{ 'All your services are listed here. Select one to see its details and manage it.'|trans }}</span>
        </div>
    </div>
    {# ClientFence core patch: status cards over the list; one click shows only that status, a second click shows every service again. #}
    {% set statuses = { 'active': 'Active'|trans, 'pending_setup': 'Pending Setup'|trans, 'suspended': 'Suspended'|trans, 'canceled': 'Canceled'|trans } %}
    {% set status = statuses[request.status|default('')] is defined ? request.status : null %}
    <div class="cf-filter-cards mb-3">
        {% for key, label in statuses %}
            <a class="card cf-filter-card cf-filter-{{ key }}{{ key == status ? ' active' }}" href="{{ 'order/service'|url(query: key == status ? {} : { 'status': key }) }}"{% if key == status %} aria-current="true"{% endif %}>
                <span class="cf-filter-label">{{ label }}</span>
                <span class="cf-filter-count">{{ client.order_get_list({ 'per_page': 1, 'hide_addons': 1, 'status': key }).total }}</span>
            </a>
        {% endfor %}
    </div>
    {# ClientFence core patch: one row per service: type icon, title and domain, next due date, price per period, status and Manage (CF-135 redesign). #}
    <div class="card mb-4 cf-svc-list">
        {% set orders = client.order_get_list({"per_page":10, "page":request.page, "hide_addons":1, "status":status, "active_first":1}) %}
        {% if orders.list %}
            {# A hosting service's domain: its account's (staff can change it), else the one on the order. #}
            {% set domains = client.servicehosting_accounts|column('domain', 'order_id') %}
            {% for order in orders.list %}
                {% set href = "order/service/manage/#{order.id}"|url %}
                {% set ordered = order.service_type == 'hosting' ? order.config.domain|default(null) : null %}
                {% set sld = ordered is iterable ? ordered[ordered.action|default('') ~ '_sld']|default('') : '' %}
                {% set domain = domains[order.id]|default('') ?: (sld ? sld ~ '.' ~ ordered[ordered.action ~ '_tld']|default('')|trim('.', 'left') : '') %}
                <div class="cf-svc-row">
                    <span class="clientfence-hosting-monogram" aria-hidden="true"><svg class="icon"><use href="#{{ { 'hosting': 'server', 'domain': 'world', 'license': 'key', 'apikey': 'key', 'downloadable': 'folder' }[order.service_type]|default('apps') }}"/></svg></span>
                    <div class="cf-svc-main">
                        <a class="cf-svc-title" href="{{ href }}">{{ order.title }}</a>
                        <span class="cf-svc-meta">{% if domain %}<bdi dir="ltr">{{ domain }}</bdi> · {% endif %}<bdi>#{{ order.id }}</bdi></span>
                    </div>
                    <div class="cf-svc-cell cf-svc-due"><span class="cf-label">{{ 'Next Due Date'|trans }}</span>{{ order.expires_at ? order.expires_at|format_date : '-' }}</div>
                    <div class="cf-svc-cell cf-svc-price"><span class="cf-label">{{ 'Price'|trans }}</span><span><strong>{{ order.total|format_currency(order.currency ?? default_currency) }}</strong> {% if order.period %}{{ order.period|period_title }}{% endif %}</span></div>
                    <div class="cf-svc-status">{{ mf.status_badge(order.status, 'order') }}</div>
                    <a class="btn btn-sm btn-outline-primary" href="{{ href }}">{{ 'Manage'|trans }}</a>
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">{{ 'No services yet.'|trans }}</div>
        {% endif %}
        {{ include('partial_pagination.html.twig', { 'list': orders, 'url': 'order/service' }) }}
    </div>
{% endblock %}
