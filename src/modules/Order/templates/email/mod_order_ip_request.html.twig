{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {% if approved|default(false) %}{{ 'IP address change approved: %title%'|trans({'%title%': order.title ?? ''}) }}{% else %}{{ 'IP address change refused: %title%'|trans({'%title%': order.title ?? ''}) }}{% endif %}{% endblock %}
{% block content %}
{% set email_title %}{{ approved|default(false) ? 'IP address change approved'|trans : 'IP address change refused'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ approved|default(false) ? 'IP address change approved'|trans : 'IP address change refused'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{% if approved|default(false) %}{{ 'Our staff approved your IP address change for %title%:'|trans({'%title%': order.title|default('')}) }}{% else %}{{ 'Our staff refused your IP address change for %title%:'|trans({'%title%': order.title|default('')}) }}{% endif %}</p>
		<p style="margin:0 0 16px; font-weight:bold;">{% if request.type|default('') == 'add' %}{{ 'Add %ip%'|trans_html({}, {'%ip%': '<span dir="ltr">' ~ request.ip|default('')|e ~ '</span>'}) }}{% elseif request.type|default('') == 'remove' %}{{ 'Remove %ip%'|trans_html({}, {'%ip%': '<span dir="ltr">' ~ request.ip|default('')|e ~ '</span>'}) }}{% else %}{{ 'Reset License'|trans }}{% endif %}</p>
		{% if reason|default('') %}<p style="margin:0 0 16px;">{{ 'Reason: %reason%'|trans({'%reason%': reason}) }}</p>{% endif %}
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ('order/service/manage/' ~ order.id|default(''))|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Manage service'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
