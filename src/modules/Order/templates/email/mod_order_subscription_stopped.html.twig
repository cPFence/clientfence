{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Automatic payment for your service has stopped'|trans }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Automatic payment has stopped'|trans }}{% endset %}
{% set email_preheader %}{{ 'The automatic payment set up for your service at its old price was cancelled.'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Automatic payment has stopped'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'The plan, price or billing cycle of %title% changed, so the automatic payment set up for it at the old price was cancelled. You have not been charged for this.'|trans_html({}, {'%title%': '<a href="' ~ (('order/service/manage/' ~ order_id|default(''))|url(area: 'client'))|e ~ '" target="_blank" style="color:#0f172a;">' ~ (title|default(''))|e ~ '</a>'}) }}</p>
		<p style="margin:0 0 16px;">{% if saved_method|default(false) %}{{ 'Your account credit or saved payment method will pay your next renewal invoice, so you do not need to do anything.'|trans }}{% else %}{{ 'The cancelled automatic payment will not pay your next renewal invoice. Unless your account credit covers it, please pay it when it arrives; paying it the same way as before sets up automatic payment again.'|trans }}{% if payment_methods|default(false) %} {{ 'You can also save a payment method on your %link%Payment methods%link_end% page now, so your invoices are paid automatically.'|trans_html({}, {'%link%': '<a href="' ~ ('payment-methods'|url(area: 'client'))|e ~ '" target="_blank" style="color:#0f172a;">', '%link_end%': '</a>'}) }}{% endif %}{% endif %}</p>
		<p style="margin:0 0 16px;">{{ 'If you have any questions, please reply to this email or open a support ticket.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ('order/service/manage/' ~ order_id|default(''))|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'View your service'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
