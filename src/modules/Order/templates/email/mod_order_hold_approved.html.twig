{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Your order is approved'|trans }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your order is approved'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your order is approved'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello :name,'|trans({':name': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We have reviewed and approved your order:'|trans }}</p>
		<ul style="margin:0 0 16px; padding-left:20px;">
		{% for o in orders|default([]) %}<li>{{ 'Order #:id: :title'|trans({':id': o.id, ':title': o.title}) }}</li>{% endfor %}
		</ul>
		<p style="margin:0 0 16px;">{{ 'If it has an invoice to pay, you will receive it by email and find it in your client area. Setup starts as usual.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'order/service'|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'My services'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
