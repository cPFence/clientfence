{% block subject %}[{{ guest.system_company.name }}] {{ 'Cancellation request received: %title%'|trans({'%title%': order.title|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence: as WHMCS "Cancellation Request Confirmation", sent to the client who asked to cancel a service (ClientFence\Mod\Order\CancelRequests). #}
{% set request = request|default({}) %}
{% set order = order|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
		h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
		p { margin: 0 0 10px; }
		.signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
	</style>
</head>
<body>
	<h1>{{ 'Cancellation request received'|trans }}</h1>
	<p>{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
	<p>{{ 'We have received your request to cancel this service: %title%.'|trans({'%title%': order.title|default('')}) }}</p>
	<p>{% if request.type|default('') == 'end_of_period' %}{{ 'It will be cancelled at the end of its billing period, on %date%. You will not be invoiced for it again.'|trans({'%date%': order.expires_at|default('')|format_date}) }}{% else %}{{ 'It will be cancelled shortly, and any unpaid invoice for it will be cancelled.'|trans }}{% endif %}</p>
	<p>{{ 'If you asked by mistake, withdraw the request from the service page before it is processed.'|trans }}</p>
	<p><a href="{{ ('order/service/manage/' ~ order.id|default(''))|url(area: 'client') }}" target="_blank">{{ 'Manage service'|trans }}</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
