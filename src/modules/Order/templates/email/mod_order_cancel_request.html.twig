{% block subject %}[{{ guest.system_company.name }}] {{ 'Cancellation request received: %title%'|trans({'%title%': order.title|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Cancellation request received'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Cancellation request received'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We have received your request to cancel this service: %title%.'|trans({'%title%': order.title|default('')}) }}</p>
		<p style="margin:0 0 16px;">{% if request.type|default('') == 'end_of_period' %}{{ 'It will be cancelled at the end of its billing period, on %date%. You will not be invoiced for it again.'|trans({'%date%': order.expires_at|default('')|format_date}) }}{% else %}{{ 'It will be cancelled shortly, and any unpaid invoice for it will be cancelled.'|trans }}{% endif %}</p>
		<p style="margin:0 0 16px;">{{ 'If you asked by mistake, withdraw the request from the service page before it is processed.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ('order/service/manage/' ~ order.id|default(''))|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Manage service'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
