{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% set active_menu = 'order' %}

{% import "macro_functions.html.twig" as mf %}

{# The catalogue the page's script reads from the form's data attributes. #}
{% set pairs = admin.product_get_pairs %}
{% set periods = guest.system_periods %}
{% set products = [] %}
{% set catalogue = admin.product_get_list({ 'per_page': 500 }) %}
{% set list = catalogue.list %}
{% if catalogue.pages|default(1) > 1 %}
    {% for page in 2..catalogue.pages %}
        {% set list = list|merge(admin.product_get_list({ 'per_page': 500, 'page': page }).list) %}
    {% endfor %}
{% endif %}
{% for p in list|filter(p => pairs[p.id] is defined and p.type != 'domain') %}
    {% set cycles = [] %}
    {% if p.pricing.type|default('') == 'recurrent' %}
        {% for code, price in p.pricing.recurrent|filter(price => price.enabled) %}
            {% set cycles = cycles|merge([{ 'code': code, 'label': periods[code]|default(code) }]) %}
        {% endfor %}
    {% endif %}
    {% set products = products|merge([{ 'id': p.id, 'title': p.title, 'type': p.type, 'periods': cycles, 'quantity': p.allow_quantity_select }]) %}
{% endfor %}
{% set tlds = [] %}
{% for t in guest.serviceDomain_tlds %}
    {% set tlds = tlds|merge([{ 'tld': t.tld, 'min_years': t.min_years, 'periods': t.periods, 'domain_fields': t.domain_fields, 'transfer_fields': t.transfer_fields }]) %}
{% endfor %}
{% set promos = admin.product_promo_get_list({ 'per_page': 500, 'status': 'active' }).list %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'order'|url }}">{{ 'Orders'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Add New Order'|trans }}</li>
    </ol>
{% endblock %}

{% block meta_title %}{{ 'Add New Order'|trans }}{% endblock %}

{% block content %}
{# ClientFence core patch: Add New Order as WHMCS: products and domains for one client in one order with one invoice,
   and an Order Summary priced by order/quote, the same code that makes the order. #}
<style>
    .cf-order-summary { position: sticky; top: 1rem; }
    .cf-order-item { border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius); background: var(--tblr-bg-surface-secondary); }
    .cf-order-item + .cf-order-item { margin-top: 1rem; }
    .cf-order-lines li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 .75rem; padding: .625rem 0; border-bottom: 1px dashed var(--tblr-border-color); }
    .cf-order-lines li > :first-child { overflow-wrap: anywhere; }
    .cf-order-lines small { grid-column: 1 / -1; }
    .cf-order-amount { font-variant-numeric: tabular-nums; text-align: end; }
    .cf-order-totals { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .375rem .75rem; }
    .cf-order-totals dd { margin: 0; }
    @media (max-width: 991.98px) { .cf-order-summary { position: static; } }
</style>

<form id="cf-new-order" novalidate data-products="{{ products|json_encode|e('html_attr') }}" data-tlds="{{ tlds|json_encode|e('html_attr') }}" data-periods="{{ periods|json_encode|e('html_attr') }}" data-today="{{ 'now'|date('Y-m-d', false) }}">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header"><h3 class="card-title">{{ 'Order details'|trans }}</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="client_id">{{ 'Client'|trans }}</label>
                            {% if client %}
                                <input type="text" class="form-control" disabled value="{{ client.first_name }} {{ client.last_name }} #{{ client.id }}">
                                <input type="hidden" name="client_id" id="client_id" value="{{ client.id }}">
                            {% else %}
                                <select class="form-control autocomplete-selector" id="client_id" name="client_id" placeholder="{{ 'Start typing the client name or ID'|trans }}" data-resturl="/api/admin/client/get_pairs"></select>
                            {% endif %}
                        </div>
                        {% if has_permission('invoice') %}
                        <div class="col-md-6">
                            <label class="form-label" for="gateway_id">{{ 'Payment method'|trans }}</label>
                            {{ mf.selectbox('gateway_id', admin.invoice_gateway_get_pairs, '', 0, 'Any payment method'|trans) }}
                        </div>
                        {% endif %}
                        <div class="col-md-6">
                            <label class="form-label" for="promocode">{{ 'Promotion code'|trans }}</label>
                            <input class="form-control" type="text" id="promocode" name="promocode" list="cf-promos" autocomplete="off">
                            <datalist id="cf-promos">
                                {% for promo in promos %}<option value="{{ promo.code }}">{% endfor %}
                            </datalist>
                            <small class="form-hint">{{ 'Leave empty for no promotion.'|trans }}</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="activate">{{ 'Order status'|trans }}</label>
                            <select class="form-select" id="activate" name="activate">
                                <option value="0">{{ 'Pending'|trans }}</option>
                                <option value="1">{{ 'Active'|trans }}</option>
                            </select>
                            <small class="form-hint">{{ 'Active sets the services up now, before payment.'|trans }}</small>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-3">
                            <label class="form-check mb-0"><input class="form-check-input" type="checkbox" id="invoice" checked> <span class="form-check-label">{{ 'Generate invoice'|trans }}</span></label>
                            <label class="form-check mb-0"><input class="form-check-input" type="checkbox" id="send_email" checked> <span class="form-check-label">{{ 'Send invoice email'|trans }}</span></label>
                            {% if has_permission('invoice') %}
                            <label class="form-check mb-0" id="cf-credit-wrap" hidden><input class="form-check-input" type="checkbox" id="use_credit" checked> <span class="form-check-label" id="cf-credit-label"></span></label>
                            <label class="form-check mb-0"><input class="form-check-input" type="checkbox" id="mark_invoice_paid"> <span class="form-check-label">{{ 'Mark the invoice as paid'|trans }}</span></label>
                            {% endif %}
                        </div>
                        {% if has_permission('invoice') %}
                        <div class="col-md-6" id="cf-paid-fields" hidden>
                            <label class="form-label" for="transaction-id">{{ 'Transaction ID'|trans }}</label>
                            <input class="form-control" type="text" id="transaction-id" name="transactionId">
                            <small class="form-hint">{{ 'Choose the payment method the client paid with. The Custom payment gateway needs a transaction ID.'|trans }}</small>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h3 class="card-title">{{ 'Products and services'|trans }}</h3></div>
                <div class="card-body" id="cf-products"></div>
                <div class="card-footer"><button type="button" class="btn btn-outline-primary w-100" id="cf-add-product">+ {{ 'Add another product'|trans }}</button></div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h3 class="card-title">{{ 'Domains'|trans }}</h3></div>
                <div class="card-body" id="cf-domains"></div>
                <div class="card-footer"><button type="button" class="btn btn-outline-primary w-100" id="cf-add-domain">+ {{ 'Add another domain'|trans }}</button></div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card cf-order-summary">
                <div class="card-header"><h3 class="card-title">{{ 'Order Summary'|trans }}</h3></div>
                <div class="card-body">
                    <div class="alert alert-danger" id="cf-quote-error" role="alert" hidden></div>
                    <ul class="list-unstyled mb-3 cf-order-lines" id="cf-lines" aria-live="polite"></ul>
                    <dl class="mb-0 cf-order-totals" id="cf-totals"></dl>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-baseline">
                    <span class="fw-bold">{{ 'Total due today'|trans }}</span>
                    <span class="h2 mb-0 cf-order-amount" id="cf-total">–</span>
                </div>
                <div class="card-body pt-0">
                    <button type="submit" class="btn btn-primary w-100" id="cf-submit">{{ 'Submit Order'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
</form>
{% endblock %}

{% block js %}
<script nonce="{{ csp_nonce }}">
(() => {
    const text = {{ {
        product: 'Product'|trans, domain: 'Domain'|trans, remove: 'Remove'|trans,
        productLabel: 'Product / service'|trans, period: 'Billing cycle'|trans, quantity: 'Quantity'|trans,
        priceOverride: 'Price override'|trans, username: 'Username'|trans, password: 'Password'|trans,
        generate: 'Leave blank to generate'|trans, import: 'Import an existing account from the server (do not create it)'|trans, priceHint: 'Leave empty for the normal price.'|trans,
        setUp: 'Already set up (do not run the module)'|trans, start: 'Start date'|trans, startHint: 'The day the service started: its first period counts from it. The invoice is dated today.'|trans,
        existing: 'Existing domain'|trans, existingHint: 'No registrar action: the expiry date is read from the registrar when it can tell.'|trans,
        ownDomain: 'The client’s own domain, or register or transfer it with this order.'|trans,
        registerToo: 'Register :domain too'|trans, transferToo: 'Transfer :domain too'|trans,
        linked: 'For product :n (:title).'|trans, linkedHere: 'Registered or transferred with this order (see Domains).'|trans,
        register: 'Register'|trans, transfer: 'Transfer'|trans,
        years: 'Registration period'|trans, year: ':n year'|trans, yearsN: ':n years'|trans, epp: 'EPP / auth code'|trans,
        noTld: 'Enter a domain with a TLD this store sells:'|trans, noProducts: 'No products. Add one, or order domains only.'|trans,
        noDomains: 'No domains in this order.'|trans, noLines: 'No items yet. Add a product or a domain.'|trans,
        noClient: 'Choose a client to see the prices.'|trans, newDomain: 'New domain'|trans, optional: '(optional)'|trans,
        setup: 'Setup fee'|trans, subtotal: 'Subtotal'|trans, discount: 'Promotion (:code)'|trans, tax: 'Tax'|trans,
        taxIncluded: 'Prices include :tax'|trans, credit: 'Client credit'|trans, creditLabel: 'Apply client credit (:amount)'|trans
    }|json_encode|raw }};

    const form = document.getElementById('cf-new-order');
    const PRODUCTS = JSON.parse(form.dataset.products), TLDS = JSON.parse(form.dataset.tlds), PERIODS = JSON.parse(form.dataset.periods), TODAY = form.dataset.today;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fill = (s, map) => Object.entries(map).reduce((out, [k, v]) => out.replace(':' + k, v), s);
    const state = { products: [], domains: [] };
    let uid = 0, currency = null, seq = 0, timer = null;
    const money = (n) => currency ? new Intl.NumberFormat(document.documentElement.lang || undefined, { style: 'currency', currency }).format(n) : String(n);
    const product = (id) => PRODUCTS.find((p) => p.id == id);
    // The longest TLD this store sells that ends the name: "shop.co.uk" is shop + .co.uk, not shop.co + .uk.
    const split = (name) => {
        const n = name.trim().toLowerCase();
        const t = TLDS.filter((x) => n.endsWith(x.tld) && n.length > x.tld.length).sort((a, b) => b.tld.length - a.tld.length)[0];
        return t ? { sld: n.slice(0, -t.tld.length), tld: t.tld, info: t } : null;
    };
    // As the client order form: the TLD's own periods, or five years from its minimum.
    const yearsFor = (t) => t && Array.isArray(t.periods) && t.periods.length ? t.periods
        : Array.from({ length: 5 }, (_, i) => i + (Number(t?.min_years) > 0 ? Number(t.min_years) : 1));

    function addProduct(id) {
        const p = product(id);
        if (!p) return;
        state.products.push({ key: ++uid, productId: p.id, period: p.periods[0]?.code || '', qty: 1, domain: '', price: '', import: false, username: '', password: '', start: TODAY });
        render();
    }
    function addDomain(data = {}) {
        state.domains.push({ key: ++uid, action: data.action || 'register', name: data.name || '', years: '', epp: '', price: '', fields: {}, linkedTo: data.linkedTo ?? null, start: TODAY });
        render();
    }

    // Start date (WHMCS Registration Date): today or a past day; the server refuses a future one.
    const startHtml = (it) => `<div class="col-md-6"><label class="form-label" for="s${it.key}">${esc(text.start)}</label>
        <input class="form-control" type="date" id="s${it.key}" data-f="start" value="${esc(it.start)}" max="${esc(TODAY)}">
        <small class="form-hint">${esc(text.startHint)}</small></div>`;

    function fieldsHtml(d, t) {
        const fields = t ? (d.action === 'transfer' ? t.transfer_fields : t.domain_fields) || {} : {};
        return Object.entries(fields).map(([name, f]) => {
            const id = `f${d.key}-${name}`, v = d.fields[name] ?? '';
            const control = f.options
                ? `<select class="form-select" id="${esc(id)}" data-field="${esc(name)}"><option value=""></option>${Object.entries(f.options).map(([o, l]) => `<option value="${esc(o)}"${o == v ? ' selected' : ''}>${esc(l)}</option>`).join('')}</select>`
                : `<input class="form-control" type="text" id="${esc(id)}" data-field="${esc(name)}" value="${esc(v)}" maxlength="255">`;
            return `<div class="col-md-6"><label class="form-label" for="${esc(id)}">${esc(f.label)}${f.required ? '' : ' ' + esc(text.optional)}</label>${control}</div>`;
        }).join('');
    }

    function render() {
        $('cf-products').innerHTML = state.products.length ? state.products.map((it, i) => {
            const p = product(it.productId);
            const linked = state.domains.some((d) => d.linkedTo === it.key);
            const domain = p.type === 'hosting' ? `<div class="col-md-6">
                    <label class="form-label" for="d${it.key}">${esc(text.domain)}</label>
                    <input class="form-control" type="text" id="d${it.key}" data-f="domain" value="${esc(it.domain)}" placeholder="example.com" autocomplete="off">
                    ${linked ? `<small class="form-hint">${esc(text.linkedHere)}</small>`
                        : (split(it.domain) ? `<div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm" data-link="register">+ ${esc(fill(text.registerToo, { domain: it.domain.trim() }))}</button>
                            <button type="button" class="btn btn-sm" data-link="transfer">+ ${esc(fill(text.transferToo, { domain: it.domain.trim() }))}</button></div>`
                        : `<small class="form-hint">${esc(text.ownDomain)}</small>`)}
                </div>
                <div class="col-md-6"><label class="form-label" for="u${it.key}">${esc(text.username)}</label>
                    <input class="form-control" type="text" id="u${it.key}" data-f="username" value="${esc(it.username)}" placeholder="${esc(text.generate)}" autocomplete="off"></div>
                <div class="col-md-6"><label class="form-label" for="w${it.key}">${esc(text.password)}</label>
                    <input class="form-control" type="text" id="w${it.key}" data-f="password" value="${esc(it.password)}" placeholder="${esc(text.generate)}" autocomplete="off"></div>` : '';
            return `<div class="cf-order-item" data-key="${it.key}">
                <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                    <span class="badge bg-blue-lt">${esc(text.product)} ${i + 1}</span><strong class="flex-fill text-truncate">${esc(p.title)}</strong>
                    <button type="button" class="btn btn-sm btn-ghost-danger" data-rm>${esc(text.remove)}</button>
                </div>
                <div class="row g-3 p-3">
                    <div class="col-md-6"><label class="form-label" for="p${it.key}">${esc(text.productLabel)}</label>
                        <select class="form-select" id="p${it.key}" data-f="productId">${PRODUCTS.map((x) => `<option value="${x.id}"${x.id == it.productId ? ' selected' : ''}>${esc(x.title)}</option>`).join('')}</select></div>
                    ${p.periods.length ? `<div class="col-md-6"><label class="form-label" for="c${it.key}">${esc(text.period)}</label>
                        <select class="form-select" id="c${it.key}" data-f="period">${p.periods.map((c) => `<option value="${esc(c.code)}"${c.code === it.period ? ' selected' : ''}>${esc(c.label)}</option>`).join('')}</select></div>` : ''}
                    ${domain}
                    ${p.quantity ? `<div class="col-md-3"><label class="form-label" for="q${it.key}">${esc(text.quantity)}</label>
                        <input class="form-control" type="number" min="1" id="q${it.key}" data-f="qty" value="${esc(it.qty)}"></div>` : ''}
                    <div class="col-md-6"><label class="form-label" for="o${it.key}">${esc(text.priceOverride)}</label>
                        <input class="form-control" type="text" inputmode="decimal" id="o${it.key}" data-f="price" value="${esc(it.price)}">
                        <small class="form-hint">${esc(text.priceHint)}</small></div>
                    ${startHtml(it)}
                    <div class="col-12"><label class="form-check mb-0"><input class="form-check-input" type="checkbox" data-f="import"${it.import ? ' checked' : ''}>
                        <span class="form-check-label">${esc(p.type === 'hosting' ? text.import : text.setUp)}</span></label></div>
                </div></div>`;
        }).join('') : `<p class="text-secondary text-center mb-0">${esc(text.noProducts)}</p>`;

        $('cf-domains').innerHTML = state.domains.length ? state.domains.map((d, i) => {
            const s = split(d.name), t = s?.info;
            const link = state.products.findIndex((p) => p.key === d.linkedTo);
            const years = yearsFor(t);
            if (!years.includes(Number(d.years))) d.years = years[0];
            return `<div class="cf-order-item" data-key="${d.key}">
                <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                    <span class="badge bg-green-lt">${esc(text.domain)} ${i + 1}</span><strong class="flex-fill text-truncate">${esc(d.name.trim() || text.newDomain)}</strong>
                    <button type="button" class="btn btn-sm btn-ghost-danger" data-rm>${esc(text.remove)}</button>
                </div>
                <div class="row g-3 p-3">
                    <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn${d.action === 'register' ? ' btn-primary' : ''}" data-act="register" aria-pressed="${d.action === 'register'}">${esc(text.register)}</button>
                            <button type="button" class="btn${d.action === 'transfer' ? ' btn-primary' : ''}" data-act="transfer" aria-pressed="${d.action === 'transfer'}">${esc(text.transfer)}</button>
                            <button type="button" class="btn${d.action === 'existing' ? ' btn-primary' : ''}" data-act="existing" aria-pressed="${d.action === 'existing'}">${esc(text.existing)}</button>
                        </div>
                        ${link >= 0 ? `<small class="text-secondary">${esc(fill(text.linked, { n: link + 1, title: product(state.products[link].productId).title }))}</small>` : ''}
                        ${d.action === 'existing' ? `<small class="text-secondary">${esc(text.existingHint)}</small>` : ''}
                    </div>
                    <div class="col-md-6"><label class="form-label" for="n${d.key}">${esc(text.domain)}</label>
                        <input class="form-control${d.name.trim() && !s ? ' is-invalid' : ''}" type="text" id="n${d.key}" data-f="name" value="${esc(d.name)}" placeholder="example.com" autocomplete="off"${link >= 0 ? ' readonly' : ''}>
                        <div class="invalid-feedback">${esc(text.noTld)} ${esc(TLDS.map((x) => x.tld).join(', '))}</div></div>
                    ${d.action === 'transfer'
                        ? `<div class="col-md-6"><label class="form-label" for="e${d.key}">${esc(text.epp)}</label>
                            <input class="form-control font-monospace" type="text" id="e${d.key}" data-f="epp" value="${esc(d.epp)}" autocomplete="off"></div>`
                        : `<div class="col-md-6"><label class="form-label" for="y${d.key}">${esc(text.years)}</label>
                            <select class="form-select" id="y${d.key}" data-f="years">${years.map((y) => `<option value="${y}"${y == d.years ? ' selected' : ''}>${esc(fill(y === 1 ? text.year : text.yearsN, { n: y }))}</option>`).join('')}</select></div>`}
                    <div class="col-md-6"><label class="form-label" for="v${d.key}">${esc(text.priceOverride)}</label>
                        <input class="form-control" type="text" inputmode="decimal" id="v${d.key}" data-f="price" value="${esc(d.price)}">
                        <small class="form-hint">${esc(text.priceHint)}</small></div>
                    ${startHtml(d)}
                    ${fieldsHtml(d, t)}
                </div></div>`;
        }).join('') : `<p class="text-secondary text-center mb-0">${esc(text.noDomains)}</p>`;
        schedule();
    }

    function domainConfig(d) {
        const s = split(d.name) || { sld: d.name.trim(), tld: '' };
        // An existing domain is ordered as a registration the server records without the registrar (import).
        return d.action === 'transfer'
            ? { action: 'transfer', transfer_sld: s.sld, transfer_tld: s.tld, transfer_code: d.epp, transfer_fields: d.fields, _start_date: d.start }
            : { action: 'register', register_sld: s.sld, register_tld: s.tld, register_years: d.years, domain_fields: d.fields, _start_date: d.start, import: d.action === 'existing' ? 1 : 0 };
    }

    function payload() {
        const items = state.products.map((it) => {
            const p = product(it.productId);
            const item = { product_id: p.id, period: it.period || null, quantity: Math.max(1, parseInt(it.qty, 10) || 1), price: it.price.trim(), config: { _start_date: it.start, import: it.import ? 1 : 0 } };
            if (p.type === 'hosting') {
                const linked = state.domains.find((d) => d.linkedTo === it.key);
                const name = it.domain.trim(), dot = name.indexOf('.');
                item.config.domain = linked ? domainConfig(linked)
                    : { action: 'owndomain', owndomain_sld: dot > 0 ? name.slice(0, dot) : name, owndomain_tld: dot > 0 ? name.slice(dot) : '' };
                if (linked) item.domain_price = linked.price.trim();
                Object.assign(item.config, { username: it.username.trim(), password: it.password });
            }
            return item;
        });
        state.domains.filter((d) => !state.products.some((p) => p.key === d.linkedTo))
            .forEach((d) => items.push({ config: domainConfig(d), price: d.price.trim() }));
        return { client_id: form.elements.client_id.value, items, promocode: $('promocode').value.trim(), gateway_id: form.elements.gateway_id?.value || '' };
    }

    function showQuote(q) {
        currency = q.currency;
        $('cf-quote-error').hidden = true;
        const paid = $('mark_invoice_paid')?.checked;
        if ($('cf-credit-wrap')) {
            $('cf-credit-wrap').hidden = !(q.credit > 0) || !$('invoice').checked || paid;
            $('cf-credit-label').textContent = fill(text.creditLabel, { amount: money(q.credit) });
        }
        const credit = $('use_credit')?.checked && !$('cf-credit-wrap').hidden ? Math.min(q.credit, q.total) : 0;
        // The invoice gets the payment method's fee on what the credit leaves; none without an invoice.
        const fee = !$('invoice').checked ? 0 : (credit ? q.fee_with_credit : q.fee);
        $('cf-lines').innerHTML = q.items.map((l) => `<li><span class="fw-medium">${esc(l.title)}${l.quantity > 1 ? ' × ' + esc(l.quantity) : ''}</span>
            <span class="cf-order-amount">${esc(money(l.total + l.setup_price))}</span>
            <small class="text-secondary">${[l.period ? PERIODS[l.period] || l.period : '', l.setup_price ? text.setup + ' ' + money(l.setup_price) : '', l.discount ? '−' + money(l.discount) : ''].filter(Boolean).map(esc).join(' · ')}</small></li>`).join('');
        const row = (label, value, cls = '') => `<dt class="fw-normal text-secondary">${esc(label)}</dt><dd class="cf-order-amount ${cls}">${esc(value)}</dd>`;
        $('cf-totals').innerHTML = [
            row(text.subtotal, money(q.subtotal)),
            q.discount ? row(fill(text.discount, { code: q.promocode || '' }), '−' + money(q.discount), 'text-success') : '',
            q.tax ? row(q.tax_included ? fill(text.taxIncluded, { tax: q.tax_name || text.tax }) : (q.tax_name || text.tax), money(q.tax)) : '',
            fee ? row(q.fee_title, money(fee)) : '',
            credit ? row(text.credit, '−' + money(credit), 'text-success') : '',
        ].join('');
        $('cf-total').textContent = money(q.total + fee - credit);
    }

    function quote() {
        const data = payload();
        if (!data.client_id || !data.items.length) {
            seq++;
            $('cf-quote-error').hidden = true;
            $('cf-lines').innerHTML = `<li><small class="text-secondary">${esc(data.client_id ? text.noLines : text.noClient)}</small></li>`;
            $('cf-totals').innerHTML = '';
            $('cf-total').textContent = '–';
            return;
        }
        const mine = ++seq;
        ClientFence.api.admin.post('order/quote', data, (q) => { if (mine === seq) showQuote(q); }, (e) => {
            if (mine !== seq) return;
            $('cf-quote-error').textContent = e?.message || String(e);
            $('cf-quote-error').hidden = false;
            $('cf-total').textContent = '–';
        }, false);
    }
    // Typing waits a moment before a new quote; an answer to an older request is ignored.
    function schedule() { clearTimeout(timer); timer = setTimeout(quote, 350); }

    function syncOptions() {
        const invoice = $('invoice').checked;
        $('send_email').disabled = !invoice;
        if ($('mark_invoice_paid')) {
            $('mark_invoice_paid').disabled = !invoice;
            if (!invoice) $('mark_invoice_paid').checked = false;
            $('cf-paid-fields').hidden = !$('mark_invoice_paid').checked;
        }
        schedule();
    }

    form.addEventListener('input', (e) => {
        const card = e.target.closest('.cf-order-item');
        if (!card) return;
        const key = Number(card.dataset.key);
        const it = state.products.find((x) => x.key === key) || state.domains.find((x) => x.key === key);
        if (e.target.dataset.field) { it.fields[e.target.dataset.field] = e.target.value; schedule(); return; }
        const f = e.target.dataset.f;
        if (!f) return;
        it[f] = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
        if (f === 'productId') {
            const p = product(it.productId);
            if (!p.periods.some((c) => c.code === it.period)) it.period = p.periods[0]?.code || '';
            if (p.type !== 'hosting') state.domains.forEach((d) => { if (d.linkedTo === key) d.linkedTo = null; });
        }
        if (f === 'domain') state.domains.forEach((d) => { if (d.linkedTo === key) d.name = it.domain; });
        // Selects and domain names change the cards; other typing only needs a new quote and keeps the focus.
        if (e.target.tagName === 'SELECT' || f === 'domain' || f === 'name') {
            const id = e.target.id, pos = e.target.selectionStart;
            render();
            const el = $(id);
            if (el) { el.focus(); if (pos != null && el.setSelectionRange) el.setSelectionRange(pos, pos); }
        } else {
            schedule();
        }
    });

    form.addEventListener('click', (e) => {
        const b = e.target.closest('button');
        const card = b?.closest('.cf-order-item');
        if (!card) return;
        const key = Number(card.dataset.key);
        if (b.hasAttribute('data-rm')) {
            state.products = state.products.filter((x) => x.key !== key);
            state.domains = state.domains.filter((x) => x.key !== key);
            state.domains.forEach((d) => { if (d.linkedTo === key) d.linkedTo = null; });
            render();
        } else if (b.dataset.act) {
            state.domains.find((x) => x.key === key).action = b.dataset.act;
            render();
        } else if (b.dataset.link) {
            addDomain({ action: b.dataset.link, name: state.products.find((x) => x.key === key).domain.trim(), linkedTo: key });
        }
    });

    $('cf-add-product').addEventListener('click', () => addProduct(PRODUCTS[0]?.id));
    $('cf-add-domain').addEventListener('click', () => addDomain());
    ['client_id', 'gateway_id', 'promocode'].forEach((id) => $(id)?.addEventListener('change', schedule));
    ['invoice', 'mark_invoice_paid'].forEach((id) => $(id)?.addEventListener('change', syncOptions));
    $('use_credit')?.addEventListener('change', schedule);

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = Object.assign(payload(), {
            activate: $('activate').value,
            invoice: $('invoice').checked ? 1 : 0,
            send_email: $('send_email').checked ? 1 : 0,
            use_credit: $('use_credit') && !$('use_credit').checked ? 0 : 1,
            mark_invoice_paid: $('mark_invoice_paid')?.checked ? 1 : 0,
            transactionId: $('transaction-id')?.value || '',
        });
        $('cf-submit').disabled = true;
        ClientFence.api.admin.post('order/create_many', data, (r) => {
            window.location = r.order_ids.length === 1 ? "{{ 'order/manage'|url }}/" + r.order_ids[0] : "{{ 'client/manage'|url }}/" + data.client_id + '#tab-orders';
        }, (err) => {
            $('cf-submit').disabled = false;
            ClientFence.message(err?.message || String(err), 'error');
        });
    });

    if (PRODUCTS.length) addProduct(PRODUCTS[0].id); else render();
    syncOptions();
})();
</script>
{% endblock %}
