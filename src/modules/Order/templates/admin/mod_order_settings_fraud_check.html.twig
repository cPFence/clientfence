{# ClientFence: the Fraud check tab of the Orders settings page (Order/FraudCheck.php, CF-116). Its own form, saved
   in config.php by clientfence/fraud_check_save; Super Administrators only (it holds the service's key). "Test the
   connection" checks the typed details with one sample call and saves nothing. #}
{# ClientFence core patch: the tab is a glass card under a ruled heading with the service as an on or off chip, the Save row stays in view (CF-135 redesign). #}
<div class="tab-pane fade" id="tab-fraud-check" role="tabpanel">
{% if not (guest.extension_is_on({ 'mod': 'clientfence' }) and admin.clientfence_backup_access) %}
    <div class="card">
        <div class="card-body">
            <p class="text-secondary mb-0">{{ 'Only Super Administrators can change the fraud check.'|trans }}</p>
        </div>
    </div>
{% else %}
    {% set fraud = admin.clientfence_fraud_check_get %}
    <form class="card" method="post" action="{{ 'clientfence/fraud_check_save'|api_url }}" {{ fb_api_form({ callback: 'clientfenceFraudCheckSaved' }) }}
          data-cf-fraud-check data-saved-text="{{ 'Saved.'|trans }}">
        <div class="card-body">
            <h4 class="card-title">
                {{ 'Fraud check on new orders'|trans }}
                <span class="bf-chip{{ fraud.provider == 'off' ? '' : ' bf-tone-ok' }}">{{ fraud.provider == 'off' ? 'Off'|trans : 'On'|trans }}</span>
            </h4>
            <p class="text-secondary">{{ 'Each order a client places in the client area is scored by the service before it is made (staff orders are not checked). An order scoring above the limit waits under Orders > Waiting for review: its invoice cannot be paid until you approve it. The client\'s email is sent hashed with its domain; card details are never sent. If the service cannot be reached or has no credit left, the order goes through and you get a notification.'|trans }}</p>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label" for="cf-fraud-provider">{{ 'Fraud check service'|trans }}</label>
                    <select class="form-select" id="cf-fraud-provider" name="provider" data-cf-chat-type>
                        <option value="off"{% if fraud.provider == 'off' %} selected{% endif %}>{{ 'Off'|trans }}</option>
                        <option value="maxmind"{% if fraud.provider == 'maxmind' %} selected{% endif %}>MaxMind minFraud Score</option>
                        <option value="fraudlabs"{% if fraud.provider == 'fraudlabs' %} selected{% endif %}>FraudLabs Pro</option>
                    </select>
                </div>
                <div class="col-lg-6">
                    <label class="form-label" for="cf-fraud-limit">{{ 'Hold orders scoring above'|trans }}</label>
                    <input class="form-control" type="number" id="cf-fraud-limit" name="limit" min="0.01" max="99.99" step="0.01" value="{{ fraud.limit }}" required>
                    <div class="form-text">{{ 'From 0 to 100; 20 is the usual limit. The service\'s own rules that say review or reject also hold the order.'|trans }}</div>
                </div>
                <div class="col-lg-6" data-cf-chat-for="maxmind">
                    <label class="form-label" for="cf-fraud-account">{{ 'Account ID'|trans }}</label>
                    <input class="form-control" type="text" id="cf-fraud-account" name="account_id" value="{{ fraud.account_id }}" inputmode="numeric" autocomplete="off" dir="ltr">
                </div>
                <div class="col-lg-6" data-cf-chat-for="maxmind fraudlabs">
                    <label class="form-label" for="cf-fraud-key">{{ 'Licence key or API key'|trans }}</label>
                    <input class="form-control" type="password" id="cf-fraud-key" name="key" value="" autocomplete="new-password" dir="ltr" placeholder="{{ fraud.has_key ? 'Saved; leave empty to keep it'|trans : '' }}">
                    <div class="form-text">{{ 'Kept encrypted and never shown again.'|trans }}</div>
                </div>
            </div>
            <input type="hidden" name="skip_active" value="0">
            <label class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" name="skip_active" value="1"{% if fraud.skip_active %} checked{% endif %}>
                <span class="form-check-label">{{ 'Skip clients who already have an active order'|trans }}</span>
            </label>
            <small class="form-hint">{{ 'MaxMind charges each check; FraudLabs Pro has a free plan of 500 checks a month. A check is kept for an hour, so a second try of the same order is not charged again.'|trans }}</small>
        </div>
        <div class="card-footer cf-set-save">
            <button class="btn btn-outline-secondary" type="submit" name="do" value="test">{{ 'Test the connection'|trans }}</button>
            <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
        </div>
    </form>
{% endif %}
</div>
