<!DOCTYPE html>
{% set locale = guest.system_locale|default('en_US') %}
{# ClientFence core patch: embedded sign-in mirrors for Arabic, Hebrew and Persian. #}
<html lang="{{ locale|replace({'_': '-'}) }}" dir="{{ locale|lower|slice(0, 2) in ['ar', 'fa', 'he'] ? 'rtl' : 'ltr' }}" data-theme="{{ request.theme == 'dark' ? 'dark' : 'light' }}">
<head>
    <title>{{ 'Sign in'|trans }}</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    {{ include('partial_embed_styles.html.twig') }}
</head>

<body>
{# ClientFence core patch (ext embed): the password, CAPTCHA and two-factor code are entered on the sign-in page in the top window; a framed sign-in cannot keep its SameSite=Strict session cookie. #}
<form action="{{ 'login'|url }}" method="get" target="_top" class="embed-shell embed-stack">
    <h1 class="embed-title">{{ 'Login to Client Area'|trans }}</h1>
    <div class="embed-field">
        <label class="embed-sr-only" for="embed-login-email">{{ 'Email'|trans }}</label>
        <input id="embed-login-email" class="embed-input" type="email" name="email" value="" required="required" autocomplete="username" placeholder="{{ 'Your email'|trans }}">
    </div>
    <button class="embed-button" type="submit">{{ 'Sign in'|trans }}</button>
</form>
</body>
</html>
