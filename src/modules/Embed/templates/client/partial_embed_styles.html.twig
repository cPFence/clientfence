{# ClientFence core patch (forum #179): the embeds take the client area's brand (Palisade's colours, Geist, its controls), and an admin-chosen brand colour through Branding's stylesheet, loaded after these defaults. #}
<style type="text/css">
    @font-face { font-family: "Geist"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'build/fonts/geist-400.woff2'|asset_url }}") format("woff2"); }
    @font-face { font-family: "Geist"; font-style: normal; font-weight: 600; font-display: swap; src: url("{{ 'build/fonts/geist-600.woff2'|asset_url }}") format("woff2"); }

    :root {
        color-scheme: light;
        --pal-brand: #0e5a7a;
        --pal-brand-rgb: 14, 90, 122;
        --pal-accent: #14a39a;
        --embed-bg: #ffffff;
        --embed-border: #e3e8f0;
        --embed-border-strong: #d5dce7;
        --embed-text: #1b2433;
        --embed-muted: #5b6779;
        --embed-primary: var(--pal-brand);
        --embed-primary-text: var(--tblr-primary-fg, #ffffff);
        --embed-link: var(--pal-brand);
        --embed-focus: rgba(var(--pal-brand-rgb), 0.25);
        --embed-radius: 14px;
        --embed-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
        --embed-font: "Geist", "IBM Plex Sans Arabic", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        --embed-input-bg: #ffffff;
        --embed-glow-at: 100% 0;
    }

    :root[dir="rtl"] {
        --embed-glow-at: 0 0;
    }

    :root[data-theme="dark"] {
        color-scheme: dark;
        --embed-bg: #0c2738;
        --embed-border: #1c3445;
        --embed-border-strong: #2a4a5e;
        --embed-text: #e6ebf3;
        --embed-muted: #9ca8ba;
        --embed-link: var(--pal-accent);
        --embed-shadow: none;
        --embed-input-bg: #10222f;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: transparent;
        color: var(--embed-text);
        font: 14px/1.4 var(--embed-font);
        accent-color: var(--embed-primary);
    }

    body {
        min-height: 100vh;
    }

    .embed-shell {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--embed-border);
        border-radius: var(--embed-radius);
        background: var(--embed-bg);
        box-shadow: var(--embed-shadow);
    }

    .embed-title {
        margin: 0 0 10px;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
    }

    .embed-stack {
        display: grid;
        gap: 10px;
    }

    .embed-field {
        display: grid;
        gap: 6px;
    }

    .embed-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .embed-label {
        display: block;
        margin: 0;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--embed-muted);
    }

    .embed-input,
    .embed-select,
    .embed-textarea,
    .embed-button {
        width: 100%;
        min-height: 36px;
        padding: 8px 10px;
        border: 1px solid var(--embed-border-strong);
        border-radius: 10px;
        background: var(--embed-input-bg);
        color: var(--embed-text);
        font: inherit;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }

    .embed-textarea {
        min-height: 96px;
        resize: vertical;
    }

    .embed-input:focus,
    .embed-select:focus,
    .embed-textarea:focus {
        outline: none;
        border-color: var(--pal-accent);
        box-shadow: 0 0 0 4px var(--embed-focus);
    }

    /* Palisade's primary button: a brand to accent gradient that lifts on hover. */
    .embed-button {
        border-color: transparent;
        background: var(--embed-primary);
        background: var(--embed-primary) linear-gradient(135deg, var(--embed-primary), color-mix(in srgb, var(--pal-accent) 80%, var(--embed-primary)));
        box-shadow: 0 6px 18px -8px var(--embed-primary);
        color: var(--embed-primary-text);
        font-weight: 600;
        cursor: pointer;
        transition: translate 0.2s ease, box-shadow 0.25s ease;
    }

    .embed-button:hover {
        translate: 0 -1px;
        box-shadow: 0 10px 26px -8px var(--pal-accent);
    }

    .embed-button:active {
        translate: none;
    }

    .embed-button:focus {
        outline: none;
    }

    .embed-button:focus-visible {
        box-shadow: 0 0 0 4px var(--embed-focus);
    }

    .embed-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .embed-inline-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 96px auto;
        gap: 8px;
        align-items: center;
    }

    .embed-inline-form .embed-button {
        width: auto;
        padding-right: 14px;
        padding-left: 14px;
        white-space: nowrap;
    }

    .embed-inline-form .embed-select {
        min-width: 0;
    }

    .embed-note {
        font-size: 12px;
        color: var(--embed-muted);
    }

    @media (max-width: 420px) {
        .embed-grid {
            grid-template-columns: 1fr;
        }
    }

    {# ClientFence core patch: the contact and sign-in embeds get a soft glow and a gradient button (CF-135 redesign). #}
    .embed-shell--contact,
    .embed-shell--login {
        background: radial-gradient(260px 150px at var(--embed-glow-at), var(--embed-focus), transparent 70%), var(--embed-bg);
        box-shadow: 0 18px 40px -28px var(--embed-primary);
    }

    @media (prefers-reduced-motion: reduce) {
        .embed-button {
            transition: none;
        }

        .embed-button:hover {
            translate: none;
        }
    }
</style>
{% set brand_css = guest.clientfence_brand.css_url|default(null) %}
{% if brand_css %}<link rel="stylesheet" href="{{ brand_css }}">{% endif %}
