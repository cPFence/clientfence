{# ClientFence core patch: a Simple license length of 20 gives 16 random characters. #}
{% import 'macro_functions.html.twig' as mf %}

{% set config = product.config|default({}) %}

<div class="card-body">
    <form method="post" action="{{ 'product/update_config'|api_url }}" {{ fb_api_form({message: 'License Settings Updated'|trans}) }}>
        <div class="mb-5">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'License Settings'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Configure how license keys are generated for this product and which validation rules should apply to issued licenses.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Prefix'|trans }}</label>
                    <input type="text" class="form-control" name="config[prefix]" value="{{ config.prefix|default('') }}">
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Length'|trans }}</label>
                    <input type="number" class="form-control" name="config[length]" min="20" max="255" value="{{ config.length|default('') }}">
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Plugin'|trans }}</label>
                    {{ mf.selectbox('config[plugin]', admin.servicelicense_plugin_get_pairs, config.plugin|default(''), 1) }}
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Validation Rules'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Choose which environment checks clients must satisfy when validating a license.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Validate IP'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="validateIPYes" type="radio" name="config[validate_ip]" value="1"{% if config.validate_ip|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="validateIPNo" type="radio" name="config[validate_ip]" value="0"{% if not config.validate_ip|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Validate Hostname'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="validateHostnameYes" type="radio" name="config[validate_host]" value="1"{% if config.validate_host|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="validateHostnameNo" type="radio" name="config[validate_host]" value="0"{% if not config.validate_host|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Validate Version'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="validateVersionYes" type="radio" name="config[validate_version]" value="1"{% if config.validate_version|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="validateVersionNo" type="radio" name="config[validate_version]" value="0"{% if not config.validate_version|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Validate Path'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" id="validatePathYes" type="radio" name="config[validate_path]" value="1"{% if config.validate_path|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" id="validatePathNo" type="radio" name="config[validate_path]" value="0"{% if not config.validate_path|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        {# ClientFence core patch: WHMCS Licensing Addon checks (WhmcsCheck.php). #}
        <div class="mb-4">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'WHMCS Licensing Addon Checks'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'For software sold with WHMCS: answer its checks at /modules/servers/licensing/verify.php in the WHMCS format.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">{{ 'Answer WHMCS checks'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[whmcs_check]" value="1"{% if config.whmcs_check|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[whmcs_check]" value="0"{% if not config.whmcs_check|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="form-text">{{ 'The answer follows the order: Active while it is active, Suspended or Expired once suspended or canceled. IP addresses follow the rules on this page; the domain and folder are checked only when the software sends them.'|trans }}</div>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        {# ClientFence core patch: per-unit billing of licences (Units.php). #}
        <div class="mb-4">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Price per Unit'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'For software that reports a count (for example websites): with per-unit billing on for a licence, its price becomes the count times the unit price a month, at least the minimum, from each report.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label" for="cf-unit-name">{{ 'Unit name'|trans }}</label>
                    <input type="text" class="form-control" id="cf-unit-name" name="config[unit_name]" maxlength="40" value="{{ config.unit_name|default('') }}">
                </div>
                <div class="col-lg-4">
                    <label class="form-label" for="cf-unit-price">{{ 'Price per unit a month'|trans }}</label>
                    <input type="number" class="form-control" id="cf-unit-price" name="config[unit_price]" min="0" step="0.0001" value="{{ config.unit_price|default('') }}">
                    <div class="form-text">{{ 'In the default currency. Empty: no per-unit billing.'|trans }}</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label" for="cf-unit-min">{{ 'Minimum a month'|trans }}</label>
                    <input type="number" class="form-control" id="cf-unit-min" name="config[unit_minimum]" min="0" step="0.01" value="{{ config.unit_minimum|default('') }}">
                </div>
                <div class="col-lg-6">
                    <label class="form-label" for="cf-unit-field">{{ 'Answer field for the per-unit switch'|trans }}</label>
                    <input type="text" class="form-control" id="cf-unit-field" name="config[unit_field]" maxlength="100" value="{{ config.unit_field|default('') }}">
                    <div class="form-text">{{ 'Optional, for WHMCS checks: sent in customfields as "name=on" while per-unit billing is on.'|trans }}</div>
                </div>
                <div class="col-lg-6">
                    <label class="form-label" for="cf-unit-count-field">{{ 'Answer field for the count'|trans }}</label>
                    <input type="text" class="form-control" id="cf-unit-count-field" name="config[unit_count_field]" maxlength="100" value="{{ config.unit_count_field|default('') }}">
                    <div class="form-text">{{ 'Optional, for WHMCS checks: sent in customfields as "name=count".'|trans }}</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Hold big drops'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_hold]" value="1"{% if config.unit_hold|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_hold]" value="0"{% if not config.unit_hold|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="input-group mt-2">
                        <span class="input-group-text">{{ 'More than'|trans }}</span>
                        <input type="number" class="form-control" name="config[unit_hold_percent]" min="1" max="99" value="{{ config.unit_hold_percent|default(50) }}" aria-label="{{ 'Drop in percent'|trans }}">
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">{{ 'A report that lowers the count by more than this waits for staff approval; rises apply at once.'|trans }}</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Warn when reports stop'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_warn]" value="1"{% if config.unit_warn|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_warn]" value="0"{% if not config.unit_warn|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="input-group mt-2">
                        <span class="input-group-text">{{ 'After'|trans }}</span>
                        <input type="number" class="form-control" name="config[unit_warn_days]" min="1" max="365" value="{{ config.unit_warn_days|default(2) }}" aria-label="{{ 'Days'|trans }}">
                        <span class="input-group-text">{{ 'days'|trans }}</span>
                    </div>
                    <div class="form-text">{{ 'The client gets an email and staff a notice, once per gap.'|trans }}</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">{{ 'Suspend when reports stop'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_suspend]" value="1"{% if config.unit_suspend|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[unit_suspend]" value="0"{% if not config.unit_suspend|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="input-group mt-2">
                        <span class="input-group-text">{{ 'After'|trans }}</span>
                        <input type="number" class="form-control" name="config[unit_suspend_days]" min="1" max="365" value="{{ config.unit_suspend_days|default(7) }}" aria-label="{{ 'Days'|trans }}">
                        <span class="input-group-text">{{ 'days'|trans }}</span>
                    </div>
                    <div class="form-text">{{ 'The order is suspended. A suspended licence cannot report, so staff unsuspend it; the time starts again then.'|trans }}</div>
                </div>
            </div>
            {% if config.unit_field|default('') or config.unit_count_field|default('') %}
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <a class="btn btn-outline-secondary" {{ fb_api_link({href: 'servicelicense/units_from_answers'|api_url(query: {product_id: product.id}), modal: {type: 'confirm', title: 'Take the switch and counts from imported answers?'|trans, content: 'For licences of this product that have no per-unit switch yet: the order form answers under the two field names above set it and the count. Prices stay as imported.'|trans}, reload: true}) }}>{{ 'Take from imported answers'|trans }}</a>
                <span class="form-text m-0">{{ 'After a WHMCS import, where these were custom fields of the service.'|trans }}</span>
            </div>
            {% endif %}
        </div>

        <hr class="my-4" />

        {# ClientFence core patch: client IP self-service limits of licences (IpSeats, CF-56). #}
        <div class="mb-4">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Client IP Addresses'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Let clients add and remove the IP addresses of their licence within these limits.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-3">
                    <label class="form-label" for="cf-ip-seats">{{ 'Servers (IP addresses)'|trans }}</label>
                    <input type="number" class="form-control" id="cf-ip-seats" name="config[ip_seats]" min="0" value="{{ config.ip_seats|default('') }}">
                    <div class="form-text">{{ 'Empty: no limit. With a limit, the IP address is always checked, whatever Validate IP says.'|trans }}</div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label" for="cf-ip-changes">{{ 'IP changes per 30 days'|trans }}</label>
                    <input type="number" class="form-control" id="cf-ip-changes" name="config[ip_changes]" min="0" value="{{ config.ip_changes ?? '' }}">
                    <div class="form-text">{{ 'Removing an IP address or a reset. Empty: no limit. 0: only staff.'|trans }}</div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Bind on first check'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[ip_bind]" value="1"{% if config.ip_bind ?? 1 %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[ip_bind]" value="0"{% if not (config.ip_bind ?? 1) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="form-text">{{ 'A check from a new IP address takes a free place by itself.'|trans }}</div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label">{{ 'Changes need staff approval'|trans }}</label>
                    <div class="d-flex flex-wrap gap-3 pt-1">
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[ip_approval]" value="1"{% if config.ip_approval|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="config[ip_approval]" value="0"{% if not config.ip_approval|default(false) %} checked{% endif %}>
                            <span class="form-check-label">{{ 'No'|trans }}</span>
                        </label>
                    </div>
                    <div class="form-text">{{ 'Client changes wait until staff approve them.'|trans }}</div>
                </div>
            </div>
        </div>

        <input type="hidden" name="id" value="{{ product.id }}">
        <div class="d-flex justify-content-end">
            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
        </div>
    </form>

    <hr class="my-4" />

    <div>
        <h3 class="card-title mb-2">{{ 'License Plugins'|trans }}</h3>
        <p>{{ 'You can create your own license generation plugins for ClientFence. Follow these steps to add a new one:'|trans }}</p>
        <ul>
            <li>{{ 'A license plugin is a PHP class named'|trans }} <strong>License_PluginName</strong> {{ 'that must include a'|trans }} <code>generate</code> {{ 'method.'|trans }}</li>
            <li>{{ 'See the default example plugin at'|trans }} <strong>/modules/Servicelicense/Plugin/Simple.php</strong></li>
            <li>{{ 'Save your custom plugin in'|trans }} <strong>/modules/Servicelicense/Plugin/PluginName.php</strong></li>
            <li>{{ 'ClientFence will automatically detect your new plugin.'|trans }}</li>
        </ul>
    </div>
</div>
