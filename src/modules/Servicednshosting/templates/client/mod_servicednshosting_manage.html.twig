{% macro fields(record, prefix) %}
    <div class="col-12">
        <label class="form-label" for="{{ prefix }}-value">{{ 'Value'|trans }}</label>
        <input class="form-control" id="{{ prefix }}-value" name="record_value" dir="ltr" value="{{ record.value|default('') }}" spellcheck="false">
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="{{ prefix }}-ttl">{{ 'TTL (seconds)'|trans }}</label>
        <input class="form-control" id="{{ prefix }}-ttl" name="record_ttl" type="number" min="0" max="2147483647" dir="ltr" value="{{ record.ttl ?? 3600 }}" required>
    </div>
    {% if not record.type|default('') or record.type == 'MX' %}
        <div class="col-sm-6">
            <label class="form-label" for="{{ prefix }}-priority">{{ 'MX priority'|trans }}</label>
            <input class="form-control" id="{{ prefix }}-priority" name="record_priority" type="number" min="0" max="65535" dir="ltr" value="{{ record.priority|default(0) }}">
        </div>
    {% endif %}
{% endmacro %}

{% if order.status == 'active' %}
{% set zone = client.servicednshosting_zone({order_id: order.id}) %}
{% set can_manage_dns = not clientfence_user or clientfence_user.owner or 'manageproducts' in clientfence_user.permissions %}
<div class="card mb-4">
    <div class="card-header"><h2 class="h4 mb-0">{{ 'DNS records'|trans }}</h2></div>
    <div class="card-body">
        {% if zone.error|default('') %}
            <div class="alert alert-warning mb-0" role="alert">{{ zone.error }}</div>
        {% else %}
            <p class="fw-semibold text-break"><bdi dir="ltr">{{ zone.domain_name }}</bdi></p>
            {% if zone.nameservers %}
                <h3 class="h6">{{ 'Nameservers'|trans }}</h3>
                <p class="text-secondary">{{ 'Set these nameservers at your domain registrar.'|trans }}</p>
                <ul class="text-break">
                    {% for server in zone.nameservers %}<li><bdi dir="ltr">{{ server }}</bdi></li>{% endfor %}
                </ul>
            {% endif %}

            {% if can_manage_dns %}
                <details class="border rounded p-3 mb-3">
                    <summary class="fw-semibold">{{ 'Add DNS record'|trans }}</summary>
                    <form class="row g-3 mt-1" action="{{ 'servicednshosting/add'|api_url }}" {{ fb_api_form({reload: true}) }}>
                        <input type="hidden" name="order_id" value="{{ order.id }}">
                        <div class="col-sm-6">
                            <label class="form-label" for="dns-record-name">{{ 'Name'|trans }}</label>
                            <input class="form-control" id="dns-record-name" name="record_name" dir="ltr" placeholder="www" spellcheck="false">
                            <div class="form-text">{{ 'Use @ for the zone apex.'|trans }}</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="dns-record-type">{{ 'Type'|trans }}</label>
                            <select class="form-select" id="dns-record-type" name="record_type" required>
                                {% for type in zone.types %}<option value="{{ type }}">{{ type }}</option>{% endfor %}
                            </select>
                        </div>
                        {{ _self.fields({}, 'dns-add') }}
                        <div class="col-12"><button class="btn btn-primary" type="submit">{{ 'Add record'|trans }}</button></div>
                    </form>
                </details>
            {% endif %}

            <ul class="list-group mb-0">
                {% for record in zone.records %}
                    <li class="list-group-item text-break">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <strong><bdi dir="ltr">{{ record.name ?: '@' }}</bdi></strong>
                            <span class="badge text-bg-secondary">{{ record.type }}</span>
                            <span class="small text-secondary">{{ 'TTL'|trans }} <bdi>{{ record.ttl }}</bdi></span>
                        </div>
                        <div><bdi dir="ltr">{% if record.priority is not null %}{{ record.priority }} {% endif %}{{ record.value }}</bdi></div>
                        {% if can_manage_dns and record.type in zone.types and (record.type != 'DS' or record.name != '') %}
                            <details class="mt-2">
                                <summary>{{ 'Edit or delete record'|trans }}</summary>
                                <form class="row g-3 mt-1 mb-2" action="{{ 'servicednshosting/update'|api_url }}" {{ fb_api_form({reload: true}) }}>
                                    <input type="hidden" name="order_id" value="{{ order.id }}">
                                    <input type="hidden" name="record_id" value="{{ record.id }}">
                                    {{ _self.fields(record, 'dns-edit-' ~ loop.index) }}
                                    <div class="col-12"><button type="submit" class="btn btn-primary btn-sm">{{ 'Save record'|trans }}</button></div>
                                </form>
                                <form action="{{ 'servicednshosting/del'|api_url }}" {{ fb_api_form({reload: true}) }}>
                                    <input type="hidden" name="order_id" value="{{ order.id }}">
                                    <input type="hidden" name="record_id" value="{{ record.id }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'Delete record'|trans }}</button>
                                </form>
                            </details>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="list-group-item">{{ 'No DNS records found.'|trans }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>

{% if not zone.error|default('') %}
    {% set dnssec = client.servicednshosting_dnssec({order_id: order.id}) %}
    {% if dnssec.supported|default(false) or dnssec.error|default('') %}
        <div class="card mb-4">
            <div class="card-header"><h2 class="h4 mb-0">{{ 'DNSSEC'|trans }}</h2></div>
            <div class="card-body">
                {% if dnssec.error|default('') %}
                    <div class="alert alert-warning mb-0" role="alert">{{ dnssec.error }}</div>
                {% else %}
                    <p>{{ dnssec.enabled ? 'DNSSEC is enabled.'|trans : 'DNSSEC is disabled.'|trans }}</p>
                    {% if dnssec.ds %}
                        <p>{{ 'Publish these DS records at your domain registrar.'|trans }}</p>
                        <ul class="text-break">{% for ds in dnssec.ds %}<li><bdi dir="ltr">{{ ds }}</bdi></li>{% endfor %}</ul>
                    {% endif %}
                    {% if can_manage_dns and dnssec.can_toggle %}
                        {% if dnssec.enabled %}<p>{{ 'Remove the DS records at your domain registrar before you disable DNSSEC, or the domain stops resolving.'|trans }}</p>{% endif %}
                        <form action="{{ (dnssec.enabled ? 'servicednshosting/dnssec_disable' : 'servicednshosting/dnssec_enable')|api_url }}" {{ fb_api_form({reload: true}) }}>
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <button type="submit" class="btn btn-outline-primary">{{ dnssec.enabled ? 'Disable DNSSEC'|trans : 'Enable DNSSEC'|trans }}</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
{% endif %}
