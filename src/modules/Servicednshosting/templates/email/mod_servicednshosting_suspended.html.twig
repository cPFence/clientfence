{% block subject %}[{{ guest.system_company.name }}] {{ ':title has been suspended'|trans({':title': order.title|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'DNS hosting suspended'|trans }}{% endset %}
{% set email_preheader %}{{ 'Record management for :domain is suspended. The zone continues to resolve.'|trans({':domain': order.config.domain_name|default('')}) }}{% endset %}
<h1>{{ 'DNS hosting suspended'|trans }}</h1>
<p>{{ 'Dear :first_name :last_name,'|trans({':first_name': c.first_name|default(''), ':last_name': c.last_name|default('')}) }}</p>
<p>{{ 'Record management for :domain is suspended. The zone continues to resolve.'|trans({':domain': order.config.domain_name|default('')}) }}</p>
<p><a href="{{ ('order/service/manage/' ~ order.id)|url(area: 'client') }}">{{ 'View your DNS service'|trans }}</a></p>
<p>{{ guest.system_email.signature }}</p>
{% endblock %}
