{# The DNS zone on the order's Service Management tab, as the domain and hosting tabs: the zone, its status and
   nameservers first, then the records (read-only for staff; NS, SOA and other provider records quieter). #}
{% import 'macro_functions.html.twig' as mf %}
{% set can_view = has_permission('servicednshosting', 'view') %}
{% set zone = can_view and order.status in ['active', 'suspended'] ? admin.servicednshosting_zone({ order_id: order.id }) : null %}
<div class="card-body">
    <div class="card mb-4">
        <div class="cf-inv cf-dom">
            <div class="cf-inv-hero">
                <div class="min-w-0">
                    <div class="cf-client-name"><bdi dir="ltr">{{ service.domain_name }}</bdi></div>
                    <div class="text-secondary">{{ 'DNS zone'|trans }}</div>
                </div>
                <div class="cf-inv-chips">
                    {{ mf.status_badge(order.status, 'order') }}
                    {% if zone and not zone.error|default('') %}<span class="badge bg-azure-lt">{{ 'DNS records'|trans }} · <bdi>{{ zone.records|length }}</bdi></span>{% endif %}
                </div>
            </div>
            {% if zone and not zone.error|default('') and zone.nameservers %}
                <dl class="cf-facts">
                    {% for server in zone.nameservers %}
                        <div><dt>{{ 'Nameserver :number'|trans({':number': loop.index}) }}</dt><dd><bdi dir="ltr" class="font-monospace">{{ server }}</bdi></dd></div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>
    </div>

    {% if not can_view %}
        <div class="alert alert-info mb-0" role="alert">{{ 'Your staff role cannot view DNS records.'|trans }}</div>
    {% elseif zone is null %}
        <div class="alert alert-info mb-0" role="alert">{{ 'The DNS records show here while the order is active or suspended.'|trans }}</div>
    {% elseif zone.error|default('') %}
        <div class="alert alert-warning mb-0" role="alert">{{ zone.error }}</div>
    {% else %}
        <div class="mb-3 cf-section-head border-0 pt-0">
            <h3 class="card-title mb-1">{{ 'DNS records'|trans }}</h3>
            <p class="text-secondary mb-0">{{ 'The client manages these records in the client area.'|trans }}</p>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Name'|trans }}</th>
                            <th scope="col">{{ 'Type'|trans }}</th>
                            <th scope="col">{{ 'Value'|trans }}</th>
                            <th scope="col">{{ 'TTL'|trans }}</th>
                            <th scope="col">{{ 'Priority'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for record in zone.records %}
                            {% set client_record = record.type in zone.types and (record.type != 'DS' or record.name != '') %}
                            <tr{% if not client_record %} class="text-secondary"{% endif %}>
                                <td class="text-nowrap{% if client_record %} fw-medium{% endif %}"><bdi dir="ltr">{{ record.name|length ? record.name : '@' }}</bdi></td>
                                <td><span class="badge font-monospace {{ client_record ? 'bg-azure-lt' : 'bg-secondary-lt' }}">{{ record.type }}</span></td>
                                <td class="w-100 cf-dns-value"><bdi dir="ltr" class="d-block font-monospace small text-break">{{ record.value }}</bdi></td>
                                <td><bdi>{{ record.ttl }}</bdi></td>
                                <td>{% if record.priority is not null %}<bdi>{{ record.priority }}</bdi>{% else %}<span class="text-secondary">-</span>{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center text-secondary py-4">{{ 'No DNS records found.'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
