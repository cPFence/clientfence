{
  "id": "servicednshosting",
  "type": "mod",
  "name": "DNS hosting",
  "description": "ClientFence core module",
  "version": "1.0.0",
  "migrations": "ClientFence\\Mod\\Servicednshosting\\Migrations",
  "service": {
    "lifecycle": "built-in",
    "entity": "ClientFence\\Mod\\Servicednshosting\\Entity\\ServiceDns",
    "single_unit": true,
    "order_config": false,
    "client_calls": {
      "zone": "products",
      "dnssec": "products",
      "add": "manageproducts",
      "update": "manageproducts",
      "del": "manageproducts",
      "dnssec_enable": "manageproducts",
      "dnssec_disable": "manageproducts"
    }
  }
}
