{# ClientFence, two-factor sign-in settings of the signed-in login (/two-factor, TwoFactor.php):
   the owner's own, or an authorized user's own (for every account the user has). Off: set up
   with an authenticator app (QR code or the key), confirmed with a code and the password; the
   backup code is shown once. On: a new backup code, or switch off with the password and a code.
   The setup and the backup code run in assets/src/js/twofactor.js. twofactor comes from
   client_twofactor_status (required: the portal requires it and it is not set up yet).
   Passkeys (Passkeys.php, while on for clients, or while the login still has some): list, rename, remove with
   the password, and add (assets/src/js/passkeys.js) with the password. #}
{% extends "layout_default.html.twig" %}
{% set active_menu = 'twofactor' %}

{% block meta_title %}{{ 'Two-factor sign-in'|trans }}{% endblock %}
{% block page_header %}{{ 'Two-factor sign-in'|trans }}{% endblock %}
{% block body_class %}clientfence-twofactor{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Two-factor sign-in'|trans }}</li>{% endblock %}

{% block content %}
{# ClientFence core patch: the shared page head, the backup code lit in the accent, passkeys as rows with a key tile (CF-135 redesign). #}
<div class="bf-page-head mb-4">
    <div>
        <h1 class="bf-page-title">{{ 'Two-factor sign-in'|trans }}</h1>
        <p class="bf-hint mb-0">{{ 'After your password, sign-in also asks for a code from an authenticator app on your phone (Google Authenticator, Microsoft Authenticator, 1Password and others).'|trans }}</p>
    </div>
</div>

{% if twofactor.required %}
    <div class="alert alert-warning" role="alert">{{ 'Your provider requires two-factor sign-in. Set it up to go on.'|trans }}</div>
{% endif %}
{% if twofactor.needs_password and not twofactor.enabled %}
    <div class="alert alert-info" role="status">{{ 'You sign in with Google only: choose a password first, then set up two-factor sign-in here.'|trans }}
        <a class="alert-link" href="{{ 'google-sign-in'|url }}">{{ 'Choose a password'|trans }}</a></div>
{% endif %}

<div data-clientfence-twofactor>
    <div class="card mb-4 cf-acct-lit" data-clientfence-twofactor-backup hidden>
        <div class="card-header"><h2>{{ 'Your backup code'|trans }}</h2></div>
        <div class="card-body">
            <p>{{ 'Keep this code somewhere safe, away from your phone. If you lose your phone, it signs you in once instead of a code. It is shown only now.'|trans }}</p>
            <p class="cf-acct-code" dir="ltr" data-clientfence-twofactor-backup-code></p>
            <a class="btn btn-primary" href="{{ 'two-factor'|url }}">{{ 'Done'|trans }}</a>
        </div>
    </div>

    {% if twofactor.enabled %}
        <div class="row g-4" data-clientfence-twofactor-on>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><h2>{{ 'Backup code'|trans }}</h2></div>
                    <div class="card-body">
                        <div class="alert {{ twofactor.backup ? 'alert-success' : 'alert-warning' }}" role="status">
                            {{ 'Two-factor sign-in is on.'|trans }}
                            {{ twofactor.backup ? 'You have a backup code.'|trans : 'You have no backup code left: make a new one.'|trans }}
                        </div>
                        <form data-clientfence-twofactor-form="client/twofactor_backup" autocomplete="off">
                            <div class="mb-3">
                                <label class="form-label" for="backup_password">{{ 'Password'|trans }}</label>
                                <input class="form-control" id="backup_password" type="password" name="password" autocomplete="current-password" required>
                                <div class="form-text">{{ 'A new backup code replaces the old one.'|trans }}</div>
                            </div>
                            <button type="submit" class="btn btn-outline-primary">{{ 'Make a new backup code'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><h2>{{ 'Switch off'|trans }}</h2></div>
                    <div class="card-body">
                        <form action="{{ 'client/twofactor_disable'|api_url }}" {{ fb_api_form({reload: true, message: 'Two-factor sign-in is off: your password alone signs you in.'|trans}) }} autocomplete="off" data-clientfence-confirm="{{ 'Switch off two-factor sign-in? Your password alone will sign you in again.'|trans }}">
                            <div class="mb-3">
                                <label class="form-label" for="off_password">{{ 'Password'|trans }}</label>
                                <input class="form-control" id="off_password" type="password" name="password" autocomplete="current-password" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="off_code">{{ 'Code from your app, or your backup code'|trans }}</label>
                                <input class="form-control" id="off_code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="19" dir="ltr" required>
                            </div>
                            <button type="submit" class="btn btn-outline-danger">{{ 'Switch off two-factor sign-in'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card" data-clientfence-twofactor-off>
            <div class="card-body">
                <div class="alert alert-secondary" role="status">{{ 'Two-factor sign-in is off: your password alone signs you in.'|trans }}</div>
                <button type="button" class="btn btn-primary" data-clientfence-twofactor-start>{{ 'Set up two-factor sign-in'|trans }}</button>
                <div data-clientfence-twofactor-setup hidden>
                    <ol class="mb-4">
                        <li>{{ 'Open your authenticator app and add an account.'|trans }}</li>
                        <li>{{ 'Scan this QR code, or type the key below.'|trans }}</li>
                        <li>{{ 'Enter the 6-digit code the app shows, and your password.'|trans }}</li>
                    </ol>
                    <div class="row g-4 align-items-start">
                        <div class="col-sm-auto">
                            <div class="clientfence-qr border rounded p-2 bg-white" data-clientfence-twofactor-qr></div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-label">{{ 'Key'|trans }}</div>
                                <div class="font-monospace fw-semibold" dir="ltr" data-clientfence-twofactor-secret></div>
                            </div>
                            <form data-clientfence-twofactor-form="client/twofactor_enable" autocomplete="off">
                                <div class="mb-3">
                                    <label class="form-label" for="setup_code">{{ 'Code'|trans }}</label>
                                    <input class="form-control" id="setup_code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" dir="ltr" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="setup_password">{{ 'Password'|trans }}</label>
                                    <input class="form-control" id="setup_password" type="password" name="password" autocomplete="current-password" required>
                                </div>
                                <button type="submit" class="btn btn-primary">{{ 'Switch on two-factor sign-in'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

{% set passkeys = client.client_passkey_list %}
{% if passkeys.on or passkeys.passkeys %}
<div class="card mt-4 cf-acct-list" data-clientfence-passkey="list" data-role="client" data-options="client/passkey_options" data-add="client/passkey_add"
     data-saved="{{ 'Passkey saved. Next time, sign in with it.'|trans }}" data-already="{{ 'This device already has a passkey for your sign-in.'|trans }}">
    <div class="card-header"><h2>{{ 'Passkeys'|trans }}</h2></div>
    <div class="card-body">
        <p>{{ 'A passkey signs you in with the fingerprint, face or PIN of your phone or computer, instead of your password and code. It also counts as two-factor sign-in.'|trans }}</p>
        {% if passkeys.passkeys %}
            <ul class="list-group mb-4">
                {% for passkey in passkeys.passkeys %}
                    <li class="list-group-item">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="cf-acct-who">
                                <span class="cf-acct-icon" aria-hidden="true"><svg class="icon"><use href="#key"/></svg></span>
                                <div class="min-w-0">
                                    <div class="fw-semibold">{{ passkey.name }}</div>
                                    <div class="small text-body-secondary">{{ 'Added %date%'|trans({'%date%': passkey.created_at|format_datetime}) }} &middot; {{ passkey.last_used_at ? 'Last used %date%'|trans({'%date%': passkey.last_used_at|format_datetime}) : 'Not used yet'|trans }}</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#passkey-{{ passkey.id }}" aria-expanded="false" aria-controls="passkey-{{ passkey.id }}">{{ 'Rename or remove'|trans }}</button>
                        </div>
                        <div class="collapse" id="passkey-{{ passkey.id }}">
                            <div class="row g-3 pt-3">
                                <form class="col-md-6" action="{{ 'client/passkey_rename'|api_url }}" {{ fb_api_form({reload: true, message: 'Passkey renamed.'|trans}) }}>
                                    <input type="hidden" name="id" value="{{ passkey.id }}">
                                    <label class="form-label" for="passkey-name-{{ passkey.id }}">{{ 'Name'|trans }}</label>
                                    <input class="form-control mb-2" id="passkey-name-{{ passkey.id }}" type="text" name="name" value="{{ passkey.name }}" maxlength="100" required>
                                    <button type="submit" class="btn btn-outline-primary">{{ 'Rename'|trans }}</button>
                                </form>
                                <form class="col-md-6" action="{{ 'client/passkey_remove'|api_url }}" {{ fb_api_form({reload: true, message: 'Passkey removed.'|trans}) }} autocomplete="off">
                                    <input type="hidden" name="id" value="{{ passkey.id }}">
                                    <label class="form-label" for="passkey-password-{{ passkey.id }}">{{ 'Password'|trans }}</label>
                                    <input class="form-control mb-2" id="passkey-password-{{ passkey.id }}" type="password" name="password" autocomplete="current-password" required>
                                    <button type="submit" class="btn btn-outline-danger">{{ 'Remove passkey'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if passkeys.on %}
            <form class="row g-2 align-items-end" data-clientfence-passkey-add autocomplete="off">
                <div class="col-sm">
                    <label class="form-label" for="passkey_password">{{ 'Password'|trans }}</label>
                    <input class="form-control" id="passkey_password" type="password" name="password" autocomplete="current-password" required>
                </div>
                <div class="col-sm-auto">
                    <button type="submit" class="btn btn-primary">{{ 'Add a passkey'|trans }}</button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}
