{% block subject %}[{{ guest.system_company.name }}] Reset your password{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
		h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
		p { margin: 0 0 10px; }
		.signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
	</style>
</head>
<body>
	<h1>Password Reset</h1>
	<p>Hello {{ first_name|default('') }},</p>
	<p>Recently a request was submitted to reset the password of your user for the client area.</p>
	<p>If you did not request this, please ignore this email. This link will expire in {{ minutes|default(60) }} minutes.</p>
	<p>To choose a new password, please visit the link below:</p>
	<p><a href='{{ "password-reset/#{token|default('')}"|url(area: 'client') }}' target="_blank">Choose a new password</a></p>
	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
