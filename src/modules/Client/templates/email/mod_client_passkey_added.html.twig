{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'A passkey was added to your account'|trans }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'A passkey was added to your account'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'A passkey was added to your account'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'A passkey was added to your sign-in to the client area. It signs in with the fingerprint, face or PIN of the device that keeps it, without your password.'|trans }}</p>
		<p style="margin:0 0 16px; font-size:13px; color:#64748b;">{{ passkey|default('') }} &middot; {{ added_at|default('') ? added_at|format_datetime : '' }} &middot; {{ 'From %ip%'|trans({'%ip%': ip|default('')}) }}{% if country|default('') %} ({{ country }}){% endif %}.</p>
		<p style="margin:0 0 16px; padding:12px 16px; background-color:#fdf1d8; border:1px solid #f3d9a4; border-radius:10px; font-size:14px; line-height:22px; color:#7a4a05;">{{ 'If this was not you, remove the passkey on your two-factor sign-in page, change your password and contact us at once.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
