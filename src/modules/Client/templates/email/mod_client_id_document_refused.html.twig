{% block subject %}[{{ guest.system_company.name }}] {{ 'Your ID document was not accepted'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Your ID document was not accepted'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your ID document was not accepted'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello :name,'|trans({':name': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We have checked your ID document and could not accept it.'|trans }}</p>
		{% if reason|default('') %}<p style="margin:0 0 16px; padding:12px 16px; background-color:#f3f6f8; border-left:3px solid #14a39a; border-radius:8px;">{{ 'Reason: :reason'|trans({ ':reason': reason }) }}</p>{% endif %}
		<p style="margin:0 0 16px;">{{ 'Please send a new one from your client area:'|trans }} <a href="{{ 'identity'|url(area: 'client') }}" target="_blank" style="color:{{ guest.system_company.brand_link|default('#2563eb') }};">{{ 'Upload an ID document'|trans }}</a></p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
