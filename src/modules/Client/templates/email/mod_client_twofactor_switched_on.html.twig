{% block subject %}[{{ guest.system_company.name }}] {{ 'Two-factor sign-in was switched on'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Two-factor sign-in was switched on'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Two-factor sign-in was switched on'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Two-factor sign-in with an authenticator app was switched on for your sign-in to the client area. From now on, signing in also asks for a code from the app.'|trans }}</p>
		<p style="margin:0 0 16px; font-size:13px; color:#64748b;">{{ switched_at|default('') ? switched_at|format_datetime : '' }} &middot; {{ 'From %ip%'|trans({'%ip%': ip|default('')}) }}{% if country|default('') %} ({{ country }}){% endif %}.</p>
		<p style="margin:0 0 16px; padding:12px 16px; background-color:#fdf1d8; border:1px solid #f3d9a4; border-radius:10px; font-size:14px; line-height:22px; color:#7a4a05;">{{ 'If this was not you, contact us at once: someone knows your password.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
