{% block subject %}[{{ guest.system_company.name }}] You are invited to {{ account|default('an account') }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
		h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
		p { margin: 0 0 10px; }
		.signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
	</style>
</head>
<body>
	<h1>Invitation</h1>
	<p>Hello,</p>
	<p>You are invited to use the client area of {{ account|default('an account') }} with your own sign-in.</p>
	<p>To accept, please visit the link below. It works once and expires in {{ days|default(7) }} days. If you did not expect this email, you can ignore it.</p>
	<p><a href='{{ "invite/#{token|default('')}"|url(area: 'client') }}' target="_blank">Accept the invitation</a></p>
	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
