{% block subject %}[{{ guest.system_company.name }}] {{ 'You are invited to %account%'|trans({'%account%': account|default('an account'|trans)}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'You are invited'|trans }}{% endset %}
{% set email_preheader %}{{ 'An invitation to %account%.'|trans({'%account%': account|default('an account'|trans)}) }}{% endset %}
{% set email_audience = 'guest' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'You are invited'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello,'|trans }}</p>
		<p style="margin:0 0 16px;">{{ 'You have been invited to use the client area of %account% with your own sign-in.'|trans_html({}, {'%account%': '<strong>' ~ (account|default('an account'|trans))|e ~ '</strong>'}) }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "invite/#{token|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Accept the invitation'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'The link works once and expires in %days% days. If you did not expect this invitation, you can ignore this email.'|trans({'%days%': days|default(7)}) }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
