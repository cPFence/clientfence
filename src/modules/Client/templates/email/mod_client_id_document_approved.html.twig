{% block subject %}[{{ guest.system_company.name }}] {{ 'Your ID document was approved'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Your ID document was approved'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your ID document was approved'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello :name,'|trans({':name': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Thank you: we have checked your ID document and approved it. An order that waited only for it now goes on, and you get its usual emails.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
