{% block subject %}[{{ guest.system_company.name }}] {{ 'Your balance is low'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Your balance is low'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your balance is low'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello :name,'|trans({':name': c.first_name|default('')}) }}</p>
		{% set cur = currency|default(default_currency) %}
		<p style="margin:0 0 16px;">{{ 'Your account balance is :balance, below the alert amount of :threshold you set.'|trans({':balance': balance|default(0)|format_currency(cur), ':threshold': threshold|default(0)|format_currency(cur)}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Add funds so your invoices and renewals can be paid from your balance. You can change or turn off this alert on the Wallet page.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'client/balance'|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Wallet'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
