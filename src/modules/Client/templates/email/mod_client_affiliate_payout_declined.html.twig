{% block subject %}[{{ guest.system_company.name }}] {{ 'Your affiliate payout request was declined'|trans }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ 'Your payout request was declined'|trans }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f4f8;">
<div style="display:none; max-height:0; overflow:hidden;">{{ 'Your affiliate payout request of %amount% was declined.'|trans({'%amount%': payout.amount|default(0)|format_currency(payout.currency|default(default_currency))}) }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f4f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
	<tr><td style="padding:20px 32px; border-bottom:3px solid {{ guest.system_company.brand_color|default('#2563eb') }};">
		{% if guest.system_company.logo_url|default('') %}
		<img src="{{ guest.system_company.logo_url }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;">
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#0f172a;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:22px; line-height:30px; color:#0f172a;">{{ 'Your payout request was declined'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We declined your affiliate payout request of %amount%. The amount is back in your available balance.'|trans({'%amount%': payout.amount|default(0)|format_currency(payout.currency|default(default_currency))}) }}</p>
		{% if payout.note|default('') %}
		<p style="margin:0 0 8px;">{{ 'Our note:'|trans }}</p>
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f8fafc; border-left:3px solid #cbd5e1; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ payout.note }}</div>
		{% endif %}
		<p style="margin:0 0 16px;">{{ 'If you have questions, please reply to this email or contact us.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td style="border-radius:6px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }};">
				<a href="{{ 'affiliates'|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open your affiliate page'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
	</td></tr>
	<tr><td style="padding:20px 32px; border-top:1px solid #e2e8f0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		<a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Client area'|trans }}</a> &middot; <a href="{{ 'affiliates'|url(area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Affiliates'|trans }}</a>{% if guest.system_company.email|default('') %} &middot; <a href="mailto:{{ guest.system_company.email }}" style="color:#64748b;">{{ guest.system_company.email }}</a>{% endif %}
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
