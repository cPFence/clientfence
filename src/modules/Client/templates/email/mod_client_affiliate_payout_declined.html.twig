{% block subject %}[{{ guest.system_company.name }}] {{ 'Your affiliate payout request was declined'|trans }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Your payout request was declined'|trans }}{% endset %}
{% set email_preheader %}{{ 'Your affiliate payout request of %amount% was declined.'|trans({'%amount%': payout.amount|default(0)|format_currency(payout.currency|default(default_currency))}) }}{% endset %}
{% set email_audience = 'affiliate' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your payout request was declined'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We declined your affiliate payout request of %amount%. The amount is back in your available balance.'|trans({'%amount%': payout.amount|default(0)|format_currency(payout.currency|default(default_currency))}) }}</p>
		{% if payout.note|default('') %}
		<p style="margin:0 0 8px;">{{ 'Our note:'|trans }}</p>
		<div style="margin:0 0 24px; padding:16px 20px; background-color:#f3f6f8; border-left:3px solid #14a39a; border-radius:8px; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155; white-space:pre-line;">{{ payout.note }}</div>
		{% endif %}
		<p style="margin:0 0 16px;">{{ 'If you have questions, please reply to this email or contact us.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'affiliates'|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open your affiliate page'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
