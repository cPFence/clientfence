{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Welcome to %company%'|trans({'%company%': guest.system_company.name}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Welcome'|trans }}{% endset %}
{% set email_preheader %}{{ 'Your client account is ready.'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Welcome to %company%'|trans({'%company%': guest.system_company.name}) }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'A member of our team has created a client account for you. In the client area you can manage your services, pay invoices and contact our support team.'|trans }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Sign-in email'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ c.email|default('') }}</td></tr>
				</table>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'To get started, choose your password with the button below.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "client/reset-password-confirm/#{hash|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Set your password'|trans }}</a>
			</td></tr>
		</table>
{% if require_email_confirmation|default(false) %}
		<p style="margin:0 0 16px;">{{ 'Please also %link%confirm your email address%link_end%. If the link has expired, you can ask for a new one after signing in.'|trans_html({}, {'%link%': '<a href="' ~ (email_confirmation_link|default('#'))|e ~ '" target="_blank" style="color:' ~ (guest.system_company.brand_link|default('#2563eb'))|e ~ ';">', '%link_end%': '</a>'}) }}</p>
{% endif %}
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
