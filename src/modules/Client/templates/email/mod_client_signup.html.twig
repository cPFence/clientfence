{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{# ClientFence core patch: Google sign-up, the welcome email of an account made with Google (ClientFence). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Welcome to %company%'|trans({'%company%': guest.system_company.name}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Welcome'|trans }}{% endset %}
{% set email_preheader %}{{ 'Your account is ready.'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Welcome to %company%'|trans({'%company%': guest.system_company.name}) }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Thank you for creating an account with us. In the client area you can place orders, manage your services, pay invoices and contact our support team.'|trans }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Sign-in email'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ c.email|default('') }}</td></tr>
				</table>
			</td></tr>
		</table>
{% if clientfence_google.google|default(false) and clientfence_google.password_step|default(false) %}
		<p style="margin:0 0 16px;">{{ 'You signed up with your Google account. Right after, you choose a password: next time, sign in with your email and that password.'|trans }}</p>
{% elseif clientfence_google.google|default(false) %}
		<p style="margin:0 0 16px;">{{ 'You signed up with your Google account, so there is no password to remember: next time, use the Google button on the sign-in page and pick the same Google account. To also sign in with your email, choose a password on the Google sign-in page of your account.'|trans }}</p>
{% else %}
		<p style="margin:0 0 16px;">{{ 'Please sign in with the password you chose when you signed up.'|trans }}</p>
{% endif %}
{% if require_email_confirmation|default(false) %}
		<p style="margin:0 0 16px;">{{ 'Please confirm your email address to finish setting up your account.'|trans }}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ email_confirmation_link|default('#') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Confirm email address'|trans }}</a>
			</td></tr>
		</table>
{% else %}
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Sign in to client area'|trans }}</a>
			</td></tr>
		</table>
{% endif %}
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
