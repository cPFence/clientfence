{% block subject %}[{{ guest.system_company.name }}] Welcome {{ c.first_name|default('') }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Welcome</h1>
	<p>Thank you for signing up with us. Your new account has been setup and you can now login to our client area using the details below:</p>
    <ul>
        <li><strong>Email:</strong> {{ c.email|default('') }}</li>
    </ul>

    {# ClientFence core patch: Google sign-up, the welcome email of an account made with Google (ClientFence). #}
    {% if clientfence_google.google|default(false) and clientfence_google.password_step|default(false) %}
    <p>You signed up with your Google account. Right after, you choose a password: next time, sign in with your email and that password.</p>
    {% elseif clientfence_google.google|default(false) %}
    <p>You signed up with your Google account, so there is no password to remember: next time, use the Google button on the sign-in page and pick the same Google account. To also sign in with your email, choose a password on the Google sign-in page of your account.</p>
    {% else %}
    <p>Please use the password you chose during signup when logging in.</p>
    {% endif %}

    {% if require_email_confirmation|default(false) %}
        <p>Please verify your email by clicking on the link below:</p>
        <a href="{{ email_confirmation_link|default('#') }}" target="_blank">Verify email address.</a>
    {% endif %}

    <p>You may <a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank">login</a> or <a href="{{ 'client/profile'|url(area: 'client') }}" target="_blank">edit your profile.</a>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
