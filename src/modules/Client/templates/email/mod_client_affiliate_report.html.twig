{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Your affiliate report for %month%'|trans({'%month%': report.month|default('')|date('Y-m')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your affiliate report'|trans }}{% endset %}
{% set email_preheader %}{{ 'Visitors, signups and commissions of your affiliate link last month.'|trans }}{% endset %}
{% set email_audience = 'affiliate' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your affiliate report for %month%'|trans({'%month%': report.month|default('')|date('Y-m')}) }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Here is how your affiliate link did last month, and your balances today.'|trans }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Visitors'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ report.visitors|default(0) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Signups'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ report.signups|default(0) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Commissions earned'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ report.earned|default(0)|format_currency(report.currency|default(default_currency)) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Pending'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ report.pending|default(0)|format_currency(report.currency|default(default_currency)) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Available'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ report.available|default(0)|format_currency(report.currency|default(default_currency)) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Paid out'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ report.paid_out|default(0)|format_currency(report.currency|default(default_currency)) }}</td></tr>
				</table>
			</td></tr>
		</table>
		{% if report.held|default(0) > 0 %}<p style="margin:0 0 16px;">{{ 'Your bonus of %amount% is held until your first commission clears.'|trans({'%amount%': report.held|format_currency(report.currency|default(default_currency))}) }}</p>{% endif %}
		<p style="margin:0 0 8px;">{{ 'Your affiliate link:'|trans }}</p>
		<p style="margin:0 0 24px; word-break:break-all;"><a href="{{ report.link|default('') }}" target="_blank" style="color:{{ guest.system_company.brand_link|default('#2563eb') }};">{{ report.link|default('') }}</a></p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ 'affiliates'|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Open your affiliate page'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
