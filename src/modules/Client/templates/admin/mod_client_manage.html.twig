{% extends 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'client' %}
{# ClientFence core patch: the top-bar "New" menu picks this client (New Order, New Invoice, New Client Ticket). #}
{% set bf_new_client = client %}
{% set can_impersonate_client = has_permission('client', 'impersonate_login') %}
{% set can_delete_client = has_permission('client', 'delete') %}
{% set can_edit_profile = has_permission('client', 'edit_profile') %}
{% set can_change_password = has_permission('client', 'change_password') %}
{% set can_manage_balance = has_permission('client', 'manage_balance') %}
{% set can_manage_api_keys = has_permission('client', 'manage_api_keys') %}
{% set can_view_client_login_history = has_permission('client', 'view_login_history') %}
{% set can_view_email_history = has_permission('email', 'view_email_history') %}
{# ClientFence core patch: tabs only for the staff allowed to read them (support staff without order access crashed the page). #}
{% set can_view_orders = has_permission('order', 'view') %}
{% set can_view_invoices = has_permission('invoice', 'view') %}
{# ClientFence core patch: no Tickets tab or ticket counts while tickets are off (Support settings). #}
{% set can_view_tickets = has_permission('support', 'view') and guest.support_tickets_enabled %}
{% set can_view_transactions = has_permission('invoice', 'manage_transactions') %}
{% set can_manage_orders = has_permission('order', 'manage') %}
{% set can_manage_invoices = has_permission('invoice', 'manage_invoices') %}
{% set can_send_emails = has_permission('email', 'send_emails') %}
{% set has_profile_edit_actions = can_edit_profile or can_change_password %}

{% block meta_title %}{{ client.first_name }} {{ client.last_name }}{% endblock %}

{% block breadcrumbs %}
<ul class="breadcrumb">
    <li class="breadcrumb-item">
        <svg class="icon">
            <use href="#home" />
        </svg>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ 'client'|url }}">{{ 'Clients'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ client.first_name }} {{ client.last_name }}</li>
</ul>
{% endblock %}

{% block content %}
{% import 'macro_functions.html.twig' as mf %}
{% set since = date(client.created_at).diff(date()) %}
{% set months = since.y * 12 + since.m %}
{% set age_months = since.m == 1 ? '1 month'|trans : '%count% months'|trans({ '%count%': since.m }) %}
{% set client_age = since.y ? (since.y == 1 ? ':n year'|trans({ ':n': 1 }) : ':n years'|trans({ ':n': since.y })) ~ (since.m ? ' ' ~ age_months : '') : (since.m ? age_months : 'Less than a month'|trans) %}
{% set trust = can_view_invoices ? admin.client_trust_score({ id: client.id }) : null %}
{% set service_counts = can_view_orders ? {
    active: admin.order_get_list({ 'client_id': client.id, 'status': 'active', 'per_page': 1 }).total,
    suspended: admin.order_get_list({ 'client_id': client.id, 'status': 'suspended', 'per_page': 1 }).total,
    canceled: admin.order_get_list({ 'client_id': client.id, 'status': 'canceled', 'per_page': 1 }).total,
} : { active: 0, suspended: 0, canceled: 0 } %}
{% if trust %}
    {% set trust_label = trust.band == 'very_good' ? 'Very good'|trans : (trust.band == 'good' ? 'Good'|trans : (trust.band == 'fair' ? 'Fair'|trans : 'Watch'|trans)) %}
    {% set trust_class = trust.band == 'very_good' ? 'bg-green-lt' : (trust.band == 'good' ? 'bg-teal-lt' : (trust.band == 'fair' ? 'bg-yellow-lt' : 'bg-red-lt')) %}
{% endif %}
<div class="card overflow-hidden">
    {# ClientFence core patch: the client reads first: name, company and status chips, then the facts as a grid (CF-135 redesign). #}
    <div class="cf-client-head">
        <span class="cf-avatar cf-avatar-lg" aria-hidden="true">{{ (client.first_name|first ~ client.last_name|first)|upper }}</span>
        <div class="cf-inv-who">
            <h2 class="cf-client-name m-0">{{ client.first_name }} {{ client.last_name }} <span class="text-secondary fw-normal">#{{ client.id }}</span></h2>
            <div class="text-secondary text-break">{% if client.company %}{{ client.company }} · {% endif %}<span dir="ltr">{{ client.email }}</span></div>
            <div class="cf-inv-chips mt-2">
                {{ mf.status_badge(client.status, 'client') }}
                <span class="badge {{ client.email_approved ? 'bg-green-lt' : 'bg-yellow-lt' }}">{{ client.email_approved ? 'Verified'|trans : 'Not verified'|trans }}</span>
                {% if client.group %}<span class="badge bg-secondary-lt">{{ client.group }}</span>{% endif %}
                <span class="badge bg-azure-lt">{{ months < 1 ? 'New client'|trans : 'Client for'|trans ~ ' ' ~ client_age }}</span>
                {% if trust %}<span class="badge {{ trust_class }}">{{ 'Trust :score · :band'|trans({ ':score': trust.total, ':band': trust_label }) }}</span>{% endif %}
            </div>
        </div>
        <div class="cf-client-acts btn-list">
            {# ClientFence core patch: only for staff who may sign in as the client (others got an error page). #}
            {% if can_impersonate_client %}
            <a href='{{ "client/login/#{client.id}"|url(query: { CSRFToken: CSRFToken }) }}' class="btn" target="_blank">
                <svg class="icon"><use href="#login" /></svg>{{ 'Sign in as client'|trans }}
            </a>
            {% endif %}
            {% if can_send_emails %}
            <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#bf-send-email">
                <svg class="icon"><use href="#mail" /></svg>{{ 'Send Email'|trans }}
            </a>
            {% endif %}
            {% if can_manage_orders %}
            <a class="btn" href="{{ 'order/new'|url(query: { 'client_id': client.id }) }}">
                <svg class="icon"><use href="#plus" /></svg>{{ 'New Order'|trans }}
            </a>
            {% endif %}
        </div>
    </div>
    <div class="card-header bg-transparent px-3 pt-0 pb-3 border-0">
        <ul class="nav nav-pills card-header-pills" role="tablist">
            {# The ids of the old Profile (#tab-info) and Edit (#tab-profile) tabs, so old links open Overview and Profile. #}
            <li class="nav-item" role="presentation">
                <a class="nav-link active" href="#tab-info" data-bs-toggle="tab" role="tab">{{ 'Overview'|trans }}</a>
            </li>
            {% if has_profile_edit_actions %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-profile" data-bs-toggle="tab" role="tab">{{ 'Profile'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_orders %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-orders" data-bs-toggle="tab" role="tab">{{ 'Orders'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_invoices %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-invoices" data-bs-toggle="tab" role="tab">{{ 'Invoices'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_tickets %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-support" data-bs-toggle="tab" role="tab">{{ 'Tickets'|trans }}</a>
            </li>
            {% endif %}
            {% if can_manage_balance %}
            {# ClientFence core patch: the balance tab is named Credit Balance; Payments was confused with Transactions. #}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-balance" data-bs-toggle="tab" role="tab">{{ 'Credit Balance'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_client_login_history %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-history" data-bs-toggle="tab" role="tab">{{ 'Logins'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_email_history %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-emails" data-bs-toggle="tab" role="tab">{{ 'Emails'|trans }}</a>
            </li>
            {% endif %}
            {% if can_view_transactions %}
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#tab-transactions" data-bs-toggle="tab" role="tab">{{ 'Transactions'|trans }}</a>
            </li>
            {% endif %}
            {# ClientFence core patch: client page widget slots (the ClientFence Users tab). #}
            {{ render_widgets('admin.client.manage.tabs', { client: client }) }}
        </ul>
    </div>
    <div class="tab-content border-top">
        <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
            {# ClientFence core patch: the WHMCS-style summary cards (billing, services, notes, files). #}
            {% include 'mod_client_summary_cards.html.twig' %}
        </div>

        {% if has_profile_edit_actions %}
        {% set first_section = can_edit_profile ? 'general' : 'security' %}
        <div class="tab-pane fade" id="tab-profile" role="tabpanel">
            <div class="cf-profile p-3">
                {# The side menu is in the address (#cf-profile-security; clientfence-admin.js). #}
                <nav class="list-group cf-profile-nav" role="tablist" data-cf-profile-nav>
                    {% for key, item in {
                        general: ['General'|trans, 'Account, contact, company and preferences'|trans, can_edit_profile],
                        security: ['Security'|trans, 'Two-factor, passkeys, password, sign-ins'|trans, true],
                        cards: ['Cards'|trans, 'Saved cards and PayPal accounts'|trans, can_view_invoices],
                        fields: ['Custom Fields'|trans, 'Extra details for this client'|trans, can_edit_profile],
                    } %}
                        {% if item[2] %}
                        <a class="list-group-item list-group-item-action{{ key == first_section ? ' active' }}" href="#cf-profile-{{ key }}" data-bs-toggle="list" role="tab">
                            <span class="fw-medium d-block">{{ item[0] }}</span>
                            <span class="small text-secondary">{{ item[1] }}</span>
                        </a>
                        {% endif %}
                    {% endfor %}
                </nav>
                <div class="tab-content">
                    {% if can_edit_profile %}
                    <div class="tab-pane fade show active" id="cf-profile-general" role="tabpanel">
                <form method="post" action="{{ 'client/update'|api_url }}" {{ fb_api_form({ message: 'Client Profile Updated'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Client Profile Details'|trans,
                        subtitle: 'Update the client account, contact information, and internal settings.'|trans
                    } %}
                        {% import 'macro_functions.html.twig' as mf %}
                        {% block form_content %}
                        <section class="mb-4 pb-4 border-bottom">
                            <h6 class="card-title text-secondary mb-3">{{ 'Account Details'|trans }}</h6>
                            <div class="row g-3">
                                <div class="col-xl-6">
                                    <label class="form-label d-block">{{ 'Status'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioStatusActive" type="radio" name="status" value="active"{% if client.status == 'active' %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Active'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioStatusSuspended" type="radio" name="status" value="suspended"{% if client.status == 'suspended' %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Suspended'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioStatusCanceled" type="radio" name="status" value="canceled"{% if client.status == 'canceled' %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Canceled'|trans }}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label d-block">{{ 'Type'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioTypePersonal" type="radio" name="type" value="individual"{% if client.type == 'individual' %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Individual'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioTypeCompany" type="radio" name="type" value="company"{% if client.type == 'company' %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Company'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioTypeOther" type="radio" name="type" value=""{% if not client.type %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Other/Unknown'|trans }}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label d-block">{{ 'Email Address Approved'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioEmailApprovedYes" type="radio" name="email_approved" value="1"{% if client.email_approved == 1 %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioEmailApprovedNo" type="radio" name="email_approved" value="0"{% if client.email_approved != 1 %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'No'|trans }}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    {# ClientFence core patch: a client can be in several groups (Client/Groups.php); the empty input clears them. #}
                                    <label class="form-label" for="client-groups">{{ 'Groups'|trans }}</label>
                                    <input type="hidden" name="group_ids[]" value="">
                                    <select class="form-select js-multi-select" id="client-groups" name="group_ids[]" multiple placeholder="{{ 'Choose groups'|trans }}">
                                        {% for id, title in admin.client_group_get_pairs %}
                                            <option value="{{ id }}"{% if id in client.group_ids|default([]) %} selected{% endif %}>{{ title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label">{{ 'Email'|trans }}</label>
                                    <input class="form-control" type="email" name="email" value="{{ client.email }}" required>
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label">{{ 'Billing Email'|trans }}</label>
                                    <input class="form-control" type="email" name="billing_email" value="{{ client.billing_email }}" placeholder="{{ client.email }}">
                                    <small class="form-hint">{{ 'Invoice notifications are sent here. Leave blank to use the account email.'|trans }}</small>
                                </div>
                                <div class="col-xl-3">
                                    <label class="form-label">{{ 'First Name'|trans }}</label>
                                    <input class="form-control" type="text" name="first_name" value="{{ client.first_name }}" required>
                                </div>
                                <div class="col-xl-3">
                                    <label class="form-label">{{ 'Last Name'|trans }}</label>
                                    <input class="form-control" type="text" name="last_name" value="{{ client.last_name }}">
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label" for="birthday">{{ 'Date of Birth'|trans }}</label>
                                    <div class="input-group">
                                        <div class="input-icon w-100">
                                            <input class="form-control datepicker"
                                                   id="birthday"
                                                   value="{{ client.birthday }}"
                                                   name="birthday"
                                                   data-pick-year="1"
                                            >
                                            <span class="input-icon-addon">
                                                <svg class="icon"><use href="#calendar" /></svg>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="mb-4 pb-4 border-bottom" id="company-details">
                            <h6 class="card-title text-secondary mb-3">{{ 'Company and Contact Details'|trans }}</h6>
                            <div class="row g-3">
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'Company Name'|trans }}</label>
                                    <input class="form-control" type="text" name="company" value="{{ client.company }}">
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'Company Number'|trans }}</label>
                                    <input class="form-control" type="text" name="company_number" value="{{ client.company_number }}">
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'Company VAT Number'|trans }}</label>
                                    <input class="form-control" type="text" name="company_vat" value="{{ client.company_vat }}">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">{{ 'Address Line 1'|trans }}</label>
                                    <input class="form-control" type="text" name="address_1" value="{{ client.address_1 }}">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">{{ 'Address Line 2'|trans }}</label>
                                    <input class="form-control" type="text" name="address_2" value="{{ client.address_2 }}">
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'Country'|trans }}</label>
                                    {{ mf.selectbox('country', country_names(), client.country, 0, 'Select Country'|trans) }}
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'State'|trans }}</label>
                                    <input class="form-control" type="text" name="state" value="{{ client.state }}">
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'City'|trans }}</label>
                                    <input class="form-control" type="text" name="city" value="{{ client.city }}">
                                </div>
                                <div class="col-xl-4">
                                    <label class="form-label">{{ 'Postcode'|trans }}</label>
                                    <input class="form-control" type="text" name="postcode" value="{{ client.postcode }}">
                                </div>
                                <div class="col-xl-8">
                                    <label class="form-label">{{ 'Phone'|trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-text">+</span>
                                        <input class="form-control fb-phone-country-code" type="text" name="phone_cc" value="{{ client.phone_cc }}" inputmode="numeric" maxlength="3" pattern="[0-9]{1,3}" autocomplete="tel-country-code">
                                        <input class="form-control" type="phone" name="phone" value="{{ client.phone }}">
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section>
                            <h6 class="card-title text-secondary mb-3">{{ 'Additional Settings'|trans }}</h6>
                            <div class="row g-3">
                                <div class="col-xl-6">
                                    <label class="form-label">{{ 'Custom Client ID'|trans }}</label>
                                    <input class="form-control" type="text" name="aid" value="{{ client.aid }}" placeholder="{{ 'Existing customer ID from another system'|trans }}">
                                </div>
                                <div class="col-xl-3">
                                    <label class="form-label">{{ 'Currency'|trans }}</label>
                                    {{ mf.selectbox('currency', guest.currency_get_pairs, client.currency, 0, 'Select Currency'|trans) }}
                                </div>
                                <div class="col-xl-3">
                                    <label class="form-label d-block">{{ 'Exempt from Tax'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioTaxExemptYes" type="radio" name="tax_exempt" value="1"{% if client.tax_exempt %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Yes'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" id="radioTaxExemptNo" type="radio" name="tax_exempt" value="0"{% if not client.tax_exempt %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'No'|trans }}</span>
                                        </label>
                                    </div>
                                </div>
                                {# ClientFence core patch: one client may order from hosting networks (CF-119, Antispam/Networks.php). #}
                                {% set hosting_network = admin.client_hosting_network({ 'id': client.id }) %}
                                {% if hosting_network.on %}
                                <div class="col-xl-6">
                                    <label class="form-label d-block">{{ 'Orders from hosting and VPN networks'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check">
                                            <input class="form-check-input" type="radio" name="hosting_network_allowed" value="1"{% if hosting_network.allowed %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'Allowed for this client'|trans }}</span>
                                        </label>
                                        <label class="form-check">
                                            <input class="form-check-input" type="radio" name="hosting_network_allowed" value="0"{% if not hosting_network.allowed %} checked{% endif %}>
                                            <span class="form-check-label">{{ 'As in the security settings'|trans }}</span>
                                        </label>
                                    </div>
                                </div>
                                {% endif %}
                                <div class="col-xl-6">
                                    <label class="form-label" for="created_at">{{ 'Account Created At'|trans }}</label>
                                    <div class="input-group">
                                        <div class="input-icon w-100">
                                            <input class="form-control datepicker"
                                                   id="created_at"
                                                   value="{{ client.created_at|date('Y-m-d') }}"
                                                   name="created_at"
                                            >
                                            <span class="input-icon-addon">
                                                <svg class="icon"><use href="#calendar" /></svg>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    <label class="form-label" for="timezone">{{ 'Timezone'|trans }}</label>
                                    <select class="form-select" name="timezone" id="timezone">
                                        <option value="">{{ '-- Use system default --'|trans }}</option>
                                        {% for region, identifiers in guest.system_timezones %}
                                            <optgroup label="{{ region }}">
                                                {% for identifier in identifiers %}
                                                    <option value="{{ identifier }}" {% if identifier == client.timezone %}selected="selected"{% endif %}>{{ identifier }}</option>
                                                {% endfor %}
                                            </optgroup>
                                        {% endfor %}
                                    </select>
                                    <small class="form-hint text-muted">{{ 'Used to display dates and times in the client\'s local time across tickets, invoices, and order history.'|trans }}</small>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">{{ 'Notes'|trans }}</label>
                                    <textarea class="form-control" name="notes" rows="5">{{ client.notes }}</textarea>
                                </div>
                            </div>
                        </section>

                        <input type="hidden" name="id" value="{{ client.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Update Profile'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
                    </div>
                    {% endif %}

                    <div class="tab-pane fade{{ first_section == 'security' ? ' show active' }}" id="cf-profile-security" role="tabpanel">
                        {% set users_page = admin.client_user_page({ client_id: client.id }) %}
                        {# Turning sign-in protections off takes both client permissions, as on the Users tab (TwoFactor.php, Passkeys.php). #}
                        {% set can_unlock = can_edit_profile and can_change_password %}
                        <div class="card mb-3">
                            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                                <span class="cf-avatar cf-avatar-sm cf-tile" aria-hidden="true"><svg class="icon"><use href="#lock" /></svg></span>
                                <span class="fw-medium">{{ 'Two-factor sign-in'|trans }}:</span>
                                <span class="badge {{ users_page.owner_twofactor ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ users_page.owner_twofactor ? 'On'|trans : 'Off'|trans }}</span>
                                {% if users_page.owner_twofactor and can_unlock %}
                                    <a class="btn btn-sm btn-outline-warning ms-auto" {{ fb_api_link({ href: 'client/twofactor_disable'|api_url(query: { client_id: client.id }), modal: { type: 'confirm', title: 'Switch off two-factor sign-in for this login? Its password alone will sign in. Do this only when you are sure who is asking.'|trans }, reload: true }) }}>{{ 'Switch off two-factor'|trans }}</a>
                                {% endif %}
                            </div>
                            <div class="card-body border-top d-flex flex-wrap align-items-center gap-2">
                                <span class="cf-avatar cf-avatar-sm cf-tile" aria-hidden="true"><svg class="icon"><use href="#key" /></svg></span>
                                <span class="fw-medium">{{ 'Passkeys'|trans }}:</span>
                                <span class="badge {{ users_page.owner_passkeys ? 'bg-blue-lt' : 'bg-secondary-lt' }}">{{ users_page.owner_passkeys }}</span>
                                {% if users_page.owner_passkeys and can_unlock %}
                                    <a class="btn btn-sm btn-outline-warning ms-auto" {{ fb_api_link({ href: 'client/passkeys_remove'|api_url(query: { client_id: client.id }), modal: { type: 'confirm', title: 'Remove every passkey of this login? Its password then signs in. Do this only when you are sure who is asking.'|trans }, reload: true }) }}>{{ 'Remove passkeys'|trans }}</a>
                                {% endif %}
                            </div>
                        </div>

                {% if can_change_password %}
                <form class="mb-3" method="post" action="{{ 'client/change_password'|api_url }}" {{ fb_api_form({ message: 'Password Changed'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Change Password'|trans,
                        subtitle: 'Set a new client-area password for this account.'|trans
                    } %}
                        {% import 'macro_functions.html.twig' as mf %}
                        {% block form_content %}
                        <div class="row g-3">
                            <div class="col-xl-6">
                                <label class="form-label">{{ 'Password'|trans }}</label>
                                <input class="form-control" type="password" name="password" value="" required>
                            </div>
                            <div class="col-xl-6">
                                <label class="form-label">{{ 'Confirm Password'|trans }}</label>
                                <input class="form-control" type="password" name="password_confirm" value="" required>
                            </div>
                        </div>
                        <input type="hidden" name="id" value="{{ client.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Change Password'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
                {% endif %}

                        {% if can_view_client_login_history %}
                        {% set signins = admin.client_login_history_get_list({ client_id: client.id, per_page: 5 }) %}
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">{{ 'Recent sign-ins'|trans }}</h3>
                                <div class="card-actions"><a href="#tab-history" role="button" data-tab-jump>{{ 'All sign-ins'|trans }}</a></div>
                            </div>
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Date'|trans }}</th>
                                            <th>{{ 'IP'|trans }}</th>
                                            <th>{{ 'Country'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for login in signins.list %}
                                        <tr>
                                            <td>{{ login.created_at|format_datetime }}</td>
                                            <td>{{ mf.ip_lookup_link(login.ip) }}</td>
                                            <td>{{ login.ip|ip_country_name|default('Unknown'|trans) }}</td>
                                        </tr>
                                        {% else %}
                                        <tr><td class="text-muted" colspan="3">{{ 'Never signed in'|trans }}</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    {% if can_view_invoices %}
                    <div class="tab-pane fade" id="cf-profile-cards" role="tabpanel">
                        {% set cards = admin.invoice_card_list({ client_id: client.id }) %}
                        {% set paying = (cards|filter(c => c.pays)|first).card|default('') %}
                        <div class="card">
                            <div class="card-header"><h3 class="card-title">{{ 'Saved cards and PayPal accounts'|trans }}</h3></div>
                            <div class="list-group list-group-flush">
                                {% for card in cards %}
                                <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                    <span class="cf-avatar cf-avatar-sm cf-tile" aria-hidden="true"><svg class="icon"><use href="#credit-card" /></svg></span>
                                    <span class="fw-medium" dir="auto">{{ card.card }}</span>
                                    {% if card.pays %}<span class="badge bg-green-lt">{{ 'Charged for unpaid invoices'|trans }}</span>{% endif %}
                                </div>
                                {% else %}
                                <div class="list-group-item text-secondary">{{ 'No saved card or PayPal account.'|trans }}</div>
                                {% endfor %}
                            </div>
                            <div class="card-body border-top text-secondary small">{{ 'Card and account details stay with the payment provider; ClientFence keeps its reference and the name shown here.'|trans }}</div>
                            {% if paying and has_permission('invoice', 'manage_transactions') %}
                            {% set unpaid = admin.invoice_get_list({ client_id: client.id, status: 'unpaid', per_page: 25 }) %}
                            {% if unpaid.list %}
                            <div class="table-responsive border-top">
                                <table class="table card-table table-vcenter text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Unpaid invoices'|trans }}</th>
                                            <th>{{ 'Amount'|trans }}</th>
                                            <th>{{ 'Due'|trans }}</th>
                                            <th class="w-1"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for invoice in unpaid.list %}
                                        <tr>
                                            <td><a href="{{ ('invoice/manage/' ~ invoice.id)|url }}">{{ invoice.serie_nr }}</a></td>
                                            <td>{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                                            <td>{{ invoice.due_at ? invoice.due_at|format_date : '-' }}</td>
                                            <td>
                                                <a class="btn btn-sm btn-outline-primary" {{ fb_api_link({href: 'invoice/card_charge'|api_url(query: {id: invoice.id}), modal: {type: 'confirm', title: 'Charge :card?'|trans({':card': paying})}, message: 'The payment was taken.'|trans, reload: true}) }}>{{ 'Charge'|trans }}</a>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    {% if can_edit_profile %}
                    <div class="tab-pane fade" id="cf-profile-fields" role="tabpanel">
                <form method="post" action="{{ 'client/update'|api_url }}" {{ fb_api_form({ message: 'Client Profile Custom Fields Updated'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Custom Fields'|trans,
                        subtitle: 'Use these fields to store extra client details that do not fit the standard profile.'|trans
                    } %}
                        {% import 'macro_functions.html.twig' as mf %}
                        {% block form_content %}
                        {% set filled = (1..20)|filter(i => client['custom_' ~ i]|default('') != '') %}
                        {% set empty_fields = (1..20)|filter(i => i not in filled) %}
                        <p class="text-secondary">{{ ':count of 20 fields filled.'|trans({ ':count': filled|length }) }}</p>
                        <div class="row g-3">
                            {% for i in filled %}
                            <div class="col-xl-6">
                                <label class="form-label">{{ 'Custom field'|trans }} {{ i }}</label>
                                <textarea class="form-control" name="custom_{{ i }}" rows="3">{{ client['custom_' ~ i]|default('') }}</textarea>
                            </div>
                            {% endfor %}
                        </div>
                        {% if filled and empty_fields %}
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-3" data-bs-toggle="collapse" data-bs-target="#cf-empty-fields" aria-expanded="false" aria-controls="cf-empty-fields">{{ 'Show empty fields'|trans }}</button>
                        {% endif %}
                        <div class="row g-3 mt-0 collapse{{ filled ? '' : ' show' }}" id="cf-empty-fields">
                            {% for i in empty_fields %}
                            <div class="col-xl-6">
                                <label class="form-label">{{ 'Custom field'|trans }} {{ i }}</label>
                                <textarea class="form-control" name="custom_{{ i }}" rows="3"></textarea>
                            </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="id" value="{{ client.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        {% if can_view_orders %}
        <div class="tab-pane fade" id="tab-orders" role="tabpanel">
            {# ClientFence core patch: paging on every list tab, each tab with its own page parameters (orders_page, tickets_page...). #}
            {% set ordersPage = request.orders_page matches '/^[1-9]\\d*$/' ? request.orders_page : 1 %}
            {% set ordersPerPage = request.orders_per_page in [10, 25, 50, 100] ? request.orders_per_page : 25 %}
            {% set orders = admin.order_get_list({ 'per_page': ordersPerPage, 'page': ordersPage, 'client_id': client.id, 'active_first': 1 }) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Client Orders'|trans,
                subtitle: 'Review the client’s active and historical orders, or create a new order directly for this client.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_action %}
                    <a href="{{ 'order/new'|url(query: { 'client_id': client.id }) }}" class="btn btn-primary">
                        <svg class="icon">
                            <use href="#plus" />
                        </svg>
                        {{ 'New Order'|trans }}
                    </a>
                {% endblock %}

                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    {# ClientFence core patch: the services' "With Selected" bar of the old summary cards, on this list (clientfence-admin.js). #}
                    {% set can_bulk = can_manage_invoices or can_manage_orders %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    {% if can_bulk %}<th class="w-1"><input class="form-check-input m-0 align-middle batch-delete-master-checkbox" type="checkbox" aria-label="{{ 'Select all'|trans }}"></th>{% endif %}
                                    <th class="w-1">#</th>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Period'|trans }}</th>
                                    <th>{{ 'Next Due'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders.list %}
                                <tr>
                                    {% if can_bulk %}<td><input class="form-check-input m-0 align-middle batch-delete-checkbox" type="checkbox" data-item-id="{{ order.id }}" aria-label="#{{ order.id }}"></td>{% endif %}
                                    <td>{{ order.id }}</td>
                                    <td dir="auto">
                                        <a href='{{ "order/manage/#{order.id}"|url }}'>{{ order.title }}</a>
                                    </td>
                                    <td>{{ order.total|format_currency(order.currency ?? default_currency) }}</td>
                                    <td>{{ order.period ? order.period|period_title : '-' }}</td>
                                    <td>{{ order.expires_at ? order.expires_at|format_date : '-' }}</td>
                                    <td>{{ mf.status_badge(order.status, 'order') }}</td>
                                    <td>
                                        <a class="btn btn-icon" href='{{ "order/manage/#{order.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#settings" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="8">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% set addon_rows = [] %}
                    {# Each add-on once: the list above already has them with "show add-ons" on (Orders settings), and a group can have two main services. #}
                    {% set listed_ids = orders.list|map(o => o.id) %}
                    {% for parent in orders.list|filter(o => o.group_master and o.group_id) %}
                        {% for addon in admin.order_addons({ 'id': parent.id }) %}
                            {% if addon.id not in listed_ids %}
                            {% set addon_rows = addon_rows|merge([{ addon: addon, parent: parent }]) %}
                            {% set listed_ids = listed_ids|merge([addon.id]) %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                    {% if addon_rows %}
                    <div class="card-body border-top pb-2"><h5 class="card-title mb-0">{{ 'Addons'|trans }}</h5></div>
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-sm text-nowrap">
                            <thead>
                                <tr>
                                    {% if can_bulk %}<th class="w-1"></th>{% endif %}
                                    <th class="w-1">#</th>
                                    <th>{{ 'Addon'|trans }}</th>
                                    <th>{{ 'Parent'|trans }}</th>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Next Due'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in addon_rows %}
                                <tr>
                                    {% if can_bulk %}<td><input class="form-check-input m-0 align-middle batch-delete-checkbox" type="checkbox" data-item-id="{{ row.addon.id }}" aria-label="#{{ row.addon.id }}"></td>{% endif %}
                                    <td>{{ row.addon.id }}</td>
                                    <td dir="auto"><a href="{{ ('order/manage/' ~ row.addon.id)|url }}">{{ row.addon.title }}</a></td>
                                    <td dir="auto"><a href="{{ ('order/manage/' ~ row.parent.id)|url }}">{{ row.parent.title }}</a></td>
                                    <td>{{ row.addon.total|format_currency(row.addon.currency ?? default_currency) }}</td>
                                    <td>{{ row.addon.expires_at ? row.addon.expires_at|format_date : '-' }}</td>
                                    <td>{{ mf.status_badge(row.addon.status, 'order') }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                    {% if can_bulk %}
                    <div class="bf-bulk m-3" data-bf-bulk
                        data-bf-none-title="{{ 'Nothing selected'|trans }}"
                        data-bf-none-text="{{ 'Tick the services first.'|trans }}"
                        data-bf-delete-title="{{ 'Delete services?'|trans }}"
                        data-bf-delete-text="{{ 'Orders %list% will be deleted. This cannot be undone.'|trans }}"
                        data-bf-delete-confirm="{{ 'Delete'|trans }}"
                        data-bf-cancel="{{ 'Cancel'|trans }}">
                        <span class="bf-bulk-label">{{ 'With Selected:'|trans }}</span>
                        {% if can_manage_invoices %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bf-bulk-action="invoice" data-bf-bulk-call="invoice/batch_renewal_invoice">{{ 'Invoice Selected Items'|trans }}</button>
                        {% endif %}
                        {% if can_manage_orders %}
                        <button type="button" class="btn btn-sm btn-danger" data-bf-bulk-action="delete" data-bf-bulk-call="order/batch_delete" data-bf-bulk-ask="Delete">{{ 'Delete'|trans }}</button>
                        {% endif %}
                    </div>
                    {% endif %}
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': orders, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-orders', 'page_param': 'orders_page', 'per_page_param': 'orders_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

        {% if can_view_invoices %}
        <div class="tab-pane fade" id="tab-invoices" role="tabpanel">
            {% set invoicesPage = request.invoices_page matches '/^[1-9]\\d*$/' ? request.invoices_page : 1 %}
            {% set invoicesPerPage = request.invoices_per_page in [10, 25, 50, 100] ? request.invoices_per_page : 100 %}
            {% set invoices = admin.invoice_get_list({ 'per_page': invoicesPerPage, 'page': invoicesPage, 'client_id': client.id, 'summary': 1 }) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Client Invoices'|trans,
                subtitle: 'Review invoices issued to this client or prepare a new invoice directly from the account view.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_action %}
                    <a href="{{ 'invoice'|url(query: { 'client_id': client.id }) }}#tab-new" class="btn btn-primary">
                        <svg class="icon">
                            <use href="#plus" />
                        </svg>
                        {{ 'New Invoice'|trans }}
                    </a>
                {% endblock %}

                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th class="w-1">#</th>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Issued On'|trans }}</th>
                                    <th>{{ 'Paid On'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for invoice in invoices.list %}
                                <tr>
                                    <td>
                                        <a href='{{ "invoice/manage/#{invoice.id}"|url }}'>{{ invoice.serie_nr }}</a>
                                    </td>
                                    <td>{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                                    <td>{{ invoice.created_at|format_date }}</td>
                                    <td>{% if invoice.paid_at %}{{ invoice.paid_at|format_date }}{% else %}-{% endif %}</td>
                                    <td>{{ mf.status_badge(invoice.status, 'invoice') }}</td>
                                    <td>
                                        <a class="btn btn-icon" href='{{ "invoice/manage/#{invoice.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="6">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': invoices, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-invoices', 'page_param': 'invoices_page', 'per_page_param': 'invoices_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

        {% if can_view_tickets %}
        <div class="tab-pane fade" id="tab-support" role="tabpanel" aria-labelledby="support-tab">
            {% set ticketsPage = request.tickets_page matches '/^[1-9]\\d*$/' ? request.tickets_page : 1 %}
            {% set ticketsPerPage = request.tickets_per_page in [10, 25, 50, 100] ? request.tickets_per_page : 25 %}
            {# ClientFence core patch: the ticket count cards filter the list by when the ticket was opened (ticket_period); a second click clears it. #}
            {% set year = 'now'|date('Y') %}
            {% set ticket_periods = {
                this_month: { label: 'Opened this month'|trans, from: 'first day of this month'|date('Y-m-d'), to: 'now'|date('Y-m-d'), tile: 'teal' },
                last_month: { label: 'Opened last month'|trans, from: 'first day of last month'|date('Y-m-d'), to: 'last day of last month'|date('Y-m-d'), tile: 'blue' },
                this_year: { label: 'Opened this year'|trans, from: year ~ '-01-01', to: 'now'|date('Y-m-d'), tile: 'violet' },
                last_year: { label: 'Opened last year'|trans, from: (year - 1) ~ '-01-01', to: (year - 1) ~ '-12-31', tile: 'amber' },
            } %}
            {% set ticket_period = ticket_periods[request.ticket_period|default('')] is defined ? request.ticket_period : null %}
            {% set ticket_filter = { 'per_page': ticketsPerPage, 'page': ticketsPage, 'client_id': client.id, 'search': request.ticket_search|default(''), 'deep': 0, 'include_first': 0 } %}
            {% if ticket_period %}
                {% set ticket_filter = ticket_filter|merge({ 'date_from': ticket_periods[ticket_period].from, 'date_to': ticket_periods[ticket_period].to }) %}
            {% endif %}
            {% set tickets = admin.support_ticket_get_list(ticket_filter) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Help Desk'|trans,
                subtitle: 'Track the client’s support tickets and open a new ticket without leaving the client profile.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_action %}
                    <a href="{{ 'support'|url(query: { 'client_id': client.id }) }}#tab-new" class="btn btn-primary">
                        <svg class="icon">
                            <use href="#plus" />
                        </svg>
                        {{ 'New Support Ticket'|trans }}
                    </a>
                {% endblock %}

                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    {# ClientFence core patch: WHMCS-style ticket counts and a search over this client's tickets. #}
                    <div class="cf-kpis cf-kpis-4 p-3 pb-0">
                        {% for key, period in ticket_periods %}
                            {% set query = request|merge({ 'ticket_period': key == ticket_period ? null : key, 'tickets_page': null })|filter(v => v is not null) %}
                            <a class="card cf-kpi cf-kpi-filter align-items-center{{ key == ticket_period ? ' active' }}" href="{{ ('client/manage/' ~ client.id)|url(query: query) }}#tab-support"{% if key == ticket_period %} aria-current="true"{% endif %}>
                                <span class="bf-tile cf-tile-{{ period.tile }}" aria-hidden="true"><svg class="icon"><use href="#calendar" /></svg></span>
                                <div>
                                    <div class="cf-label">{{ period.label }}</div>
                                    <div class="cf-kpi-value">{{ admin.support_ticket_get_list({ 'client_id': client.id, 'date_from': period.from, 'date_to': period.to, 'per_page': 1, 'deep': 0, 'include_first': 0 }).total }}</div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                    <form class="d-flex gap-2 p-3" method="get" action="{{ ('client/manage/' ~ client.id)|url }}#tab-support" role="search">
                        {% if ticket_period %}<input type="hidden" name="ticket_period" value="{{ ticket_period }}">{% endif %}
                        <input class="form-control" type="search" name="ticket_search" value="{{ request.ticket_search|default('') }}" placeholder="{{ 'Search this client’s tickets'|trans }}" aria-label="{{ 'Search this client’s tickets'|trans }}">
                        <button class="btn btn-outline-secondary" type="submit">{{ 'Search'|trans }}</button>
                        {% if request.ticket_search|default('') %}<a class="btn btn-link" href="{{ ('client/manage/' ~ client.id)|url }}#tab-support">{{ 'Clear'|trans }}</a>{% endif %}
                    </form>
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th class="w-1">#</th>
                                    <th>{{ 'Help desk'|trans }}</th>
                                    <th>{{ 'Subject'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ticket in tickets.list %}
                                <tr>
                                    <td>{{ ticket.id }}</td>
                                    <td>{{ ticket.helpdesk.name }}</td>
                                    <td>
                                        <a href='{{ "support/ticket/#{ticket.id}"|url }}'>{{ ticket.subject|truncate(30) }}</a>
                                    </td>
                                    <td>{{ mf.status_badge(ticket.status, 'ticket') }}</td>
                                    <td>
                                        <a class="btn btn-icon" href='{{ "support/ticket/#{ticket.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="5">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': tickets, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-support', 'page_param': 'tickets_page', 'per_page_param': 'tickets_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

        {% if can_manage_balance %}
        <div class="tab-pane fade" id="tab-balance" role="tabpanel" aria-labelledby="balance-tab">
            {% set paymentsPage = request.payments_page matches '/^[1-9]\\d*$/' ? request.payments_page : 1 %}
            {% set paymentsPerPage = request.payments_per_page in [10, 25, 50, 100] ? request.payments_per_page : 25 %}
            {% set payments = admin.client_balance_get_list({ 'per_page': paymentsPerPage, 'page': paymentsPage, 'client_id': client.id }) %}
            {# ClientFence core patch: the credit balance and its low balance alert on top of the Credit Balance tab, as a key figure card. #}
            {% set balance_alert = admin.client_balance_alert_get({ id: client.id }) %}
            <div class="card cf-kpi cf-kpi-action align-items-center m-3 mb-0">
                <span class="bf-tile cf-tile-violet" aria-hidden="true"><svg class="icon"><use href="#currency-dollar" /></svg></span>
                <div>
                    <div class="cf-label">{{ 'Credit Balance'|trans }}</div>
                    <div class="cf-kpi-value">{{ client.balance|format_currency(client.currency ?? default_currency) }}</div>
                    <div class="cf-kpi-sub">{{ 'Low balance alert'|trans }}: {{ balance_alert and balance_alert.threshold is not null ? 'Alert below :amount'|trans({ ':amount': balance_alert.threshold|format_currency(client.currency ?? default_currency) }) : 'Off'|trans }}</div>
                </div>
                <label class="btn btn-primary ms-auto" for="inputAmount"><svg class="icon"><use href="#plus" /></svg>{{ 'Add Funds'|trans }}</label>
            </div>
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Credit History'|trans,
                subtitle: "Credit added to or used from this client's balance."|trans,
                card_class: 'm-3 mb-0'
            } %}
                {% block section_content %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Description'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for i, tx in payments.list %}
                                <tr>
                                    <td>{{ (tx.amount ?? 0)|format_currency(tx.currency ?? default_currency) }}</td>
                                    <td>{{ tx.description }}</td>
                                    <td>{{ tx.created_at|format_datetime }}</td>
                                    <td>
                                        <a class="btn btn-icon"
                                            {{ fb_api_link({ href: 'client/balance_delete'|api_url(query: {id: tx.id }), modal: {type: 'confirm', title: 'Are you sure?'|trans} }) }}>
                                            <svg class="icon">
                                                <use href="#trash" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="4">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': payments, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-balance', 'page_param': 'payments_page', 'per_page_param': 'payments_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="p-3">
                <form method="post" action="{{ 'client/balance_add_funds'|api_url }}" {{ fb_api_form({ message: 'Funds Added'|trans}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Add Funds for Client'|trans,
                        subtitle: 'Record a manual balance credit on this client account.'|trans
                    } %}
                        {% block form_content %}
                            <div class="row g-3">
                                <div class="col-xl-4">
                                    <label class="form-label" for="inputAmount">{{ 'Amount'|trans }}</label>
                                    <div class="input-group">
                                        <input class="form-control" type="text" id="inputAmount" name="amount" required>
                                        <span class="input-group-text">{{ client.currency|currency_symbol }}</span>
                                    </div>
                                </div>
                                <div class="col-xl-8">
                                    <label class="form-label" for="inputDescription">{{ 'Description'|trans }}</label>
                                    <input class="form-control" id="inputDescription" type="text" name="description" required>
                                </div>
                            </div>
                            <input type="hidden" name="id" value="{{ client.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">
                                <svg class="icon">
                                    <use href="#plus" />
                                </svg>
                                {{ 'Add Funds'|trans }}
                            </button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>
        {% endif %}

        {% if can_view_client_login_history %}
        <div class="tab-pane fade" id="tab-history" role="tabpanel" aria-labelledby="history-tab">
            {% set loginsPage = request.logins_page matches '/^[1-9]\\d*$/' ? request.logins_page : 1 %}
            {% set loginsPerPage = request.logins_per_page in [10, 25, 50, 100] ? request.logins_per_page : 10 %}
            {% set logins = admin.client_login_history_get_list({ 'per_page': loginsPerPage, 'page': loginsPage, 'client_id': client.id }) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Login History'|trans,
                subtitle: 'See recent client login activity, including originating IP address and detected country.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th>{{ 'IP'|trans }}</th>
                                    <th>{{ 'Country'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for i, login in logins.list %}
                                <tr>
                                    <td>{{ mf.ip_lookup_link(login.ip) }}</td>
                                    <td>{{ login.ip|ip_country_name|default('Unknown'|trans) }}</td>
                                    <td>{{ login.created_at|format_datetime }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="3">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': logins, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-history', 'page_param': 'logins_page', 'per_page_param': 'logins_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

        {% if can_view_email_history %}
        <div class="tab-pane fade" id="tab-emails" role="tabpanel" aria-labelledby="emails-tab">
            {% set emailsPage = request.emails_page matches '/^[1-9]\\d*$/' ? request.emails_page : 1 %}
            {% set emailsPerPage = request.emails_per_page in [10, 25, 50, 100] ? request.emails_per_page : 25 %}
            {% set emails = admin.email_email_get_list({ 'per_page': emailsPerPage, 'page': emailsPage, 'client_id': client.id }) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Emails Sent to Client'|trans,
                subtitle: 'Review outbound email history for this client and preview the rendered message content.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_content %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th>{{ 'Email Subject'|trans }}</th>
                                    <th>{{ 'To'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for i, email in emails.list %}
                                <tr>
                                    <td>{{ email.subject }}</td>
                                    <td>{{ email.recipients }}</td>
                                    <td>{{ email.created_at|format_datetime }}</td>
                                    <td>
                                        <button class="btn btn-icon email-preview-btn"
                                            data-email-subject="{{ email.subject }}"
                                            data-email-content="{{ email.content_html|e('html_attr') }}"
                                            title="{{ 'Preview'|trans }}">
                                            <svg class="icon">
                                                <use href="#eye" />
                                            </svg>
                                        </button>
                                        <a class="btn btn-icon" href='{{ "email/#{email.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit"></use>
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="4">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}

                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': emails, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-emails', 'page_param': 'emails_page', 'per_page_param': 'emails_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

        {% if can_view_transactions %}
        <div class="tab-pane fade" id="tab-transactions" role="tabpanel" aria-labelledby="transactions-tab">
            {% set transactionsPage = request.transactions_page matches '/^[1-9]\\d*$/' ? request.transactions_page : 1 %}
            {% set transactionsPerPage = request.transactions_per_page in [10, 25, 50, 100] ? request.transactions_per_page : 100 %}
            {% set transactions = admin.invoice_transaction_get_list({ 'client_id': client.id, 'per_page': transactionsPerPage, 'page': transactionsPage }) %}
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Transactions Received'|trans,
                subtitle: 'Review payment transactions recorded against this client across all gateways.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    {# ClientFence core patch: WHMCS-style totals of the money this client paid and was refunded (processed transactions, per currency). #}
                    {% for totals in admin.invoice_transaction_client_totals({ 'client_id': client.id }) %}
                        {# The same key figure cards as the Overview and the Credit Balance tab. #}
                        <div class="cf-kpis p-3">
                            {% for box in [
                                { label: 'Total in'|trans, value: totals.in, icon: 'currency-dollar', tile: 'teal' },
                                { label: 'Total out'|trans, value: totals.out, icon: 'receipt-refund', tile: 'amber' },
                                { label: 'Balance'|trans, value: totals.balance, icon: 'chart-bar', tile: 'blue' },
                            ] %}
                                <div class="card cf-kpi align-items-center">
                                    <span class="bf-tile cf-tile-{{ box.tile }}" aria-hidden="true"><svg class="icon"><use href="#{{ box.icon }}" /></svg></span>
                                    <div>
                                        <div class="cf-label">{{ box.label }}</div>
                                        <div class="cf-kpi-value">{{ box.value|format_currency(totals.currency) }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th>{{ 'ID'|trans }}</th>
                                    <th>{{ 'Type'|trans }}</th>
                                    <th>{{ 'Gateway'|trans }}</th>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for i, tx in transactions.list %}
                                <tr>
                                    <td>{{ tx.txn_id }}</td>
                                    <td>{{ tx.type }}</td>
                                    <td>{{ tx.gateway }}</td>
                                    <td>{% if tx.amount %}
                                            {{ tx.amount|format_currency(tx.currency ?? default_currency) }}
                                        {% else %}
                                            -
                                        {% endif %}</td>
                                    <td>{{ mf.status_badge(tx.status, 'transaction') }}</td>
                                    <td>{{ tx.created_at|format_datetime }}</td>
                                    <td>
                                        <a class="btn btn-icon" href='{{ "invoice/transaction/#{tx.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td class="text-muted" colspan="7">{{ 'The list is empty'|trans }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
                {% block section_footer %}
                    <div class="d-flex align-items-center">
                        {{ include('partial_pagination.html.twig', { 'list': transactions, 'url': 'client/manage/' ~ client.id, 'hash': '#tab-transactions', 'page_param': 'transactions_page', 'per_page_param': 'transactions_per_page', 'split_footer_controls': true }) }}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}
        {# ClientFence core patch: client page widget slots (the ClientFence Users tab content). #}
        {{ render_widgets('admin.client.manage.panes', { client: client }) }}
    </div>
</div>

{# The page's popups sit outside the tabs: the header opens them from any tab. #}
{% if can_manage_invoices %}
<div class="modal fade" id="bf-funds-invoice" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" action="{{ 'invoice/funds_invoice'|api_url }}" {{ fb_api_form({ callback: 'clientfenceInvoiceCreated' }) }}>
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Create Add Funds Invoice'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="client_id" value="{{ client.id }}">
                <label class="form-label" for="bf-funds-amount">{{ 'Amount'|trans }}</label>
                <div class="input-group">
                    <input class="form-control" type="text" inputmode="decimal" id="bf-funds-amount" name="amount" required>
                    <span class="input-group-text">{{ client.currency|currency_symbol }}</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="submit">{{ 'Create Invoice'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

{% if can_send_emails %}
{% set company = guest.system_company %}
<div class="modal fade" id="bf-send-email" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" method="post" action="{{ 'email/send'|api_url }}" {{ fb_api_form({ reload: true, message: 'Email sent'|trans }) }}>
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Send Email'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="client_id" value="{{ client.id }}">
                <input type="hidden" name="to" value="{{ client.email }}">
                <input type="hidden" name="to_name" value="{{ client.first_name }} {{ client.last_name }}">
                <input type="hidden" name="from" value="{{ company.email }}">
                <input type="hidden" name="from_name" value="{{ company.name }}">
                <p class="text-secondary">{{ 'To: %email%'|trans({ '%email%': client.email }) }}</p>
                <label class="form-label" for="bf-email-subject">{{ 'Subject'|trans }}</label>
                <input class="form-control mb-2" id="bf-email-subject" name="subject" required>
                <label class="form-label" for="bf-email-content">{{ 'Message'|trans }}</label>
                <textarea class="form-control" id="bf-email-content" name="content" rows="8" required></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="submit">{{ 'Send'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

{# Suspend all services asks for the reason (Order Api client_services_action; clientfence-admin.js lists what failed). #}
{% if can_manage_orders and service_counts.active %}
<div class="modal fade" id="cf-suspend-all" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" action="{{ 'order/client_services_action'|api_url }}" {{ fb_api_form({ callback: 'clientfenceServicesDone' }) }}>
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Suspend all active services (:count)?'|trans({ ':count': service_counts.active }) }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="client_id" value="{{ client.id }}">
                <input type="hidden" name="action" value="suspend">
                <p class="text-secondary">{{ 'Each active service is suspended as with Suspend on its order page, with your reason: the server account is suspended and the client gets the usual email. Add-ons go with their service.'|trans }}</p>
                <label class="form-label" for="cf-suspend-reason">{{ 'Reason for Suspension'|trans }}</label>
                <input class="form-control" id="cf-suspend-reason" name="reason">
            </div>
            <div class="modal-footer">
                <button class="btn btn-warning" type="submit">{{ 'Suspend all services'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}

{% block js%}
{{ include('partial_email_preview.html.twig') }}
<script nonce="{{ csp_nonce }}">
    function onAfterInvoicePrepared(id) {
        window.location = "{{ 'invoice/manage/'|url }}/" + id;
    }
</script>
{% endblock %}
{# ClientFence core patch: Bootstrap Icons from the sprite instead of an inline Tabler drawing. #}
