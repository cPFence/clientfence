{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Client Settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ul class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|url }}">{{ 'Settings'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Client Settings'|trans }}</li>
    </ul>
{% endblock %}

{% block content %}
    {% set params = admin.extension_config_get({ 'ext': 'mod_client' }) %}
    {% set required_fields = params.required|default([]) %}
    {% set auto_login_after_signup = params.auto_login_after_signup is not defined or params.auto_login_after_signup == true %}
    {# ClientFence core patch: no filler subtitles, the sections side by side on wide screens, each switch with its hint, Save rows that stay in view (CF-135 redesign). #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Client Settings'|trans }}</h3>
        </div>
        <div class="card-body pt-3 pb-0">
            <ul class="nav nav-pills mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" href="#tab-index" data-bs-toggle="tab" role="tab">{{ 'General'|trans }}</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-custom-fields" data-bs-toggle="tab" role="tab">{{ 'Custom Fields'|trans }}</a>
                </li>
                {# ClientFence core patch: privacy tools and marketing email opt-out, off by default (Client/Privacy.php). #}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-privacy" data-bs-toggle="tab" role="tab">{{ 'Privacy'|trans }}</a>
                </li>
                {# ClientFence core patch: the affiliate program settings (Client/Affiliates), in their own form below. #}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-affiliates" data-bs-toggle="tab" role="tab">{{ 'Affiliates'|trans }}</a>
                </li>
                {# ClientFence core patch: the ID documents settings (Client/IdDocuments.php), in their own form below. #}
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tab-id-documents" data-bs-toggle="tab" role="tab">{{ 'ID documents'|trans }}</a>
                </li>
            </ul>
            <form method="post" action="{{ 'extension/config_save'|api_url }}" {{ fb_api_form({message: 'Configuration Updated'|trans}) }}>
                <input type="hidden" name="ext" value="mod_client">
                <div class="tab-content border-top">
                    <div class="tab-pane fade show active" id="tab-index" role="tabpanel">
                        <div class="card-body">
                            <div class="row row-cards">
                                <div class="col-12 col-xl-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-3">{{ 'Signup Controls'|trans }}</h4>

                                            <div class="d-flex flex-column gap-3">
                                                <label class="form-check form-switch form-switch-2">
                                                    <input class="form-check-input" name="disable_signup" type="checkbox" {% if params.disable_signup|default(false) %}checked="checked"{% endif %}>
                                                    <span class="form-check-label">{{ 'Disable New Signups'|trans }}</span>
                                                </label>
                                                <div>
                                                    <label class="form-check form-switch form-switch-2 mb-1">
                                                        <input class="form-check-input" name="require_email_confirmation" type="checkbox" {% if params.require_email_confirmation|default(false) %}checked="checked"{% endif %}>
                                                        <span class="form-check-label">{{ 'Require Email Confirmation'|trans }}</span>
                                                    </label>
                                                    <small class="form-hint">{{ 'After enabling this feature, existing users who have not yet confirmed their email addresses will also need to do so.'|trans }}</small>
                                                </div>
                                                <div>
                                                    <input type="hidden" name="auto_login_after_signup" value="0">
                                                    <label class="form-check form-switch form-switch-2 mb-1">
                                                        <input class="form-check-input" name="auto_login_after_signup" value="1" type="checkbox" {% if auto_login_after_signup %}checked="checked"{% endif %}>
                                                        <span class="form-check-label">{{ 'Auto Login After Signup'|trans }}</span>
                                                    </label>
                                                    <small class="form-hint">{{ 'Automatically log clients in after successful registration.'|trans }}</small>
                                                </div>
                                                <label class="form-check form-switch form-switch-2">
                                                    <input class="form-check-input" name="disable_change_email" type="checkbox" {% if params.disable_change_email|default(false) %}checked="checked"{% endif %}>
                                                    <span class="form-check-label">{{ 'Disable Email Change'|trans }}</span>
                                                </label>
                                                {# ClientFence core patch (CF-254): one switch hides Birthday and Gender from every client page. #}
                                                <div>
                                                    <input type="hidden" name="hide_birthday_gender" value="0">
                                                    <label class="form-check form-switch form-switch-2 mb-1">
                                                        <input class="form-check-input" name="hide_birthday_gender" value="1" type="checkbox" {% if params.hide_birthday_gender|default(false) %}checked="checked"{% endif %}>
                                                        <span class="form-check-label">{{ 'Hide Birthday and Gender'|trans }}</span>
                                                    </label>
                                                    <small class="form-hint">{{ 'Clients no longer see or fill in these two fields on the sign-up, checkout and profile pages, even when they are Required Profile Fields. Staff still see the birthday on the client page. Some registrars read the birthday for a few domain extensions (ResellerClub .ru, Namecheap .fr).'|trans }}</small>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                                <div class="col-12 col-xl-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-3">{{ 'Required Profile Fields'|trans }}</h4>
                                            <select class="form-select" name="required[]" multiple size="14">
                                        <optgroup label="General">
                                            <option value="last_name" {% if 'last_name' in required_fields %}selected{% endif %}>{{ 'Last Name'|trans }}</option>
                                            <option value="company" {% if 'company' in required_fields %}selected{% endif %}>{{ 'Company'|trans }}</option>
                                            {# ClientFence core patch: the VAT number can be required too. #}
                                            <option value="company_vat" {% if 'company_vat' in required_fields %}selected{% endif %}>{{ 'Company VAT'|trans }}</option>
                                            <option value="gender" {% if 'gender' in required_fields %}selected{% endif %}>{{ 'Gender'|trans }}</option>
                                            <option value="birthday" {% if 'birthday' in required_fields %}selected{% endif %}>{{ 'Birthday'|trans }}</option>
                                        </optgroup>
                                        <optgroup label="Address">
                                            <option value="country" {% if 'country' in required_fields %}selected{% endif %}>{{ 'Country'|trans }}</option>
                                            <option value="city" {% if 'city' in required_fields %}selected{% endif %}>{{ 'City'|trans }}</option>
                                            <option value="state" {% if 'state' in required_fields %}selected{% endif %}>{{ 'State'|trans }}</option>
                                            <option value="address_1" {% if 'address_1' in required_fields %}selected{% endif %}>{{ 'Address Line 1'|trans }}</option>
                                            <option value="address_2" {% if 'address_2' in required_fields %}selected{% endif %}>{{ 'Address Line 2'|trans }}</option>
                                            <option value="postcode" {% if 'postcode' in required_fields %}selected{% endif %}>{{ 'Post Code'|trans }}</option>
                                            <option value="phone" {% if 'phone' in required_fields %}selected{% endif %}>{{ 'Phone'|trans }}</option>
                                        </optgroup>
                                    </select>
                                        </div>
                                    </section>
                                </div>
                                {# ClientFence core patch: WHMCS's automatic client status update (Client/StatusUpdate.php). #}
                                <div class="col-12 col-xl-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-2">{{ 'Automatic status update'|trans }}</h4>
                                            <p class="text-secondary mb-3">{{ 'Once a day, clients without an active or suspended service, add-on or domain become Inactive, and Active again once they have one. Inactive clients sign in, order, pay and open tickets as before. Clients newer than two days, Suspended and Canceled clients, and clients with Status Update off on their profile are left as they are.'|trans }}</p>
                                            <label class="form-label" for="client-status-update">{{ 'Set clients Inactive'|trans }}</label>
                                            <select class="form-select" id="client-status-update" name="status_update">
                                                {% for value, label in { off: 'Off'|trans, services: 'Without services'|trans, signin: 'Without services and without a sign-in for 3 months'|trans } %}
                                                    <option value="{{ value }}"{% if params.status_update|default('off') == value %} selected{% endif %}>{{ label }}</option>
                                                {% endfor %}
                                            </select>
                                            <small class="form-hint">{{ 'The sign-in choice reads the sign-in history: keep the activity log at least 90 days (Activity settings).'|trans }}</small>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-end cf-set-save">
                            <input type="submit" value="{{ 'Update'|trans }}" class="btn btn-primary">
                        </div>
                    </div>

                    {# ClientFence core patch: WHMCS custom client fields: type, options, description, validation, display order, admin only,
                       order form, invoice and the texts per language for each of the 20 slots (Client/CustomFields.php). #}
                    {% set cf = admin.client_custom_fields %}
                    {% set cf_types = { text: 'Text Box'|trans, link: 'Link/URL'|trans, password: 'Password'|trans, dropdown: 'Drop Down'|trans, tickbox: 'Checkbox'|trans, textarea: 'Text Area'|trans } %}
                    <div class="tab-pane fade" id="tab-custom-fields" role="tabpanel">
                        <div class="card-body">
                            <p class="text-secondary">{{ 'Extra details clients give at sign-up or on their profile, as WHMCS custom client fields. Admin Only fields are seen and changed by staff only, unless Show on Invoice is also on: that prints the field on invoices made from now on.'|trans }}</p>
                            <div class="row row-cards">
                            {% for i in 1..20 %}
                                {% set field_name = 'custom_' ~ i %}
                                {% set custom_field = cf.fields[field_name]|default({}) %}
                                {% set base = 'custom_fields[' ~ field_name ~ ']' %}
                                <div class="col-md-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-3">{% if custom_field.title|default('') is not empty %}{{ custom_field.title }}{% else %}{{ 'Custom_'|trans }}{{ i }}{% endif %}</h4>
                                            <div class="row g-2 mb-3">
                                                <div class="col-sm-8">
                                                    <label class="form-label" for="custom-field-title-{{ i }}">{{ 'Field Title'|trans }}</label>
                                                    <input class="form-control" id="custom-field-title-{{ i }}" type="text" placeholder="{{ 'Field title'|trans }}" name="{{ base }}[title]" value="{{ custom_field.title|default('') }}">
                                                </div>
                                                <div class="col-sm-4">
                                                    <label class="form-label" for="custom-field-order-{{ i }}">{{ 'Display Order'|trans }}</label>
                                                    <input class="form-control" id="custom-field-order-{{ i }}" type="number" step="1" name="{{ base }}[order]" value="{{ custom_field.order|default(0) }}">
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="custom-field-type-{{ i }}">{{ 'Field Type'|trans }}</label>
                                                    <select class="form-select" id="custom-field-type-{{ i }}" name="{{ base }}[type]">
                                                        {% for type, type_label in cf_types %}
                                                            <option value="{{ type }}"{% if custom_field.type|default('text') == type %} selected{% endif %}>{{ type_label }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="custom-field-regex-{{ i }}">{{ 'Validation'|trans }}</label>
                                                    <input class="form-control font-monospace" id="custom-field-regex-{{ i }}" type="text" dir="ltr" spellcheck="false" placeholder="/^[0-9]+$/" name="{{ base }}[regex]" value="{{ custom_field.regex|default('') }}">
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-hint">{{ 'Validation: a regular expression with its delimiters that a new answer must match. Leave blank to accept any answer.'|trans }}</div>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="custom-field-options-{{ i }}">{{ 'Select Options'|trans }}</label>
                                                    <input class="form-control" id="custom-field-options-{{ i }}" type="text" name="{{ base }}[options]" value="{{ custom_field.options|default('') }}">
                                                    <div class="form-hint">{{ 'Drop Down only: the choices, separated by commas.'|trans }}</div>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="custom-field-description-{{ i }}">{{ 'Description'|trans }}</label>
                                                    <input class="form-control" id="custom-field-description-{{ i }}" type="text" name="{{ base }}[description]" value="{{ custom_field.description|default('') }}">
                                                    <div class="form-hint">{{ 'Shown under the field.'|trans }}</div>
                                                </div>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-sm-6">
                                                    <label class="form-check form-switch form-switch-2">
                                                        <input type="hidden" name="{{ base }}[active]" value="0">
                                                        <input class="form-check-input" id="custom-field-active-{{ i }}" type="checkbox" name="{{ base }}[active]" value="1"{% if custom_field.active ?? false %} checked{% endif %}>
                                                        <span class="form-check-label">{{ 'Active'|trans }}</span>
                                                    </label>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-check form-switch form-switch-2">
                                                        <input type="hidden" name="{{ base }}[required]" value="0">
                                                        <input class="form-check-input" id="custom-field-required-{{ i }}" type="checkbox" name="{{ base }}[required]" value="1"{% if custom_field.required ?? false %} checked{% endif %}>
                                                        <span class="form-check-label">{{ 'Required'|trans }}</span>
                                                    </label>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-check form-switch form-switch-2">
                                                        <input type="hidden" name="{{ base }}[admin_only]" value="0">
                                                        <input class="form-check-input" id="custom-field-admin_only-{{ i }}" type="checkbox" name="{{ base }}[admin_only]" value="1"{% if custom_field.admin_only ?? false %} checked{% endif %}>
                                                        <span class="form-check-label">{{ 'Admin Only'|trans }}</span>
                                                    </label>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-check form-switch form-switch-2">
                                                        <input type="hidden" name="{{ base }}[show_order]" value="0">
                                                        <input class="form-check-input" id="custom-field-show_order-{{ i }}" type="checkbox" name="{{ base }}[show_order]" value="1"{% if custom_field.show_order ?? true %} checked{% endif %}>
                                                        <span class="form-check-label">{{ 'Show on Order Form'|trans }}</span>
                                                    </label>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-check form-switch form-switch-2">
                                                        <input type="hidden" name="{{ base }}[show_invoice]" value="0">
                                                        <input class="form-check-input" id="custom-field-show_invoice-{{ i }}" type="checkbox" name="{{ base }}[show_invoice]" value="1"{% if custom_field.show_invoice ?? false %} checked{% endif %}>
                                                        <span class="form-check-label">{{ 'Show on Invoice'|trans }}</span>
                                                    </label>
                                                </div>
                                            </div>
                                            {% if cf.languages|default({}) is not empty %}
                                                <details class="mt-3">
                                                    <summary class="text-secondary">{{ 'Translations'|trans }}{% if custom_field.translations|default({}) is not empty %} <span class="badge bg-blue-lt ms-1">{{ custom_field.translations|length }}</span>{% endif %}</summary>
                                                    <div class="form-hint mb-2">{{ 'The title, description and options in other languages. Leave blank to use the default text; give the options in the same order.'|trans }}</div>
                                                    {% for lang, language in cf.languages %}
                                                        {% set own = custom_field.translations[lang]|default({}) %}
                                                        {% set rtl = lang is rtl %}
                                                        <fieldset class="border-top pt-2 mt-2">
                                                            <legend class="fs-5 fw-medium mb-1">{{ language }}</legend>
                                                            <div class="row g-2">
                                                                <div class="col-sm-6">
                                                                    <input class="form-control form-control-sm" type="text" name="{{ base }}[translations][{{ lang }}][title]" value="{{ own.title|default('') }}" placeholder="{{ custom_field.title|default('Field title'|trans) }}" aria-label="{{ 'Field Title'|trans }} ({{ language }})" lang="{{ lang[:2] }}"{% if rtl %} dir="rtl"{% endif %}>
                                                                </div>
                                                                <div class="col-sm-6">
                                                                    <input class="form-control form-control-sm" type="text" name="{{ base }}[translations][{{ lang }}][options]" value="{{ own.options|default('') }}" placeholder="{{ custom_field.options|default('Select Options'|trans) }}" aria-label="{{ 'Select Options'|trans }} ({{ language }})" lang="{{ lang[:2] }}"{% if rtl %} dir="rtl"{% endif %}>
                                                                </div>
                                                                <div class="col-12">
                                                                    <input class="form-control form-control-sm" type="text" name="{{ base }}[translations][{{ lang }}][description]" value="{{ own.description|default('') }}" placeholder="{{ custom_field.description|default('Description'|trans) }}" aria-label="{{ 'Description'|trans }} ({{ language }})" lang="{{ lang[:2] }}"{% if rtl %} dir="rtl"{% endif %}>
                                                                </div>
                                                            </div>
                                                        </fieldset>
                                                    {% endfor %}
                                                </details>
                                            {% endif %}
                                        </div>
                                    </section>
                                </div>
                            {% endfor %}
                            </div>
                        </div>
                        <div class="card-footer text-end cf-set-save">
                            <input type="submit" value="{{ 'Update'|trans }}" class="btn btn-primary">
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-privacy" role="tabpanel">
                        <div class="card-body">
                            <div class="row row-cards">
                                <div class="col-12 col-xl-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-2">{{ 'Privacy Tools (GDPR)'|trans }}</h4>
                                            <p class="text-secondary mb-3">{{ 'Staff can download a client\'s data as a file and anonymize a client from the client\'s page. Clients can download their own data and ask for their account to be deleted (a ticket for staff) on their profile.'|trans }}</p>
                                            <input type="hidden" name="privacy_tools" value="0">
                                            <label class="form-check form-switch form-switch-2">
                                                <input class="form-check-input" name="privacy_tools" value="1" type="checkbox" {% if params.privacy_tools|default('0') == '1' %}checked="checked"{% endif %}>
                                                <span class="form-check-label">{{ 'Turn on the privacy tools'|trans }}</span>
                                            </label>
                                            <small class="form-hint mt-2">{{ 'Anonymizing keeps orders, invoices and payments for your records and erases the person: names, email, address, phone, IP addresses, ticket messages and sent emails. It is refused while the client has live services or unpaid invoices.'|trans }}</small>
                                        </div>
                                    </section>
                                </div>
                                <div class="col-12 col-xl-6">
                                    <section class="card card-sm h-100">
                                        <div class="card-body">
                                            <h4 class="card-title mb-2">{{ 'Marketing Email Opt-out'|trans }}</h4>
                                            <p class="text-secondary mb-3">{{ 'Clients can turn marketing email off on their profile, and every marketing Mass Mailer email gets an unsubscribe link and one-click unsubscribe headers. Mass Mailer always skips clients who opted out, also when staff turned marketing off on the client\'s profile. Service email (invoices, tickets, sign-in) always goes.'|trans }}</p>
                                            <input type="hidden" name="marketing_optout" value="0">
                                            <label class="form-check form-switch form-switch-2">
                                                <input class="form-check-input" name="marketing_optout" value="1" type="checkbox" {% if params.marketing_optout|default('0') == '1' %}checked="checked"{% endif %}>
                                                <span class="form-check-label">{{ 'Turn on the marketing email opt-out'|trans }}</span>
                                            </label>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-end cf-set-save">
                            <input type="submit" value="{{ 'Update'|trans }}" class="btn btn-primary">
                        </div>
                    </div>
                </div>
            </form>
            {{ include('mod_client_settings_affiliates.html.twig') }}
            {{ include('mod_client_settings_id_documents.html.twig') }}
        </div>
    </div>
    {# ClientFence: Google sign-in (Client/Google.php), saved on its own. #}
    {{ include('mod_client_settings_google.html.twig') }}
{% endblock %}
