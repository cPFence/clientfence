{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Cookie Consent'|trans }}{% endblock %}

{% set active_menu = 'extensions' %}

{% block content %}
    {# ClientFence core patch (ext cookieconsent): the message and button per language (blank: the built-in text). #}
    {% set notice = admin.cookieconsent_get_config %}
    {% set language_names = {} %}
    {% for l in guest.extension_languages(true) %}
        {% set language_names = language_names|merge({(l.locale): l.title}) %}
    {% endfor %}
    {% set builtin = notice.default_builtin %}
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Cookie Consent'|trans }}</h3>
                <p class="card-subtitle">{{ 'A notice about cookies for visitors of the client area. Once a visitor accepts it, it does not show again in that browser.'|trans }}</p>
            </div>
        </div>
        <form method="post" action="{{ 'cookieconsent/save_settings'|api_url }}" id="cookie-form" {{ fb_api_form({ message: 'Saved.'|trans }) }}>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-lg-6">
                        {% if language_names|length > 1 %}
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-2 border-bottom" id="cookie-langs" role="tablist" aria-label="{{ 'Languages'|trans }}">
                                <button class="btn btn-sm btn-primary" type="button" role="tab" aria-selected="true" data-cf-lang="">{{ 'Default'|trans }} <span class="ms-1 opacity-75">{{ language_names[notice.default_locale] ?? notice.default_locale }}</span></button>
                                {% for lang, title in language_names|filter((t, l) => l != notice.default_locale) %}
                                    <button class="btn btn-sm btn-outline-secondary" type="button" role="tab" aria-selected="false" data-cf-lang="{{ lang }}"{% if notice.translations[lang] is not defined %} hidden{% endif %}>{{ title }}</button>
                                {% endfor %}
                                <select class="form-select form-select-sm w-auto" data-cf-add-lang aria-label="{{ 'Add language'|trans }}">
                                    <option value="">+ {{ 'Add language'|trans }}</option>
                                    {% for lang, title in language_names|filter((t, l) => l != notice.default_locale and notice.translations[l] is not defined) %}
                                        <option value="{{ lang }}">{{ title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <div data-cf-pane="">
                            <div class="mb-3">
                                <label class="form-label" for="cookie-message">{{ 'Message'|trans }}</label>
                                <textarea class="form-control" rows="4" maxlength="1000" name="message" id="cookie-message" placeholder="{{ builtin.message }}" data-cf-field="message">{{ notice.message }}</textarea>
                                <div class="form-hint">{{ 'Leave blank to show the built-in text in each visitor\'s language.'|trans }}</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="cookie-button">{{ 'Button text'|trans }}</label>
                                <input class="form-control" type="text" maxlength="40" name="button" id="cookie-button" value="{{ notice.button }}" placeholder="{{ builtin.button }}" data-cf-field="button">
                            </div>
                        </div>
                        {% for lang, title in language_names|filter((t, l) => l != notice.default_locale) %}
                            {% set own = notice.translations[lang] ?? {} %}
                            {% set rtl = lang[:2] in ['ar', 'he', 'fa'] %}
                            <div data-cf-pane="{{ lang }}" hidden>
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                    <label class="form-label mb-0" for="cookie-message-{{ lang }}">{{ 'Message'|trans }} <span class="badge bg-blue-lt ms-1">{{ title }}</span></label>
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-cf-remove-lang>{{ 'Remove'|trans }}</button>
                                </div>
                                <textarea class="form-control mb-3" rows="4" maxlength="1000" name="translations[{{ lang }}][message]" id="cookie-message-{{ lang }}" placeholder="{{ notice.builtin[lang].message }}" lang="{{ lang[:2] }}"{% if rtl %} dir="rtl"{% endif %} data-cf-field="message">{{ own.message ?? '' }}</textarea>
                                <label class="form-label" for="cookie-button-{{ lang }}">{{ 'Button text'|trans }} <span class="badge bg-blue-lt ms-1">{{ title }}</span></label>
                                <input class="form-control mb-3" type="text" maxlength="40" name="translations[{{ lang }}][button]" id="cookie-button-{{ lang }}" value="{{ own.button ?? '' }}" placeholder="{{ notice.builtin[lang].button }}" lang="{{ lang[:2] }}"{% if rtl %} dir="rtl"{% endif %} data-cf-field="button">
                            </div>
                        {% endfor %}
                        {# A turned-off language keeps its texts. #}
                        {% for lang, own in notice.translations|filter((o, l) => language_names[l] is not defined) %}
                            <input type="hidden" name="translations[{{ lang }}][message]" value="{{ own.message }}">
                            <input type="hidden" name="translations[{{ lang }}][button]" value="{{ own.button }}">
                        {% endfor %}
                        <div class="mb-3">
                            <label class="form-label" for="cookie-privacy-url">{{ 'Privacy Policy'|trans }}</label>
                            <input class="form-control" type="url" maxlength="300" name="privacy_url" id="cookie-privacy-url" value="{{ notice.privacy_url }}" placeholder="https://">
                            <div class="form-text">{{ 'Empty: no link.'|trans }}</div>
                        </div>
                        <div>
                            <label class="form-label" for="cookie-position">{{ 'Position'|trans }}</label>
                            <select class="form-select" name="position" id="cookie-position">
                                <option value="bar"{% if notice.position == 'bar' %} selected{% endif %}>{{ 'Bar along the bottom'|trans }}</option>
                                <option value="card"{% if notice.position == 'card' %} selected{% endif %}>{{ 'Card in the bottom corner'|trans }}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span class="form-label">{{ 'Preview'|trans }}</span>
                        <div class="ratio ratio-4x3 border rounded bg-body-tertiary overflow-hidden" aria-hidden="true">
                            <div>
                                <div id="cookie-preview" class="position-absolute bottom-0 start-0 d-flex flex-wrap align-items-center justify-content-center gap-2 p-3 bg-body shadow-sm small">
                                    <p class="m-0">
                                        <span id="cookie-preview-message"></span>
                                        <span class="link-primary text-decoration-underline" id="cookie-preview-link">{{ 'Privacy Policy'|trans }}</span>
                                    </p>
                                    <span class="btn btn-primary btn-sm" id="cookie-preview-button"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
            </div>
        </form>
    </div>
    <script nonce="{{ csp_nonce }}">
        (() => {
            const form = document.getElementById('cookie-form');
            const fields = form.elements;
            const preview = document.getElementById('cookie-preview');
            let lang = '';
            // The preview shows the language tab that is open; a blank field shows its hint, the built-in text.
            const field = (name) => form.querySelector('[data-cf-pane="' + lang + '"] [data-cf-field="' + name + '"]');
            const update = () => {
                const card = fields.position.value === 'card';
                document.getElementById('cookie-preview-message').textContent = field('message').value.trim() || field('message').placeholder;
                document.getElementById('cookie-preview-button').textContent = field('button').value.trim() || field('button').placeholder;
                document.getElementById('cookie-preview-link').hidden = fields.privacy_url.value.trim() === '';
                preview.classList.toggle('end-0', !card);
                preview.classList.toggle('border-top', !card);
                preview.classList.toggle('m-3', card);
                preview.classList.toggle('w-50', card);
                preview.classList.toggle('flex-column', card);
                preview.classList.toggle('align-items-stretch', card);
                preview.classList.toggle('border', card);
                preview.classList.toggle('rounded-3', card);
            };
            const bar = document.getElementById('cookie-langs');
            const show = (next) => {
                lang = next;
                bar.querySelectorAll('[data-cf-lang]').forEach((button) => {
                    const on = button.dataset.cfLang === lang;
                    button.classList.toggle('btn-primary', on);
                    button.classList.toggle('btn-outline-secondary', !on);
                    button.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                form.querySelectorAll('[data-cf-pane]').forEach((pane) => { pane.hidden = pane.dataset.cfPane !== lang; });
                update();
            };
            if (bar) {
                const add = bar.querySelector('[data-cf-add-lang]');
                bar.addEventListener('click', (e) => {
                    const button = e.target.closest('[data-cf-lang]');
                    if (button) {
                        show(button.dataset.cfLang);
                    }
                });
                // A new language starts from the default texts, or the built-in ones in that language.
                add.addEventListener('change', () => {
                    const next = add.value;
                    if (next === '') {
                        return;
                    }
                    bar.querySelector('[data-cf-lang="' + next + '"]').hidden = false;
                    add.selectedOptions[0].remove();
                    form.querySelectorAll('[data-cf-pane="' + next + '"] [data-cf-field]').forEach((input) => {
                        input.value = form.querySelector('[data-cf-pane=""] [data-cf-field="' + input.dataset.cfField + '"]').value.trim() || input.placeholder;
                    });
                    show(next);
                });
                // Removing empties the language's fields: saved blank, it shows the default texts.
                form.addEventListener('click', (e) => {
                    if (!e.target.closest('[data-cf-remove-lang]')) {
                        return;
                    }
                    const button = bar.querySelector('[data-cf-lang="' + lang + '"]');
                    form.querySelectorAll('[data-cf-pane="' + lang + '"] [data-cf-field]').forEach((input) => { input.value = ''; });
                    button.hidden = true;
                    add.add(new Option(button.textContent.trim(), lang));
                    show('');
                });
            }
            form.addEventListener('input', update);
            update();
        })();
    </script>
{% endblock %}
