{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}

{# ClientFence core patch: a payment form is headed by its invoice and amount; only the redirect step is "processing" (GitHub #11). #}
{% set heading = payment.type == 'form' ? 'Processing Payment...'|trans : 'Pay invoice :number'|trans({ ':number': '#' ~ invoice.serie_nr }) %}

{% block meta_title %}{{ heading }}{% endblock %}

    {% block breadcrumb %}
        <li class="breadcrumb-item"><a href="{{ 'invoice'|url }}">{{ 'Invoices'|trans }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Payment'|trans }}</li>
    {% endblock %}

{% block content %}

<div class="row">
    <div class="col-md-12">
        {# ClientFence core patch: the invoice and its amount due first as the key figure (amber), the gateway's own part in the card below (CF-135 redesign). #}
        <section class="card cf-pay-hero mb-4{{ payment.type == 'form' ? '' : ' is-warn' }}">
            <div class="cf-pay-hero-text">
                <h1 class="bf-page-title mb-0">{{ heading }}</h1>
                {% if payment.type == 'form' %}<span class="bf-hint">{{ 'Thank you for your patience.'|trans }}</span>{% endif %}
            </div>
            {% if payment.type != 'form' %}
                <div class="cf-pay-hero-figure">
                    <span>{{ 'Amount due'|trans }}</span>
                    <strong>{{ invoice.balance_due|format_currency(invoice.currency) }}</strong>
                </div>
            {% endif %}
        </section>
        <div class="card mb-4">
            <div class="card-body">
                {% if payment.type == 'html' %}
                    {{ payment.result|raw }}
                {% endif %}
                {% if payment.type == 'form' %}
                    <h2>{{ 'Redirecting to Payment Gateway...'|trans }}</h2>
                    <form method="post" action="{{ payment.service_url }}" name="payment_form">
                            {% for key, value in payment.result %}
                                <input type="hidden" name="{{ key }}" value="{{ value }}" />
                            {% endfor %}
                        <input class="btn btn-primary" type="submit" value="{{ 'Please click here to continue if this page does not redirect automatically in 5 seconds'|trans }}" id="payment_button"/>
                    </form>

                    <script nonce="{{ csp_nonce }}">
                        document.addEventListener('DOMContentLoaded', function() {
                            document.getElementById('payment_button').style.display = 'none';
                            document.forms["payment_form"].submit();
                        });
                    </script>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
