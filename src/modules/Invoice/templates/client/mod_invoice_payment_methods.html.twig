{# ClientFence: the client's saved cards and PayPal account (/payment-methods, Invoice/SavedCards.php): the method
   invoices are charged to automatically, other saved cards, adding a card with Stripe's card form, and
   removing one. The card form runs in assets/src/js/cards.js. cards comes from invoice_card_list. #}
{% extends "layout_default.html.twig" %}
{% set active_menu = 'payment-methods' %}

{% block meta_title %}{{ 'Payment methods'|trans }}{% endblock %}
{% block page_header %}{{ 'Payment methods'|trans }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Payment methods'|trans }}</li>{% endblock %}

{% block content %}
<div class="page-heading">
    <h1>{{ 'Payment methods'|trans }}</h1>
    {% if cards.available or cards.paypal %}
    <p>{{ 'The payment method marked "Pays invoices automatically" pays your invoices when they are due. You can also save one when you pay an invoice.'|trans }}</p>
    {% endif %}
</div>

{% if not cards.available and not cards.paypal %}
    <div class="alert alert-info" role="status">{{ 'Saved payment methods are not available.'|trans }}</div>
{% else %}
<div data-clientfence-cards data-return-url="{{ 'payment-methods'|url }}">
    {% if cards.paypal %}
    {# ClientFence: a saved PayPal account (Invoice/SavedCards.php): saved through PayPal's own approval page. #}
    <div class="card mb-4">
        <div class="card-header"><h2>PayPal</h2></div>
        {% if cards.paypal.account %}
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span dir="ltr">{{ cards.paypal.account }}</span>
                    <span class="d-flex flex-wrap align-items-center gap-2">
                        {% if cards.paypal.default %}
                            <span class="badge text-bg-success">{{ 'Pays invoices automatically'|trans }}</span>
                        {% else %}
                            <button class="btn btn-sm btn-outline-primary" type="button" data-clientfence-card-call="invoice/paypal_default">{{ 'Use for invoices'|trans }}</button>
                        {% endif %}
                        <button class="btn btn-sm btn-outline-danger" type="button" data-clientfence-card-call="invoice/paypal_remove" data-confirm="{{ 'Remove this PayPal account?'|trans }}">{{ 'Remove'|trans }}</button>
                    </span>
                </li>
            </ul>
        {% else %}
            <div class="card-body">
                <p class="text-secondary">{{ 'Save your PayPal account to pay your invoices automatically.'|trans }}</p>
                <a class="btn btn-primary" href="{{ 'payment-methods/paypal'|url }}">{{ 'Save my PayPal account'|trans }}</a>
            </div>
        {% endif %}
    </div>
    {% endif %}
    {% if cards.available %}
    <div class="card mb-4">
        <div class="card-header"><h2>{{ cards.bank ? 'Saved cards and bank accounts'|trans : 'Saved cards'|trans }}</h2></div>
        {% if cards.cards is empty %}
            <div class="card-body"><p class="mb-0 text-secondary">{{ cards.bank ? 'You have no saved cards or bank accounts.'|trans : 'You have no saved cards.'|trans }}</p></div>
        {% else %}
            <ul class="list-group list-group-flush">
                {% for card in cards.cards %}
                    <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span dir="ltr">{{ card.card }}</span>
                        <span class="d-flex flex-wrap align-items-center gap-2">
                            {% if card.default %}
                                <span class="badge text-bg-success">{{ 'Pays invoices automatically'|trans }}</span>
                            {% else %}
                                <button class="btn btn-sm btn-outline-primary" type="button" data-clientfence-card-call="invoice/card_default" data-id="{{ card.id }}">{{ 'Use for invoices'|trans }}</button>
                            {% endif %}
                            <button class="btn btn-sm btn-outline-danger" type="button" data-clientfence-card-call="invoice/card_remove" data-id="{{ card.id }}" data-confirm="{{ cards.bank ? 'Remove this payment method?'|trans : 'Remove this card?'|trans }}">{{ 'Remove'|trans }}</button>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="card">
        <div class="card-header"><h2>{{ cards.bank ? 'Add a card or bank account'|trans : 'Add a card'|trans }}</h2></div>
        <div class="card-body">
            <button class="btn btn-primary" type="button" data-clientfence-card-add>{{ cards.bank ? 'Add a card or bank account'|trans : 'Add a card'|trans }}</button>
            <form data-clientfence-card-form hidden>
                <div class="mb-3" data-clientfence-card-element></div>
                <button class="btn btn-primary" type="submit">{{ cards.bank ? 'Save'|trans : 'Save card'|trans }}</button>
            </form>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}
{% endblock %}
