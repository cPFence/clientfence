{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'invoice' %}

{% block meta_title %}{{ 'Subscription'|trans }} {{ subscription.sid }}{% endblock %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'invoice/subscriptions'|url }}">{{ 'Subscriptions'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Subscription'|trans }} #{{ subscription.id }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% embed 'partial_admin_detail_tabs.html.twig' with {
        title: 'Subscription'|trans ~ ' ' ~ subscription.sid
    } %}
        {% block detail_tabs %}
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" href="#tab-index" data-bs-toggle="tab" role="tab">{{ 'Subscription'|trans }}</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" href="#tab-manage" data-bs-toggle="tab" role="tab">{{ 'Manage'|trans }}</a>
                        </li>
        {% endblock %}

        {% block detail_tab_content %}
            {% import 'macro_functions.html.twig' as mf %}
            <div class="tab-pane fade show active" id="tab-index" role="tabpanel">
                <div class="card-body">
                    {% embed 'partial_admin_summary_card.html.twig' with {
                        title: 'Subscription Details'|trans,
                        centered_actions: true
                    } %}
                        {% import 'macro_functions.html.twig' as mf %}
                        {% block summary_content %}
                            {# ClientFence core patch: the summary reads first: the amount per period in its status colour, the status chip, the client, then the facts (CF-135 redesign). #}
                            {% set tone = subscription.status == 'active' ? 'ok' : (subscription.status == 'pending_cancellation' ? 'warn' : 'muted') %}
                            <div class="cf-inv cf-pay">
                                <div class="cf-inv-hero">
                                    <div>
                                        <div class="cf-inv-figure cf-tone-{{ tone }}">{{ subscription.amount|format_currency(subscription.currency ?? default_currency) }}</div>
                                        <div class="text-secondary">{{ subscription.period|period_title }}</div>
                                    </div>
                                    <div class="cf-inv-chips">
                                        {{ mf.status_badge(subscription.status, 'subscription') }}
                                    </div>
                                </div>
                                <div class="cf-inv-client">
                                    <span class="cf-avatar" aria-hidden="true">{{ (subscription.client.first_name|first ~ subscription.client.last_name|first)|upper }}</span>
                                    <div class="cf-inv-who">
                                        <a href='{{ "client/manage/#{subscription.client.id}"|url }}'>{{ subscription.client.first_name }} {{ subscription.client.last_name }}</a>
                                    </div>
                                </div>
                                <dl class="cf-facts">
                                    <div><dt>{{ 'Payment Gateway'|trans }}</dt><dd>{{ subscription.gateway.title }}</dd></div>
                                    <div><dt>{{ 'Subscription ID on Payment Gateway'|trans }}</dt><dd>{{ subscription.sid|default('-') }}</dd></div>
                                    <div><dt>{{ 'Created At'|trans }}</dt><dd>{{ subscription.created_at|format_date }}</dd></div>
                                    {% if subscription.created_at != subscription.updated_at %}
                                    <div><dt>{{ 'Updated At'|trans }}</dt><dd>{{ subscription.updated_at|format_date }}</dd></div>
                                    {% endif %}
                                </dl>
                            </div>
                        {% endblock %}

                        {% block summary_actions %}
                            <a class="btn btn-danger" href="{{ 'invoice/subscription_delete'|api_url(query: { 'id': subscription.id }) }}"
                                {{ fb_api_link({modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'invoice/subscriptions'|url}) }}>
                                <svg class="icon icon-tabler" width="24" height="24">
                                    <use href="#trash" />
                                </svg>
                                <span>{{ 'Delete'|trans }}</span>
                            </a>
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>

            <div class="tab-pane fade" id="tab-manage" role="tabpanel">
                <div class="card-body">
                    <form method="post" action="{{ 'invoice/subscription_update'|api_url }}" {{ fb_api_form({reload: true}) }}>
                        {% embed 'partial_admin_form_card.html.twig' with {
                            title: 'Subscription Settings'|trans,
                            subtitle: 'Update the stored recurring billing settings and gateway subscription reference.'|trans
                        } %}
                            {% import 'macro_functions.html.twig' as mf %}
                            {% block form_content %}
                                <div class="row g-3">
                                    <div class="col-xl-6">
                                        <label class="form-label">{{ 'Payment Gateway'|trans }}</label>
                                        {{ mf.selectbox('gateway_id', admin.invoice_gateway_get_pairs, subscription.gateway.id, 0, 'Select Payment Gateway'|trans) }}
                                    </div>
                                    <div class="col-xl-6">
                                        <label class="form-label" for="subscription_sid">{{ 'Subscription ID on Payment Gateway'|trans }}</label>
                                        <input class="form-control" id="subscription_sid" type="text" name="sid" value="{{ subscription.sid }}" required>
                                    </div>
                                    <div class="col-xl-6">
                                        <label class="form-label d-block">{{ 'Status'|trans }}</label>
                                        <div class="d-flex flex-wrap gap-3">
                                            <label class="form-check">
                                                <input class="form-check-input" id="radioStatusActive" type="radio" name="status" value="active"{% if subscription.status == 'active' %} checked{% endif %}>
                                                <span class="form-check-label">{{ 'Active'|trans }}</span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" id="radioStatusCanceled" type="radio" name="status" value="canceled"{% if subscription.status == 'canceled' %} checked{% endif %}>
                                                <span class="form-check-label">{{ 'Canceled'|trans }}</span>
                                            </label>
                                        </div>
                                        {% if subscription.status == 'pending_cancellation' %}
                                            <div class="form-hint">{{ 'Cancellation is scheduled at the payment gateway. Select a different status only to override the synchronized state.'|trans }}</div>
                                        {% endif %}
                                    </div>
                                    <div class="col-xl-6">
                                        <label class="form-label">{{ 'Period'|trans }}</label>
                                        {{ mf.selectbox('period', guest.system_periods, subscription.period, 1, 'Select Period'|trans) }}
                                    </div>
                                    <div class="col-xl-6">
                                        <label class="form-label" for="subscription_amount">{{ 'Amount'|trans }}</label>
                                        <input class="form-control" id="subscription_amount" type="text" name="amount" value="{{ subscription.amount }}" required>
                                    </div>
                                    <div class="col-xl-6">
                                        <label class="form-label">{{ 'Currency'|trans }}</label>
                                        {{ mf.selectbox('currency', guest.currency_get_pairs, subscription.currency, 1, 'Select Currency'|trans) }}
                                    </div>
                                </div>
                            {% endblock %}

                            {% block form_actions %}
                                <button class="btn btn-primary" type="submit">{{ 'Update Subscription'|trans }}</button>
                            {% endblock %}
                        {% endembed %}
                        <input type="hidden" name="id" value="{{ subscription.id }}">
                    </form>
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
