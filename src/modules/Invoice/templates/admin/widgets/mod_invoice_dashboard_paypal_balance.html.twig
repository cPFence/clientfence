{# The PayPal balance of each enabled PayPal gateway whose "PayPal balance on the dashboard" is on (PayPal Email with its
   REST API keys, PayPal Auto-Pay), as WHMCS's gateway balance widget. Slot admin.index.dashboard; invoice_paypal_balances
   asks PayPal at most every 10 minutes. #}
{% if admin.system_is_allowed({ 'mod': 'invoice' }) %}
    {% for paypal in admin.invoice_paypal_balances %}
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm h-100">
                <div class="card-body d-flex align-items-center h-100">
                    <div class="row align-items-center w-100">
                        <div class="col-auto">
                            <span class="bg-blue text-white avatar">
                                <svg class="icon">
                                    <use href="#currency-dollar" />
                                </svg>
                            </span>
                        </div>
                        <div class="col">
                            {% for balance in paypal.balances %}
                                <div class="font-weight-medium">{{ balance.amount|format_currency(balance.currency) }}</div>
                            {% else %}
                                <div class="text-muted">{{ paypal.error ?: 'No balance.'|trans }}</div>
                            {% endfor %}
                            <div class="text-muted">{{ 'PayPal balance (:gateway)'|trans({ ':gateway': paypal.gateway }) }}{% if paypal.test_mode %} · {{ 'Test mode'|trans }}{% endif %}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
