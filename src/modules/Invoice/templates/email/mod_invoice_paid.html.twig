{% block subject %}[{{ guest.system_company.name }}] {{ 'Payment received: invoice #%number%'|trans({'%number%': invoice.serie_nr|default('')}) }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ 'Payment received'|trans }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f4f8;">
<div style="display:none; max-height:0; overflow:hidden;">{{ 'Thank you for your payment of %total%.'|trans({'%total%': invoice.total|default(0)|format_currency(invoice.currency|default(default_currency))}) }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f4f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
	<tr><td style="padding:20px 32px; border-bottom:3px solid {{ guest.system_company.brand_color|default('#2563eb') }};">
		{% if guest.system_company.logo_url|default('') %}
		<img src="{{ guest.system_company.logo_url }}" alt="{{ guest.system_company.name }}" height="40" style="display:block; height:40px; width:auto; border:0;">
		{% else %}
		<span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#0f172a;">{{ guest.system_company.name }}</span>
		{% endif %}
	</td></tr>
	<tr><td style="padding:32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px; color:#334155;">
		<h1 style="margin:0 0 16px; font-size:22px; line-height:30px; color:#0f172a;">{{ 'Payment received'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Thank you! We have received your payment for invoice %number%. This email is your receipt.'|trans_html({}, {'%number%': '<strong>#' ~ (invoice.serie_nr|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Invoice number'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">#{{ invoice.serie_nr|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Amount paid'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ invoice.total|default(0)|format_currency(invoice.currency|default(default_currency)) }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Date paid'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ invoice.paid_at|default('')|format_date }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Invoice date'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ invoice.created_at|default('')|format_date }}</td></tr>
					{% for order in invoice.orders|default([]) %}
					<tr><td colspan="2" style="padding:8px 0 0; border-top:1px solid #e2e8f0;"></td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Order'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">#{{ order.id }}{% if order.product_name %} &middot; {{ order.product_name }}{% endif %}</td></tr>
					{% if order.expires_at %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Renewal date'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ order.expires_at|format_date }}</td></tr>{% endif %}
					{% endfor %}
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td style="border-radius:6px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }};">
				<a href="{{ "invoice/#{invoice.hash|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'View invoice'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'You can also %link%download the invoice as a PDF%link_end% for your records.'|trans_html({}, {'%link%': '<a href="' ~ ("invoice/pdf/#{invoice.hash|default('')}"|url(area: 'client'))|e ~ '" target="_blank" style="color:' ~ (guest.system_company.brand_link|default('#2563eb'))|e ~ ';">', '%link_end%': '</a>'}) }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
	</td></tr>
	<tr><td style="padding:20px 32px; border-top:1px solid #e2e8f0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
		{{ guest.system_company.name }}{% if guest.system_company.address_1|default('') %} &middot; {{ guest.system_company.address_1 }}{% endif %}<br>
		<a href="{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Client area'|trans }}</a> &middot; <a href="{{ 'client/profile'|url(area: 'client') }}" target="_blank" style="color:#64748b;">{{ 'Profile'|trans }}</a>{% if guest.system_company.email|default('') %} &middot; {% endif %}{% if guest.system_company.email|default('') %}<a href="mailto:{{ guest.system_company.email }}" style="color:#64748b;">{{ guest.system_company.email }}</a>{% endif %}
	</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{% endblock %}
