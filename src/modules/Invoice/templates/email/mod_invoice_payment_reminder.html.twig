{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Payment reminder: invoice #%number%'|trans({'%number%': invoice.serie_nr|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Payment reminder'|trans }}{% endset %}
{% set email_preheader %}{{ 'Invoice #%number% is due on %due_at%.'|trans({'%number%': invoice.serie_nr|default(''), '%due_at%': invoice.due_at|default('')|format_date}) }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Payment reminder'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{% set days_left = invoice.due_at|default('')|daysleft %}{% if days_left > 0 %}{{ 'This is a friendly reminder that invoice %number% is due in %days% days, on %date%.'|trans_html({'%days%': days_left, '%date%': invoice.due_at|default('')|format_date}, {'%number%': '<strong>#' ~ (invoice.serie_nr|default(''))|e ~ '</strong>'}) }}{% elseif days_left == 0 %}{{ 'This is a friendly reminder that invoice %number% is due today.'|trans_html({}, {'%number%': '<strong>#' ~ (invoice.serie_nr|default(''))|e ~ '</strong>'}) }}{% else %}{{ 'This is a friendly reminder that invoice %number% was due on %date%. Please arrange payment as soon as possible.'|trans_html({'%date%': invoice.due_at|default('')|format_date}, {'%number%': '<strong>#' ~ (invoice.serie_nr|default(''))|e ~ '</strong>'}) }}{% endif %}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Invoice number'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top; font-weight:bold;"><span dir="ltr">#{{ invoice.serie_nr|default('') }}</span></td></tr>
					{% if invoice.po_number|default('') %}<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'PO number'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ invoice.po_number }}</td></tr>{% endif %}
					<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Amount due'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top; font-weight:bold;">{{ (invoice.balance_due ?? invoice.total)|default(0)|format_currency(invoice.currency|default(default_currency)) }}</td></tr>
					<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Due date'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ invoice.due_at|default('')|format_date }}</td></tr>
					{% for order in invoice.orders|default([]) %}
					<tr><td colspan="2" style="padding:8px 0 0; border-top:1px solid #e4eaee;"></td></tr>
					<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Order'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">#{{ order.id }}{% if order.product_name %} &middot; {{ order.product_name }}{% endif %}</td></tr>
					{% if order.expires_at %}<tr><td style="padding:4px 6px; color:#64748b; vertical-align:top;">{{ 'Renewal date'|trans }}</td><td align="right" style="padding:4px 6px; vertical-align:top;">{{ order.expires_at|format_date }}</td></tr>{% endif %}
					{% endfor %}
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "invoice/#{invoice.hash|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Pay invoice'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'You can also %link%download the invoice as a PDF%link_end%. If you have already paid, please disregard this message.'|trans_html({}, {'%link%': '<a href="' ~ ("invoice/pdf/#{invoice.hash|default('')}"|url(area: 'client'))|e ~ '" target="_blank" style="color:' ~ (guest.system_company.brand_link|default('#2563eb'))|e ~ ';">', '%link_end%': '</a>'}) }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
