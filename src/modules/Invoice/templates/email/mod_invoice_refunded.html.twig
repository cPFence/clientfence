{% block subject %}[{{ guest.system_company.name }}] {{ 'Refund of invoice %number%'|trans({'%number%': invoice.serie_nr|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence: as WHMCS "Invoice Refund Confirmation", sent to the client for each refund of an invoice (Invoice\Service::refundInvoice()). #}
{% set refund = refund|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
		h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
		p { margin: 0 0 10px; }
		.signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
	</style>
</head>
<body>
	<h1>{{ 'Invoice refund'|trans }}</h1>
	<p>{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
	<p>{{ 'We have refunded %amount% of invoice %number%.'|trans({'%amount%': refund.amount|default(0)|format_currency(invoice.currency|default(default_currency)), '%number%': invoice.serie_nr|default('')}) }}</p>
	<p>{% if refund.to_credit|default(false) %}{{ 'The amount was added to your account credit.'|trans }}{% else %}{{ 'It is returned to you by the payment method you paid with.'|trans }}{% endif %}</p>
	<p><a href="{{ ('invoice/' ~ invoice.hash|default(''))|url(area: 'client') }}" target="_blank">{{ 'View invoice'|trans }}</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
