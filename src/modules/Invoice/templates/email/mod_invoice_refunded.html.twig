{% block subject %}[{{ guest.system_company.name }}] {{ 'Refund of invoice %number%'|trans({'%number%': invoice.serie_nr|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Invoice refund'|trans }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Invoice refund'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'We have refunded %amount% of invoice %number%.'|trans({'%amount%': refund.amount|default(0)|format_currency(invoice.currency|default(default_currency)), '%number%': invoice.serie_nr|default('')}) }}</p>
		<p style="margin:0 0 16px;">{% if refund.to_credit|default(false) %}{{ 'The amount was added to your account credit.'|trans }}{% else %}{{ 'It is returned to you by the payment method you paid with.'|trans }}{% endif %}</p>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ ('invoice/' ~ invoice.hash|default(''))|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'View invoice'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
