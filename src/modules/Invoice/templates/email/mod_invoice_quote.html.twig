{% block subject %}[{{ guest.system_company.name }}] {{ 'Quote #%id%: %subject%'|trans({'%id%': quote.id|default(''), '%subject%': quote.subject|default('')}) }}{% endblock %}
{% block content %}
{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% set email_title %}{{ 'Quote #%id%'|trans({'%id%': quote.id|default('')}) }}{% endset %}
{% set email_preheader %}{{ 'Our quote for %subject%.'|trans({'%subject%': quote.subject|default('')}) }}{% endset %}
{% set email_audience = 'guest' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Quote #%id%'|trans({'%id%': quote.id|default('')}) }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %name%,'|trans({'%name%': quote.recipient.name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'Thank you for your interest. Please find our quote for %subject% below; the PDF is attached to this email.'|trans_html({}, {'%subject%': '<strong>' ~ (quote.subject|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Quote'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">#{{ quote.id|default('') }}</td></tr>
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Total'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ quote.total|default(0)|format_currency(quote.currency|default(default_currency)) }}</td></tr>
					{% if quote.valid_until|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Valid until'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ quote.valid_until|default('')|format_date }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ quote_link|default('') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'View and accept quote'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 16px;">{{ 'Once you accept the quote, we send you the invoice. Questions? Just reply to this email.'|trans }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
