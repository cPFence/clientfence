{% block subject %}[{{ guest.system_company.name }}] Quote #{{ quote.id|default('') }}: {{ quote.subject|default('') }}{% endblock %}
{% block content %}
{# ClientFence: a quote sent by staff (ClientFence\Mod\Invoice\Quotes::send()), to a client or a
   prospect, with the quote PDF attached. `quote_link` opens it without signing in. #}
{% set quote = quote|default({}) %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>Quote #{{ quote.id|default('') }}</h1>
	<p>Hello {{ quote.recipient.name|default('') }},</p>
	<p>Here is our quote for <strong>{{ quote.subject|default('') }}</strong>. The PDF is attached.</p>
	<ul>
		<li><strong>Total:</strong> {{ quote.total|default(0)|format_currency(quote.currency|default(default_currency)) }}</li>
		{% if quote.valid_until|default('') %}
			<li><strong>Valid until:</strong> {{ quote.valid_until|format_date }}</li>
		{% endif %}
	</ul>
	<p><a href="{{ quote_link|default('') }}" target="_blank">View and accept the quote</a>. When you accept it, we send you the invoice.</p>
	<p>Questions? Just reply to this email.</p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
