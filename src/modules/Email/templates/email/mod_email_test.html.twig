{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'ClientFence Email Test'|trans }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Email test'|trans }}{% endset %}
{% set email_audience = 'staff' %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your email settings work'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Hello %staff_member_name%,'|trans({'%staff_member_name%': staff_member_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'If you are reading this email, ClientFence is %bold%configured properly%bold_end% and is %bold%able to send emails%bold_end%. No further action is needed.'|trans_html({}, {'%bold%': '<strong>', '%bold_end%': '</strong>'}) }}</p>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
