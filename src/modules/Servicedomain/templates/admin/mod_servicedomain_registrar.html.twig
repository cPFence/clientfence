{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% block meta_title %}{{ 'Registrar'|trans }} {{ registrar.title }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicedomain'|url }}">{{ 'Domain Management'|trans }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicedomain'|url }}#tab-registrars">{{ 'Registrars'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ registrar.title }}</li>
    </ol>
{% endblock %}

{% block content %}
{# ClientFence core patch: the registrar reads first: its name, adapter and test mode, with its TLDs and prices; the form follows (CF-135 redesign). #}
<div class="card cf-hero-card mb-3">
    <div class="cf-inv">
        <div class="cf-inv-client cf-client-hero">
            <span class="cf-avatar cf-avatar-lg cf-tile" aria-hidden="true">{{ registrar.title|first|upper }}</span>
            <div class="cf-inv-who">
                <span class="cf-client-name">{{ registrar.title }}</span>
                {% if registrar.label|default('') and registrar.label != registrar.title %}<span class="text-secondary">{{ registrar.label }}</span>{% endif %}
                <div class="cf-inv-chips mt-1">
                    <span class="badge {{ registrar.test_mode ? 'bg-yellow-lt' : 'bg-green-lt' }}">{{ 'Test Mode'|trans }}: {{ registrar.test_mode ? 'Yes'|trans : 'No'|trans }}</span>
                </div>
            </div>
            <a class="btn ms-auto" href='{{ "servicedomain/registrar/#{registrar.id}/prices"|url }}'>
                <svg class="icon"><use href="#currency-dollar" /></svg>
                <span>{{ 'TLDs and prices'|trans }}</span>
            </a>
        </div>
    </div>
</div>
<div>
    <form method="post" action="{{ 'servicedomain/registrar_update'|api_url }}" id="registrar-update" {{ fb_api_form({message: 'Registrar Updated'|trans}) }}>
        {% embed 'partial_admin_form_card.html.twig' with {
            title: 'Details'|trans,
            card_class: 'mb-0'
        } %}
            {% import 'macro_functions.html.twig' as mf %}
            {% block form_content %}
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">{{ 'Registrar Title'|trans }}</label>
                        <input class="form-control" type="text" name="title" value="{{ registrar.title }}">
                    </div>
                    <div class="col-12">
                        <label class="form-label d-block">{{ 'Enable Test Mode'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="radioTestModeYes" type="radio" name="test_mode" value="1"{% if registrar.test_mode %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="radioTestModeNo" type="radio" name="test_mode" value="0"{% if not registrar.test_mode %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="d-flex flex-column gap-1 mb-4 cf-section-head">
                        <h6 class="card-title mb-0">{{ 'Adapter Settings'|trans }}</h6>
                        <p class="text-secondary mb-0">{{ 'Provide the credentials and connection details required by this registrar adapter.'|trans }}</p>
                    </div>
                    {{ mf.build_form(registrar.form, registrar.config, {'test_mode': registrar.test_mode}, registrar.secret_fields) }}
                </div>

                <input type="hidden" name="id" value="{{ registrar.id }}">
            {% endblock %}

            {% block form_actions %}
                {# ClientFence core patch: saves, then checks the registrar answers with these settings (like the hosting server page). #}
                {% if registrar.registrar not in ['Custom', 'Email'] %}
                <button class="btn btn-outline-primary" id="registrar-test" type="button" data-cf-connected="{{ 'Connected in :seconds s'|trans }}">{{ 'Update and Test Connection'|trans }}</button>
                {% endif %}
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}

{% block js %}
<script nonce="{{ csp_nonce }}">
    (function () {
        const form = document.getElementById('registrar-update');
        const button = document.getElementById('registrar-test');

        if (!form || !button) {
            return;
        }

        const fail = function (error) {
            button.disabled = false;
            ClientFence.ui.notify(error.message, 'error');
        };

        button.addEventListener('click', function () {
            if (!form.reportValidity()) {
                return;
            }
            button.disabled = true;
            // Save first: the test reads the saved settings. A slow registrar may take up to 80 s.
            ClientFence.api.makeRequest('POST', ClientFence.tools.getBaseURL(form.getAttribute('action')), ClientFence.tools.serializeFormDataToJSON(new FormData(form)), function () {
                ClientFence.api.makeRequest('POST', ClientFence.tools.getBaseURL(form.getAttribute('action').replace('registrar_update', 'registrar_test_connection')), { id: form.elements.namedItem('id').value }, function (result) {
                    button.disabled = false;
                    ClientFence.ui.notify(button.dataset.cfConnected.replace(':seconds', result.seconds), 'success');
                }, fail, true, 90000);
            }, fail);
        });
    })();

    (function () {
        const testModeYes = document.getElementById('radioTestModeYes');
        const testModeNo = document.getElementById('radioTestModeNo');

        if (!testModeYes || !testModeNo) {
            return;
        }

        const managedInputs = document.querySelectorAll('[data-required-when-test-mode]');

        if (managedInputs.length === 0) {
            return;
        }

        function updateRequiredStates() {
            const testMode = testModeYes.checked;

            managedInputs.forEach(function (input) {
                const requiredTestMode = input.getAttribute('data-required-when-test-mode');
                if (String(testMode) === requiredTestMode) {
                    input.setAttribute('required', '');
                } else {
                    input.removeAttribute('required');
                }
            });
        }

        testModeYes.addEventListener('change', updateRequiredStates);
        testModeNo.addEventListener('change', updateRequiredStates);
    })();
</script>
{% endblock %}
