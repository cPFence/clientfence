{% import 'macro_functions.html.twig' as mf %}
<div class="card-body">
    <div class="card mb-4">
        {# ClientFence core patch: the domain reads first: its name, status, registrar and expiry, then the facts as a grid (CF-135 redesign). #}
        <div class="cf-inv cf-dom">
            <div class="cf-inv-hero">
                <div class="min-w-0">
                    <div class="cf-client-name"><a target="_blank" href="https://{{ service.domain }}"><bdi>{{ service.domain }}</bdi></a></div>
                    <div class="text-secondary">{{ 'Registrar'|trans }}: {{ service.registrar }}</div>
                </div>
                <div class="cf-inv-chips">
                    {{ mf.status_badge(order.status, 'order') }}
                    {% if service.expires_at %}
                        {% if date(service.expires_at) < date() %}
                            <span class="badge bg-red-lt">{{ 'Expired'|trans }} · {{ service.expires_at|format_date }}</span>
                        {% else %}
                            {% set days = service.expires_at|daysleft %}
                            <span class="badge {{ days <= 30 ? 'bg-yellow-lt' : 'bg-green-lt' }}">{{ 'Expires At'|trans }} · {{ service.expires_at|format_date }} · <bdi>{{ days }}</bdi> {{ 'day(s)'|trans }}</span>
                        {% endif %}
                    {% endif %}
                    {% if service.transfer_status %}
                        {% if service.transfer_status == 'pending' %}<span class="badge bg-azure-lt">{{ 'Transfer in progress'|trans }}</span>{% else %}<span class="badge bg-danger-lt">{{ 'Transfer not completed: see Orders > Failed actions'|trans }}</span>{% endif %}
                    {% endif %}
                </div>
            </div>
            <dl class="cf-facts">
                <div><dt>{{ 'Nameserver 1'|trans }}</dt><dd>{{ service.ns1|default('-') }}</dd></div>
                <div><dt>{{ 'Nameserver 2'|trans }}</dt><dd>{{ service.ns2|default('-') }}</dd></div>
                <div><dt>{{ 'Nameserver 3'|trans }}</dt><dd>{{ service.ns3|default('-') }}</dd></div>
                <div><dt>{{ 'Nameserver 4'|trans }}</dt><dd>{{ service.ns4|default('-') }}</dd></div>
                <div><dt>{{ 'Transfer Code'|trans }}</dt><dd>{{ service.transfer_code|default('-') }}</dd></div>
                <div><dt>{{ 'Locked'|trans }}</dt><dd id="locked-value">{{ mf.boolean_badge(service.locked, 'Yes'|trans, 'No'|trans, 'text-bg-danger', 'text-bg-success') }}</dd></div>
                <div><dt>{{ 'Privacy Protection'|trans }}</dt><dd id="privacy-value">{{ mf.boolean_badge(service.privacy, 'Enabled'|trans, 'Disabled'|trans, 'text-bg-danger', 'text-bg-success') }}</dd></div>
                <div><dt>{{ 'Registration/Renewal Years'|trans }}</dt><dd>{{ service.period }}</dd></div>
                <div><dt>{{ 'Registration Date'|trans }}</dt><dd>{{ service.registered_at|format_date }}</dd></div>
                <div><dt>{{ 'Expires At'|trans }}</dt><dd>
                    {{ service.expires_at|format_date }}
                    {# ClientFence core patch: a registrar expiry before the order's next due date (DomainSync.php). #}
                    {% if service.expires_at and order.expires_at and service.expires_at|slice(0, 10) < order.expires_at|slice(0, 10) %}
                        <span class="badge bg-warning-lt ms-1">{{ 'Before the next due date %date%'|trans({'%date%': order.expires_at|format_date}) }}</span>
                    {% endif %}
                </dd></div>
                <div><dt>{{ 'Last Synced'|trans }}</dt><dd id="synced-at-value">
                    {{ service.synced_at ? service.synced_at|format_date : 'Never'|trans }}
                    {% if service.sync_error %}<div class="text-danger small">{{ service.sync_error }}</div>{% endif %}
                </dd></div>
                {# ClientFence core patch: the Email registrar's requests waiting for staff (Servicedomain/DomainTickets.php). #}
                {% if service.requests|default(null) %}
                <div class="cf-facts-wide"><dt>{{ 'Waiting for Staff'|trans }}</dt><dd>
                    {% for text in service.requests.actions %}<div class="mb-2">{{ text|nl2br }}</div>{% endfor %}
                    <a href="{{ "support/ticket/#{service.requests.ticket_id}"|url }}">{{ 'Ticket #:id'|trans({':id': service.requests.ticket_id}) }}</a>
                </dd></div>
                {% endif %}
            </dl>
        </div>

        {# ClientFence core patch: Sync Now, Get EPP, Lock, Unlock and the privacy switch are Module Commands on the Details tab (mod_servicedomain_commands.html.twig). #}
    </div>

{% if service.requests|default(null) %}
    <form method="post" action="{{ 'servicedomain/requests_done'|api_url }}" {{ fb_api_form({message: 'Requests marked done'|trans, reload: true}) }}>
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-column gap-1 mb-4">
                    <h5 class="card-title mb-0">{{ 'Mark Requests Done'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ 'Make the changes at the registrar first. Marking them done stores the requested values on this domain and replies to the client on the ticket.'|trans }}</p>
                </div>
                <div class="row g-3">
                    {% if service.requests.actions.transfer_code is defined %}
                    <div class="col-lg-6">
                        <label class="form-label" for="requests-transfer-code">{{ 'Transfer Code (EPP)'|trans }}</label>
                        <input class="form-control" type="text" name="transfer_code" id="requests-transfer-code">
                    </div>
                    {% endif %}
                    <div class="col-lg-6">
                        <label class="form-label" for="requests-expires-at">{{ 'Expiry date at the registrar (optional)'|trans }}</label>
                        <input class="form-control" type="date" name="expires_at" id="requests-expires-at">
                    </div>
                </div>
                <input type="hidden" name="order_id" value="{{ order.id }}">
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button class="btn btn-primary" type="submit">{{ 'Mark Done'|trans }}</button>
            </div>
        </div>
    </form>
{% endif %}

{% if order.status == 'active' %}
    <form method="post" action="{{ 'servicedomain/update_nameservers'|api_url }}" {{ fb_api_form({message: 'Nameservers Updated'|trans}) }}>
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-column gap-1 mb-4">
                    <h5 class="card-title mb-0">{{ 'Nameservers'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ 'Update the authoritative nameservers assigned to this domain.'|trans }}</p>
                </div>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Nameserver 1'|trans }}</label>
                        <input class="form-control" type="text" name="ns1" value="{{ request.ns1|default(service.ns1) }}">
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Nameserver 2'|trans }}</label>
                        <input class="form-control" type="text" name="ns2" value="{{ request.ns2|default(service.ns2) }}">
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Nameserver 3'|trans }}</label>
                        <input class="form-control" type="text" name="ns3" value="{{ request.ns3|default(service.ns3) }}">
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Nameserver 4'|trans }}</label>
                        <input class="form-control" type="text" name="ns4" value="{{ request.ns4|default(service.ns4) }}">
                    </div>
                </div>
                <input type="hidden" name="order_id" value="{{ order.id }}">
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            </div>
        </div>
    </form>
{% endif %}

{# ClientFence core patch: also after a failed registration, to correct its domain fields before the retry. #}
{% if order.status in ['active', 'failed_setup'] %}
    <form method="post" action="{{ 'servicedomain/update'|api_url }}" {{ fb_api_form({message: 'Domain Data Updated'|trans}) }}>
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-column gap-1 mb-4">
                    <h5 class="card-title mb-0">{{ 'Domain Data'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ 'Maintain the registrar transfer code and renewal period stored for this service.'|trans }}</p>
                </div>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Transfer Code (EPP)'|trans }}</label>
                        <input class="form-control" type="text" name="transfer_code" value="{{ request.transfer_code|default(service.transfer_code) }}">
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Period'|trans }}</label>
                        <input class="form-control" type="text" name="period" value="{{ request.period|default(service.period) }}">
                    </div>
                </div>
                {# ClientFence core patch: the registrar's domain fields, saved in the order (correct them before a retry). #}
                {% if order.config.action|default('') in ['register', 'transfer'] %}
                    {% set fields = order.config.action == 'transfer' ? service.transfer_fields|default({}) : service.domain_fields|default({}) %}
                    {{ include('mod_servicedomain_domain_fields.html.twig', {tlds: [{tld: service.tld, domain_fields: fields}], prefix: 'domain_fields', values: order.config.domain_fields|default({})}) }}
                {% endif %}
                <input type="hidden" name="order_id" value="{{ order.id }}">
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            </div>
        </div>
    </form>
{% endif %}

{% if order.status == 'active' %}
    <form method="post" action="{{ 'servicedomain/update_contacts'|api_url }}" {{ fb_api_form({message: 'Domain Contact Details Updated'|trans}) }}>
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-column gap-1 mb-4">
                    <h5 class="card-title mb-0">{{ 'Domain Contact Details'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ 'Update the registration contact details that are sent to the domain registrar.'|trans }}</p>
                </div>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'First Name'|trans }}</label>
                        <input class="form-control" type="text" name="contact[first_name]" value="{{ request.first_name|default(service.contact.first_name) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Last Name'|trans }}</label>
                        <input class="form-control" type="text" name="contact[last_name]" value="{{ request.last_name|default(service.contact.last_name) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Email'|trans }}</label>
                        <input class="form-control" type="text" name="contact[email]" value="{{ request.email|default(service.contact.email) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Company'|trans }}</label>
                        <input class="form-control" type="text" name="contact[company]" value="{{ request.company|default(service.contact.company) }}" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label">{{ 'Address Line 1'|trans }}</label>
                        <input class="form-control" type="text" name="contact[address1]" value="{{ request.address1|default(service.contact.address1) }}" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label">{{ 'Address Line 2'|trans }}</label>
                        <input class="form-control" type="text" name="contact[address2]" value="{{ request.address2|default(service.contact.address2) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Country'|trans }}</label>
                        <select class="form-select" name="contact[country]" required>
                            <option value="">{{ 'Select Country'|trans }}</option>
                            {% for code, name in country_names() %}
                                <option value="{{ code }}" {% if (request.country|default(service.contact.country)) == code %}selected{% endif %}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'City'|trans }}</label>
                        <input class="form-control" type="text" name="contact[city]" value="{{ request.city|default(service.contact.city) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'State'|trans }}</label>
                        <input class="form-control" type="text" name="contact[state]" value="{{ request.state|default(service.contact.state) }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Zip'|trans }}</label>
                        <input class="form-control" type="text" name="contact[postcode]" value="{{ request.postcode|default(service.contact.postcode) }}" required>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Phone Country Code'|trans }}</label>
                        <div class="input-group">
                            <span class="input-group-text">+</span>
                            <input class="form-control fb-phone-country-code" type="text" name="contact[phone_cc]" value="{{ request.phone_cc|default(service.contact.phone_cc) }}" inputmode="numeric" maxlength="3" pattern="[0-9]{1,3}" autocomplete="tel-country-code" required>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <label class="form-label">{{ 'Phone Number'|trans }}</label>
                        <input class="form-control" type="text" name="contact[phone]" value="{{ request.phone|default(service.contact.phone) }}" required>
                    </div>
                </div>
                <input type="hidden" name="order_id" value="{{ order.id }}">
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            </div>
        </div>
    </form>
{% endif %}
</div>
