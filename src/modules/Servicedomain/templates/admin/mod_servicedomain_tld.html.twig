{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ tld.tld }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicedomain'|url }}">{{ 'Domain Management'|trans }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicedomain'|url }}">{{ 'TLDs'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ tld.tld }}</li>
    </ol>
{% endblock %}

{% block content %}
{# ClientFence core patch: the TLD reads first: its name, sale and operation chips, registrar and prices as facts; the form follows (CF-135 redesign). #}
{% set cur = guest.currency_get.code %}
<div class="card cf-hero-card mb-3">
    <div class="cf-inv">
        <div class="cf-inv-client cf-client-hero">
            <div class="cf-inv-who">
                <span class="cf-client-name"><bdi>{{ tld.tld }}</bdi></span>
                <div class="cf-inv-chips mt-1">
                    <span class="badge {{ tld.active ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ tld.active ? 'Active'|trans : 'Inactive'|trans }}</span>
                    <span class="bf-chip{% if tld.allow_register %} bf-tone-ok{% endif %}">{{ 'Allow register:'|trans }} {{ tld.allow_register ? 'Yes'|trans : 'No'|trans }}</span>
                    <span class="bf-chip{% if tld.allow_transfer %} bf-tone-ok{% endif %}">{{ 'Allow transfer:'|trans }} {{ tld.allow_transfer ? 'Yes'|trans : 'No'|trans }}</span>
                    {% if tld.price_locked %}<span class="badge bg-secondary-lt">{{ 'Keep my price'|trans }}</span>{% endif %}
                </div>
            </div>
            <div class="cf-hero-price">
                <div class="cf-inv-figure">{{ tld.price_registration|format_currency(cur) }}</div>
                <div class="text-secondary">{{ 'Registration Price'|trans }}</div>
            </div>
        </div>
        <dl class="cf-facts">
            <div><dt>{{ 'Registrar'|trans }}</dt><dd>{% if tld.registrar.title %}<a href='{{ "servicedomain/registrar/#{tld.registrar.id}"|url }}'>{{ tld.registrar.title }}</a>{% else %}-{% endif %}</dd></div>
            <div><dt>{{ 'Renewal Price'|trans }}</dt><dd>{{ tld.price_renew|format_currency(cur) }}</dd></div>
            <div><dt>{{ 'Transfer Price'|trans }}</dt><dd>{{ tld.price_transfer|format_currency(cur) }}</dd></div>
            <div><dt>{{ 'Minimum Years of Registration'|trans }}</dt><dd>{{ tld.min_years }}</dd></div>
            {% if tld.periods %}<div><dt>{{ 'Allowed Registration Periods (years)'|trans }}</dt><dd><bdi>{{ tld.periods|join(', ') }}</bdi></dd></div>{% endif %}
        </dl>
    </div>
</div>
<div class="card">
    <form method="post" action="{{ 'servicedomain/tld_update'|api_url }}" {{ fb_api_form({message: 'Top Level Domain Settings Updated'|trans}) }}>
        {% embed 'partial_admin_form_card.html.twig' with {
            title: 'Details'|trans,
            body_class: 'pt-4'
        } %}
            {% block form_content %}
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Registrar'|trans }}</label>
                        <select class="form-select" name="tld_registrar_id">
                            {% for id, title in admin.servicedomain_registrar_get_pairs %}
                            <option value="{{ id }}"{% if id == tld.registrar.id %} selected{% endif %}>{{ title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Registration Price'|trans }}</label>
                        <input class="form-control" type="number" min="0" step="any" name="price_registration" value="{{ tld.price_registration }}" required>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Renewal Price'|trans }}</label>
                        <input class="form-control" type="number" min="0" step="any" name="price_renew" value="{{ tld.price_renew }}" required>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Transfer Price'|trans }}</label>
                        <input class="form-control" type="number" min="0" step="any" name="price_transfer" value="{{ tld.price_transfer }}" required>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">{{ 'Minimum Years of Registration'|trans }}</label>
                        <input class="form-control" type="number" min="1" step="1" name="min_years" value="{{ tld.min_years }}" required>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">{{ 'Allowed Registration Periods (years)'|trans }}</label>
                        <input class="form-control" type="text" name="periods" value="{{ tld.periods ? tld.periods|join(',') : '' }}" placeholder="{{ '1,2,3,5,10'|trans }}">
                        <div class="form-hint">{{ 'Comma-separated list of exact registration periods, in years. Leave blank to allow any period from the minimum above upwards.'|trans }}</div>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label d-block">{{ 'Allow Registration'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="inputAllowRegisterYes" type="radio" name="allow_register" value="1"{% if tld.allow_register %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="inputAllowRegisterNo" type="radio" name="allow_register" value="0"{% if not tld.allow_register %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label d-block">{{ 'Allow Transfer'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="inputAllowTransferYes" type="radio" name="allow_transfer" value="1"{% if tld.allow_transfer %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="inputAllowTransferNo" type="radio" name="allow_transfer" value="0"{% if not tld.allow_transfer %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label d-block">{{ 'Require Transfer Code'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="inputRequireTransferCodeYes" type="radio" name="require_transfer_code" value="1"{% if tld.require_transfer_code %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="inputRequireTransferCodeNo" type="radio" name="require_transfer_code" value="0"{% if not tld.require_transfer_code %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                        <div class="form-hint">{{ 'Require clients to enter a transfer code (EPP/auth code) before this TLD can be ordered for transfer.'|trans }}</div>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label d-block">{{ 'Active'|trans }}</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check">
                                <input class="form-check-input" id="inputActiveYes" type="radio" name="active" value="1"{% if tld.active %} checked{% endif %}>
                                <span class="form-check-label">{{ 'Yes'|trans }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" id="inputActiveNo" type="radio" name="active" value="0"{% if not tld.active %} checked{% endif %}>
                                <span class="form-check-label">{{ 'No'|trans }}</span>
                            </label>
                        </div>
                    </div>
                    {# ClientFence core patch: "Keep my price" (Servicedomain/PriceSync.php). #}
                    <div class="col-lg-5">
                        <input type="hidden" name="price_locked" value="0">
                        <label class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="price_locked" value="1"{% if tld.price_locked %} checked{% endif %}>
                            <span class="form-check-label">{{ 'Keep my price'|trans }}</span>
                        </label>
                        <div class="form-hint">{{ 'The price import and the scheduled sync leave this extension\'s prices alone.'|trans }}</div>
                    </div>
                </div>
                {# ClientFence core patch: fixed currency prices (Product/CurrencyPrices.php), per year. #}
                {{ include('mod_product_currency_prices.html.twig', { kind: 'tld', id: tld.id, setup: false, rows: [
                    { period: 'register', label: 'Registration Price'|trans, price: tld.price_registration, setup: 0 },
                    { period: 'renew', label: 'Renewal Price'|trans, price: tld.price_renew, setup: 0 },
                    { period: 'transfer', label: 'Transfer Price'|trans, price: tld.price_transfer, setup: 0 },
                ] }) }}
                <input type="hidden" name="tld" value="{{ tld.tld }}">
            {% endblock %}

            {% block form_actions %}
                <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
            {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}
