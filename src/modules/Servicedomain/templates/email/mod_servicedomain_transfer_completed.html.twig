{# ClientFence core patch: the message only; the email layout (Email Settings > Email Layout) adds the page, header and footer (CF-234). #}
{% block subject %}[{{ guest.system_company.name }}] {{ 'Domain transfer of %domain% completed'|trans({'%domain%': service.domain|default('')}) }}{% endblock %}
{% block content %}
{% set email_title %}{{ 'Your domain transfer is complete'|trans }}{% endset %}
{% set email_preheader %}{{ 'The transfer of %domain% to us is complete.'|trans({'%domain%': service.domain|default('')}) }}{% endset %}
		<h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:bold; color:#0c2738;">{{ 'Your domain transfer is complete'|trans }}</h1>
		<p style="margin:0 0 16px;">{{ 'Dear %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
		<p style="margin:0 0 16px;">{{ 'The transfer of %domain% to us is complete. You can now manage it in your client area.'|trans_html({}, {'%domain%': '<strong>' ~ (service.domain|default(''))|e ~ '</strong>'}) }}</p>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Domain'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top; font-weight:bold;">{{ service.domain|default('') }}</td></tr>
					{% if service.expires_at|default(false) %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Expiry date'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.expires_at|default('')|format_date }}</td></tr>{% endif %}
					{% if order.period|default(false) %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Billing'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ order.total|default(0)|format_currency(order.currency|default(default_currency)) }} {{ order.period|default('')|period_title }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		{% if service.ns1|default('') or service.ns2|default('') or service.ns3|default('') or service.ns4|default('') %}
		<h2 style="margin:8px 0 10px; font-size:16px; line-height:24px; color:#0c2738;">{{ 'Nameservers'|trans }}</h2>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px; background-color:#f8fafc; border:1px solid #e4eaee; border-radius:12px;">
			<tr><td height="4" style="height:4px; font-size:0; line-height:0; background-color:#14a39a; background-image:linear-gradient(90deg, #14a39a 0%, {{ guest.system_company.brand_color|default('#2563eb') }} 100%); border-radius:12px 12px 0 0;"></td></tr>
			<tr><td style="padding:16px 20px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#334155;">
					{% if service.ns1|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Nameserver 1'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.ns1|default('') }}</td></tr>{% endif %}
					{% if service.ns2|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Nameserver 2'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.ns2|default('') }}</td></tr>{% endif %}
					{% if service.ns3|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Nameserver 3'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.ns3|default('') }}</td></tr>{% endif %}
					{% if service.ns4|default('') %}<tr><td style="padding:4px 12px 4px 0; color:#64748b; vertical-align:top;">{{ 'Nameserver 4'|trans }}</td><td align="right" style="padding:4px 0; vertical-align:top;">{{ service.ns4|default('') }}</td></tr>{% endif %}
				</table>
			</td></tr>
		</table>
		{% endif %}
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
			<tr><td bgcolor="{{ guest.system_company.brand_color|default('#2563eb') }}" style="border-radius:999px; background-color:{{ guest.system_company.brand_color|default('#2563eb') }}; mso-padding-alt:13px 30px;">
				<a href="{{ "order/service/manage/#{order.id|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block; padding:13px 30px; border-radius:999px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:{{ guest.system_company.brand_text|default('#ffffff') }}; text-decoration:none;">{{ 'Manage domain'|trans }}</a>
			</td></tr>
		</table>
		<p style="margin:0 0 0;">{{ guest.system_email.signature }}</p>
{% endblock %}
