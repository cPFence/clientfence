{% set periods = guest.system_periods %}
{% set pricing = product.pricing %}
{% set transfer_tlds = guest.serviceDomain_tlds({ "allow_transfer": 1 }) %}
{% set tlds = guest.serviceDomain_tlds({"allow_register":1}) %}
{# ClientFence core patch: the choices above the fields on a phone (the domain field was 19-42 px wide). #}
<div class="d-flex flex-column flex-md-row mb-3">
    <nav class="nav nav-pills flex-md-column border-end me-3 mb-3 mb-md-0 gap-2">
        {% if tlds is not empty %}
            <a class="nav-link me-3 py-1 px-2 fs-7 active" href="#" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-tab-pane"
                role="tab" aria-controls="register-tab-pane">{{ 'Register'|trans }}</a>
        {% endif %}
        {% if transfer_tlds is not empty %}
        <a class="nav-link me-3 py-1 px-2 fs-7 {% if tlds is empty %} active {% endif %}" href="#" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-tab-pane"
               role="tab" aria-controls="transfer-tab-pane">{{ 'Transfer'|trans }}</a>
        {% endif %}
    </nav>
    <div class="tab-content">
        {% if tlds is not empty %}
            {# ClientFence core patch (CF-139): one name across the ticked TLDs (up to 20), the staff-pinned ones ticked first
               (WHMCS Spotlight TLDs), results per TLD as they arrive and the chosen domains added to the cart together
               (themes/palisade/assets/src/js/domain-search.js). ?tld= (the store's search) ticks one more TLD, first;
               ?tlds= (the embedded checker) ticks exactly those. With a name (?register_sld=) the search runs at once. #}
            {% set pinned = guest.servicedomain_pinned_tlds %}
            {% set picked = request.tld is iterable or request.tld not in tlds|column('tld') ? [] : [request.tld] %}
            {% set top = picked|merge((pinned ?: [(tlds|first).tld])|filter(t => t not in picked)) %}
            {% set wanted = request.tlds is iterable or not request.tlds ? [] : request.tlds|split(',') %}
            {% set ticked = wanted ?: top %}
            {% set rest = tlds|filter(t => t.tld not in top) %}
            <div class="tab-pane show active" id="register-tab-pane" role="tabpanel" aria-labelledby="register-tab" tabindex="0" data-cf-domain-search>
                <script nonce="{{ csp_nonce }}" type="application/json" data-cf-domain-search-data>{{ {
                    max: 20,
                    auto: wanted is not empty,
                    currency: guest.cart_get_currency.code,
                    rate: guest.cart_get_currency.conversion_rate,
                    texts: {
                        available: 'Available'|trans,
                        taken: 'Domain is not available.'|trans,
                        unknown: 'Unknown'|trans,
                        year: ' Year @ '|trans,
                        years: ' Years @ '|trans,
                    },
                }|json_encode|raw }}</script>
                <label class="form-label" for="cf-ds-sld">{{ 'Register a new domain'|trans }}</label>
                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control form-control-sm cf-ds-sld" type="text" id="cf-ds-sld" name="register_sld" dir="ltr" autocomplete="off"
                        value="{{ request.register_sld }}" placeholder="{{ 'Enter new domain name to register'|trans }}">
                    <button class="btn btn-sm btn-dark" type="button" data-cf-ds-check>{{ 'Check'|trans }}</button>
                </div>
                <fieldset class="cf-ds-tlds" aria-describedby="cf-ds-max">
                    <legend class="visually-hidden">{{ 'Extensions'|trans }}</legend>
                    {% for name in top %}
                        <label class="cf-ds-tld"><input class="form-check-input" type="checkbox" value="{{ name }}" data-cf-ds-tld{% if name in ticked %} checked{% endif %}> <span dir="ltr">{{ name }}</span></label>
                    {% endfor %}
                    {% if rest is not empty %}
                        <details class="cf-ds-more"{% if rest|filter(t => t.tld in ticked) is not empty %} open{% endif %}>
                            <summary>{{ 'More extensions'|trans }}</summary>
                            <div class="cf-ds-more-list">
                                {% for tld in rest %}
                                    <label class="cf-ds-tld"><input class="form-check-input" type="checkbox" value="{{ tld.tld }}" data-cf-ds-tld{% if tld.tld in ticked %} checked{% endif %}> <span dir="ltr">{{ tld.tld }}</span></label>
                                {% endfor %}
                            </div>
                        </details>
                    {% endif %}
                    <div class="form-hint" id="cf-ds-max">{{ 'Choose up to :count extensions.'|trans({':count': 20}) }}</div>
                </fieldset>
                <ul class="cf-ds-results list-unstyled" data-cf-ds-results aria-live="polite" hidden></ul>
                <div class="onAfterDomainCheck" style="display:none;">
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="nameserversCb">
                        <label class="form-check-label text-sm" for="nameserversCb">
                            {{ 'I want to use my nameservers'|trans }}
                        </label>
                    </div>
                    <div id="nameservers" class="flex-column row" hidden>
                        <div class="mb-2 col-md-6">
                            <input class="form-control form-control-sm" type="text" name="ns1" value="" placeholder="{{ 'Nameserver 1'|trans }}"/>
                        </div>
                        <div class="mb-2 col-md-6">
                            <input class="form-control form-control-sm" type="text" name="ns2" value="" placeholder="{{ 'Nameserver 2'|trans }}"/>
                        </div>
                        <div class="mb-2 col-md-6">
                            <input class="form-control form-control-sm" type="text" name="ns3" value="" placeholder="{{ 'Nameserver 3'|trans }}"/>
                        </div>
                        <div class="mb-2 col-md-6">
                            <input class="form-control form-control-sm" type="text" name="ns4" value="" placeholder="{{ 'Nameserver 4'|trans }}"/>
                        </div>
                    </div>
                    <div class="cf-ds-fields">
                        {{ include('mod_servicedomain_domain_fields.html.twig', {prefix: 'domain_fields', tld_select: 'register_tld'}) }}
                    </div>
                </div>
            </div>
        {% endif %}
        {% if transfer_tlds is not empty %}
            <div class="tab-pane {% if tlds is empty %} show active {% endif %}" id="transfer-tab-pane" role="tabpanel" aria-labelledby="transfer-tab" tabindex="0">
                <div class="row">
                    <div class="col-sm-12">
                        <label class="form-label">{{ 'Transfer a new domain'|trans }}</label>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="input-group" style="max-width: 500px;">
                                <input class="form-control form-control-sm" type="text" name="transfer_sld"
                                       value="{{ request.transfer_sld }}"
                                       placeholder="{{ 'Enter your domain name to transfer'|trans }}">
                                <select class="form-select form-select-sm" name="transfer_tld" style="width: 30%; max-width: 120px;">
                                    {% for tld in transfer_tlds %}
                                        <option value="{{ tld.tld }}" label="{{ tld.tld }}" data-require-transfer-code="{{ tld.require_transfer_code ? '1' : '0' }}">{{ tld.tld }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button class="btn btn-sm btn-dark" type="button" id="transfer-check">{{ 'Check'|trans }}</button>
                        </div>
                    </div>
                    <div id="domain-transfer-config" style="display:none;">
                        <p class="fs-7 mt-2">{{ 'Transfer price is'|trans }}&nbsp;<span class="fw-bold" id="transfer-price"></span></p>
                        <input class="form-control form-control-sm" type="text" name="transfer_code" id="transfer-code"
                               value="{{ request.transfer_code }}" style="width: 200px" placeholder="{{ 'Enter domain transfer code'|trans }}">
                        <div class="form-hint" id="transfer-code-hint" style="display:none;">{{ 'This TLD requires a transfer code (EPP/auth code) to proceed.'|trans }}</div>
                        {{ include('mod_servicedomain_domain_fields.html.twig', {tlds: transfer_tlds, key: 'transfer_fields', prefix: 'transfer_fields', tld_select: 'transfer_tld'}) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

{# ClientFence core patch: domain searches show the guest CAPTCHA (once an hour). #}
{{ include('mod_servicedomain_lookup_captcha.html.twig') }}
<input type="hidden" name="id" value="{{ product.id }}"/>
<input type="hidden" name="action" value="register" id="domain-action"/>

{% set currency = guest.cart_get_currency %}
<script nonce="{{ csp_nonce }}" type="text/javascript">
    function fadeIn(el) {
        el.style.removeProperty('display');
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.15s ease-in';
        requestAnimationFrame(() => el.style.opacity = '1');
    }

    function slideDown(el) {
        el.style.removeProperty('display');
        el.style.overflow = 'hidden';
        el.style.height = '0';
        el.style.transition = 'height 0.2s ease-out';
        requestAnimationFrame(() => el.style.height = el.scrollHeight + 'px');
    }

    document.addEventListener('DOMContentLoaded', function () {
        const currencyFormat = JSON.parse('{{ currency|json_encode|e('js') }}');

        document.querySelectorAll('ul.nav.nav-tabs > li.domain-tab a').forEach(a => {
            a.addEventListener('click', function () {
                document.getElementById('domain-action').value = this.getAttribute('rel');
            });
        });

        const configNext = document.getElementById('config-next');
        configNext.style.display = 'none';
        configNext.disabled = true;

        const addons = document.querySelector('.addons');
        if (addons) {
            const orderButton = document.querySelector('.order-button');
            if (orderButton) {
                orderButton.addEventListener('click', function () {
                    this.style.display = 'none';
                    slideDown(addons);
                    return false;
                });
            }
        }

        document.querySelectorAll('.addon-period-selector').forEach(el => {
            el.addEventListener('change', function () {
                const r = this.getAttribute('rel');
                const spans = document.querySelectorAll('#' + r + ' span');
                spans.forEach(span => span.style.display = 'none');
                const visibleSpan = document.querySelector('#' + r + ' span.' + this.value);
                if (visibleSpan) {
                    fadeIn(visibleSpan);
                }
            });
            el.dispatchEvent(new Event('change'));
        });

        const formatCurrency = (price, rate, code, multiply) => {
            let total = parseFloat(price) * parseFloat(rate);
            if (typeof multiply !== 'undefined') {
                total *= multiply;
            }
            // ClientFence core patch: in the page's language, as the store and checkout show prices (it was "E£518.10" on an Arabic page).
            try {
                return new Intl.NumberFormat(document.documentElement.lang || 'en-US', { style: 'currency', currency: code }).format(total);
            } catch (e) {
                return ClientFence.currency.format(total, { ...currencyFormat, code: code });
            }
        };

        function updateTransferCodeRequirement() {
            const tldSelect = document.querySelector('select[name="transfer_tld"]');
            const selectedOption = tldSelect && tldSelect.options[tldSelect.selectedIndex];
            const requiresTransferCode = selectedOption && selectedOption.dataset.requireTransferCode === '1';
            const transferCodeInput = document.getElementById('transfer-code');
            const transferCodeHint = document.getElementById('transfer-code-hint');
            if (transferCodeInput) transferCodeInput.required = requiresTransferCode;
            if (transferCodeHint) transferCodeHint.style.display = requiresTransferCode ? '' : 'none';
        }

        const transferTldSelect = document.querySelector('select[name="transfer_tld"]');
        if (transferTldSelect) {
            transferTldSelect.addEventListener('change', updateTransferCodeRequirement);
        }

        const transferCheck = document.getElementById('transfer-check');
        if (transferCheck) {
            transferCheck.addEventListener('click', function (event) {
                const tldSelect = document.querySelector('select[name="transfer_tld"]');
                const sld = document.querySelector('input[name="transfer_sld"]').value.toLowerCase();
                const tld = tldSelect.value.toLowerCase();
                document.getElementById('domain-action').value = 'transfer';
                const domain = sld + tld;

                ClientFenceDomainCaptcha.post(
                    'servicedomain/can_be_transferred',
                    {sld: sld, tld: tld},
                    function (result) {
                        setTransferPricing(tld);
                        const domainNameEl = document.getElementById('domain-name');
                        if (domainNameEl) domainNameEl.textContent = domain;
                        const transferConfig = document.getElementById('domain-transfer-config');
                        if (transferConfig) fadeIn(transferConfig);
                        const onAfterDomainCheck = document.querySelector('.onAfterDomainCheck');
                        if (onAfterDomainCheck) fadeIn(onAfterDomainCheck);

                        const transferOrderButton = document.querySelector('#transfer .order-button');
                        if (transferOrderButton) transferOrderButton.style.display = '';

                        updateTransferCodeRequirement();
                    },
                );

                return false;
            });
        }

        // ClientFence core patch (CF-139): the register search and its prices are in domain-search.js.

        function setTransferPricing(tld) {
            ClientFence.api.guest.post(
                'servicedomain/pricing',
                {tld: tld},
                function (result) {
                    const price = formatCurrency(result.price_transfer, {{ currency.conversion_rate }}, "{{ currency.code }}");
                    const transferPriceEl = document.getElementById('transfer-price');
                    if (transferPriceEl) transferPriceEl.textContent = price;
                    configNext.style.display = '';
                    configNext.disabled = false;
                },
            );
        }

        // Handle URL parameters for pre-filling domain form
        const urlParams = new URLSearchParams(window.location.search);

        const tldParam = urlParams.get('tld');
        if (tldParam) {
            const transferTldSelect = document.querySelector('select[name="transfer_tld"]');
            if (transferTldSelect) {
                for (let i = 0; i < transferTldSelect.options.length; i++) {
                    if (transferTldSelect.options[i].value === tldParam) {
                        transferTldSelect.selectedIndex = i;
                        break;
                    }
                }
            }
        }

        const nameParam = urlParams.get('name');
        if (nameParam) {
            const registerSldInput = document.querySelector('input[name="register_sld"]');
            if (registerSldInput) {
                registerSldInput.value = nameParam;
            }
            const transferSldInput = document.querySelector('input[name="transfer_sld"]');
            if (transferSldInput) {
                transferSldInput.value = nameParam;
            }
        }
    });
</script>
