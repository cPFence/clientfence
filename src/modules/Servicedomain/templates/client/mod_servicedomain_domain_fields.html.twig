{# ClientFence core patch: the details a TLD's registrar asks for (Registrar_AdapterAbstract::getDomainFields()), one block
   per TLD; only the block of the TLD chosen in the select named tld_select is shown and sent (the server checks
   required fields: a required input in a hidden tab would block the other tab's order). Takes tlds, key (domain_fields, or transfer_fields for the transfer tab), prefix (the
   inputs' name, e.g. domain_fields or domain[domain_fields]) and tld_select. #}
{% for tld in tlds %}
    {% set fields = tld[key|default('domain_fields')]|default({}) %}
    {% if fields is not empty %}
        <div class="mt-3" data-domain-fields="{{ tld.tld }}" data-tld-select="{{ tld_select }}" hidden>
            {% for name, field in fields %}
                {% set id = 'df-' ~ prefix|replace({'[': '-', ']': ''}) ~ '-' ~ tld.tld|replace({'.': ''}) ~ '-' ~ name %}
                <div class="mb-2" style="max-width: 500px;">
                    <label class="form-label fs-7 mb-1" for="{{ id }}">{{ field.label }}{% if not field.required|default(false) %} {{ '(optional)'|trans }}{% endif %}</label>
                    {% if field.options is defined %}
                        <select class="form-select form-select-sm" id="{{ id }}" name="{{ prefix }}[{{ name }}]" disabled>
                            <option value=""></option>
                            {% for value, label in field.options %}
                                <option value="{{ value }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <input class="form-control form-control-sm" type="text" id="{{ id }}" name="{{ prefix }}[{{ name }}]" maxlength="255" disabled>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endfor %}
<script nonce="{{ csp_nonce }}">
    document.addEventListener('DOMContentLoaded', function () {
        const select = document.querySelector('select[name="{{ tld_select|e('js') }}"]');
        if (!select) return;
        const show = function () {
            document.querySelectorAll('[data-tld-select="{{ tld_select|e('js') }}"]').forEach(function (block) {
                const on = block.dataset.domainFields === select.value;
                block.hidden = !on;
                block.querySelectorAll('input, select').forEach(function (input) { input.disabled = !on; });
            });
        };
        select.addEventListener('change', show);
        show();
    });
</script>
