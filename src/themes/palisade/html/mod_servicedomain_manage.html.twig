{# ClientFence: the domain card of the service page (CF-52): Nameservers first, Contact, Protection (lock and
   privacy) and Transfer. Dates are in the page's tiles; Sync Now and Renew Now are in mod_servicedomain_head. #}
{# A tracked incoming transfer (Servicedomain/DomainSync.php). #}
{% if service.transfer_status == 'pending' %}
<div class="alert alert-info">{{ 'Transfer in progress: we will email you when the registrar completes it.'|trans }}</div>
{% elseif service.transfer_status == 'failed' %}
<div class="alert alert-warning">{{ 'Transfer not completed: our team is looking into it.'|trans }}</div>
{% endif %}
{% if order.status == 'active' %}
<div class="card mb-4">
    <ul class="nav bf-card-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#ns-tab-pane" role="tab" aria-controls="ns-tab-pane" aria-selected="true"><svg class="icon icon-sm" aria-hidden="true"><use href="#sitemap"/></svg>{{ 'Nameservers'|trans }}</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#whois-tab-pane" role="tab" aria-controls="whois-tab-pane" aria-selected="false"><svg class="icon icon-sm" aria-hidden="true"><use href="#address-book"/></svg>{{ 'Contact'|trans }}</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#protect-tab-pane" role="tab" aria-controls="protect-tab-pane" aria-selected="false"><svg class="icon icon-sm" aria-hidden="true"><use href="#shield-check"/></svg>{{ 'Protection'|trans }}</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#transfer-tab-pane" role="tab" aria-controls="transfer-tab-pane" aria-selected="false"><svg class="icon icon-sm" aria-hidden="true"><use href="#key"/></svg>{{ 'Transfer'|trans }}</button>
        </li>
    </ul>
    <div class="tab-content">
            {# Domain nameservers #}
            <div class="card-body tab-pane active" id="ns-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h3 class="h6 mt-1 mb-1">{{ 'Update Nameservers'|trans }}</h3>
                    <span class="small text-muted">{{ 'If you would like to host this domain with another company you can update nameservers.'|trans }}</span>
                </div>

                <form method="post" action="{{ 'servicedomain/update_nameservers'|api_url }}" {{ fb_api_form({message: 'Nameservers Updated'|trans}) }}>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label for="ns1" class="form-label">{{ 'Nameserver 1'|trans }}</label>
                                    <input class="form-control" type="text" name="ns1" id="ns1"
                                           value="{{ request.ns1|default(service.ns1) }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="ns2" class="form-label">{{ 'Nameserver 2'|trans }}</label>
                                    <input class="form-control" type="text" name="ns2" id="ns2"
                                           value="{{ request.ns2|default(service.ns2) }}" required>
                                </div>
                            </div>
                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label for="ns3" class="form-label">{{ 'Nameserver 3'|trans }}</label>
                                    <input class="form-control" type="text" name="ns3" id="ns3"
                                           value="{{ request.ns3|default(service.ns3) }}">
                                </div>
                                <div class="col-md-6">
                                    <label for="ns4" class="form-label">{{ 'Nameserver 4'|trans }}</label>
                                    <input class="form-control" type="text" name="ns4" id="ns4"
                                           value="{{ request.ns4|default(service.ns4) }}">
                                </div>
                            </div>
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
                        </div>
                    </div>
                </form>
            </div>

            {# Domain WHOIS #}
            <div class="card-body tab-pane" id="whois-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h3 class="h6 mt-1 mb-1">{{ 'Update Domain Contact Details'|trans }}</h3>
                    <span class="small text-secondary">{{ 'Domain contact details will be displayed once someone will check WHOIS output (which is public) of your service. This will update Technical, Billing and Admin contacts for this service. You can enable domain privacy protection if you want to hide your public WHOIS information.'|trans }}</span>
                </div>
                <form method="post" action="{{ 'servicedomain/update_contacts'|api_url }}" {{ fb_api_form({message: 'Contact Details Updated'|trans}) }}>
                    <div class="mb-3 row">
                        <div class="col-md-6">
                            <label for="whois_first_name" class="form-label">{{ 'First Name'|trans }}</label>
                            <input class="form-control" type="text" name="contact[first_name]" id="whois_first_name"
                                   value="{{ request.first_name|default(service.contact.first_name) }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="whois_last_name" class="form-label">{{ 'Last Name'|trans }}</label>
                            <input class="form-control" type="text" name="contact[last_name]" id="whois_last_name"
                                   value="{{ request.last_name|default(service.contact.last_name) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-6">
                            <label for="whois_email" class="form-label">{{ 'Email'|trans }}</label>
                            <input class="form-control" type="text" name="contact[email]" id="whois_email"
                                   value="{{ request.email|default(service.contact.email) }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="whois_company" class="form-label">{{ 'Company'|trans }}</label>
                            <input class="form-control" type="text" name="contact[company]" id="whois_company"
                                   value="{{ request.company|default(service.contact.company) }}">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-6">
                            <label for="whois_address1" class="form-label">{{ 'Address Line 1'|trans }}</label>
                            <input class="form-control" type="text" name="contact[address1]" id="whois_address1"
                                   value="{{ request.address1|default(service.contact.address1) }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="whois_address2" class="form-label">{{ 'Address Line 2'|trans }}</label>
                            <input class="form-control" type="text" name="contact[address2]" id="whois_address2"
                                   value="{{ request.address2|default(service.contact.address2) }}">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-6">
                            <label for="whois_country" class="form-label">{{ 'Country'|trans }}</label>
                            <select class="form-select" name="contact[country]" id="whois_country" required>
                                <option value="">{{ 'Select Country'|trans }}</option>
                                {% for code, name in country_names() %}
                                    <option value="{{ code }}" {% if (request.country|default(service.contact.country)) == code %}selected{% endif %}>{{ name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="whois_city" class="form-label">{{ 'City'|trans }}</label>
                            <input class="form-control" type="text" name="contact[city]" id="whois_city"
                                   value="{{ request.city|default(service.contact.city) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-6">
                            <label for="whois_state" class="form-label">{{ 'State'|trans }}</label>
                            <input class="form-control" type="text" name="contact[state]" id="whois_state"
                                   value="{{ request.state|default(service.contact.state) }}" required>
                        </div>

                        <div class="col-md-6">
                            <label for="whois_postcode" class="form-label">{{ 'Zip'|trans }}</label>
                            <input class="form-control" type="text" name="contact[postcode]" id="whois_postcode"
                                   value="{{ request.postcode|default(service.contact.postcode) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-12">
                            <label for="whois_phone" class="form-label">{{ 'Phone Number'|trans }}</label>
                            <input type="hidden" name="contact[phone_cc]" id="whois_phone_cc" value="{{ request.phone_cc|default(service.contact.phone_cc) }}">
                            <input class="form-control js-phone-input" type="tel" name="contact[phone]" id="whois_phone"
                                   value="{{ request.phone|default(service.contact.phone) }}" autocomplete="tel" data-initial-country="{{ request.country|default(service.contact.country)|lower }}" required>
                        </div>
                    </div>
                    <input type="hidden" name="order_id" value="{{ order.id }}">
                    <button class="btn btn-primary" type="submit" value="{{ 'Update' }}">{{ 'Update'|trans }}</button>
                </form>
            </div>

            {# Domain protection #}
            <div class="card-body tab-pane" id="protect-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h3 class="h6 mt-1 mb-1">{{ 'Domain Protection'|trans }}</h3>
                    <span class="small text-secondary">{{ 'Domain locking is a security feature which prevents your domain name from being transferred without first unlocking it. When this is enabled, a domain cannot be transferred even with the transfer code.'|trans }}</span>
                </div>
                <button class="btn btn-danger icon-link" type="button" id="domain-unlock" {% if service.locked == 0 %}style="display:none;"{% endif %}>
                    <svg class="icon"><use href="#lock-open" /></svg>
                    {{ 'Unlock'|trans }}
                </button>
                <button class="btn btn-primary icon-link" type="button" id="domain-lock" {% if service.locked == 1 %}style="display:none;"{% endif %}>
                    <svg class="icon"><use href="#lock" /></svg>
                    {{ 'Lock'|trans }}
                </button>
                <hr class="my-4">
                <div class="mb-3">
                    <h3 class="h6 mt-1 mb-1">{{ 'Domain Privacy Settings'|trans }}</h3>
                    <span class="small text-muted">{{ 'If you would like to hide domain contact information which is shown on WHOIS you can enable privacy protection. Once domain privacy protection is enabled no one will know who registered this service. And once you decide to disable privacy protection, information that is listed above on "Update Domain Contact Details" section will be seen on domain WHOIS again.'|trans }}</span>
                </div>
                <button class="btn btn-warning" type="button" id="domain-disable-pp" {% if service.privacy == 0 %}style="display:none;"{% endif %}>{{ 'Disable Privacy protection'|trans }}</button>
                <button class="btn btn-primary" type="button" id="domain-enable-pp" {% if service.privacy == 1 %}style="display:none;"{% endif %}>{{ 'Enable Privacy protection'|trans }}</button>
            </div>

            {# Domain transfer #}
            <div class="card-body tab-pane" id="transfer-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h3 class="h6 mt-1 mb-1">{{ 'Domain Secret'|trans }}</h3>
                    <span class="small text-secondary">{{ 'Most domain names (except a few top-level domains like .EU and .UK) have a Domain Secret Key/Authorization Code (EPP Code) associated with them. This code is typically required when transferring the domain to a new registrar.'|trans }}</span>
                </div>
                <button class="btn btn-primary" type="button" id="get-epp">{{ 'Get EPP Code'|trans }}</button>
            </div>
    </div>
</div>

    <script nonce="{{ csp_nonce }}">
        document.addEventListener("DOMContentLoaded", function() {
            document.getElementById('domain-lock').addEventListener('click', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('servicedomain/lock', { order_id: {{ order.id }} },
                    () => {
                        ClientFence.message('Domain locked');

                        document.getElementById('domain-lock').style.display =
                            document.getElementById('domain-lock').style.display === 'none' ? '' : 'none';
                        document.getElementById('domain-unlock').style.display =
                            document.getElementById('domain-unlock').style.display === 'none' ? '' : 'none';
                    });
            });

            document.getElementById('domain-unlock').addEventListener('click', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('servicedomain/unlock', { order_id: {{ order.id }} },
                    () => {
                        ClientFence.message('Domain unlocked');

                        document.getElementById('domain-lock').style.display =
                            document.getElementById('domain-lock').style.display === 'none' ? '' : 'none';
                        document.getElementById('domain-unlock').style.display =
                            document.getElementById('domain-unlock').style.display === 'none' ? '' : 'none';
                    });
            });

            document.getElementById('domain-enable-pp').addEventListener('click', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('servicedomain/enable_privacy_protection', { order_id: {{ order.id }} },
                    (result) =>{
                        ClientFence.message('Privacy Protection enabled');

                        const enableBtn = document.getElementById('domain-enable-pp');
                        const disableBtn = document.getElementById('domain-disable-pp');

                        enableBtn.style.display = enableBtn.style.display === 'none' ? '' : 'none';
                        disableBtn.style.display = disableBtn.style.display === 'none' ? '' : 'none';
                    });
            });

            document.getElementById('domain-disable-pp').addEventListener('click', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('servicedomain/disable_privacy_protection', { order_id: {{ order.id }} },
                    (result) => {
                        ClientFence.message('Privacy Protection disabled');

                        const enableBtn = document.getElementById('domain-enable-pp');
                        const disableBtn = document.getElementById('domain-disable-pp');

                        enableBtn.style.display = enableBtn.style.display === 'none' ? '' : 'none';
                        disableBtn.style.display = disableBtn.style.display === 'none' ? '' : 'none';
                    }
                );
            });

            document.getElementById('get-epp').addEventListener('click', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('servicedomain/get_transfer_code', { order_id: {{ order.id }} },
                    (result) => {
                        ClientFence.message('Domain transfer code is: ' + result);
                    });
            });

            document.getElementById('domain-sync').addEventListener('click', function(event) {
                event.preventDefault();

                const syncButton = event.currentTarget;
                syncButton.disabled = true;

                ClientFence.api.client.post('servicedomain/sync', { order_id: {{ order.id }} },
                    () => {
                        ClientFence.message({{ 'Domain synchronized with registrar'|trans|json_encode|raw }});
                        window.location.reload();
                    },
                    (error) => {
                        syncButton.disabled = false;
                        ClientFence.message(`${error.message} (${error.code})`, 'error');
                    });
            });
        });
    </script>
{% endif %}
