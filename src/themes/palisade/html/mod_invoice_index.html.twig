{# ClientFence: FOSSBilling's invoice list with the invoice number as FOSSBilling formats it (serie_nr, which
   follows the invoice_number_padding setting) instead of a hard-coded 5-digit padding, and links to the
   account statement and the client's quotes. #}
{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}

{% block meta_title %}{{ 'Invoice Management'|trans }}{% endblock %}
{% block page_header %}{{ 'Invoice Management'|trans }}{% endblock %}

{% block body_class %}invoice-index{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Invoices'|trans }}</li>
{% endblock %}

{% block content %}
    {% set unpaid_invoices = client.invoice_get_list({"status":"unpaid", "per_page":10, "page":request.page}) %}
    {% set paid_invoices = client.invoice_get_list({"per_page":10, "page":request.page, "status":"paid"}) %}
    {# ClientFence: cancelled and refunded invoices in a tab of their own, with their status (as WHMCS lists every invoice). #}
    {% set closed_invoices = client.invoice_get_list({"per_page":10, "page":request.page, "status":["canceled", "refunded"]}) %}
    <div class="row">
        <div class="col-md-12">
            <div class="bf-page-head mb-4">
                <div>
                    <h1 class="bf-page-title">{{ 'Invoices'|trans }}</h1>
                    <span class="bf-hint">{{ 'All of your invoices: unpaid, paid, and cancelled or refunded, each in its tab.'|trans }}</span>
                </div>
                {# ClientFence: links to the account statement (mod_invoice_statement) and, when
                   the client has quotes, to them (mod_invoice_quotes). #}
                <div class="d-flex flex-wrap gap-2">
                    {% if client.invoice_quote_get_list %}
                        <a class="btn btn-outline-secondary" href="{{ 'invoice/quotes'|url }}">{{ 'Quotes'|trans }}</a>
                    {% endif %}
                    <a class="btn btn-outline-secondary" href="{{ 'invoice/statement'|url }}">{{ 'Account statement'|trans }}</a>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <nav>
                        <div class="nav nav-tabs" id="invoice-tab" role="tablist">
                            <button class="nav-link active" id="unpaid-tab" data-bs-toggle="tab"
                                    data-bs-target="#nav-unpaid" type="button" role="tab" aria-controls="nav-unpaid"
                                    aria-selected="true">{{ 'Unpaid'|trans }}{% if unpaid_invoices.total %}&nbsp;<span
                                    class="badge text-bg-danger">{{ unpaid_invoices.total }}</span>{% endif %}</button>
                            <button class="nav-link" id="paid-tab" data-bs-toggle="tab" data-bs-target="#nav-paid"
                                    type="button" role="tab" aria-controls="nav-paid"
                                    aria-selected="false">{{ 'Paid'|trans }}{% if paid_invoices.total %}&nbsp;<span
                                    class="badge text-bg-secondary">{{ paid_invoices.total }}</span>{% endif %}</button>
                            <button class="nav-link" id="closed-tab" data-bs-toggle="tab" data-bs-target="#nav-closed"
                                    type="button" role="tab" aria-controls="nav-closed"
                                    aria-selected="false">{{ 'Cancelled and refunded'|trans }}{% if closed_invoices.total %}&nbsp;<span
                                    class="badge text-bg-secondary">{{ closed_invoices.total }}</span>{% endif %}</button>
                        </div>
                    </nav>
                    <div class="tab-content" id="nav-tabContent">
                        <div class="tab-pane fade show active table-responsive" id="nav-unpaid" role="tabpanel"
                             aria-labelledby="nav-home-tab" tabindex="0">
                            <table class="table table-bordered table-hover table-stack">
                                <thead>
                                <tr>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th>{{ 'Invoice Date'|trans }}</th>
                                    <th>{{ 'Due Date'|trans }}</th>
                                    <th>{{ 'Total'|trans }}</th>
                                    <th>{{ 'Actions'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i, invoice in unpaid_invoices.list %}
                                    <tr>
                                        <td>{{ 'Invoice'|trans }} #{{ invoice.serie_nr }}</td>
                                        <td>{{ invoice.created_at|format_date }}</td>
                                        <td>{{ invoice.due_at|format_date }}</td>
                                        <td>{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                                        <td>{% if invoice.pending_payment|default(null) %}<a class="btn btn-sm btn-outline-secondary" href='{{ "invoice/#{invoice.hash}"|url }}'>{{ 'Payment pending'|trans }}</a>{% else %}<a class="btn btn-sm btn-success" href='{{ "invoice/#{invoice.hash}"|url }}'>{{ 'Pay'|trans }}</a>{% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="empty-state">{{ 'The list is empty'|trans }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            {{ include('partial_pagination.html.twig', { 'list': unpaid_invoices, 'url': 'invoice' }) }}
                        </div>
                        <div class="tab-pane fade table-responsive" id="nav-paid" role="tabpanel" aria-labelledby="nav-profile-tab"
                             tabindex="0">
                            <table class="table table-bordered table-hover table-stack">
                                <thead>
                                <tr>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th>{{ 'Invoice Date'|trans }}</th>
                                    <th>{{ 'Paid Date'|trans }}</th>
                                    <th>{{ 'Total'|trans }}</th>
                                    <th>{{ 'Actions'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i, invoice in paid_invoices.list %}
                                    <tr>
                                        <td>{{ 'Invoice'|trans }} #{{ invoice.serie_nr }}</td>
                                        <td>{{ invoice.created_at|format_date }}</td>
                                        <td>{{ invoice.paid_at|format_date }}</td>
                                        <td>{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                                        <td><a href='{{ "invoice/#{invoice.hash}"|url }}' class="btn btn-outline-secondary btn-sm">{{ 'View'|trans }}</a></td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7" class="empty-state">{{ 'The list is empty'|trans }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            {{ include('partial_pagination.html.twig', { 'list': paid_invoices, 'url': 'invoice', 'hash': '#nav-paid' }) }}
                        </div>
                        <div class="tab-pane fade table-responsive" id="nav-closed" role="tabpanel" aria-labelledby="closed-tab"
                             tabindex="0">
                            <table class="table table-bordered table-hover table-stack">
                                <thead>
                                <tr>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th>{{ 'Invoice Date'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th>{{ 'Total'|trans }}</th>
                                    <th>{{ 'Actions'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i, invoice in closed_invoices.list %}
                                    <tr>
                                        <td>{{ 'Invoice'|trans }} #{{ invoice.serie_nr }}</td>
                                        <td>{{ invoice.created_at|format_date }}</td>
                                        <td><span class="bf-chip bf-chip-muted" data-bf-status>{{ invoice.status == 'refunded' ? 'Refunded'|trans : 'Canceled'|trans }}</span></td>
                                        <td>{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                                        <td><a href='{{ "invoice/#{invoice.hash}"|url }}' class="btn btn-outline-secondary btn-sm">{{ 'View'|trans }}</a></td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="empty-state">{{ 'The list is empty'|trans }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            {{ include('partial_pagination.html.twig', { 'list': closed_invoices, 'url': 'invoice', 'hash': '#nav-closed' }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
