{# ClientFence: the service page (CF-52). A header with the service's own actions, the open invoice, four tiles,
   the service card (mod_service<type>_manage.html.twig) or a Details card, and a Manage panel. A service type
   adds to the header and the panel with mod_service<type>_head.html.twig (`part`: meta, actions or manage).
   No Order Notes row: notes are staff notes. #}
{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service'|url}}">{{ 'Services'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set has_partial = order.status == 'active' and guest.system_template_exists({ 'file': service_partial }) %}
{% set service = has_partial ? client.order_service({ 'id': order.id }) : null %}
{% set head_partial = "mod_service" ~ order.service_type ~ "_head.html.twig" %}
{% set has_head = service and guest.system_template_exists({ 'file': head_partial }) %}
{# ClientFence core patch: prorated upgrades and downgrades by the client (Order\Upgrades) replace the upgrade request ticket. #}
{% set upgrade = order.status == 'active' ? client.order_upgrade_options({ 'id': order.id }) : { 'available': false } %}
{# ClientFence core patch: cancellation requests in their own list, as WHMCS (Order\CancelRequests); the client can withdraw one while it waits. #}
{% set cancel_request = order.status == 'active' ? client.order_cancel_request_get({ 'id': order.id }) : null %}
{# ClientFence core patch: an unpaid renewal invoice is paid here; Renew Now would only open it again (Invoice Service generateForOrder()). #}
{% set can_renew = order.period and order.status in ['active', 'suspended'] %}
{% set tickets_on = guest.support_tickets_enabled %}

{# The order form answers (Formbuilder), each with its question in the client's language. Deleting a form clears it from its orders. #}
{% set answers = [] %}
{% if order.form_id and guest.extension_is_on({ 'mod': 'formbuilder' }) %}
    {% for field in guest.formbuilder_get({ 'id': order.form_id }).fields %}
        {% set value = order.config[field.name]|default(null) %}
        {% set shown = [] %}
        {% for one in (value is iterable ? value : [value])|filter(v => v is not null and v != '') %}
            {% set label = one %}
            {% if field.type in ['select', 'radio', 'checkbox'] and field.options is iterable %}
                {% for option_label, option_value in field.options %}{% if option_value == one %}{% set label = option_label %}{% endif %}{% endfor %}
            {% endif %}
            {% set shown = shown|merge([label]) %}
        {% endfor %}
        {% if shown %}{% set answers = answers|merge([{ 'label': field.label, 'value': shown|join(', ') }]) %}{% endif %}
    {% endfor %}
{% endif %}
{% set lines = order.config.option_lines|default([]) %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
    {# Inside the block: the layout sets clientfence_user (an authorized user's permissions). #}
    {% set open_invoice = can_renew and order.unpaid_invoice_id and (not clientfence_user or clientfence_user.owner or 'invoices' in clientfence_user.permissions) ? client.invoice_get_list({ 'id': order.unpaid_invoice_id, 'status': 'unpaid', 'per_page': 1 }).list|first : null %}
    {{ render_widgets('client.order.manage.content.start', { 'order': order }) }}

    {% set icon = { 'hosting': 'server', 'domain': 'world', 'license': 'key', 'apikey': 'key', 'downloadable': 'folder' }[order.service_type]|default('apps') %}
    <div class="clientfence-hosting-hero card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <span class="clientfence-hosting-monogram is-large" aria-hidden="true"><svg class="icon"><use href="#{{ icon }}"/></svg></span>
            <div class="min-w-0 flex-grow-1">
                <h1 class="clientfence-hosting-hero-domain mb-1">{% if order.service_type == 'domain' and service %}<bdi dir="ltr">{{ service.domain }}</bdi>{% else %}{{ order.title }}{% endif %}</h1>
                <div class="clientfence-hosting-hero-meta">
                    {{ mf.status_badge(order.status, 'order') }}
                    {% if has_head %}{{ include(head_partial, { 'part': 'meta' }) }}{% else %}<span>{{ 'Order #:id'|trans({ ':id': order.id }) }}</span>{% endif %}
                </div>
            </div>
            {% if has_head %}
                <div class="clientfence-hosting-actions">{{ include(head_partial, { 'part': 'actions' }) }}</div>
            {% endif %}
        </div>
    </div>

    {% if open_invoice %}
        <div class="alert alert-warning bf-pay-strip mb-4" role="status">
            <span class="d-inline-flex align-items-center gap-2"><svg class="icon flex-none" aria-hidden="true"><use href="#alert-triangle"/></svg>{{ 'Invoice :number for :amount is waiting for payment. Your service renews when it is paid.'|trans({ ':number': open_invoice.serie_nr, ':amount': open_invoice.total|format_currency(open_invoice.currency) }) }}</span>
            <a class="btn btn-sm btn-warning" href="{{ 'invoice'|url }}/{{ open_invoice.hash }}">{{ 'Pay invoice'|trans }}</a>
        </div>
    {% endif %}
    {% if upgrade.waiting|default(null) %}
        {% set waiting = upgrade.waiting %}
        <div class="alert alert-info bf-pay-strip mb-4" role="status">
            <span>{{ 'Your change to %title%, %period%, is waiting for payment of invoice #%number% (%amount%). It is made as soon as the invoice is paid.'|trans({ '%title%': waiting.title, '%period%': waiting.period|period_title|lower, '%number%': waiting.invoice_number, '%amount%': waiting.amount|format_currency(waiting.currency) }) }}</span>
            <a class="btn btn-primary btn-sm" href="{{ 'invoice'|url }}/{{ waiting.invoice_hash }}">{{ 'Pay Invoice'|trans }}</a>
        </div>
    {% endif %}
    {% if cancel_request %}
        <div class="alert alert-warning bf-pay-strip mb-4" role="status">
            <span>{{ cancel_request.type == 'end_of_period'
                ? 'You asked on %date% to cancel this service at the end of its billing period. You can withdraw the request until it is processed.'|trans({ '%date%': cancel_request.created_at|format_date })
                : 'You asked on %date% to cancel this service immediately. You can withdraw the request until it is processed.'|trans({ '%date%': cancel_request.created_at|format_date }) }}</span>
            <a class="btn btn-outline-secondary btn-sm" {{ fb_api_link({href: 'order/cancel_request_withdraw'|api_url(query: {id: order.id}), modal: {type: 'confirm', title: 'Withdraw the cancellation request?'|trans, content: 'The service stays active.'|trans}, reload: true}) }}>{{ 'Withdraw Request'|trans }}</a>
        </div>
    {% endif %}

    {% set tile_col = tickets_on ? 'col-6 col-xl-3' : 'col-6 col-xl-4' %}
    {# A domain's dates are the registrar's (Sync Now updates them); a one-off promo price does not renew. #}
    {% set is_domain = order.service_type == 'domain' and service %}
    {% set expires_at = is_domain ? service.expires_at : order.expires_at %}
    {% set since = is_domain ? service.registered_at : order.activated_at %}
    <div class="row g-3 mb-4">
        <div class="{{ tile_col }}">
            <div class="stat-card">
                <span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#credit-card"/></svg></span>
                {% if order.service_type == 'domain' %}
                    <div class="stat-label">{{ 'Payment Amount'|trans }}</div>
                    <div class="stat-value">{{ (order.total - order.discount)|format_currency(order.currency ?? default_currency) }}</div>
                    <div class="stat-meta">{{ order.created_at|format_date }}</div>
                {% else %}
                    <div class="stat-label">{{ 'Price'|trans }}</div>
                    <div class="stat-value">{{ (order.promo_recurring ? order.total - order.discount : order.total)|format_currency(order.currency ?? default_currency) }}</div>
                    <div class="stat-meta">{{ order.period ? order.period|period_title : 'One-time payment'|trans }}</div>
                {% endif %}
            </div>
        </div>
        <div class="{{ tile_col }}">
            <div class="stat-card{% if expires_at and expires_at|daysleft <= 14 %} is-alert{% endif %}">
                <span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#refresh"/></svg></span>
                <div class="stat-label">{{ order.service_type == 'domain' ? 'Expires'|trans : 'Next renewal'|trans }}</div>
                <div class="stat-value is-sm">{{ expires_at ? expires_at|format_date : '-' }}</div>
                <div class="stat-meta">{{ expires_at ? 'in :days day(s)'|trans({ ':days': expires_at|daysleft }) : 'Does not renew'|trans }}</div>
            </div>
        </div>
        <div class="{{ tile_col }}">
            <div class="stat-card">
                <span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#circle-check"/></svg></span>
                <div class="stat-label">{{ is_domain ? 'Registered on'|trans : 'Active since'|trans }}</div>
                <div class="stat-value is-sm">{{ since ? since|format_date : '-' }}</div>
                <div class="stat-meta">{{ 'Order #:id'|trans({ ':id': order.id }) }}</div>
            </div>
        </div>
        {# ClientFence core patch: no ticket count or Open Ticket while tickets are off (Support settings). #}
        {% if tickets_on %}
        <div class="{{ tile_col }}">
            <a class="stat-card d-block" href="{{ 'support'|url }}">
                <span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#headset"/></svg></span>
                <div class="stat-label">{{ 'Open tickets'|trans }}</div>
                <div class="stat-value">{{ order.active_tickets }}</div>
                <div class="stat-meta">{{ 'About this service'|trans }}</div>
            </a>
        </div>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            {{ render_widgets('client.order.manage.service.before', { 'order': order, 'service': service }) }}
            {% if service %}
                {{ include(service_partial, { 'order': order, 'service': service }) }}
            {% elseif has_partial %}
                <div class="alert alert-info" role="alert">{{ 'This order has no active service to manage.'|trans }}</div>
            {% endif %}
            {{ render_widgets('client.order.manage.service.after', { 'order': order, 'service': service }) }}

            {# A product without its own service card (or with options and answers next to it). #}
            {% if not service or lines or answers or order.discount > 0 %}
            <div class="card mb-4">
                <div class="card-header"><h2>{{ 'Details'|trans }}</h2></div>
                <dl class="bf-facts">
                    {% if not service %}
                        <div class="bf-fact"><dt>{{ 'Product'|trans }}</dt><dd>{{ order.title }}</dd></div>
                    {% endif %}
                    {# ClientFence: configurable options (Product/Options.php). #}
                    {% for line in lines %}
                        <div class="bf-fact"><dt>{{ line.title }}</dt><dd><bdi>{% if line.type == 'yesno' %}{{ 'Yes'|trans }}{% elseif line.type == 'quantity' %}{{ line.quantity }}{% if line.unit %} {{ line.unit }}{% endif %}{% else %}{{ line.value }}{% endif %}</bdi></dd></div>
                    {% endfor %}
                    {% for answer in answers %}
                        <div class="bf-fact"><dt>{{ answer.label }}</dt><dd><bdi>{{ answer.value }}</bdi> <button class="bf-copy" type="button" data-bf-copy="{{ answer.value }}" aria-label="{{ 'Copy'|trans }}"><svg class="icon icon-sm" aria-hidden="true"><use href="#copy"/></svg></button></dd></div>
                    {% endfor %}
                    {% if order.discount > 0 %}
                        <div class="bf-fact"><dt>{{ 'Order Discount'|trans }}</dt><dd>-{{ order.discount|format_currency(order.currency ?? default_currency) }}</dd></div>
                    {% endif %}
                    <div class="bf-fact"><dt>{{ 'Order Created'|trans }}</dt><dd>{{ order.created_at|format_date }}</dd></div>
                </dl>
                {% if answers %}
                    <div class="card-footer small text-secondary">{{ 'Your answers on the order form.'|trans }}</div>
                {% endif %}
            </div>
            {% endif %}
            {{ render_widgets('client.order.manage.details.after', { 'order': order }) }}

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card mb-4">
                <div class="card-header"><h2>{{ 'Addons'|trans }}</h2></div>
                {% for addon in addons %}
                    <a class="list-row" href="{{ "order/service/manage/#{addon.id}"|url }}">
                        <div class="min-w-0">
                            <div class="list-row-title text-truncate">{{ addon.title }}</div>
                            <div class="list-row-meta">{{ addon.total|format_currency(addon.currency ?? default_currency) }} · {{ addon.period|period_title }}{% if addon.expires_at %} · {{ 'Expires'|trans }} {{ addon.expires_at|format_date }}{% endif %}</div>
                        </div>
                        {{ mf.status_badge(addon.status, 'order') }}
                    </a>
                {% endfor %}
            </div>
            {% endif %}

            {# ClientFence core patch: add-ons ordered for this service (Order/AddonOrders.php), through the cart. #}
            {% set addon_offers = client.order_addon_offers({ "id": order.id }) %}
            {% if addon_offers|length > 0 %}
            <div class="card mb-4" id="order-addons">
                <div class="card-header"><h2>{{ 'Order Add-ons'|trans }}</h2></div>
                {% for offer in addon_offers %}
                    <div class="list-row">
                        <div class="min-w-0">
                            <div class="list-row-title">{{ offer.title }}</div>
                            <div class="list-row-meta">{{ 'Due now'|trans }}: {{ (offer.now + offer.setup)|format_currency(order.currency) }}{% if offer.period %} {{ 'to :date'|trans({':date': offer.due|format_date}) }} · {{ 'Then'|trans }}: {{ offer.price|format_currency(order.currency) }} {{ offer.period|period_title }}{% endif %}</div>
                        </div>
                        <a class="btn btn-primary btn-sm" {{ fb_api_link({href: 'order/addon_order'|api_url(query: {id: order.id, product_id: offer.id}), redirect: 'cart'|url}) }}>{{ 'Order'|trans }}</a>
                    </div>
                {% endfor %}
                <div class="card-footer small text-secondary">{{ 'Add-ons are charged to this service\'s due date, then renew with it.'|trans }}</div>
            </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header"><h2>{{ 'Manage'|trans }}</h2></div>
                <div class="bf-manage">
                    {% if can_renew and not open_invoice and (order.service_type != 'domain' or not has_head) %}
                        <a class="list-row" {{ fb_api_link({href: 'invoice/renewal_invoice'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Are you sure?'|trans, content: 'This will generate new invoice. Are you sure you want to continue?'|trans}, callback: 'onRenewalInvoiceCreated'}) }}>
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#refresh"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Renew Now'|trans }}</span><span class="list-row-meta d-block">{{ 'Pay the next period now'|trans }}</span></span>
                            <svg class="icon icon-sm bf-chev" aria-hidden="true"><use href="#chevron-right"/></svg>
                        </a>
                    {% endif %}
                    {% if has_head %}{{ include(head_partial, { 'part': 'manage' }) }}{% endif %}
                    {% if upgrade.available %}
                        <button class="list-row" type="button" id="request-upgrade" data-bs-toggle="modal" data-bs-target="#upgrade-modal">
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#arrows-exchange"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Upgrade / Downgrade'|trans }}</span><span class="list-row-meta d-block">{{ 'Change plan or billing cycle'|trans }}</span></span>
                            <svg class="icon icon-sm bf-chev" aria-hidden="true"><use href="#chevron-right"/></svg>
                        </button>
                    {% elseif upgrade.notice|default(false) %}
                        {# ClientFence: why Upgrade / Downgrade is not offered now (GitHub #8). #}
                        <div class="list-row is-off" id="upgrade-unavailable">
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#arrows-exchange"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Upgrade / Downgrade'|trans }}</span><span class="list-row-meta d-block">{{ upgrade.reason }}</span></span>
                        </div>
                    {% endif %}
                    {% if upgrade.options_change|default(false) %}
                        <button class="list-row" type="button" data-bs-toggle="modal" data-bs-target="#options-change-modal">
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#pencil"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Change options'|trans }}</span><span class="list-row-meta d-block text-truncate">{{ lines|map(l => l.title ~ ': ' ~ (l.type == 'quantity' ? l.quantity ~ (l.unit ? ' ' ~ l.unit : '') : (l.type == 'yesno' ? 'Yes'|trans : l.value)))|join(', ') }}</span></span>
                            <svg class="icon icon-sm bf-chev" aria-hidden="true"><use href="#chevron-right"/></svg>
                        </button>
                    {% endif %}
                    {% if tickets_on %}
                        <button class="list-row" type="button" id="open-ticket" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#headset"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Open Ticket'|trans }}</span><span class="list-row-meta d-block">{{ 'About this service'|trans }}</span></span>
                            <svg class="icon icon-sm bf-chev" aria-hidden="true"><use href="#chevron-right"/></svg>
                        </button>
                    {% endif %}
                    {% if order.status == 'active' and not cancel_request %}
                        <button class="list-row is-danger" type="button" id="request-cancel" data-bs-toggle="modal" data-bs-target="#cancel-request-modal">
                            <span class="clientfence-hosting-tile-icon"><svg class="icon icon-sm" aria-hidden="true"><use href="#x"/></svg></span>
                            <span class="min-w-0"><span class="list-row-title d-block">{{ 'Request Cancellation'|trans }}</span><span class="list-row-meta d-block">{{ 'Now or at the end of the period'|trans }}</span></span>
                            <svg class="icon icon-sm bf-chev" aria-hidden="true"><use href="#chevron-right"/></svg>
                        </button>
                    {% endif %}
                    {{ render_widgets('client.order.manage.actions.end', { 'order': order }) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="modal fade" id="cancel-request-modal" tabindex="-1" role="dialog" aria-labelledby="cancel-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit Cancellation Request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="cancel-request-form" class="request-cancellation">
                            <div class="modal-body">
                                <input type="hidden" name="id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="cancel-type" class="form-label">{{ 'Cancellation Type'|trans }}</label>
                                    <select class="form-select" id="cancel-type" name="type">
                                        <option value="immediate">{{ 'Immediate'|trans }}</option>
                                        {% if order.expires_at %}<option value="end_of_period">{{ 'End of billing period'|trans }} ({{ order.expires_at|format_date }})</option>{% endif %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="cancel-reason" class="form-label">{{ 'Reason'|trans }}</label>
                                    <textarea class="form-control" id="cancel-reason" name="reason" rows="5" maxlength="2000" required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="open-ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticket-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit New Support Ticket'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="open-ticket-form" class="open-ticket">
                            <div class="modal-body">
                                {# ClientFence core patch: the ticket limit per client, Open Ticket off when none is left (Support/TicketLimit.php). #}
                                {% set ticket_limit = client.support_ticket_limit %}
                                {{ include('partials/ticket_limit.html.twig') }}
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Message'|trans }}</label>
                                    <textarea class="editor-textarea form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary"{% if ticket_limit and ticket_limit.left == 0 %} disabled{% endif %}>{{ 'Open Ticket'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {% if upgrade.available %}
            {% set cur = upgrade.current %}
            {% set first = upgrade.options|first %}
            <div class="modal fade" id="upgrade-modal" tabindex="-1" role="dialog" aria-labelledby="upgrade-modal-title" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="upgrade-modal-title">{{ 'Upgrade or Downgrade'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="upgrade-form">
                            <div class="modal-body">
                                <p class="mb-1"><strong>{{ 'Current'|trans }}:</strong> {{ cur.title }}, {{ cur.price|format_currency(cur.currency) }} {{ cur.period|period_title|lower }}</p>
                                <p class="text-secondary small mb-3">{{ 'Your current period ends on %date%; %left% of its %total% days are unused. Their value is credited against the new price.'|trans({ '%date%': first.expires_at|format_date, '%left%': first.days_left, '%total%': first.days_total }) }}</p>
                                <input type="hidden" name="id" value="{{ order.id }}">
                                {# Why a plan is not offered, e.g. too many IP addresses for it (IpSeats, CF-56). #}
                                {% if upgrade.reason %}<div class="alert alert-info small">{{ upgrade.reason }}</div>{% endif %}
                                <div class="list-group">
                                    {% for opt in upgrade.options %}
                                    <label class="list-group-item d-flex gap-3 align-items-start">
                                        <input class="form-check-input flex-shrink-0 mt-1" type="radio" name="choice" value="{{ opt.product_id }}|{{ opt.period }}" {{ loop.first ? 'required' : '' }}>
                                        <span class="flex-grow-1">
                                            <span class="d-block fw-semibold">
                                                {{ opt.title }}, {{ opt.period|period_title|lower }}
                                                <span class="badge {{ opt.kind == 'downgrade' ? 'bg-info' : 'bg-success' }} ms-1">{{ opt.kind == 'downgrade' ? 'Downgrade'|trans : 'Upgrade'|trans }}</span>
                                            </span>
                                            <span class="d-block text-secondary small">
                                                {{ opt.price|format_currency(cur.currency) }} {{ opt.period|period_title|lower }}.
                                                {% if opt.same_cycle %}
                                                    {{ 'Your renewal date stays %date%: %charge% for the %left% days left, less %credit% unused.'|trans({ '%date%': opt.new_expires_at|format_date, '%charge%': opt.charge|format_currency(cur.currency), '%left%': opt.days_left, '%credit%': opt.credit|format_currency(cur.currency) }) }}
                                                {% else %}
                                                    {{ 'A new period starts today and renews on %date%: %charge%, less %credit% unused.'|trans({ '%date%': opt.new_expires_at|format_date, '%charge%': opt.charge|format_currency(cur.currency), '%credit%': opt.credit|format_currency(cur.currency) }) }}
                                                {% endif %}
                                            </span>
                                        </span>
                                        <span class="text-end text-nowrap">
                                            {% if opt.amount > 0 %}
                                                <span class="d-block fw-semibold">{{ opt.total|format_currency(cur.currency) }}</span>
                                                <span class="d-block text-secondary small">{{ 'to pay now'|trans }}</span>
                                            {% elseif opt.amount < 0 %}
                                                <span class="d-block fw-semibold">{{ (0 - opt.total)|format_currency(cur.currency) }}</span>
                                                <span class="d-block text-secondary small">{{ 'account credit'|trans }}</span>
                                            {% else %}
                                                <span class="d-block fw-semibold">{{ 'No charge'|trans }}</span>
                                            {% endif %}
                                            {% if opt.tax_rate > 0 and opt.amount != 0 %}
                                                <span class="d-block text-secondary small">{{ 'Tax included.'|trans }}</span>
                                            {% endif %}
                                        </span>
                                    </label>
                                    {% endfor %}
                                </div>
                                <p class="text-secondary small mt-3 mb-0">{{ 'An amount to pay is invoiced, and the change is made as soon as the invoice is paid. A credit goes to your account balance and is used for your next invoices.'|trans }}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                                <button type="submit" class="btn btn-primary" id="upgrade-submit">{{ 'Continue'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}

            {# ClientFence: the client changes the configurable options (Order\Upgrades::optionsQuote(); product-options.js). #}
            {% if upgrade.options_change|default(false) %}
            <div class="modal fade" id="options-change-modal" tabindex="-1" role="dialog" aria-labelledby="options-change-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="options-change-title">{{ 'Change options'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" data-cf-options-change data-currency="{{ order.currency }}" data-invoice-url="{{ 'invoice'|url }}"
                              data-text-working="{{ 'Pricing your choice…'|trans }}"
                              data-text-pick="{{ 'Change an option to see the new price.'|trans }}"
                              data-text-quote="{{ ':kind: the new price is :price :period. :due'|trans|replace({ ':period': order.period|period_title|lower }) }}"
                              data-text-upgrade="{{ 'Upgrade'|trans }}" data-text-downgrade="{{ 'Downgrade'|trans }}"
                              data-text-pay="{{ ':amount to pay now for the days left.'|trans }}"
                              data-text-credit="{{ ':amount goes to your account credit.'|trans }}"
                              data-text-free="{{ 'No charge.'|trans }}"
                              data-text-tax="{{ 'Tax included.'|trans }}"
                              data-text-done="{{ 'Your service was changed'|trans }}"
                              data-text-later="{{ 'The change could not be made yet; our staff will finish it'|trans }}">
                            <div class="modal-body">
                                <input type="hidden" name="id" value="{{ order.id }}">
                                <input type="hidden" name="product_id" value="{{ order.product_id }}">
                                <input type="hidden" name="period" value="{{ order.period }}">
                                {{ include('mod_product_options_form.html.twig', { 'product_id': order.product_id, 'options_list': upgrade.product_options, 'currency': guest.currency_get({ 'code': order.currency }), 'selected': order.config.options|default({}), 'lines': order.config.option_lines|default([]), 'per': order.period|period_title|lower, 'no_setup': true }) }}
                                <p class="fw-semibold mb-0" data-cf-options-quote role="status" aria-live="polite"></p>
                                <p class="text-secondary small mt-3 mb-0">{{ 'An amount to pay is invoiced, and the change is made as soon as the invoice is paid. A credit goes to your account balance and is used for your next invoices.'|trans }}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                                <button type="submit" class="btn btn-primary">{{ 'Continue'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

{% endblock %}
{% block js %}
{% autoescape "js" %}
    <script nonce="{{ csp_nonce|raw }}">
        window.onRenewalInvoiceCreated = (hash) => { window.location = {{ 'invoice'|url|json_encode|raw }} + '/' + hash; };
        document.addEventListener("DOMContentLoaded", function() {
            // Copy buttons of the service page and its cards (data-bf-copy holds the text).
            document.addEventListener('click', (event) => {
                const button = event.target.closest('[data-bf-copy]');
                if (button) {
                    navigator.clipboard?.writeText(button.dataset.bfCopy).then(() => ClientFence.message({{ 'Copied'|trans|json_encode|raw }}, 'success'));
                }
            });

            const cancelRequestForm = document.getElementById('cancel-request-form');
            const upgradeForm = document.getElementById('upgrade-form');
            const openTicketForm = document.getElementById('open-ticket-form');

            cancelRequestForm.addEventListener('submit', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('order/cancel_request', ClientFence.tools.serializeFormDataToObject(new FormData(cancelRequestForm)),
                    () => {
                        ClientFence.message({{ 'Service cancellation request received'|trans|json_encode|raw }});
                        window.location.reload();
                    },
                    (res) => {
                        ClientFence.message(res.message, 'error');
                    });
            });

            if (upgradeForm) {
                upgradeForm.addEventListener('submit', function(event) {
                    event.preventDefault();
                    const choice = upgradeForm.querySelector('input[name="choice"]:checked');
                    if (!choice) {
                        return;
                    }
                    const [productId, period] = choice.value.split('|');
                    const button = document.getElementById('upgrade-submit');
                    button.disabled = true;

                    ClientFence.api.client.post('order/upgrade', { id: upgradeForm.elements.id.value, product_id: productId, period: period },
                        (res) => {
                            if (res.invoice_hash) {
                                window.location = {{ 'invoice'|url|json_encode|raw }} + '/' + res.invoice_hash;
                                return;
                            }
                            ClientFence.message(res.status === 'applied' ? {{ 'Your service was changed'|trans|json_encode|raw }} : {{ 'The change could not be made yet; our staff will finish it'|trans|json_encode|raw }}, res.status === 'applied' ? 'success' : 'error');
                            window.setTimeout(() => window.location.reload(), 1500);
                        },
                        (res) => {
                            button.disabled = false;
                            ClientFence.message(res.message, 'error');
                        });
                });
            }

            openTicketForm.addEventListener('submit', function(event) {
                event.preventDefault();

                ClientFence.api.client.post('support/ticket_create', ClientFence.tools.serializeFormDataToObject(new FormData(openTicketForm)),
                    () => {
                        ClientFence.message({{ 'Ticket was submitted. If you want to track conversation please go to support section'|trans|json_encode|raw }});
                        let openTicketModal = bootstrap.Modal.getInstance(document.getElementById('open-ticket-modal'));
                        openTicketModal.hide();
                    },
                    (res) => {
                        ClientFence.message(res.message, 'error')
                    });
            });

        });

    </script>
{% endautoescape %}
{% endblock %}
