{% extends "layout_public.html.twig" %}
{% set allow_guest = true %}

{% block meta_title %}{{ 'Sign in'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
{% embed 'partials/auth_shell.html.twig' %}
    {% block auth_content %}
        <h1>{{ 'Welcome back'|trans }}</h1>
        <p class="auth-lead">{{ 'Sign in to manage your services, invoices and support tickets.'|trans }}</p>
        {{ render_widgets('client.page.login.form.before') }}
        {# ?back=<path on this site> (the checkout's "Sign in"): where the sign-in goes next, also
           after the two-factor code; otherwise FOSSBilling's redirect_uri. Same rule as the
           two-factor page's back: one leading slash, no backslash, space or "://". #}
        {% set back = request.back|default('') %}
        {% set back = back is iterable or not (back matches '#^/(?![/\\\\])[^\\s\\\\]*$#') or '://' in back ? '' : back %}
        <form method="post" action="{{ 'client/login'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({callback: 'clientfenceSignIn'}) }} data-clientfence-sign-in data-redirect="{{ back ?: redirect_uri|default('/')|url }}" data-twofactor="{{ back ? 'two-factor/code'|url({back: back}) : 'two-factor/code'|url }}">
    {# ClientFence core patch (0.8.9 port): bind guest authentication to this browser session. #}
    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <div class="mb-3">
                <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                <input class="form-control" id="email" type="email" name="email" value="{{ request.email }}" autocomplete="username" required autofocus>
            </div>
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label" for="password">{{ 'Password'|trans }}</label>
                    {% if settings.show_password_reset_link|default('1') %}
                        <a class="small" href="{{ 'password-reset'|url }}">{{ 'Forgot Password?'|trans }}</a>
                    {% endif %}
                </div>
                <input class="form-control" id="password" type="password" name="password" autocomplete="current-password" required>
            </div>
            {% import "macro_functions.html.twig" as mf %}
            <div class="mt-3">{{ mf.recaptcha }}</div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">{{ 'Sign in'|trans }}</button>
        </form>
        {{ render_widgets('client.page.login.form.after') }}
        {# Sign-up open (ClientFence: client sign-up on, or the store preview link) and the theme
           setting "Show Signup Link" on: a link to the sign-up page; otherwise accounts are made by
           the team. #}
        {% set support_email = guest.system_company.email|default('') %}
        {% if guest.clientfence_signup_info.open and settings.show_signup_link|default('1') %}
            <p class="mt-4 mb-1" data-clientfence-signup-link>
                {{ 'New here?'|trans }} <a class="fw-semibold" href="{{ 'signup'|url(back ? {back: back} : {}) }}">{{ 'Create an account'|trans }}</a>
            </p>
            {% if support_email %}
            <p class="small text-body-secondary mb-0">
                {{ 'Need help? Email'|trans }} <a href="mailto:{{ support_email }}">{{ support_email }}</a>
            </p>
            {% endif %}
        {% elseif support_email %}
            <p class="small text-body-secondary mt-4 mb-0">
                {{ 'Accounts are created by our team. Need help? Email'|trans }}
                <a href="mailto:{{ support_email }}">{{ support_email }}</a>
            </p>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
