{# ClientFence: FOSSBilling's ticket list with the new-ticket form on the page instead of a modal (open
   when there are no tickets, after ?ticket=1 or on #new-ticket), help desk names translated and a
   plain text message box instead of the English-only rich editor, with ticket attachments (ClientFence
   Pack, partials/ticket_upload.html.twig). The submitted time is one
   translated phrase (":time ago"), so Arabic reads "منذ 1 أسبوع". #}
{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'support' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Support Tickets'|trans }}{% endblock %}
{% block page_header %}{{ 'Support Tickets'|trans }}{% endblock %}

{% block body_class %}support-tickets{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Support Tickets'|trans }}</li>{% endblock %}


{% block content %}
{% set tickets = client.support_ticket_get_list({"per_page":10, "page":request.page, "deep": 0, "include_first": 0}) %}
{% set show_form = not tickets.list or request.ticket or request.subject %}
<div class="row">
    <div class="col-md-12">
        <div class="bf-page-head mb-4">
            <div>
                <h1 class="bf-page-title">{{ 'Support Tickets'|trans }}</h1>
                <span class="bf-hint">{{ 'Need an answer? We are here to help!'|trans }}</span>
            </div>
            <div>
                <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#new-ticket" aria-controls="new-ticket" aria-expanded="{{ show_form ? 'true' : 'false' }}">{{ 'New Ticket'|trans }}</button>
            </div>
        </div>
        <div class="card mb-4">
            <div class="collapse{{ show_form ? ' show' : '' }}" id="new-ticket">
                <div class="card-body border-bottom">
                    <h2 class="h5 mb-3">{{ 'Open New Ticket'|trans }}</h2>
                    <form action="" method="post" id="ticket-submit" class="form">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="support-helpdesk-id" class="form-label">{{ 'Helpdesk'|trans }}</label>
                                <select name="support_helpdesk_id" id="support-helpdesk-id" class="form-select" required>
                                    {% for id, name in client.support_helpdesk_get_pairs %}
                                        <option value="{{ id }}"{% if request.support_helpdesk_id == id %} selected{% endif %}>{{ name|trans }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                {# Urgency, as WHMCS (Support/TicketPriority.php). #}
                                <label for="ticket-priority" class="form-label">{{ 'Urgency'|trans }}</label>
                                <select name="priority" id="ticket-priority" class="form-select">
                                    {% for level, title in guest.support_ticket_priorities %}
                                        <option value="{{ level }}"{% if level == (request.priority|default('medium')) %} selected{% endif %}>{{ title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                <input type="text" name="subject" class="form-control" id="subject" required value="{{ request.subject|e }}">
                            </div>
                            {% if guest.support_kb_suggestions_enabled({ 'area': 'ticket' }) %}
                                <div class="col-12">{{ include('mod_support_kb_suggestions.html.twig', { 'input_id': 'subject' }) }}</div>
                            {% endif %}
                            <div class="col-12">
                                <label for="message" class="form-label">{{ 'Message'|trans }}</label>
                                <textarea name="content" class="form-control" id="message" rows="10" dir="auto" required>{{ request.content|e }}</textarea>
                                {% include 'partials/ticket_upload.html.twig' %}
                            </div>
                            {# ClientFence: optional server access or another secret, added once the ticket exists (Support/TicketSecrets.php). #}
                            {% set secret_kinds = client.support_ticket_secret_kinds %}
                            {% if secret_kinds.server or secret_kinds.other %}
                                <div class="col-12">
                                    <details class="border rounded p-3" id="new-ticket-secret">
                                        <summary class="fw-medium">{{ secret_kinds.server ? 'Server access (optional)'|trans : 'Secrets (optional)'|trans }}</summary>
                                        <p class="text-secondary small mt-2">{{ 'If our support team needs to sign in to your server, add the details here. They are encrypted at once, only authorized support staff can open them, every opening is shown on the ticket, and they are deleted when the ticket is closed. You can also add them later from the ticket page.'|trans }}</p>
                                        <p class="small fw-medium">{{ 'Never put passwords in the message itself.'|trans }}</p>
                                        {{ include('partials/ticket_secret_fields.html.twig', { kinds: secret_kinds, prefix: 'new-secret' }) }}
                                    </details>
                                </div>
                                {{ include('partials/ticket_secrets_script.html.twig') }}
                            {% endif %}
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">{{ 'Submit'|trans }}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body table-responsive">
                {% if tickets.list %}
                <table class="table table-striped table-bordered table-hover table-stack">
                    <thead>
                    <tr>
                        <th>{{ 'ID'|trans }}</th>
                        <th>{{ 'Subject'|trans }}</th>
                        <th>{{ 'Help Desk'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Submitted'|trans }}</th>
                        <th>{{ 'Actions'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for i, ticket in tickets.list %}
                        <tr>
                            <td>#{{ticket.id}}</td>
                            <td><a href='{{ "support/ticket/#{ticket.id}"|url }}'>{{ ticket.subject|truncate(40) }}</a></td>
                            <td>{{ ticket.helpdesk.name|trans }}</td>
                            <td>
                                {{ mf.status_badge(ticket.status, 'ticket') }}
                            </td>
                            <td title="{{ ticket.created_at|format_date }}">{{ ':time ago'|trans({ ':time': ticket.created_at|timeago }) }}</td>
                            <td class="actions">
                                {% if ticket.status == 'closed' %}
                                    <a href='{{ "support/ticket/#{ticket.id}"|url }}' class="btn btn-sm btn-outline-secondary">{{ 'View'|trans }}</a>
                                {% else %}
                                    <a href='{{ "support/ticket/#{ticket.id}"|url }}#reply-to' class="btn btn-sm btn-outline-info">{{ 'Reply'|trans }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ include('partial_pagination.html.twig', { 'list': tickets, 'url': 'support' }) }}
                {% else %}
                    <div class="d-flex justify-content-center my-2 py-4">
                        <span class="blockquote m-0">{{ 'No Support Tickets'|trans }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>


{% endblock %}

{% block js %}
    <script nonce="{{ csp_nonce }}">
        document.addEventListener("DOMContentLoaded", function() {
            // Plain text box: keep each line break (Markdown hard break; blank lines stay paragraphs).
            const keepLineBreaks = (text) => (text || '').replace(/\r\n?/g, '\n').replace(/([^\n])\n(?=[^\n])/g, '$1  \n');
            let submitTicket = document.getElementById('ticket-submit');
            submitTicket.addEventListener('submit', (event) => {
                event.preventDefault();
                const ticket = ClientFence.tools.serializeFormDataToObject(new FormData(submitTicket));
                ticket.content = keepLineBreaks(ticket.content);
                delete ticket['new-secret_kind'];
                const secretBox = document.getElementById('new-ticket-secret');
                const secret = secretBox && window.ClientFenceSecrets ? ClientFenceSecrets.collect(secretBox) : null;
                ClientFence.api.client.post('support/ticket_create', ticket,
                    (res) => {
                        const open = (hash) => { window.location = "{{ 'support/ticket'|url }}" + '/' + res + hash; };
                        if (!secret) return open('');
                        // The ticket exists either way; a refused secret is shown and can be added again there.
                        ClientFence.api.client.post('support/ticket_secret_add', Object.assign({ ticket_id: res }, secret),
                            () => open('#secrets'),
                            (err) => { ClientFence.message(err.message, 'error'); setTimeout(() => open('#secrets'), 4000); });
                    },
                    (res) => {
                        ClientFence.message(res.message, 'error')
                    });
            });
            const newTicket = document.getElementById('new-ticket');
            if (window.location.hash === '#new-ticket') {
                bootstrap.Collapse.getOrCreateInstance(newTicket, { toggle: false }).show();
            }
            newTicket.addEventListener('shown.bs.collapse', () => {
                newTicket.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                document.getElementById('subject').focus();
            });
        });
    </script>
{% endblock %}
