{# ClientFence: the Network Status page, as WHMCS (Support/NetworkIssues.php): a status summary, then
   open issues, scheduled work and resolved issues, each with what it affects, priority, start and end
   and the description staff keep up to date. #}
{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'network-status' %}

{% block meta_title %}{{ 'Network Status'|trans }}{% endblock %}
{% block body_class %}network-status{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Network Status'|trans }}</li>
{% endblock %}

{% block content %}
{% set groups = { 'open': 'Open'|trans, 'scheduled': 'Scheduled'|trans, 'resolved': 'Resolved'|trans } %}
{% set tones = { 'reported': 'warn', 'investigating': 'warn', 'in_progress': 'warn', 'outage': 'danger', 'scheduled': 'info', 'resolved': 'ok' } %}
{% set open_count = issues.counts.open|default(0) %}
<div class="bf-page-head mb-4">
    <div>
        <h1 class="bf-page-title">{{ 'Network Status'|trans }}</h1>
        <span class="bf-hint">{{ 'Outages and planned work on our servers and services.'|trans }}</span>
    </div>
</div>

<div class="ns-summary ns-{{ open_count ? 'warn' : 'ok' }} mb-4" role="status">
    <span class="ns-summary-icon"><svg class="icon" aria-hidden="true"><use href="#{{ open_count ? 'alert-triangle' : 'circle-check' }}"/></svg></span>
    <div>
        <strong>{{ open_count ? ':count open issue(s)'|trans({ ':count': open_count }) : 'All systems operational'|trans }}</strong>
        <span>{{ open_count ? 'Our team is working on it. Details are below.'|trans : 'No open issues: everything is running normally.'|trans }}</span>
    </div>
</div>

<nav class="bf-seg ns-tabs mb-4" aria-label="{{ 'Network Status'|trans }}">
    {% for key, label in groups %}
        <a class="bf-seg-item{% if group == key %} is-on{% endif %}" href="{{ 'network-status'|url(query: { 'group': key }) }}"{% if group == key %} aria-current="page"{% endif %}>
            <span>{{ label }}<span class="ns-count">{{ issues.counts[key]|default(0) }}</span></span>
        </a>
    {% endfor %}
</nav>

{% for issue in issues.list %}
    {% set tone = tones[issue.status]|default('info') %}
    <article class="ns-issue ns-{{ tone }}">
        <header class="ns-issue-head">
            <h2 dir="auto">{{ issue.title }}</h2>
            <span class="ns-status">{{ issue.status_title }}</span>
        </header>
        <dl class="ns-meta">
            <div><dt>{{ 'Affects'|trans }}</dt><dd dir="auto">{{ issue.about }}</dd></div>
            <div><dt>{{ 'Priority'|trans }}</dt><dd>{{ issue.priority_title }}</dd></div>
            <div><dt>{{ 'Start'|trans }}</dt><dd>{{ issue.start_at|format_datetime }}</dd></div>
            {% if issue.end_at %}<div><dt>{{ 'End'|trans }}</dt><dd>{{ issue.end_at|format_datetime }}</dd></div>{% endif %}
        </dl>
        {% if issue.description %}
            <p class="ns-text" dir="auto">{{ issue.description|nl2br }}</p>
        {% endif %}
        <footer class="ns-updated">{{ 'Last updated'|trans }}: {{ issue.updated_at|format_datetime }}</footer>
    </article>
{% else %}
    <div class="ns-empty">
        <svg class="icon" aria-hidden="true"><use href="#circle-check"/></svg>
        <p class="mb-0">
            {% if group == 'open' %}{{ 'No open issues: everything is running normally.'|trans }}
            {% elseif group == 'scheduled' %}{{ 'No planned work.'|trans }}
            {% else %}{{ 'No resolved issues.'|trans }}{% endif %}
        </p>
    </div>
{% endfor %}

{% if issues.pages > 1 %}
    <nav class="d-flex gap-2 mt-3" aria-label="{{ 'Pages'|trans }}">
        {% if issues.page > 1 %}<a class="btn btn-outline-secondary btn-sm" href="{{ 'network-status'|url(query: { 'group': group, 'page': issues.page - 1 }) }}">{{ 'Previous'|trans }}</a>{% endif %}
        {% if issues.page < issues.pages %}<a class="btn btn-outline-secondary btn-sm" href="{{ 'network-status'|url(query: { 'group': group, 'page': issues.page + 1 }) }}">{{ 'Next'|trans }}</a>{% endif %}
    </nav>
{% endif %}
{% endblock %}
