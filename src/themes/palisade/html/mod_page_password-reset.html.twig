{% extends "layout_public.html.twig" %}
{% set allow_guest = true %}

{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block body_class %}page-password-reset{% endblock %}

{% block body %}
{% embed 'partials/auth_shell.html.twig' %}
    {% block auth_content %}
        {% import "macro_functions.html.twig" as mf %}
        <h1>{{ 'Reset Your Password'|trans }}</h1>
        <p class="auth-lead">{{ 'Enter your email to receive a password reset link and choose a new password.'|trans }}</p>
        {% if link_error is defined %}<div class="alert alert-warning" role="alert">{{ link_error }} {{ 'Ask for a new link below.'|trans }}</div>{% endif %}
        <form method="post" action="{{ 'client/reset_password'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans}) }}>
            <div class="mb-3">
                <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                <input class="form-control" id="email" type="email" name="email" value="{{ request.email }}" autocomplete="username" required autofocus>
            </div>
            {{ mf.recaptcha }}
            <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">{{ 'Reset Password'|trans }}</button>
        </form>
        <a class="btn btn-link w-100 mt-3 d-inline-flex align-items-center justify-content-center gap-2" href="{{ 'login'|url }}">
            <svg class="icon icon-sm flip-rtl" aria-hidden="true"><use href="#arrow-left"/></svg>{{ 'Back to Login'|trans }}
        </a>
    {% endblock %}
{% endembed %}
{% endblock %}
