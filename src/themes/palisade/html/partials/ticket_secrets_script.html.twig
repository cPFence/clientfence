{# ClientFence: reads and clears the ticket secret fields (partials/ticket_secret_fields.html.twig)
   and switches between server access and other secret. Included once per page. #}
<script nonce="{{ csp_nonce }}">
    window.ClientFenceSecrets = {
        // The add call's parameters, or null when nothing was typed.
        collect(box) {
            const kindInput = box.querySelector('[data-cf-secret-kind]:checked') || box.querySelector('input[type="hidden"][data-cf-secret-kind]');
            const kind = kindInput ? kindInput.value : 'server';
            const pane = box.querySelector('[data-cf-secret-pane="' + kind + '"]');
            const data = { kind };
            let typed = false;
            pane.querySelectorAll('[data-cf-secret]').forEach((field) => {
                data[field.dataset.cfSecret] = field.value;
                if (field.tagName !== 'SELECT' && field.value.trim() !== '') typed = true;
            });
            return typed ? data : null;
        },
        clear(box) {
            box.querySelectorAll('input[data-cf-secret], textarea[data-cf-secret]').forEach((field) => { field.value = ''; });
        },
    };
    document.addEventListener('change', (event) => {
        const radio = event.target.closest('[data-cf-secret-kind]');
        if (!radio || radio.type !== 'radio') return;
        const box = radio.closest('[data-cf-secret-fields]');
        box.querySelectorAll('[data-cf-secret-pane]').forEach((pane) => { pane.hidden = pane.dataset.cfSecretPane !== radio.value; });
    });
</script>
