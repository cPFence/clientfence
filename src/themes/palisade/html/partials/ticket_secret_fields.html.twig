{# ClientFence: the fields of a ticket secret (Support/TicketSecrets.php), on the new ticket form
   and the ticket page. `kinds` is client.support_ticket_secret_kinds; `prefix` keeps the ids unique.
   Read by ClientFenceSecrets.collect() (partials/ticket_secrets_script.html.twig). #}
{% set prefix = prefix|default('secret') %}
<div class="ticket-secret-fields" data-cf-secret-fields>
    {% if kinds.server and kinds.other %}
        <div class="btn-group mb-3" role="group" aria-label="{{ 'Kind of secret'|trans }}">
            <input type="radio" class="btn-check" name="{{ prefix }}_kind" id="{{ prefix }}-kind-server" value="server" checked data-cf-secret-kind>
            <label class="btn btn-outline-secondary btn-sm" for="{{ prefix }}-kind-server">{{ 'Server access'|trans }}</label>
            <input type="radio" class="btn-check" name="{{ prefix }}_kind" id="{{ prefix }}-kind-other" value="other" data-cf-secret-kind>
            <label class="btn btn-outline-secondary btn-sm" for="{{ prefix }}-kind-other">{{ 'Other secret'|trans }}</label>
        </div>
    {% else %}
        <input type="hidden" name="{{ prefix }}_kind" value="{{ kinds.server ? 'server' : 'other' }}" data-cf-secret-kind>
    {% endif %}
    {% if kinds.server %}
        <div class="row g-2" data-cf-secret-pane="server">
            <div class="col-sm-4">
                <label class="form-label" for="{{ prefix }}-type">{{ 'Access type'|trans }}</label>
                <select class="form-select" id="{{ prefix }}-type" data-cf-secret="type">
                    <option value="ssh">{{ 'SSH / SFTP'|trans }}</option>
                    <option value="panel">{{ 'Control panel'|trans }}</option>
                    <option value="other">{{ 'Other'|trans }}</option>
                </select>
            </div>
            <div class="col-sm-5">
                <label class="form-label" for="{{ prefix }}-host">{{ 'Host or IP address'|trans }}</label>
                <input class="form-control" type="text" id="{{ prefix }}-host" maxlength="255" dir="ltr" autocomplete="off" data-cf-secret="host">
            </div>
            <div class="col-sm-3">
                <label class="form-label" for="{{ prefix }}-port">{{ 'Port'|trans }}</label>
                <input class="form-control" type="number" min="1" max="65535" id="{{ prefix }}-port" dir="ltr" data-cf-secret="port">
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="{{ prefix }}-username">{{ 'Username'|trans }}</label>
                <input class="form-control" type="text" id="{{ prefix }}-username" maxlength="255" dir="ltr" autocomplete="off" data-cf-secret="username">
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="{{ prefix }}-password">{{ 'Password'|trans }}</label>
                <input class="form-control" type="password" id="{{ prefix }}-password" maxlength="1000" dir="ltr" autocomplete="new-password" data-cf-secret="password">
            </div>
            <div class="col-12">
                <label class="form-label" for="{{ prefix }}-ssh-key">{{ 'SSH private key (instead of a password)'|trans }}</label>
                <textarea class="form-control font-monospace" id="{{ prefix }}-ssh-key" rows="3" maxlength="20000" dir="ltr" autocomplete="off" spellcheck="false" data-cf-secret="ssh_key"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label" for="{{ prefix }}-note">{{ 'Note for our team (optional)'|trans }}</label>
                <input class="form-control" type="text" id="{{ prefix }}-note" maxlength="2000" dir="auto" data-cf-secret="note">
            </div>
        </div>
    {% endif %}
    {% if kinds.other %}
        <div class="row g-2"{% if kinds.server %} hidden{% endif %} data-cf-secret-pane="other">
            <div class="col-12">
                <label class="form-label" for="{{ prefix }}-label">{{ 'What is it?'|trans }}</label>
                <input class="form-control" type="text" id="{{ prefix }}-label" maxlength="100" dir="auto" placeholder="{{ 'For example: WordPress admin login'|trans }}" data-cf-secret="label">
            </div>
            <div class="col-12">
                <label class="form-label" for="{{ prefix }}-value">{{ 'Secret'|trans }}</label>
                <textarea class="form-control font-monospace" id="{{ prefix }}-value" rows="3" maxlength="5000" dir="ltr" autocomplete="off" spellcheck="false" data-cf-secret="value"></textarea>
            </div>
        </div>
    {% endif %}
</div>
