{# ClientFence (CF-239): the registrant details a domain registration or transfer needs (Cart\Service::REGISTRANT_FIELDS),
   asked at checkout as WHMCS does. `fields`: the ones to ask; `country`: the phone's first country; `hidden`: shown by
   checkout.js once the order registers or transfers a domain. checkout.js sends them with the sign-up or saves them to
   the profile before the order, cart.js saves them to the profile. #}
{# The box with `hidden` carries no display class: Bootstrap's .d-flex (!important) would show it. #}
<div data-cf-registrant{% if hidden|default(false) %} hidden{% endif %}><div class="d-flex flex-column gap-2 mt-3">
    <span class="bf-hint">{{ 'The domain is registered in your name, so the registry needs your address and phone number.'|trans }}</span>
    <div class="bf-grid-2">
        {% for name, field in {
            address_1: ['Address Line 1', 'address-line1', true], city: ['City', 'address-level2', true],
            state: ['State', 'address-level1', false], postcode: ['Zip/Postal Code', 'postal-code', true]
        } %}
            {% if name in fields %}
                <label class="bf-label bf-stack">{{ field[0]|trans }}<input class="form-control" name="{{ name }}" autocomplete="{{ field[1] }}" maxlength="100"{% if field[2] %} required{% endif %}></label>
            {% endif %}
        {% endfor %}
        {% if 'country' in fields %}
            <label class="bf-label bf-stack">{{ 'Country'|trans }}<select class="form-select" name="country" autocomplete="country" required>
                <option value="">{{ '-- Select Country --'|trans }}</option>
                {% for val, title in guest.system_countries %}
                    <option value="{{ val }}"{% if guest.system_default_country == val %} selected{% endif %}>{{ title|e }}</option>
                {% endfor %}
            </select></label>
        {% endif %}
        {% if 'phone' in fields %}
            {# The phone widget (phone-input.js) keeps the dial code in phone_cc, as on the sign-up and profile pages. #}
            <div class="bf-stack">
                <label class="bf-label" for="cf-registrant-phone">{{ 'Phone Number'|trans }}</label>
                <input type="hidden" name="phone_cc" value="">
                <input class="form-control js-phone-input" id="cf-registrant-phone" type="tel" name="phone" autocomplete="tel" maxlength="100" data-initial-country="{{ country|default('')|lower }}" required>
            </div>
        {% endif %}
    </div>
</div></div>
