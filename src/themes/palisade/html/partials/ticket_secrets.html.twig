{# ClientFence: the ticket's secrets on the client ticket page (Support/TicketSecrets.php): what
   was added (never the values), who opened or deleted what, and a form to add one while the
   ticket is open. Shown when a kind is on or the ticket has secrets or a history. #}
{% set kinds = client.support_ticket_secret_kinds %}
{% set secrets = client.support_ticket_secret_list({ 'ticket_id': ticket.id }) %}
{% set can_add = ticket.status != 'closed' and (kinds.server or kinds.other) %}
{% if can_add or secrets.secrets is not empty or secrets.events is not empty %}
    <div class="card mt-3" id="secrets">
        <div class="card-body">
            <h2 class="h6 mb-1">{{ 'Server access and secrets'|trans }}</h2>
            <p class="text-secondary small mb-3">{{ 'Encrypted at once, opened only by authorized support staff (each opening is listed here), and deleted when the ticket is closed or after :days days.'|trans({ ':days': kinds.days }) }}</p>
            {% if secrets.secrets is not empty %}
                <ul class="list-group mb-3">
                    {% for secret in secrets.secrets %}
                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>
                                <span class="fw-medium" dir="auto">{{ secret.label }}</span>
                                <span class="text-secondary small d-block">{{ secret.kind == 'server' ? 'Server access'|trans : 'Other secret'|trans }} · {{ secret.created_at|format_datetime }}</span>
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-cf-secret-delete="{{ secret.id }}">{{ 'Delete'|trans }}</button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if secrets.events is not empty %}
                <h3 class="h6 small text-secondary mb-2">{{ 'History'|trans }}</h3>
                <ul class="list-unstyled small mb-3">
                    {% for event in secrets.events %}
                        <li>
                            {{ event.created_at|format_datetime }} ·
                            {% if event.action == 'opened' %}
                                {{ ':label opened by :name'|trans({ ':label': event.label, ':name': event.staff_name|default('Support'|trans) }) }}
                            {% elseif event.action == 'deleted' %}
                                {{ ':label deleted'|trans({ ':label': event.label }) }}
                            {% else %}
                                {{ ':label deleted after the time limit'|trans({ ':label': event.label }) }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if can_add %}
                <details{% if secrets.secrets is empty %} open{% endif %}>
                    <summary class="fw-medium mb-2">{{ 'Add server access or a secret'|trans }}</summary>
                    <form id="ticket-secret-add" data-ticket-id="{{ ticket.id }}">
                        {{ include('partials/ticket_secret_fields.html.twig', { prefix: 'ticket-secret' }) }}
                        <p class="small text-secondary mt-2 mb-2">{{ 'Never put passwords in the message itself.'|trans }}</p>
                        <button type="submit" class="btn btn-primary btn-sm">{{ 'Add securely'|trans }}</button>
                    </form>
                </details>
            {% endif %}
        </div>
    </div>
    {{ include('partials/ticket_secrets_script.html.twig') }}
    <script nonce="{{ csp_nonce }}">
        document.addEventListener('DOMContentLoaded', () => {
            const reloadAt = () => { window.location.hash = 'secrets'; window.location.reload(); };
            document.getElementById('ticket-secret-add')?.addEventListener('submit', (event) => {
                event.preventDefault();
                const form = event.currentTarget;
                const data = ClientFenceSecrets.collect(form);
                if (!data) return;
                data.ticket_id = form.dataset.ticketId;
                ClientFence.api.client.post('support/ticket_secret_add', data, () => { ClientFenceSecrets.clear(form); reloadAt(); }, (res) => ClientFence.message(res.message, 'error'));
            });
            document.querySelectorAll('[data-cf-secret-delete]').forEach((button) => button.addEventListener('click', () => {
                ClientFence.api.client.post('support/ticket_secret_delete', { id: button.dataset.cfSecretDelete }, reloadAt, (res) => ClientFence.message(res.message, 'error'));
            }));
        });
    </script>
{% endif %}
