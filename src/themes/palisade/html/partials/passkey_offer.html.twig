{# ClientFence: "Sign in faster next time", once after a sign-in without a passkey (Client/Passkeys.php offer()).
   passkeys.js shows it only where the device unlocks passkeys itself; "Not now" keeps it away from this
   browser for a year (the cookie named in Passkeys::NOT_NOW). No password asked: the sign-in was just now. #}
<div class="card mb-4" data-clientfence-passkey="offer" data-role="client" data-options="client/passkey_options" data-add="client/passkey_add" data-cookie="clientfence_passkey_later"
     data-saved="{{ 'Passkey saved. Next time, sign in with it.'|trans }}" data-already="{{ 'This device already has a passkey for your sign-in.'|trans }}" hidden>
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1">
            <h2 class="h5 mb-1">{{ 'Sign in faster next time'|trans }}</h2>
            <p class="mb-0 text-body-secondary">{{ 'Create a passkey: your fingerprint, face or device PIN then signs you in, without your password and code.'|trans }}</p>
        </div>
        <button type="button" class="btn btn-outline-secondary" data-clientfence-passkey-later>{{ 'Not now'|trans }}</button>
        <button type="button" class="btn btn-primary" data-clientfence-passkey-create>{{ 'Create a passkey'|trans }}</button>
    </div>
</div>
