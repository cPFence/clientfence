msgid "Decide when the store opens."
msgstr "Odlučite kada se prodavnica otvara."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "Email PIN for staff"
msgstr "PIN kod e-poštom za osoblje"

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "Keep bots out and make a stolen staff password useless on its own."
msgstr "Držite botove podalje i učinite ukradenu lozinku osoblja beskorisnom samu po sebi."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "More can be set in System → Settings → System → Sign-in security. Locked out? On the server run: php console.php clientfence:signin-security-off"
msgstr "Više opcija je u Sistem → Podešavanja → Sistem → Bezbednost prijave. Zaključani ste? Na serveru pokrenite: php console.php clientfence:signin-security-off"

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "Other countries, and addresses whose country is not known, are refused. Addresses on the Allowed IPs list in Staff settings always pass."
msgstr "Druge zemlje i adrese čija zemlja nije poznata se odbijaju. Adrese sa liste dozvoljenih IP adresa u podešavanjima osoblja uvek prolaze."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "Security checks"
msgstr "Bezbednosne provere"

