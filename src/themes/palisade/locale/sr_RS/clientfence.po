msgid "Sign-in rules, proxies, access lists and sessions."
msgstr "Pravila prijave, proksiji, liste pristupa i sesije."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "Staff password reset"
msgstr "Resetovanje lozinke osoblja"

#: src/modules/Staff/templates/admin/mod_staff_settings.html.twig
msgid "Staff sign-in rules (email PIN, IP addresses, countries) and staff password reset are in Security > Settings."
msgstr "Pravila prijave osoblja (PIN imejlom, IP adrese, zemlje) i resetovanje lozinke osoblja su u Bezbednost > Podešavanja."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "The \"Forgot your password?\" link of the staff login emails a reset link. Turn it off when staff passwords are only reset by a Super Administrator."
msgstr "Veza „Zaboravili ste lozinku?“ na prijavi osoblja šalje imejlom vezu za resetovanje. Isključite je ako lozinke osoblja resetuje samo super administrator."

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "This request comes from %remote%. The address used for the visitor: %client%."
msgstr "Ovaj zahtev stiže sa %remote%. Adresa koja se koristi za posetioca: %client%."

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "Trust these proxies"
msgstr "Veruj ovim proksijima"

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "Trusted proxies"
msgstr "Pouzdani proksiji"

#: src/modules/Clientfence/SecuritySettings.php
msgid "Unknown settings section."
msgstr "Nepoznat odeljak podešavanja."

#: src/modules/Clientfence/Health.php
msgid "Visitor addresses"
msgstr "Adrese posetilaca"

#: src/modules/Clientfence/Health.php
msgid "Visitors connect directly: no proxy in front of the portal."
msgstr "Posetioci se povezuju direktno: nema proksija ispred portala."

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "When visitors reach the portal through a proxy such as Cloudflare, every request comes from the proxy. Trust its addresses so the visitor address is read from the header it sends: sign-in rules, rate limits and logs then see the real visitor. Trust only addresses that are really your proxy, never a whole network."
msgstr "Kada posetioci stižu do portala preko proksija kao što je Cloudflare, svaki zahtev dolazi sa proksija. Verujte njegovim adresama da se adresa posetioca čita iz zaglavlja koje šalje: pravila prijave, ograničenja učestalosti i evidencije tada vide pravog posetioca. Verujte samo adresama koje zaista pripadaju vašem proksiju, nikada celoj mreži."

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "X-Forwarded-For (Cloudflare and most proxies)"
msgstr "X-Forwarded-For (Cloudflare i većina proksija)"

#: src/modules/Security/templates/admin/mod_security_settings.html.twig
msgid "X-Forwarded-For, Host and Prefix (only if your proxy sets all of them)"
msgstr "X-Forwarded-For, Host i Prefix (samo ako vaš proksi postavlja sva tri)"

# To translate (tools/locales.py starter).
#: src/modules/Clientfence/Health.php
msgid "The web server already reads the visitor address from the proxy: :ip."
msgstr "Veb server već čita adresu posetioca sa proksija: :ip."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "After your password, enter a code from an authenticator app such as Google Authenticator, Microsoft Authenticator or 1Password. The email PIN is always offered instead when you sign in."
msgstr "Posle lozinke unesite kod iz aplikacije za autentifikaciju, kao što su Google Authenticator, Microsoft Authenticator ili 1Password. PIN putem e-pošte se pri prijavi uvek nudi kao alternativa."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Code from the app"
msgstr "Kod iz aplikacije"

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Code from the app or the backup code"
msgstr "Kod iz aplikacije ili rezervni kod"

#: src/modules/Staff/templates/admin/mod_staff_login_code.html.twig
msgid "Email me a PIN instead"
msgstr "Pošalji mi PIN e-poštom"

#: src/modules/Staff/templates/admin/mod_staff_login_code.html.twig
msgid "Enter the 6-digit code from your authenticator app, or your backup code."
msgstr "Unesite 6-cifreni kod iz aplikacije za autentifikaciju ili rezervni kod."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Keep it somewhere safe: it signs you in once if you lose your phone. It is shown only now."
msgstr "Čuvajte ga na sigurnom mestu: jednom vas prijavljuje ako izgubite telefon. Prikazuje se samo sada."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "New backup code"
msgstr "Novi rezervni kod"

#: src/modules/Staff/Api/Admin.php
msgid "Only Super Administrators can switch off two-factor sign-in."
msgstr "Samo super administratori mogu da isključe dvofaktorsku prijavu."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Scan this QR code with your authenticator app, or type in the key."
msgstr "Skenirajte ovaj QR kod aplikacijom za autentifikaciju ili ukucajte ključ."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Since %date%."
msgstr "Od %date%."

#: src/modules/Staff/templates/admin/mod_staff_manage.html.twig
msgid "This staff member signs in with an authenticator app. Turn it off if they lost the phone and the backup code."
msgstr "Ovaj član osoblja se prijavljuje aplikacijom za autentifikaciju. Isključite je ako je izgubio telefon i rezervni kod."

#: src/modules/Staff/templates/admin/mod_staff_manage.html.twig
msgid "Turn off two-factor sign-in"
msgstr "Isključi dvofaktorsku prijavu"

#: src/modules/Staff/templates/admin/mod_staff_manage.html.twig
msgid "Turn off two-factor sign-in?"
msgstr "Isključiti dvofaktorsku prijavu?"

#: src/modules/Staff/templates/admin/mod_staff_manage.html.twig src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Two-factor sign-in is off."
msgstr "Dvofaktorska prijava je isključena."

#: src/modules/Staff/templates/admin/mod_staff_login_pin.html.twig
msgid "Use the authenticator app instead"
msgstr "Koristi aplikaciju za autentifikaciju"

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "Your backup code was used: make a new one."
msgstr "Vaš rezervni kod je iskorišćen: napravite novi."

# To translate (tools/locales.py starter).
#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "After the right password, a 6-digit PIN goes to the email of the login, and signing in needs it. It works once, for 10 minutes. Clients who sign in with an authenticator app or with Google are not asked. Staff who set up an authenticator app on their Profile page can enter its code instead. \"Trust this browser for 30 days\" skips the PIN on a known browser until the password changes."
msgstr "Posle tačne lozinke, 6-cifreni PIN kod stiže na e-adresu naloga i za prijavu je obavezan. Važi jednom, 10 minuta. Klijenti koji se prijavljuju pomoću aplikacije za autentifikaciju ili preko Google-a ne dobijaju upit. Osoblje koje je podesilo aplikaciju za autentifikaciju na svojoj stranici Profil može umesto toga da unese njen kod. „Veruj ovom pregledaču 30 dana“ preskače PIN kod u poznatom pregledaču do promene lozinke."
