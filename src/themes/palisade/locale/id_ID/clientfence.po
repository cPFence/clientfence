msgstr "ClientFence berhasil menerapkan patch untuk versi %version%."

#: src/modules/System/templates/admin/mod_system_update_finalize.html.twig
msgid "ClientFence is applying update patches. Keep this tab open until the request completes."
msgstr "ClientFence sedang menerapkan patch pembaruan. Biarkan tab ini terbuka sampai permintaan selesai."

#: src/modules/Seo/templates/admin/mod_seo_settings.html.twig
msgid "ClientFence pings every enabled search engine automatically every 24 hours. Cron jobs must be working for this to run."
msgstr "ClientFence mem-ping setiap mesin pencari yang diaktifkan secara otomatis setiap 24 jam. Cron job harus berfungsi agar ini berjalan."

#: src/modules/Serviceapikey/templates/admin/mod_serviceapikey_config.html.twig
msgid "ClientFence removes the \"custom_\" prefix when returning these values through the API. For example, \"custom_monthlyLimit\" becomes \"monthlyLimit\"."
msgstr "ClientFence menghapus awalan \"custom_\" saat mengembalikan nilai ini melalui API. Misalnya, \"custom_monthlyLimit\" menjadi \"monthlyLimit\"."

