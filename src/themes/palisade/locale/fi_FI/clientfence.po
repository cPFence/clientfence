msgstr "ClientFence lataa julkaisun ja tarkistaa sen, ja tallentaa sitten varmuuskopion tietokannasta ja jokaisesta julkaisun korvaamasta tiedostosta palvelimen varmuuskopiokansioon. Se asentaa julkaisun huoltotilan ollessa päällä, päivittää tietokannan ja kirjaa sinut ulos hallinta-alueelta. Uudelleenkirjautumisen jälkeen sinua pyydetään viimeistelemään päivitys."

#: src/modules/Extension/templates/admin/mod_extension_index.html.twig
msgid "ClientFence gives developers all the capabilities to customize, integrate, and extend the core system into your own website and applications."
msgstr "ClientFence antaa kehittäjille kaikki mahdollisuudet mukauttaa, integroida ja laajentaa ydinjärjestelmää omalle sivustolleen ja sovelluksiinsa."

#: src/modules/System/Service.php
msgid "ClientFence has detected that cron hasn't been run in an abnormal time period. Please ensure the cronjob is configured to be run every 5 minutes."
msgstr "ClientFence on havainnut, ettei cronia ole ajettu epätavallisen pitkään aikaan. Varmista, että cron-työ on määritetty suoritettavaksi 5 minuutin välein."

#: src/modules/System/templates/admin/mod_system_update_finalize.html.twig
msgid "ClientFence has successfully applied the patches for version %version%."
msgstr "ClientFence otti onnistuneesti käyttöön version %version% korjaukset."

#: src/modules/System/templates/admin/mod_system_update_finalize.html.twig
msgid "ClientFence is applying update patches. Keep this tab open until the request completes."
msgstr "ClientFence ottaa käyttöön päivityskorjauksia. Pidä tämä välilehti auki, kunnes pyyntö valmistuu."

#: src/modules/Currency/templates/admin/mod_currency_settings.html.twig
msgid "ClientFence is configured to automatically sync currency exchange rates."
msgstr "ClientFence on määritetty synkronoimaan valuuttakurssit automaattisesti."

#: src/modules/Currency/templates/admin/mod_currency_settings.html.twig
msgid "ClientFence is not configured to automatically sync currency exchange rates."
msgstr "ClientFencea ei ole määritetty synkronoimaan valuuttakursseja automaattisesti."

#: src/modules/Seo/templates/admin/mod_seo_settings.html.twig
msgid "ClientFence pings every enabled search engine automatically every 24 hours. Cron jobs must be working for this to run."
msgstr "ClientFence pingaa automaattisesti kaikkia käytössä olevia hakukoneita 24 tunnin välein. Cron-töiden on toimittava, jotta tämä toimii."

#: src/modules/Serviceapikey/templates/admin/mod_serviceapikey_config.html.twig
msgid "ClientFence removes the \"custom_\" prefix when returning these values through the API. For example, \"custom_monthlyLimit\" becomes \"monthlyLimit\"."
msgstr "ClientFence poistaa \"custom_\"-etuliitteen palauttaessaan nämä arvot API:n kautta. Esimerkiksi \"custom_monthlyLimit\" muuttuu muotoon \"monthlyLimit\"."

#: src/modules/System/Service.php
msgid "ClientFence requires :extension extension to be enabled on this server for security reasons."
msgstr "ClientFence vaatii tietoturvasyistä, että laajennus :extension on käytössä tällä palvelimella."

#: src/modules/Email/templates/admin/mod_email_settings.html.twig
msgid "ClientFence sends email using Sendmail by default, or you can configure SMTP, SendGrid, or a custom Symfony mailer DSN."
msgstr "ClientFence lähettää sähköpostin oletuksena Sendmaililla, tai voit määrittää SMTP:n, SendGridin tai mukautetun Symfony mailer DSN:n."

#: src/modules/Extension/templates/admin/mod_extension_languages.html.twig
msgid "ClientFence ships with its translations. To add another language, place its translation files on the server."
msgstr "ClientFence toimitetaan käännöksineen. Lisätäksesi toisen kielen, aseta sen käännöstiedostot palvelimelle."

#: src/modules/Currency/templates/admin/mod_currency_settings.html.twig
msgid "ClientFence supports several exchange-rate providers. By default it uses the ExchangeRate-API Open Access endpoint, which works without extra configuration."
msgstr "ClientFence tukee useita valuuttakurssien tarjoajia. Oletuksena se käyttää ExchangeRate-API Open Access -päätepistettä, joka toimii ilman lisämäärityksiä."

