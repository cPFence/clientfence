msgstr "Πριν από την επόμενη ημερομηνία οφειλής %date%"

#: src/modules/Servicedomain/templates/admin/mod_servicedomain_index.html.twig
msgid "Both are off until you turn them on. They need the cron job."
msgstr "Και τα δύο είναι ανενεργά μέχρι να τα ενεργοποιήσετε. Χρειάζονται την εργασία cron."

#: src/modules/Clientfence/Notifications.php
msgid "Domain :domain expires at the registrar on :date, before its next due date :due"
msgstr "Το όνομα χώρου :domain λήγει στον καταχωρητή στις :date, πριν από την επόμενη ημερομηνία οφειλής του :due"

#: src/modules/Order/templates/admin/mod_order_failed_actions.html.twig
msgid "Domain transfer"
msgstr "Μεταφορά ονόματος χώρου"

#: src/modules/Clientfence/Notifications.php
