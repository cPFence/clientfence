msgid "Upmind named no currency for its brand."
msgstr "Το Upmind δεν όρισε νόμισμα για το brand του."

#: src/modules/Clientfence/Upmind/Api.php
msgid "Upmind refused the API token (:status). Check the token, its permissions and its IP whitelist in Upmind under Settings > API Tokens."
msgstr "Το Upmind απέρριψε το διακριτικό API (:status). Ελέγξτε το διακριτικό, τα δικαιώματά του και τη λευκή λίστα IP του στο Upmind, στο Settings > API Tokens."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Upmind was read on :date. Make the plan below."
msgstr "Το Upmind διαβάστηκε στις :date. Δημιουργήστε το παρακάτω πλάνο."

