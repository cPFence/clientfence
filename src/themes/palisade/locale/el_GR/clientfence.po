#: src/modules/System/templates/admin/mod_system_settings.html.twig
msgid "Maintenance"
msgstr "Συντήρηση"

#: src/modules/System/templates/admin/mod_system_maintenance_panel.html.twig
msgid "Maintenance mode"
msgstr "Λειτουργία συντήρησης"

