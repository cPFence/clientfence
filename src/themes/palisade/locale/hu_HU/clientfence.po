msgstr "A munkatársak bejelentkezési szabályai (e-mailes PIN, IP-címek, országok) a Rendszer > Beállítások > Bejelentkezési biztonság alatt találhatók."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "Staff sign-ins from any other address are refused. Use it only with fixed addresses, such as an office or a VPN."
msgstr "A más címről érkező munkatársi bejelentkezéseket elutasítjuk. Csak rögzített címekkel használja, például irodával vagy VPN-nel."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "Staff sign-ins from any other country, or from an address whose country is not known, are refused. Addresses on the IP address list above always pass: add a fixed office or server address there as a way back in."
msgstr "A más országból vagy ismeretlen országú címről érkező munkatársi bejelentkezéseket elutasítjuk. A fenti IP-címlistán szereplő címek mindig átjutnak: adjon hozzá oda egy rögzített iroda- vagy szervercímet visszaútként."

#: src/modules/Clientfence/SignInSecurity.php
msgid "The country of your address (:ip) is not known, so this would lock you out. Add your address to the staff IP address list first."
msgstr "A címe (:ip) országa ismeretlen, ezért ez kizárná Önt. Először adja hozzá a címét a munkatársak IP-címlistájához."

#: src/modules/Clientfence/SignInSecurity.php
msgid "You are signing in from :country (:ip), which is not on the list: this would lock you out. Add :country or put your address on the staff IP address list."
msgstr "Bejelentkezés innen: :country (:ip), ami nincs a listán: ez kizárná Önt. Adja hozzá ezt: :country, vagy tegye a címét a munkatársak IP-címlistájára."

#: src/modules/Clientfence/SignInSecurity.php
msgid "You are signing in from :ip, which is not on the list: this would lock you out. Add :ip to the list."
msgstr "Bejelentkezés erről a címről: :ip, ami nincs a listán: ez kizárná Önt. Adja hozzá a listához ezt: :ip."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "Your address now: %ip%. Save refuses a list without it."
msgstr "Az Ön jelenlegi címe: %ip%. A mentés elutasít egy olyan listát, amely nem tartalmazza."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "on the IP address list"
msgstr "az IP-címlistán"

