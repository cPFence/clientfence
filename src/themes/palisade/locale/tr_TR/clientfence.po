msgstr "Web sitesi dosyaları ve veritabanları bu yedekle değiştirilir. O tarihten sonra yapılan değişiklikler kaybolur."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The website was not found on this hosting account."
msgstr "Web sitesi bu barındırma hesabında bulunamadı."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "This hosting account has no stored panel subscription. Run Sync on the service first."
msgstr "Bu barındırma hesabında kayıtlı bir panel aboneliği yok. Önce hizmet üzerinde “Sunucuyla Eşitle” işlemini çalıştırın."

#: src/modules/Servicehosting/Api/Client.php
msgid "This hosting account is suspended, so backups cannot be restored."
msgstr "Bu barındırma hesabı askıya alındığı için yedekler geri yüklenemez."

#: src/modules/Servicehosting/Panel/StatusCheck.php
msgid "This hosting order cannot be checked."
msgstr "Bu barındırma siparişi kontrol edilemez."

#: src/modules/Servicehosting/Service.php
msgid "This hosting plan cannot be ordered right now. Please contact us."
msgstr "Bu barındırma planı şu anda sipariş edilemez. Lütfen bizimle iletişime geçin."

