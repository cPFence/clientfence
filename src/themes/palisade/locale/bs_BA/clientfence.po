msgid "ClientFence version"
msgstr "Verzija ClientFence"

#: src/modules/Servicelicense/templates/admin/mod_servicelicense_config.html.twig
msgid "ClientFence will automatically detect your new plugin."
msgstr "ClientFence će automatski prepoznati vaš novi dodatak."

#: src/modules/Clientfence/manifest.json
msgid "ClientFence: admin area style, support dashboard for staff without statistics, help desk greetings, WHMCS-style suspension and termination, domain renewal reminders for staff, store gate (closed, custom group or public), store title, store preview link, payment method cards and system health."
msgstr "ClientFence: stil administratorske zone, kontrolna tabla podrške za osoblje bez statistike, pozdravi službe podrške, suspenzija i ukidanje u stilu WHMCS-a, podsjetnici osoblju za obnovu domena, pristup prodavnici (zatvorena, prilagođena grupa ili javna), naziv prodavnice, link za pregled prodavnice, kartice načina plaćanja i stanje sistema."

#: src/modules/Clientfence/Service.php
msgid "ClientFence: schema.json is damaged; install the pack again."
msgstr "ClientFence: schema.json je oštećen; ponovo instalirajte paket."

