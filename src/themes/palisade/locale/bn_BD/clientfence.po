#: src/modules/Clientfence/Whmcs/Preflight.php
msgid "In a copy of the :system database, change each text column of the affected tables to a binary type (VARBINARY or BLOB) and then to utf8mb4 text, which keeps the bytes and reads them as UTF-8 (a plain CONVERT TO CHARACTER SET keeps the text garbled); then import from the copy."
msgstr ":system ডেটাবেসের একটি কপিতে প্রভাবিত টেবিলগুলোর প্রতিটি টেক্সট কলাম বাইনারি ধরনে (VARBINARY বা BLOB) বদলান, তারপর utf8mb4 টেক্সটে বদলান। এতে বাইটগুলো অক্ষত থাকে এবং UTF-8 হিসেবে পড়া হয়। শুধু CONVERT TO CHARACTER SET চালালে টেক্সট বিকৃতই থেকে যায়। তারপর কপি থেকে ইমপোর্ট করুন।"

#: src/modules/Clientfence/Whmcs/Preflight.php
msgid "In a copy of the :system database, repair only the affected rows, for each column: UPDATE tblclients SET col = CONVERT(CAST(CONVERT(col USING latin1) AS BINARY) USING utf8mb4) WHERE LOCATE(X'C383C2', CAST(col AS BINARY)) > 0 OR LOCATE(X'C382C2', CAST(col AS BINARY)) > 0; then import from the copy."
msgstr ":system ডেটাবেসের একটি কপিতে প্রতিটি কলামের শুধু প্রভাবিত সারিগুলো ঠিক করুন: UPDATE tblclients SET col = CONVERT(CAST(CONVERT(col USING latin1) AS BINARY) USING utf8mb4) WHERE LOCATE(X'C383C2', CAST(col AS BINARY)) > 0 OR LOCATE(X'C382C2', CAST(col AS BINARY)) > 0; তারপর কপি থেকে ইমপোর্ট করুন।"

