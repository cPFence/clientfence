msgstr "ধন্যবাদ। চালিয়ে যেতে আপনার ইমেইল ও পাসওয়ার্ড দিয়ে সাইন ইন করুন। এই ইমেইলের যদি আগে থেকেই অ্যাকাউন্ট থাকে, তাহলে সেই অ্যাকাউন্টের পাসওয়ার্ড ব্যবহার করুন, অথবা তা রিসেট করুন।"

#: src/modules/Client/templates/email/mod_client_id_document_approved.html.twig
msgid "Thank you: we have checked your ID document and approved it. An order that waited only for it now goes on, and you get its usual emails."
msgstr "ধন্যবাদ: আমরা আপনার পরিচয়পত্র যাচাই করে অনুমোদন করেছি। যে অর্ডার শুধু এর জন্য অপেক্ষা করছিল তা এখন এগিয়ে যাবে, এবং আপনি এর স্বাভাবিক ইমেইলগুলো পাবেন।"

#: src/library/Registrar/Adapter/Centralnicreseller.php src/library/Registrar/Adapter/Connectreseller.php src/library/Registrar/Adapter/Dynadot.php …
msgid "The \":domain_registrar\" domain registrar is not fully configured. Please configure the :missing"
msgstr "\":domain_registrar\" ডোমেইন রেজিস্ট্রার পুরোপুরি কনফিগার করা হয়নি। অনুগ্রহ করে কনফিগার করুন: :missing"

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \":driver\" cache driver requires an installation identifier (\"info.instance_id\" in the configuration file) so that installations sharing the same server don't collide. Reinstall or update ClientFence to have one generated automatically, or set it manually."
msgstr "\":driver\" ক্যাশ ড্রাইভারের একটি ইনস্টলেশন আইডেন্টিফায়ার প্রয়োজন (কনফিগারেশন ফাইলে \"info.instance_id\"), যাতে একই সার্ভারে থাকা ইনস্টলেশনগুলোর মধ্যে সংঘাত না হয়। এটি স্বয়ংক্রিয়ভাবে তৈরি করতে ClientFence আবার ইনস্টল বা হালনাগাদ করুন, অথবা নিজে সেট করুন।"

#: src/library/Payment/Adapter/Eway.php src/library/Payment/Adapter/GoCardless.php src/library/Payment/Adapter/Mollie.php …
msgid "The \":pay_gateway\" payment gateway is not fully configured. Please configure the :missing"
msgstr "\":pay_gateway\" পেমেন্ট গেটওয়ে পুরোপুরি কনফিগার করা হয়নি। অনুগ্রহ করে কনফিগার করুন: :missing"

#: src/library/Server/Manager/CWP.php src/library/Server/Manager/Directadmin.php src/library/Server/Manager/Whm.php
msgid "The \":server_manager\" server manager is not fully configured. Please configure the :missing"
msgstr "\":server_manager\" সার্ভার ম্যানেজার পুরোপুরি কনফিগার করা হয়নি। অনুগ্রহ করে কনফিগার করুন: :missing"

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "The \"Forgot your password?\" link of the staff login emails a reset link. Turn it off when staff passwords are only reset by a Super Administrator."
msgstr "স্টাফ লগইনের \"পাসওয়ার্ড ভুলে গেছেন?\" লিংকটি একটি রিসেট লিংক ইমেইল করে। স্টাফের পাসওয়ার্ড যদি শুধু একজন সুপার অ্যাডমিনিস্ট্রেটর রিসেট করেন, তাহলে এটি বন্ধ করুন।"

#: src/modules/Email/Service.php
msgid "The \"from\" email address cannot be empty"
msgstr "\"from\" ইমেইল ঠিকানা খালি রাখা যাবে না"

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \"memcached\" cache driver requires the PHP memcached extension to be installed."
msgstr "\"memcached\" ক্যাশ ড্রাইভারের জন্য PHP memcached এক্সটেনশন ইনস্টল থাকা প্রয়োজন।"

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \"redis\" cache driver requires the PHP redis (or relay) extension to be installed."
msgstr "\"redis\" ক্যাশ ড্রাইভারের জন্য PHP redis (বা relay) এক্সটেনশন ইনস্টল থাকা প্রয়োজন।"

#: src/modules/Staff/templates/email/mod_staff_order_action_failed.html.twig
msgid "The %action% action of order %order% (client %client%) failed. Its hosting panel, registrar or other service refused it or could not finish it."
msgstr "অর্ডার %order%-এর (ক্লায়েন্ট %client%) %action% কাজটি ব্যর্থ হয়েছে। এর হোস্টিং প্যানেল, রেজিস্ট্রার বা অন্য সার্ভিস এটি প্রত্যাখ্যান করেছে বা শেষ করতে পারেনি।"

#: src/modules/Staff/templates/email/mod_staff_order_action_failed.html.twig
msgid "The %action% action of order %order% failed. Its hosting panel, registrar or other service refused it or could not finish it."
msgstr "অর্ডার %order%-এর %action% কাজটি ব্যর্থ হয়েছে। এর হোস্টিং প্যানেল, রেজিস্ট্রার বা অন্য সার্ভিস এটি প্রত্যাখ্যান করেছে বা শেষ করতে পারেনি।"

#: src/modules/Support/TicketSecrets.php
msgid "The :field field contains control characters."
msgstr ":field ফিল্ডে কন্ট্রোল ক্যারেক্টার আছে।"

#: src/modules/Support/TicketSecrets.php
msgid "The :field field must be at most :max characters."
msgstr ":field ফিল্ড সর্বোচ্চ :max অক্ষরের হতে পারে।"

#: src/modules/Support/TicketSecrets.php
msgid "The :field field must be text."
msgstr ":field ফিল্ড অবশ্যই টেক্সট হতে হবে।"

#: src/modules/Client/Contacts.php
msgid "The :field is too long (:max characters at most)."
msgstr ":field খুব দীর্ঘ (সর্বোচ্চ :max অক্ষর)।"

#: src/modules/Clientfence/Whmcs/Snapshot.php
msgid "The :name import needs PHP's pdo_sqlite extension. Turn it on for this site's PHP version, then try again."
msgstr ":name ইমপোর্টের জন্য PHP-এর pdo_sqlite এক্সটেনশন প্রয়োজন। এই সাইটের PHP সংস্করণের জন্য এটি চালু করুন, তারপর আবার চেষ্টা করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: login for :email: could not be created."
msgstr ":email: এর জন্য :panel: লগইন তৈরি করা যায়নি।"

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: organization :org: has no subscription :id:. Check both IDs in the panel."
msgstr ":panel: প্রতিষ্ঠান :org: এর কোনো সাবস্ক্রিপশন :id: নেই। প্যানেলে দুটো আইডিই যাচাই করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server already has a login for :email:, and the client has not confirmed this email address. Check that the client owns it, mark the email as confirmed on the client, then try again."
msgstr ":panel: সার্ভারে :email: এর জন্য আগে থেকেই একটি লগইন আছে, এবং ক্লায়েন্ট এই ইমেইল ঠিকানা নিশ্চিত করেননি। ক্লায়েন্ট যে এর মালিক তা যাচাই করুন, ক্লায়েন্টের পেজে ইমেইলটি নিশ্চিত হিসেবে চিহ্নিত করুন, তারপর আবার চেষ্টা করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server could not complete the request. Please try again later."
msgstr ":panel: সার্ভার অনুরোধটি সম্পন্ন করতে পারেনি। অনুগ্রহ করে পরে আবার চেষ্টা করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server did not confirm the step \":step:\". Please try again later."
msgstr ":panel: সার্ভার \":step:\" ধাপটি নিশ্চিত করেনি। অনুগ্রহ করে পরে আবার চেষ্টা করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Api.php src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server did not give a sign-in link. Please try again later."
msgstr ":panel: সার্ভার কোনো সাইন-ইন লিংক দেয়নি। অনুগ্রহ করে পরে আবার চেষ্টা করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server did not recognise the organization ID. Check the server settings."
msgstr ":panel: সার্ভার প্রতিষ্ঠানের আইডি চিনতে পারেনি। সার্ভার সেটিংস যাচাই করুন।"

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server refused the API token. Check the server settings (organization ID, token and its allowed IP addresses)."
msgstr ":panel: সার্ভার API টোকেন প্রত্যাখ্যান করেছে। সার্ভার সেটিংস যাচাই করুন (প্রতিষ্ঠানের আইডি, টোকেন ও এর অনুমোদিত IP ঠিকানা)।"

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server sent an answer that could not be read."
msgstr ":panel: সার্ভার এমন একটি উত্তর পাঠিয়েছে যা পড়া যায়নি।"

#: src/modules/Invoice/Accounting/FreeAgent.php
msgid "The :program bank account is in :bank_currency and the payment in :currency: choose an account in :currency for it."
msgstr ":program ব্যাংক অ্যাকাউন্টটি :bank_currency-তে এবং পেমেন্টটি :currency-তে: এর জন্য :currency-তে একটি অ্যাকাউন্ট বেছে নিন।"

#: src/modules/Invoice/Accounting/FreeAgent.php
msgid "The :program total of :number is :total instead of :expected: check the tax rates in the accounting settings."
msgstr ":number-এর :program মোট :expected-এর বদলে :total: অ্যাকাউন্টিং সেটিংসে করের হার যাচাই করুন।"

#: src/modules/Invoice/Quotes.php
msgid "The :what can be at most :max characters."
msgstr ":what সর্বোচ্চ :max অক্ষরের হতে পারে।"

#: src/modules/Order/Proration.php
msgid "The :what is not valid."
msgstr ":what বৈধ নয়।"

#: src/library/Server/Manager/CWP.php
msgid "The CWP server returned HTTP status :status. Check server availability and API configuration."
msgstr "CWP সার্ভার HTTP স্ট্যাটাস :status ফেরত দিয়েছে। সার্ভারের প্রাপ্যতা ও API কনফিগারেশন যাচাই করুন।"

#: src/library/Server/Manager/CWP.php
msgid "The CWP server returned an invalid JSON response. Check the server address, port and API configuration."
msgstr "CWP সার্ভার একটি অবৈধ JSON উত্তর ফেরত দিয়েছে। সার্ভারের ঠিকানা, পোর্ট ও API কনফিগারেশন যাচাই করুন।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed answered HTTP :code."
msgstr "ClientFence রিলিজ ফিড HTTP :code উত্তর দিয়েছে।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed could not be reached: :error"
msgstr "ClientFence রিলিজ ফিডে পৌঁছানো যায়নি: :error"

#: src/library/ClientFence/Update.php
msgid "The ClientFence release feed did not provide a SHA-256 digest. Update canceled for security reasons."
msgstr "ClientFence রিলিজ ফিড কোনো SHA-256 ডাইজেস্ট দেয়নি। নিরাপত্তার কারণে হালনাগাদ বাতিল করা হয়েছে।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed has no valid SHA-256 for the archive."
msgstr "ClientFence রিলিজ ফিডে আর্কাইভের জন্য কোনো বৈধ SHA-256 নেই।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed has no valid version."
msgstr "ClientFence রিলিজ ফিডে কোনো বৈধ সংস্করণ নেই।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed is not valid JSON."
msgstr "ClientFence রিলিজ ফিড বৈধ JSON নয়।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed is too large."
msgstr "ClientFence রিলিজ ফিড খুব বড়।"

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed names an archive outside its own folder."
msgstr "ClientFence রিলিজ ফিড নিজের ফোল্ডারের বাইরের একটি আর্কাইভের নাম দিয়েছে।"

#: src/library/ClientFence/Update.php
msgid "The ClientFence release feed provided an invalid SHA-256 digest. Update canceled for security reasons."
msgstr "ClientFence রিলিজ ফিড একটি অবৈধ SHA-256 ডাইজেস্ট দিয়েছে। নিরাপত্তার কারণে হালনাগাদ বাতিল করা হয়েছে।"

