msgid "Clients in these groups"
msgstr "Клијенти у овим групама"

#: src/modules/Client/templates/admin/mod_client_settings_affiliates.html.twig
msgid "Clients may join by themselves"
msgstr "Клијенти могу сами да се придруже"

