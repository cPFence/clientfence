#: src/library/Registrar/Adapter/Subreg.php
msgid ":domain has a trademark claim and cannot be registered through :registrar."
msgstr "Doména :domain má uplatnený nárok z ochrannej známky a nedá sa zaregistrovať cez :registrar."

#: src/library/Registrar/Adapter/Subreg.php
msgid ":registrar returned an unreadable response."
msgstr "Registrátor :registrar vrátil nečitateľnú odpoveď."

#: src/library/Registrar/Adapter/Subreg.php
msgid "Registers and manages domains through your Subreg.CZ account over the Subreg API (needs the PHP soap extension). Test mode sends every call to the Subreg OT&E test system (demoreg.net) instead of the live registry. Privacy protection is not supported."
msgstr "Registruje a spravuje domény cez váš účet Subreg.CZ pomocou Subreg API (vyžaduje rozšírenie PHP soap). Testovací režim posiela každé volanie do testovacieho systému Subreg OT&E (demoreg.net) namiesto ostrého registra. Ochrana súkromia nie je podporovaná."

#: src/library/Registrar/Adapter/Subreg.php
msgid "Your Subreg login. For an account admin, enter admin#username and the admin's password; the admin needs API access."
msgstr "Vaše prihlasovacie meno do Subreg. Pre správcu účtu zadajte admin#username a heslo správcu; správca musí mať prístup k API."

# To translate (tools/locales.py starter).
#: src/library/Registrar/Adapter/Subreg.php
msgid ":domain is in another :registrar account and needs an internal transfer at :registrar."
msgstr "Doména :domain je v inom účte u :registrar a vyžaduje interný prevod u :registrar."
