#: src/modules/System/templates/admin/mod_system_update.html.twig
msgid "ClientFence does not have sufficient filesystem permissions to perform the update on this server. Please review the issues below and resolve them before attempting the update again."
msgstr "ClientFence nima zadostnih dovoljenj datotečnega sistema za izvedbo posodobitve na tem strežniku. Preglejte spodnje težave in jih odpravite, preden znova poskusite posodobitev."

#: src/library/ClientFence/Update.php
msgid "ClientFence does not have sufficient filesystem permissions to perform the update. Resolve the reported issues before trying again."
msgstr "ClientFence nima zadostnih dovoljenj datotečnega sistema za izvedbo posodobitve. Odpravite navedene težave, preden poskusite znova."

#: src/modules/System/templates/admin/mod_system_update.html.twig
msgid "ClientFence downloads the release and checks it, then saves a backup of the database and of every file the release replaces in the server backups folder. It installs the release with maintenance mode on, updates the database and logs you out of the admin area. The site reopens as soon as the update is complete. If the database update needs attention, you will be asked to finalize it after logging back in."
msgstr "ClientFence prenese izdajo in jo preveri, nato v mapo varnostnih kopij strežnika shrani varnostno kopijo baze podatkov in vseh datotek, ki jih izdaja zamenja. Izdajo namesti z vklopljenim načinom vzdrževanja, posodobi bazo podatkov in vas odjavi iz skrbniškega dela. Spletno mesto se znova odpre, takoj ko je posodobitev končana. Če posodobitev baze podatkov potrebuje pozornost, boste po ponovni prijavi pozvani, da jo dokončate."

#: src/modules/Extension/templates/admin/mod_extension_index.html.twig
msgid "ClientFence gives developers all the capabilities to customize, integrate, and extend the core system into your own website and applications."
msgstr "ClientFence razvijalcem daje vse možnosti za prilagajanje, integracijo in razširitev jedrnega sistema v vaše spletno mesto in aplikacije."

#: src/modules/System/Service.php
msgid "ClientFence has detected that cron hasn't been run in an abnormal time period. Please ensure the cronjob is configured to be run every 5 minutes."
msgstr "ClientFence je zaznal, da cron nenavadno dolgo ni bil zagnan. Poskrbite, da je opravilo cron nastavljeno za zagon vsakih 5 minut."

#: src/modules/System/templates/admin/mod_system_update_finalize.html.twig
