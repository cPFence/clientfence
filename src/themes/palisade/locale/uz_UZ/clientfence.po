msgstr "Upmind API tokenini rad etdi (:status). Upmind'da Settings > API Tokens bo'limida tokenni, uning ruxsatlarini va IP oq ro'yxatini tekshiring."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Upmind was read on :date. Make the plan below."
msgstr "Upmind :date da o'qildi. Quyidagi rejani tuzing."

