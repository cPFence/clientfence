msgid "Read Upmind first, until it finishes."
msgstr "Avval Upmind'ni tugaguncha o'qing."

#: src/modules/Clientfence/Upmind/Snapshot.php src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Read Upmind first."
msgstr "Avval Upmind'ni o'qing."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Read Upmind, then make the plan below. Keep this page open while it reads."
msgstr "Upmind'ni o'qing, so'ng quyidagi rejani tuzing. O'qish paytida bu sahifani ochiq qoldiring."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Reading Upmind stopped. Fix the cause, then go on reading."
msgstr "Upmind'ni o'qish to'xtadi. Sababini bartaraf eting, so'ng o'qishni davom ettiring."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Reading Upmind… keep this page open."
msgstr "Upmind o'qilmoqda… bu sahifani ochiq qoldiring."

#: src/modules/Clientfence/Whmcs/Import.php
msgid "Save the Upmind API token first."
msgstr "Avval Upmind API tokenini saqlang."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Services and domains"
msgstr "Xizmatlar va domenlar"

#: src/modules/Clientfence/Upmind/Snapshot.php
msgid "The Upmind import needs PHP's pdo_sqlite extension. Turn it on for this site's PHP version, then try again."
msgstr "Upmind importi uchun PHP'ning pdo_sqlite kengaytmasi kerak. Uni ushbu saytning PHP versiyasi uchun yoqing va qayta urinib ko'ring."

#: src/modules/Clientfence/Whmcs/Import.php
msgid "The import has started: Upmind can no longer be read again."
msgstr "Import boshlandi: Upmind'ni endi qayta o'qib bo'lmaydi."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Ticket attachments."
msgstr "Chipta biriktirmalari."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Two-factor sign-in, saved cards and other stored payment methods. Stripe cards can be found again with \"Find saved cards in Stripe\"."
msgstr "Ikki bosqichli kirish, saqlangan kartalar va boshqa saqlangan to'lov usullari. Stripe kartalarini \"Stripe'dan saqlangan kartalarni topish\" orqali qayta topish mumkin."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
