#: src/modules/Support/Mail/ImapClient.php
msgid "The mail server host or port is not valid."
msgstr "ಮೇಲ್ ಸರ್ವರ್ ಹೋಸ್ಟ್ ಅಥವಾ ಪೋರ್ಟ್ ಮಾನ್ಯವಾಗಿಲ್ಲ."

#: src/modules/Support/MailImport.php
msgid "The mail server port must be 1 to 65535."
