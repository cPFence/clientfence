msgstr "ಡೊಮೇನ್ ವರ್ಷಕ್ಕೆ :amount ದರದಲ್ಲಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."

#: src/themes/palisade/html/mod_order_product.html.twig
msgid "The domain renews at :amount every :years years."
msgstr "ಡೊಮೇನ್ ಪ್ರತಿ :years ವರ್ಷಗಳಿಗೊಮ್ಮೆ :amount ದರದಲ್ಲಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."

#: src/themes/palisade/html/mod_order_product.html.twig
msgid "The domain renews free while this plan is active."
msgstr "ಈ ಪ್ಲಾನ್ ಸಕ್ರಿಯವಾಗಿರುವವರೆಗೆ ಡೊಮೇನ್ ಉಚಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."

# To translate (tools/locales.py starter).
#: src/modules/Support/templates/admin/mod_support_helpdesk.html.twig src/modules/Support/templates/admin/modal/mod_support_new_helpdesk.html.twig
msgid "Enter 0 to never close tickets automatically."
msgstr "ಟಿಕೆಟ್‌ಗಳನ್ನು ಎಂದಿಗೂ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚದಿರಲು 0 ನಮೂದಿಸಿ."


