#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":domain was refused: :error"
msgstr ":domain ತಿರಸ್ಕರಿಸಲಾಗಿದೆ: :error"

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar accepted the lock, but :domain is still unlocked. The change has not been applied."
msgstr ":registrar ಲಾಕ್ ಅನ್ನು ಸ್ವೀಕರಿಸಿದೆ, ಆದರೆ :domain ಈಗಲೂ ಅನ್‌ಲಾಕ್ ಆಗಿದೆ. ಬದಲಾವಣೆಯನ್ನು ಅನ್ವಯಿಸಲಾಗಿಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar accepted the registration of :domain but does not hold it."
msgstr ":registrar :domain ನೋಂದಣಿಯನ್ನು ಸ್ವೀಕರಿಸಿದೆ, ಆದರೆ ಅದು ಅದರ ಬಳಿ ಇಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar accepted the unlock, but :domain is still locked. The change has not been applied."
msgstr ":registrar ಅನ್‌ಲಾಕ್ ಅನ್ನು ಸ್ವೀಕರಿಸಿದೆ, ಆದರೆ :domain ಈಗಲೂ ಲಾಕ್ ಆಗಿದೆ. ಬದಲಾವಣೆಯನ್ನು ಅನ್ವಯಿಸಲಾಗಿಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar answered about :other when asked about :domain."
msgstr ":domain ಬಗ್ಗೆ ಕೇಳಿದಾಗ :registrar :other ಬಗ್ಗೆ ಉತ್ತರಿಸಿದೆ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar did not report an expiry date for :domain."
msgstr ":registrar :domain ಗೆ ಮುಕ್ತಾಯ ದಿನಾಂಕವನ್ನು ತಿಳಿಸಿಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar did not return a transfer code for :domain."
msgstr ":registrar :domain ಗೆ ವರ್ಗಾವಣೆ ಕೋಡ್ ಅನ್ನು ಹಿಂತಿರುಗಿಸಿಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar did not say whether :domain is available."
msgstr ":domain ಲಭ್ಯವಿದೆಯೇ ಎಂದು :registrar ತಿಳಿಸಿಲ್ಲ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar holds no transfer code for :domain. Request it from WebHosting|4U."
msgstr ":registrar ಬಳಿ :domain ಗೆ ವರ್ಗಾವಣೆ ಕೋಡ್ ಇಲ್ಲ. WebHosting|4U ನಿಂದ ಕೇಳಿ ಪಡೆಯಿರಿ."

#: src/library/Registrar/Adapter/Webhosting4u.php
msgid ":registrar rejected the credentials. Check the API username and key."
