#: src/modules/Order/Upgrades.php
msgid "The new product no longer exists."
msgstr "ಹೊಸ ಉತ್ಪನ್ನ ಇನ್ನು ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ."

#: src/modules/Clientfence/Backups.php
msgid "The newest backup sent is :days days old: check that the cron runs."
msgstr "ಕಳುಹಿಸಿದ ಅತ್ಯಂತ ಹೊಸ ಬ್ಯಾಕಪ್ :days ದಿನಗಳಷ್ಟು ಹಳೆಯದು: cron ಚಲಿಸುತ್ತಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."

#: src/modules/Clientfence/CloudBackups.php
