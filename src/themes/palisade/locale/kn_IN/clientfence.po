msgstr "ಗುಂಪು ತನಗೆ ತಾನೇ ಮೂಲ ಗುಂಪಾಗಲು ಸಾಧ್ಯವಿಲ್ಲ"

#: src/modules/Staff/Service.php
msgid "A group cannot use one of its subgroups as parent"
msgstr "ಗುಂಪು ತನ್ನ ಉಪಗುಂಪುಗಳಲ್ಲಿ ಒಂದನ್ನು ಮೂಲ ಗುಂಪಾಗಿ ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ"

#: src/modules/Servicehosting/ServerSecrets.php
msgid "A hosting server key could not be read with this install's encryption key. Enter the server's password or API key again."
msgstr "ಹೋಸ್ಟಿಂಗ್ ಸರ್ವರ್ ಕೀಯನ್ನು ಈ ಸ್ಥಾಪನೆಯ ಎನ್‌ಕ್ರಿಪ್ಶನ್ ಕೀಯಿಂದ ಓದಲಾಗಲಿಲ್ಲ. ಸರ್ವರ್‌ನ ಪಾಸ್‌ವರ್ಡ್ ಅಥವಾ API ಕೀಯನ್ನು ಮತ್ತೆ ನಮೂದಿಸಿ."

#: src/modules/Product/Options.php
msgid "A key may only have letters, digits, dots, dashes and underscores (at most :max)."
msgstr "ಕೀಯಲ್ಲಿ ಅಕ್ಷರಗಳು, ಅಂಕಿಗಳು, ಚುಕ್ಕೆಗಳು, ಡ್ಯಾಶ್‌ಗಳು ಮತ್ತು ಅಂಡರ್‌ಸ್ಕೋರ್‌ಗಳು ಮಾತ್ರ ಇರಬಹುದು (ಗರಿಷ್ಠ :max)."

#: src/modules/Servicelicense/templates/admin/mod_servicelicense_config.html.twig
msgid "A license plugin is a PHP class named"
msgstr "ಲೈಸೆನ್ಸ್ ಪ್ಲಗಿನ್ ಎಂದರೆ ಈ ಹೆಸರಿನ PHP ಕ್ಲಾಸ್"

#: src/modules/Clientfence/templates/admin/mod_clientfence_backups_panel.html.twig
msgid "A lost passphrase makes the copies useless: keep it somewhere safe, off this server."
msgstr "ಪಾಸ್‌ಫ್ರೇಸ್ ಕಳೆದುಹೋದರೆ ಪ್ರತಿಗಳು ನಿರುಪಯುಕ್ತವಾಗುತ್ತವೆ: ಅದನ್ನು ಈ ಸರ್ವರ್‌ನ ಹೊರಗೆ, ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಇಡಿ."

#: src/modules/Client/templates/email/mod_client_signup_admin.html.twig
msgid "A member of our team has created a client account for you. In the client area you can manage your services, pay invoices and contact our support team."
msgstr "ನಮ್ಮ ತಂಡದ ಸದಸ್ಯರೊಬ್ಬರು ನಿಮಗಾಗಿ ಕ್ಲೈಂಟ್ ಖಾತೆಯನ್ನು ರಚಿಸಿದ್ದಾರೆ. ಕ್ಲೈಂಟ್ ಪ್ರದೇಶದಲ್ಲಿ ನೀವು ನಿಮ್ಮ ಸೇವೆಗಳನ್ನು ನಿರ್ವಹಿಸಬಹುದು, ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಪಾವತಿಸಬಹುದು ಮತ್ತು ನಮ್ಮ ಬೆಂಬಲ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಬಹುದು."

#: src/modules/Staff/templates/email/mod_staff_clientfence_update.html.twig
msgid "A new ClientFence release is out (%date%). This site runs ClientFence %version%."
msgstr "ಹೊಸ ClientFence ಬಿಡುಗಡೆ ಹೊರಬಂದಿದೆ (%date%). ಈ ಸೈಟ್ ClientFence %version% ಅನ್ನು ಚಲಾಯಿಸುತ್ತಿದೆ."

#: src/modules/Staff/templates/email/mod_staff_clientfence_update.html.twig
msgid "A new ClientFence release is out. This site runs ClientFence %version%."
msgstr "ಹೊಸ ClientFence ಬಿಡುಗಡೆ ಹೊರಬಂದಿದೆ. ಈ ಸೈಟ್ ClientFence %version% ಅನ್ನು ಚಲಾಯಿಸುತ್ತಿದೆ."

#: src/modules/Client/templates/client/mod_client_signin_pin.html.twig src/modules/Staff/templates/admin/mod_staff_login_pin.html.twig
msgid "A new PIN is on its way."
msgstr "ಹೊಸ PIN ಬರುತ್ತಿದೆ."

#: src/modules/Client/templates/admin/mod_client_settings_affiliates.html.twig
msgid "A new affiliate's starting balance. It can be paid out once a first commission has cleared."
msgstr "ಹೊಸ ಅಫಿಲಿಯೇಟ್‌ನ ಆರಂಭಿಕ ಬ್ಯಾಲೆನ್ಸ್. ಮೊದಲ ಕಮಿಷನ್ ಕ್ಲಿಯರ್ ಆದ ನಂತರ ಅದನ್ನು ಪಾವತಿಸಬಹುದು."

#: src/modules/Client/templates/client/mod_client_twofactor_settings.html.twig
msgid "A new backup code replaces the old one."
msgstr "ಹೊಸ ಬ್ಯಾಕಪ್ ಕೋಡ್ ಹಳೆಯದನ್ನು ಬದಲಿಸುತ್ತದೆ."

#: src/modules/Staff/templates/email/mod_staff_client_signup.html.twig
msgid "A new client has just created an account with %company%."
msgstr "ಹೊಸ ಕ್ಲೈಂಟ್ ಒಬ್ಬರು ಈಗಷ್ಟೇ %company% ನಲ್ಲಿ ಖಾತೆ ರಚಿಸಿದ್ದಾರೆ."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "A new country or network is one the login has not signed in from (with the PIN, the app or a trusted browser) in the last 90 days. A sign-in whose country or network is not known is always asked."
msgstr "ಹೊಸ ದೇಶ ಅಥವಾ ನೆಟ್‌ವರ್ಕ್ ಎಂದರೆ ಕಳೆದ 90 ದಿನಗಳಲ್ಲಿ ಆ ಲಾಗಿನ್ (PIN, ಆ್ಯಪ್ ಅಥವಾ ವಿಶ್ವಾಸಾರ್ಹ ಬ್ರೌಸರ್‌ನೊಂದಿಗೆ) ಸೈನ್ ಇನ್ ಆಗದಿರುವ ಸ್ಥಳ. ದೇಶ ಅಥವಾ ನೆಟ್‌ವರ್ಕ್ ತಿಳಿಯದ ಸೈನ್-ಇನ್‌ಗೆ ಯಾವಾಗಲೂ ಕೇಳಲಾಗುತ್ತದೆ."

#: src/modules/Invoice/templates/admin/mod_invoice_tax.html.twig
msgid "A new line staff add on an invoice starts with Taxed ticked when the client pays tax. Staff can untick it."
msgstr "ಕ್ಲೈಂಟ್ ತೆರಿಗೆ ಪಾವತಿಸುವಾಗ, ಸಿಬ್ಬಂದಿ ಇನ್‌ವಾಯ್ಸ್‌ಗೆ ಸೇರಿಸುವ ಹೊಸ ಸಾಲು ತೆರಿಗೆ ವಿಧಿಸಲಾಗಿದೆ ಟಿಕ್ ಮಾಡಿದ ಸ್ಥಿತಿಯಲ್ಲಿ ಆರಂಭವಾಗುತ್ತದೆ. ಸಿಬ್ಬಂದಿ ಅದನ್ನು ಅನ್‌ಟಿಕ್ ಮಾಡಬಹುದು."

#: src/modules/Staff/templates/email/mod_staff_client_order.html.twig
msgid "A new order has been placed on %created_at%."
msgstr "%created_at% ರಂದು ಹೊಸ ಆರ್ಡರ್ ಮಾಡಲಾಗಿದೆ."

#: src/themes/palisade/html/mod_order_manage.html.twig
msgid "A new period starts today and renews on %date%: %charge%, less %credit% unused."
msgstr "ಹೊಸ ಅವಧಿ ಇಂದು ಆರಂಭವಾಗುತ್ತದೆ ಮತ್ತು %date% ರಂದು ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ: %charge%, ಬಳಸದ %credit% ಕಳೆದು."

#: src/modules/Support/templates/email/mod_support_helpdesk_ticket_open.html.twig
msgid "A new support ticket was opened in %helpdesk%: %subject%."
msgstr "%helpdesk% ನಲ್ಲಿ ಹೊಸ ಬೆಂಬಲ ಟಿಕೆಟ್ ತೆರೆಯಲಾಗಿದೆ: %subject%."

#: src/modules/Support/templates/email/mod_support_ticket_staff_open.html.twig
msgid "A new ticket from our team"
msgstr "ನಮ್ಮ ತಂಡದಿಂದ ಹೊಸ ಟಿಕೆಟ್"

#: src/modules/Client/templates/admin/mod_client_settings_google.html.twig
msgid "A new visitor who continues with Google gets an account at once, with the email Google confirmed. Continuing means they accept the two pages below; we record the date and IP address. If your client settings require more details (phone, address…), they fill them in right after."
msgstr "Google ಮೂಲಕ ಮುಂದುವರಿಯುವ ಹೊಸ ಸಂದರ್ಶಕರಿಗೆ, Google ದೃಢೀಕರಿಸಿದ ಇಮೇಲ್‌ನೊಂದಿಗೆ ತಕ್ಷಣ ಖಾತೆ ಸಿಗುತ್ತದೆ. ಮುಂದುವರಿಯುವುದು ಎಂದರೆ ಅವರು ಕೆಳಗಿನ ಎರಡು ಪುಟಗಳನ್ನು ಒಪ್ಪುತ್ತಾರೆ; ನಾವು ದಿನಾಂಕ ಮತ್ತು IP ವಿಳಾಸವನ್ನು ದಾಖಲಿಸುತ್ತೇವೆ. ನಿಮ್ಮ ಕ್ಲೈಂಟ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೆಚ್ಚಿನ ವಿವರಗಳು (ಫೋನ್, ವಿಳಾಸ…) ಬೇಕಿದ್ದರೆ, ಅವರು ತಕ್ಷಣವೇ ಅವುಗಳನ್ನು ಭರ್ತಿ ಮಾಡುತ್ತಾರೆ."

#: src/modules/Client/Affiliates/Affiliates.php
msgid "A note is required."
msgstr "ಟಿಪ್ಪಣಿ ಅಗತ್ಯವಿದೆ."

#: src/modules/Cookieconsent/templates/admin/mod_cookieconsent_index.html.twig
msgid "A notice about cookies for visitors of the client area. Once a visitor accepts it, it does not show again in that browser."
msgstr "ಕ್ಲೈಂಟ್ ಪ್ರದೇಶದ ಸಂದರ್ಶಕರಿಗೆ ಕುಕೀಗಳ ಕುರಿತ ಸೂಚನೆ. ಸಂದರ್ಶಕರು ಅದನ್ನು ಒಪ್ಪಿದ ನಂತರ, ಆ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಅದು ಮತ್ತೆ ಕಾಣಿಸುವುದಿಲ್ಲ."

#: src/modules/Invoice/Service.php
msgid "A paid invoice cannot be deleted. Undo a payment recorded by mistake with Reverse payment, or refund the invoice."
msgstr "ಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ತಪ್ಪಾಗಿ ದಾಖಲಿಸಿದ ಪಾವತಿಯನ್ನು ಪಾವತಿ ಹಿಂತಿರುಗಿಸಿ ಮೂಲಕ ರದ್ದುಮಾಡಿ, ಅಥವಾ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಮರುಪಾವತಿಸಿ."

#: src/modules/Invoice/Api/Admin.php src/modules/Invoice/Service.php
msgid "A paid invoice keeps its status. Undo a payment recorded by mistake with Reverse payment, or refund the invoice."
msgstr "ಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್ ತನ್ನ ಸ್ಥಿತಿಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ. ತಪ್ಪಾಗಿ ದಾಖಲಿಸಿದ ಪಾವತಿಯನ್ನು ಪಾವತಿ ಹಿಂತಿರುಗಿಸಿ ಮೂಲಕ ರದ್ದುಮಾಡಿ, ಅಥವಾ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಮರುಪಾವತಿಸಿ."

#: src/modules/Invoice/Service.php
msgid "A paid or refunded invoice cannot be deleted. Refund it instead."
msgstr "ಪಾವತಿಸಿದ ಅಥವಾ ಮರುಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಬದಲಿಗೆ ಅದನ್ನು ಮರುಪಾವತಿಸಿ."

#: src/modules/Invoice/Service.php
msgid "A paid or refunded invoice keeps its status, and only Refund marks an invoice refunded."
msgstr "ಪಾವತಿಸಿದ ಅಥವಾ ಮರುಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್ ತನ್ನ ಸ್ಥಿತಿಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ, ಮತ್ತು ಮರುಪಾವತಿ ಮಾತ್ರ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಮರುಪಾವತಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸುತ್ತದೆ."

#: src/modules/Order/Api/Client.php
msgid "A paid order cannot be deleted. Please contact support."
msgstr "ಪಾವತಿಸಿದ ಆರ್ಡರ್ ಅನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ."

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "A passkey signs in with the fingerprint, face or PIN of the device, instead of the password and the second step (authenticator code or email PIN). Each person adds passkeys on their two-factor sign-in page, and is offered one after signing in with the password. A passkey also meets \"Require two-factor sign-in\". Staff sign-ins still need an allowed IP address and country."
msgstr "ಪಾಸ್‌ಕೀ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಎರಡನೇ ಹಂತದ (ಆಥೆಂಟಿಕೇಟರ್ ಕೋಡ್ ಅಥವಾ ಇಮೇಲ್ PIN) ಬದಲಿಗೆ ಸಾಧನದ ಬೆರಳಚ್ಚು, ಮುಖ ಅಥವಾ PIN ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತದೆ. ಪ್ರತಿಯೊಬ್ಬರೂ ತಮ್ಮ ಎರಡು-ಹಂತದ ಸೈನ್-ಇನ್ ಪುಟದಲ್ಲಿ ಪಾಸ್‌ಕೀಗಳನ್ನು ಸೇರಿಸುತ್ತಾರೆ, ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ನೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಒಂದನ್ನು ನೀಡಲಾಗುತ್ತದೆ. ಪಾಸ್‌ಕೀ \"ಎರಡು-ಹಂತದ ಸೈನ್-ಇನ್ ಕಡ್ಡಾಯ\" ಅನ್ನೂ ಪೂರೈಸುತ್ತದೆ. ಸಿಬ್ಬಂದಿ ಸೈನ್-ಇನ್‌ಗಳಿಗೆ ಈಗಲೂ ಅನುಮತಿಸಲಾದ IP ವಿಳಾಸ ಮತ್ತು ದೇಶ ಬೇಕು."

#: src/modules/Client/templates/client/mod_client_twofactor_settings.html.twig
msgid "A passkey signs you in with the fingerprint, face or PIN of your phone or computer, instead of your password and code. It also counts as two-factor sign-in."
msgstr "ಪಾಸ್‌ಕೀ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಕೋಡ್ ಬದಲಿಗೆ ನಿಮ್ಮ ಫೋನ್ ಅಥವಾ ಕಂಪ್ಯೂಟರ್‌ನ ಬೆರಳಚ್ಚು, ಮುಖ ಅಥವಾ PIN ಮೂಲಕ ನಿಮ್ಮನ್ನು ಸೈನ್ ಇನ್ ಮಾಡುತ್ತದೆ. ಇದು ಎರಡು-ಹಂತದ ಸೈನ್-ಇನ್ ಆಗಿಯೂ ಎಣಿಕೆಯಾಗುತ್ತದೆ."

#: src/modules/Staff/templates/admin/mod_staff_profile.html.twig
msgid "A passkey signs you in with the fingerprint, face or PIN of your phone or computer, instead of your password and the second step. The allowed IP addresses and countries still apply."
msgstr "ಪಾಸ್‌ಕೀ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಎರಡನೇ ಹಂತದ ಬದಲಿಗೆ ನಿಮ್ಮ ಫೋನ್ ಅಥವಾ ಕಂಪ್ಯೂಟರ್‌ನ ಬೆರಳಚ್ಚು, ಮುಖ ಅಥವಾ PIN ಮೂಲಕ ನಿಮ್ಮನ್ನು ಸೈನ್ ಇನ್ ಮಾಡುತ್ತದೆ. ಅನುಮತಿಸಲಾದ IP ವಿಳಾಸಗಳು ಮತ್ತು ದೇಶಗಳು ಈಗಲೂ ಅನ್ವಯಿಸುತ್ತವೆ."

#: src/modules/Client/templates/email/mod_client_passkey_added.html.twig
msgid "A passkey was added to your account"
msgstr "ನಿಮ್ಮ ಖಾತೆಗೆ ಪಾಸ್‌ಕೀ ಸೇರಿಸಲಾಗಿದೆ"

#: src/modules/Client/templates/email/mod_client_passkey_added.html.twig
msgid "A passkey was added to your sign-in to the client area. It signs in with the fingerprint, face or PIN of the device that keeps it, without your password."
msgstr "ಕ್ಲೈಂಟ್ ಪ್ರದೇಶಕ್ಕೆ ನಿಮ್ಮ ಸೈನ್-ಇನ್‌ಗೆ ಪಾಸ್‌ಕೀ ಸೇರಿಸಲಾಗಿದೆ. ಅದನ್ನು ಇಟ್ಟುಕೊಂಡಿರುವ ಸಾಧನದ ಬೆರಳಚ್ಚು, ಮುಖ ಅಥವಾ PIN ಮೂಲಕ, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಇಲ್ಲದೆ ಅದು ಸೈನ್ ಇನ್ ಮಾಡುತ್ತದೆ."

#: src/modules/Client/Api/Admin.php
msgid "A password is required when the welcome email is disabled."
msgstr "ಸ್ವಾಗತ ಇಮೇಲ್ ನಿಷ್ಕ್ರಿಯವಾಗಿರುವಾಗ ಪಾಸ್‌ವರ್ಡ್ ಅಗತ್ಯವಿದೆ."

#: src/modules/Page/templates/client/mod_page_password-reset.html.twig src/modules/Staff/templates/admin/mod_staff_password_reset.html.twig src/themes/palisade/html/mod_page_password-reset.html.twig
msgid "A password reset confirmation email will be sent to you if we found an account with that email address."
msgstr "ಆ ಇಮೇಲ್ ವಿಳಾಸದ ಖಾತೆ ನಮಗೆ ಸಿಕ್ಕರೆ, ಪಾಸ್‌ವರ್ಡ್ ಮರುಹೊಂದಿಕೆಯ ದೃಢೀಕರಣ ಇಮೇಲ್ ನಿಮಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ."

#: src/modules/Clientfence/Notifications.php
msgid "A payment could not be processed (transaction #:id)"
msgstr "ಪಾವತಿಯನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ (ವಹಿವಾಟು #:id)"

#: src/themes/palisade/html/partials/pay_methods.html.twig
msgid "A payment fee of :fee is added to the invoice."
msgstr "ಇನ್‌ವಾಯ್ಸ್‌ಗೆ :fee ಪಾವತಿ ಶುಲ್ಕವನ್ನು ಸೇರಿಸಲಾಗುತ್ತದೆ."

#: src/modules/Invoice/GatewayFees.php src/modules/Invoice/SavedCards.php
msgid "A payment for this invoice is still clearing."
msgstr "ಈ ಇನ್‌ವಾಯ್ಸ್‌ನ ಪಾವತಿಯೊಂದು ಇನ್ನೂ ಕ್ಲಿಯರ್ ಆಗುತ್ತಿದೆ."

#: src/modules/Invoice/PaymentReversal.php
msgid "A payment was recorded on this invoice after it was paid, so its payment cannot be reversed. Refund it instead."
msgstr "ಈ ಇನ್‌ವಾಯ್ಸ್ ಪಾವತಿಯಾದ ನಂತರ ಅದರ ಮೇಲೆ ಪಾವತಿಯೊಂದನ್ನು ದಾಖಲಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದರ ಪಾವತಿಯನ್ನು ಹಿಂತಿರುಗಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಬದಲಿಗೆ ಅದನ್ನು ಮರುಪಾವತಿಸಿ."

#: src/modules/Product/templates/admin/mod_product_manage.html.twig
msgid "A percentage of what the client paid, or a fixed amount in the affiliate's currency. Used with Percentage or Fixed amount."
msgstr "ಕ್ಲೈಂಟ್ ಪಾವತಿಸಿದ ಮೊತ್ತದ ಶೇಕಡಾವಾರು, ಅಥವಾ ಅಫಿಲಿಯೇಟ್‌ನ ಕರೆನ್ಸಿಯಲ್ಲಿ ಸ್ಥಿರ ಮೊತ್ತ. ಶೇಕಡಾವಾರು ಅಥವಾ ಸ್ಥಿರ ಮೊತ್ತದೊಂದಿಗೆ ಬಳಸಲಾಗುತ್ತದೆ."

#: src/modules/Client/templates/admin/mod_client_settings_affiliates.html.twig
msgid "A percentage of what the client paid, or a fixed amount in the default currency."
msgstr "ಕ್ಲೈಂಟ್ ಪಾವತಿಸಿದ ಮೊತ್ತದ ಶೇಕಡಾವಾರು, ಅಥವಾ ಡೀಫಾಲ್ಟ್ ಕರೆನ್ಸಿಯಲ್ಲಿ ಸ್ಥಿರ ಮೊತ್ತ."

#: src/modules/Massmailer/templates/admin/mod_massmailer_message.html.twig
msgid "A placeholder is filled in for each client. It goes into the subject or the message, wherever you clicked last."
msgstr "ಪ್ರತಿ ಕ್ಲೈಂಟ್‌ಗೆ ಪ್ಲೇಸ್‌ಹೋಲ್ಡರ್ ಅನ್ನು ಭರ್ತಿ ಮಾಡಲಾಗುತ್ತದೆ. ನೀವು ಕೊನೆಯದಾಗಿ ಎಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿದಿರೋ ಅಲ್ಲಿಗೆ, ವಿಷಯ ಅಥವಾ ಸಂದೇಶದೊಳಗೆ ಅದು ಹೋಗುತ್ತದೆ."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "A private address for this admin area is the first thing bots look for. Bookmark the new one: the old address stops working."
msgstr "ಬಾಟ್‌ಗಳು ಮೊದಲು ಹುಡುಕುವುದು ಈ ಅಡ್ಮಿನ್ ಪ್ರದೇಶದ ಖಾಸಗಿ ವಿಳಾಸವನ್ನೇ. ಹೊಸದನ್ನು ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡಿ: ಹಳೆಯ ವಿಳಾಸ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತದೆ."

#: src/modules/Client/templates/admin/mod_client_settings_affiliates.html.twig
msgid "A product can pay another commission or none (product page), and an affiliate can have its own (client page). The affiliate's own wins, then the product's; a product set to No commission never pays."
msgstr "ಒಂದು ಉತ್ಪನ್ನ ಬೇರೆ ಕಮಿಷನ್ ನೀಡಬಹುದು ಅಥವಾ ನೀಡದಿರಬಹುದು (ಉತ್ಪನ್ನ ಪುಟ), ಮತ್ತು ಒಬ್ಬ ಅಫಿಲಿಯೇಟ್‌ಗೆ ತನ್ನದೇ ಕಮಿಷನ್ ಇರಬಹುದು (ಕ್ಲೈಂಟ್ ಪುಟ). ಅಫಿಲಿಯೇಟ್‌ನದೇ ಮೊದಲು ಅನ್ವಯಿಸುತ್ತದೆ, ನಂತರ ಉತ್ಪನ್ನದ್ದು; ಕಮಿಷನ್ ಇಲ್ಲ ಎಂದು ಹೊಂದಿಸಿದ ಉತ್ಪನ್ನ ಎಂದಿಗೂ ಪಾವತಿಸುವುದಿಲ್ಲ."

#: src/modules/Order/templates/admin/mod_order_settings.html.twig
msgid "A product offers the products listed on its Upgrades tab, and its own other billing cycles."
msgstr "ಒಂದು ಉತ್ಪನ್ನವು ತನ್ನ ಅಪ್‌ಗ್ರೇಡ್‌ಗಳು ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡಿದ ಉತ್ಪನ್ನಗಳನ್ನು ಮತ್ತು ತನ್ನದೇ ಇತರ ಬಿಲ್ಲಿಂಗ್ ಸೈಕಲ್‌ಗಳನ್ನು ನೀಡುತ್ತದೆ."

#: src/modules/Invoice/Promotions.php
msgid "A promotion can only be applied to an unpaid invoice."
msgstr "ಪಾವತಿಯಾಗದ ಇನ್‌ವಾಯ್ಸ್‌ಗೆ ಮಾತ್ರ ಪ್ರಚಾರವನ್ನು ಅನ್ವಯಿಸಬಹುದು."

#: src/modules/Invoice/templates/admin/mod_invoice_quote.html.twig
msgid "A quote becomes Accepted when the client accepts it, or with Accept for the client."
msgstr "ಕ್ಲೈಂಟ್ ಒಪ್ಪಿದಾಗ, ಅಥವಾ ಕ್ಲೈಂಟ್ ಪರವಾಗಿ ಸ್ವೀಕರಿಸಿ ಮೂಲಕ, ಕೊಟೇಶನ್ ಸ್ವೀಕರಿಸಲಾಗಿದೆ ಆಗುತ್ತದೆ."

#: src/modules/Invoice/Quotes.php
msgid "A quote can have at most :max lines."
msgstr "ಕೊಟೇಶನ್‌ನಲ್ಲಿ ಗರಿಷ್ಠ :max ಸಾಲುಗಳಿರಬಹುದು."

#: src/modules/Redirect/Service.php
msgid "A redirect for this path already exists."
msgstr "ಈ ಪಾತ್‌ಗೆ ಈಗಾಗಲೇ ಮರುನಿರ್ದೇಶನ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ."

#: src/modules/Invoice/Service.php
msgid "A refund to account credit cannot also be sent back through the payment gateway."
msgstr "ಖಾತೆ ಕ್ರೆಡಿಟ್‌ಗೆ ಮಾಡಿದ ಮರುಪಾವತಿಯನ್ನು ಪಾವತಿ ಗೇಟ್‌ವೇ ಮೂಲಕವೂ ಹಿಂದಿರುಗಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/modules/Support/templates/admin/mod_support_settings_mail.html.twig
msgid "A reply to a closed ticket is refused and the sender told. Help desks where clients cannot reopen tickets always refuse them."
msgstr "ಮುಚ್ಚಿದ ಟಿಕೆಟ್‌ಗೆ ಬರುವ ಪ್ರತ್ಯುತ್ತರವನ್ನು ನಿರಾಕರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಕಳುಹಿಸಿದವರಿಗೆ ತಿಳಿಸಲಾಗುತ್ತದೆ. ಕ್ಲೈಂಟ್‌ಗಳು ಟಿಕೆಟ್‌ಗಳನ್ನು ಮತ್ತೆ ತೆರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲದ ಹೆಲ್ಪ್ ಡೆಸ್ಕ್‌ಗಳು ಅವುಗಳನ್ನು ಯಾವಾಗಲೂ ನಿರಾಕರಿಸುತ್ತವೆ."

#: src/modules/Servicelicense/templates/admin/mod_servicelicense_manage.html.twig
msgid "A report on :date dropped the count from :old to :new; the price waits for your approval."
msgstr ":date ರಂದು ಬಂದ ವರದಿ ಎಣಿಕೆಯನ್ನು :old ರಿಂದ :new ಗೆ ಇಳಿಸಿದೆ; ಬೆಲೆ ನಿಮ್ಮ ಅನುಮೋದನೆಗಾಗಿ ಕಾಯುತ್ತಿದೆ."

#: src/modules/Servicelicense/templates/admin/mod_servicelicense_config.html.twig
msgid "A report that lowers the count by more than this waits for staff approval; rises apply at once."
msgstr "ಇದಕ್ಕಿಂತ ಹೆಚ್ಚು ಎಣಿಕೆಯನ್ನು ಇಳಿಸುವ ವರದಿ ಸಿಬ್ಬಂದಿ ಅನುಮೋದನೆಗಾಗಿ ಕಾಯುತ್ತದೆ; ಏರಿಕೆಗಳು ತಕ್ಷಣ ಅನ್ವಯಿಸುತ್ತವೆ."

#: src/modules/Support/templates/admin/mod_support_settings_escalation.html.twig
msgid "A rule acts on tickets of the chosen help desks, statuses and priorities that got no reply for the set time: it can add a reply, move the ticket, change its priority and status, assign it and email staff. It acts once for each reply, and only when the time runs out after the rule was made. The cron runs the rules."
msgstr "ನಿಯಮವು ಆಯ್ಕೆಮಾಡಿದ ಹೆಲ್ಪ್ ಡೆಸ್ಕ್‌ಗಳು, ಸ್ಥಿತಿಗಳು ಮತ್ತು ಆದ್ಯತೆಗಳ, ನಿಗದಿತ ಸಮಯದವರೆಗೆ ಪ್ರತ್ಯುತ್ತರ ಸಿಗದ ಟಿಕೆಟ್‌ಗಳ ಮೇಲೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ: ಅದು ಪ್ರತ್ಯುತ್ತರ ಸೇರಿಸಬಹುದು, ಟಿಕೆಟ್ ಅನ್ನು ಸ್ಥಳಾಂತರಿಸಬಹುದು, ಅದರ ಆದ್ಯತೆ ಮತ್ತು ಸ್ಥಿತಿಯನ್ನು ಬದಲಿಸಬಹುದು, ನಿಯೋಜಿಸಬಹುದು ಮತ್ತು ಸಿಬ್ಬಂದಿಗೆ ಇಮೇಲ್ ಮಾಡಬಹುದು. ಪ್ರತಿ ಪ್ರತ್ಯುತ್ತರಕ್ಕೆ ಒಮ್ಮೆ ಮಾತ್ರ, ಮತ್ತು ನಿಯಮ ರಚಿಸಿದ ನಂತರ ಸಮಯ ಮುಗಿದಾಗ ಮಾತ್ರ ಅದು ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. cron ನಿಯಮಗಳನ್ನು ಚಲಾಯಿಸುತ್ತದೆ."

#: src/library/Payment/Adapter/Stripe.php
