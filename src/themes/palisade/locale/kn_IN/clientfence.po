msgid "Thank you for choosing %company%. Your hosting account %title% has been set up. This email holds everything you need to start using it: please keep it for your records."
msgstr "%company% ಅನ್ನು ಆಯ್ಕೆಮಾಡಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ ಹೋಸ್ಟಿಂಗ್ ಖಾತೆ %title% ಅನ್ನು ಹೊಂದಿಸಲಾಗಿದೆ. ಅದನ್ನು ಬಳಸಲು ಆರಂಭಿಸಲು ನಿಮಗೆ ಬೇಕಾದ ಎಲ್ಲವೂ ಈ ಇಮೇಲ್‌ನಲ್ಲಿದೆ: ದಯವಿಟ್ಟು ಇದನ್ನು ನಿಮ್ಮ ದಾಖಲೆಗಳಿಗಾಗಿ ಇಟ್ಟುಕೊಳ್ಳಿ."

#: src/modules/Support/templates/email/mod_support_ticket_open.html.twig
msgid "Thank you for contacting our support team. A ticket has been opened for your request and a member of our team will reply as soon as possible. You will be notified by email when there is a response."
msgstr "ನಮ್ಮ ಬೆಂಬಲ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ ವಿನಂತಿಗಾಗಿ ಟಿಕೆಟ್ ತೆರೆಯಲಾಗಿದೆ ಮತ್ತು ನಮ್ಮ ತಂಡದ ಸದಸ್ಯರು ಆದಷ್ಟು ಬೇಗ ಪ್ರತ್ಯುತ್ತರಿಸುತ್ತಾರೆ. ಪ್ರತಿಕ್ರಿಯೆ ಬಂದಾಗ ನಿಮಗೆ ಇಮೇಲ್ ಮೂಲಕ ತಿಳಿಸಲಾಗುತ್ತದೆ."

#: src/modules/Client/templates/email/mod_client_signup.html.twig
msgid "Thank you for creating an account with us. In the client area you can place orders, manage your services, pay invoices and contact our support team."
msgstr "ನಮ್ಮಲ್ಲಿ ಖಾತೆ ರಚಿಸಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು. ಕ್ಲೈಂಟ್ ಪ್ರದೇಶದಲ್ಲಿ ನೀವು ಆರ್ಡರ್‌ಗಳನ್ನು ಮಾಡಬಹುದು, ನಿಮ್ಮ ಸೇವೆಗಳನ್ನು ನಿರ್ವಹಿಸಬಹುದು, ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಪಾವತಿಸಬಹುದು ಮತ್ತು ನಮ್ಮ ಬೆಂಬಲ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಬಹುದು."

#: src/modules/Support/templates/email/mod_support_ticket_feedback_request.html.twig
msgid "Thank you for helping us improve our service."
msgstr "ನಮ್ಮ ಸೇವೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು."

#: src/themes/palisade/html/mod_support_ticket.html.twig
msgid "Thank you for rating this reply."
msgstr "ಈ ಪ್ರತ್ಯುತ್ತರವನ್ನು ರೇಟ್ ಮಾಡಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು."

#: src/modules/Invoice/templates/email/mod_invoice_created.html.twig
msgid "Thank you for your business. A new invoice has been issued for your account on %created_at%. Please find the details below."
msgstr "ನಿಮ್ಮ ವ್ಯವಹಾರಕ್ಕೆ ಧನ್ಯವಾದಗಳು. %created_at% ರಂದು ನಿಮ್ಮ ಖಾತೆಗೆ ಹೊಸ ಇನ್‌ವಾಯ್ಸ್ ನೀಡಲಾಗಿದೆ. ವಿವರಗಳು ಕೆಳಗಿವೆ."

#: src/modules/Invoice/templates/email/mod_invoice_quote.html.twig
msgid "Thank you for your interest. Please find our quote for %subject% below; the PDF is attached to this email."
msgstr "ನಿಮ್ಮ ಆಸಕ್ತಿಗೆ ಧನ್ಯವಾದಗಳು. %subject% ಗಾಗಿ ನಮ್ಮ ಕೊಟೇಶನ್ ಕೆಳಗಿದೆ; PDF ಈ ಇಮೇಲ್‌ಗೆ ಲಗತ್ತಿಸಲಾಗಿದೆ."

#: src/modules/Servicedomain/templates/email/mod_servicedomain_activated.html.twig
msgid "Thank you for your order. The transfer of %title% to us has started. It usually takes a few days; we will email you when it is complete."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. %title% ನಮ್ಮಲ್ಲಿಗೆ ವರ್ಗಾವಣೆ ಆರಂಭವಾಗಿದೆ. ಇದಕ್ಕೆ ಸಾಮಾನ್ಯವಾಗಿ ಕೆಲವು ದಿನಗಳು ಹಿಡಿಯುತ್ತವೆ; ಅದು ಪೂರ್ಣಗೊಂಡಾಗ ನಾವು ನಿಮಗೆ ಇಮೇಲ್ ಮಾಡುತ್ತೇವೆ."

#: src/modules/Servicedownloadable/templates/email/mod_servicedownloadable_activated.html.twig
msgid "Thank you for your order. Your %title% is now active and ready to download."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ %title% ಈಗ ಸಕ್ರಿಯವಾಗಿದೆ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗೆ ಸಿದ್ಧವಾಗಿದೆ."

#: src/modules/Servicecustom/templates/email/mod_servicecustom_activated.html.twig
msgid "Thank you for your order. Your %title% is now active and ready to use."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ %title% ಈಗ ಸಕ್ರಿಯವಾಗಿದೆ ಮತ್ತು ಬಳಕೆಗೆ ಸಿದ್ಧವಾಗಿದೆ."

#: src/modules/Serviceapikey/templates/email/mod_serviceapikey_activated.html.twig
msgid "Thank you for your order. Your %title% is now active. Your API key is below: please keep it secret."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ %title% ಈಗ ಸಕ್ರಿಯವಾಗಿದೆ. ನಿಮ್ಮ API ಕೀ ಕೆಳಗಿದೆ: ದಯವಿಟ್ಟು ಅದನ್ನು ರಹಸ್ಯವಾಗಿಡಿ."

#: src/modules/Servicelicense/templates/email/mod_servicelicense_activated.html.twig
msgid "Thank you for your order. Your %title% is now active. Your license key is below: please keep it for your records."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ %title% ಈಗ ಸಕ್ರಿಯವಾಗಿದೆ. ನಿಮ್ಮ ಲೈಸೆನ್ಸ್ ಕೀ ಕೆಳಗಿದೆ: ದಯವಿಟ್ಟು ಅದನ್ನು ನಿಮ್ಮ ದಾಖಲೆಗಳಿಗಾಗಿ ಇಟ್ಟುಕೊಳ್ಳಿ."

#: src/modules/Servicedomain/templates/email/mod_servicedomain_activated.html.twig
msgid "Thank you for your order. Your domain %title% is now active."
msgstr "ನಿಮ್ಮ ಆರ್ಡರ್‌ಗೆ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ ಡೊಮೇನ್ %title% ಈಗ ಸಕ್ರಿಯವಾಗಿದೆ."

#: src/modules/Invoice/templates/client/mod_invoice_banklink.html.twig
msgid "Thank you for your patience."
msgstr "ನಿಮ್ಮ ತಾಳ್ಮೆಗೆ ಧನ್ಯವಾದಗಳು."

#: src/modules/Invoice/templates/email/mod_invoice_paid.html.twig
msgid "Thank you for your payment of %total%."
msgstr "%total% ನ ನಿಮ್ಮ ಪಾವತಿಗೆ ಧನ್ಯವಾದಗಳು."

#: src/themes/palisade/html/mod_invoice_thankyou.html.twig
msgid "Thank you for your payment."
msgstr "ನಿಮ್ಮ ಪಾವತಿಗೆ ಧನ್ಯವಾದಗಳು."

#: src/modules/Invoice/templates/email/mod_invoice_paid.html.twig
msgid "Thank you! We have received your payment for invoice %number%. This email is your receipt."
msgstr "ಧನ್ಯವಾದಗಳು! ಇನ್‌ವಾಯ್ಸ್ %number% ಗಾಗಿ ನಿಮ್ಮ ಪಾವತಿಯನ್ನು ನಾವು ಸ್ವೀಕರಿಸಿದ್ದೇವೆ. ಈ ಇಮೇಲ್ ನಿಮ್ಮ ರಸೀದಿ."

#: src/themes/palisade/html/mod_support_feedback.html.twig
msgid "Thank you, your feedback was received."
msgstr "ಧನ್ಯವಾದಗಳು, ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆ ಸ್ವೀಕರಿಸಲಾಗಿದೆ."

#: src/themes/palisade/html/mod_page_signup.html.twig
msgid "Thank you. Sign in with your email and password to continue. If this email already had an account, use that account’s password, or reset it."
msgstr "ಧನ್ಯವಾದಗಳು. ಮುಂದುವರಿಯಲು ನಿಮ್ಮ ಇಮೇಲ್ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ನೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ಈ ಇಮೇಲ್‌ಗೆ ಈಗಾಗಲೇ ಖಾತೆ ಇದ್ದರೆ, ಆ ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ, ಅಥವಾ ಅದನ್ನು ಮರುಹೊಂದಿಸಿ."

#: src/modules/Client/templates/email/mod_client_id_document_approved.html.twig
msgid "Thank you: we have checked your ID document and approved it. An order that waited only for it now goes on, and you get its usual emails."
msgstr "ಧನ್ಯವಾದಗಳು: ನಾವು ನಿಮ್ಮ ಗುರುತಿನ ದಾಖಲೆಯನ್ನು ಪರಿಶೀಲಿಸಿ ಅನುಮೋದಿಸಿದ್ದೇವೆ. ಅದಕ್ಕಾಗಿ ಮಾತ್ರ ಕಾಯುತ್ತಿದ್ದ ಆರ್ಡರ್ ಈಗ ಮುಂದುವರಿಯುತ್ತದೆ, ಮತ್ತು ನಿಮಗೆ ಅದರ ಸಾಮಾನ್ಯ ಇಮೇಲ್‌ಗಳು ಬರುತ್ತವೆ."

#: src/library/Registrar/Adapter/Centralnicreseller.php src/library/Registrar/Adapter/Connectreseller.php src/library/Registrar/Adapter/Dynadot.php …
msgid "The \":domain_registrar\" domain registrar is not fully configured. Please configure the :missing"
msgstr "\":domain_registrar\" ಡೊಮೇನ್ ರಿಜಿಸ್ಟ್ರಾರ್ ಸಂಪೂರ್ಣವಾಗಿ ಸಂರಚಿಸಲ್ಪಟ್ಟಿಲ್ಲ. ದಯವಿಟ್ಟು ಇದನ್ನು ಸಂರಚಿಸಿ: :missing"

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \":driver\" cache driver requires an installation identifier (\"info.instance_id\" in the configuration file) so that installations sharing the same server don't collide. Reinstall or update ClientFence to have one generated automatically, or set it manually."
msgstr "\":driver\" ಕ್ಯಾಶ್ ಡ್ರೈವರ್‌ಗೆ ಸ್ಥಾಪನಾ ಗುರುತಿಸುವಿಕೆ (ಸಂರಚನಾ ಫೈಲ್‌ನಲ್ಲಿ \"info.instance_id\") ಬೇಕು, ಇದರಿಂದ ಒಂದೇ ಸರ್ವರ್ ಹಂಚಿಕೊಳ್ಳುವ ಸ್ಥಾಪನೆಗಳು ಘರ್ಷಿಸುವುದಿಲ್ಲ. ಅದು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ರಚನೆಯಾಗಲು ClientFence ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಿ ಅಥವಾ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ, ಅಥವಾ ಅದನ್ನು ಕೈಯಾರೆ ಹೊಂದಿಸಿ."

#: src/library/Payment/Adapter/Eway.php src/library/Payment/Adapter/GoCardless.php src/library/Payment/Adapter/Mollie.php …
msgid "The \":pay_gateway\" payment gateway is not fully configured. Please configure the :missing"
msgstr "\":pay_gateway\" ಪಾವತಿ ಗೇಟ್‌ವೇ ಸಂಪೂರ್ಣವಾಗಿ ಸಂರಚಿಸಲ್ಪಟ್ಟಿಲ್ಲ. ದಯವಿಟ್ಟು ಇದನ್ನು ಸಂರಚಿಸಿ: :missing"

#: src/library/Server/Manager/CWP.php src/library/Server/Manager/Directadmin.php src/library/Server/Manager/Whm.php
msgid "The \":server_manager\" server manager is not fully configured. Please configure the :missing"
msgstr "\":server_manager\" ಸರ್ವರ್ ಮ್ಯಾನೇಜರ್ ಸಂಪೂರ್ಣವಾಗಿ ಸಂರಚಿಸಲ್ಪಟ್ಟಿಲ್ಲ. ದಯವಿಟ್ಟು ಇದನ್ನು ಸಂರಚಿಸಿ: :missing"

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "The \"Forgot your password?\" link of the staff login emails a reset link. Turn it off when staff passwords are only reset by a Super Administrator."
msgstr "ಸಿಬ್ಬಂದಿ ಲಾಗಿನ್‌ನ \"ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮರೆತಿರಾ?\" ಲಿಂಕ್ ಮರುಹೊಂದಿಕೆ ಲಿಂಕ್ ಅನ್ನು ಇಮೇಲ್ ಮಾಡುತ್ತದೆ. ಸಿಬ್ಬಂದಿ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೂಪರ್ ಅಡ್ಮಿನಿಸ್ಟ್ರೇಟರ್ ಮಾತ್ರ ಮರುಹೊಂದಿಸುವಾಗ ಇದನ್ನು ಆಫ್ ಮಾಡಿ."

#: src/modules/Email/Service.php
msgid "The \"from\" email address cannot be empty"
msgstr "\"from\" ಇಮೇಲ್ ವಿಳಾಸ ಖಾಲಿಯಾಗಿರಬಾರದು"

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \"memcached\" cache driver requires the PHP memcached extension to be installed."
msgstr "\"memcached\" ಕ್ಯಾಶ್ ಡ್ರೈವರ್‌ಗೆ PHP memcached ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಸ್ಥಾಪನೆಯಾಗಿರಬೇಕು."

#: src/library/ClientFence/Cache/CacheFactory.php
msgid "The \"redis\" cache driver requires the PHP redis (or relay) extension to be installed."
msgstr "\"redis\" ಕ್ಯಾಶ್ ಡ್ರೈವರ್‌ಗೆ PHP redis (ಅಥವಾ relay) ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಸ್ಥಾಪನೆಯಾಗಿರಬೇಕು."

#: src/modules/Staff/templates/email/mod_staff_order_action_failed.html.twig
msgid "The %action% action of order %order% (client %client%) failed. Its hosting panel, registrar or other service refused it or could not finish it."
msgstr "ಆರ್ಡರ್ %order% (ಕ್ಲೈಂಟ್ %client%) ನ %action% ಕ್ರಿಯೆ ವಿಫಲವಾಗಿದೆ. ಅದರ ಹೋಸ್ಟಿಂಗ್ ಪ್ಯಾನೆಲ್, ರಿಜಿಸ್ಟ್ರಾರ್ ಅಥವಾ ಇತರ ಸೇವೆ ಅದನ್ನು ನಿರಾಕರಿಸಿದೆ ಅಥವಾ ಪೂರ್ಣಗೊಳಿಸಲಾಗಲಿಲ್ಲ."

#: src/modules/Staff/templates/email/mod_staff_order_action_failed.html.twig
msgid "The %action% action of order %order% failed. Its hosting panel, registrar or other service refused it or could not finish it."
msgstr "ಆರ್ಡರ್ %order% ನ %action% ಕ್ರಿಯೆ ವಿಫಲವಾಗಿದೆ. ಅದರ ಹೋಸ್ಟಿಂಗ್ ಪ್ಯಾನೆಲ್, ರಿಜಿಸ್ಟ್ರಾರ್ ಅಥವಾ ಇತರ ಸೇವೆ ಅದನ್ನು ನಿರಾಕರಿಸಿದೆ ಅಥವಾ ಪೂರ್ಣಗೊಳಿಸಲಾಗಲಿಲ್ಲ."

#: src/modules/Support/TicketSecrets.php
msgid "The :field field contains control characters."
msgstr ":field ಕ್ಷೇತ್ರದಲ್ಲಿ ನಿಯಂತ್ರಣ ಅಕ್ಷರಗಳಿವೆ."

#: src/modules/Support/TicketSecrets.php
msgid "The :field field must be at most :max characters."
msgstr ":field ಕ್ಷೇತ್ರ ಗರಿಷ್ಠ :max ಅಕ್ಷರಗಳಾಗಿರಬೇಕು."

#: src/modules/Support/TicketSecrets.php
msgid "The :field field must be text."
msgstr ":field ಕ್ಷೇತ್ರ ಪಠ್ಯವಾಗಿರಬೇಕು."

#: src/modules/Client/Contacts.php
msgid "The :field is too long (:max characters at most)."
msgstr ":field ತುಂಬಾ ಉದ್ದವಾಗಿದೆ (ಗರಿಷ್ಠ :max ಅಕ್ಷರಗಳು)."

#: src/modules/Clientfence/Whmcs/Snapshot.php
msgid "The :name import needs PHP's pdo_sqlite extension. Turn it on for this site's PHP version, then try again."
msgstr ":name ಆಮದಿಗೆ PHP ಯ pdo_sqlite ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಬೇಕು. ಈ ಸೈಟ್‌ನ PHP ಆವೃತ್ತಿಗೆ ಅದನ್ನು ಆನ್ ಮಾಡಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: login for :email: could not be created."
msgstr ":email: ಗಾಗಿ :panel: ಲಾಗಿನ್ ರಚಿಸಲಾಗಲಿಲ್ಲ."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: organization :org: has no subscription :id:. Check both IDs in the panel."
msgstr ":panel: ಸಂಸ್ಥೆ :org: ಗೆ ಚಂದಾದಾರಿಕೆ :id: ಇಲ್ಲ. ಪ್ಯಾನೆಲ್‌ನಲ್ಲಿ ಎರಡೂ ID ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server already has a login for :email:, and the client has not confirmed this email address. Check that the client owns it, mark the email as confirmed on the client, then try again."
msgstr ":panel: ಸರ್ವರ್‌ನಲ್ಲಿ :email: ಗೆ ಈಗಾಗಲೇ ಲಾಗಿನ್ ಇದೆ, ಮತ್ತು ಕ್ಲೈಂಟ್ ಈ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ದೃಢೀಕರಿಸಿಲ್ಲ. ಅದು ಕ್ಲೈಂಟ್‌ಗೆ ಸೇರಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ, ಕ್ಲೈಂಟ್‌ನಲ್ಲಿ ಇಮೇಲ್ ಅನ್ನು ದೃಢೀಕರಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server could not complete the request. Please try again later."
msgstr ":panel: ಸರ್ವರ್ ವಿನಂತಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server did not confirm the step \":step:\". Please try again later."
msgstr ":panel: ಸರ್ವರ್ \":step:\" ಹಂತವನ್ನು ದೃಢೀಕರಿಸಲಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Api.php src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server did not give a sign-in link. Please try again later."
msgstr ":panel: ಸರ್ವರ್ ಸೈನ್-ಇನ್ ಲಿಂಕ್ ನೀಡಲಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Panel.php
msgid "The :panel: server did not recognise the organization ID. Check the server settings."
msgstr ":panel: ಸರ್ವರ್ ಸಂಸ್ಥೆ ID ಯನ್ನು ಗುರುತಿಸಲಿಲ್ಲ. ಸರ್ವರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server refused the API token. Check the server settings (organization ID, token and its allowed IP addresses)."
msgstr ":panel: ಸರ್ವರ್ API ಟೋಕನ್ ಅನ್ನು ನಿರಾಕರಿಸಿದೆ. ಸರ್ವರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ (ಸಂಸ್ಥೆ ID, ಟೋಕನ್ ಮತ್ತು ಅದರ ಅನುಮತಿಸಿದ IP ವಿಳಾಸಗಳು)."

#: src/modules/Servicehosting/Panel/Enhance/Api.php
msgid "The :panel: server sent an answer that could not be read."
msgstr ":panel: ಸರ್ವರ್ ಓದಲಾಗದ ಉತ್ತರವನ್ನು ಕಳುಹಿಸಿದೆ."

#: src/modules/Invoice/Accounting/FreeAgent.php
msgid "The :program bank account is in :bank_currency and the payment in :currency: choose an account in :currency for it."
msgstr ":program ಬ್ಯಾಂಕ್ ಖಾತೆ :bank_currency ನಲ್ಲಿದೆ ಮತ್ತು ಪಾವತಿ :currency ನಲ್ಲಿದೆ: ಅದಕ್ಕಾಗಿ :currency ನಲ್ಲಿರುವ ಖಾತೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ."

#: src/modules/Invoice/Accounting/FreeAgent.php
msgid "The :program total of :number is :total instead of :expected: check the tax rates in the accounting settings."
msgstr ":number ನ :program ಒಟ್ಟು ಮೊತ್ತ :expected ಬದಲಿಗೆ :total ಆಗಿದೆ: ಲೆಕ್ಕಪತ್ರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ತೆರಿಗೆ ದರಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/modules/Invoice/Quotes.php
msgid "The :what can be at most :max characters."
msgstr ":what ಗರಿಷ್ಠ :max ಅಕ್ಷರಗಳಾಗಿರಬಹುದು."

#: src/modules/Order/Proration.php
msgid "The :what is not valid."
msgstr ":what ಮಾನ್ಯವಾಗಿಲ್ಲ."

#: src/library/Server/Manager/CWP.php
msgid "The CWP server returned HTTP status :status. Check server availability and API configuration."
msgstr "CWP ಸರ್ವರ್ HTTP ಸ್ಥಿತಿ :status ಹಿಂದಿರುಗಿಸಿದೆ. ಸರ್ವರ್ ಲಭ್ಯತೆ ಮತ್ತು API ಸಂರಚನೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/library/Server/Manager/CWP.php
msgid "The CWP server returned an invalid JSON response. Check the server address, port and API configuration."
msgstr "CWP ಸರ್ವರ್ ಅಮಾನ್ಯ JSON ಪ್ರತಿಕ್ರಿಯೆ ಹಿಂದಿರುಗಿಸಿದೆ. ಸರ್ವರ್ ವಿಳಾಸ, ಪೋರ್ಟ್ ಮತ್ತು API ಸಂರಚನೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed answered HTTP :code."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ HTTP :code ಎಂದು ಉತ್ತರಿಸಿದೆ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed could not be reached: :error"
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ ತಲುಪಲಾಗಲಿಲ್ಲ: :error"

#: src/library/ClientFence/Update.php
msgid "The ClientFence release feed did not provide a SHA-256 digest. Update canceled for security reasons."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ SHA-256 digest ನೀಡಲಿಲ್ಲ. ಭದ್ರತಾ ಕಾರಣಗಳಿಗಾಗಿ ಅಪ್‌ಡೇಟ್ ರದ್ದುಮಾಡಲಾಗಿದೆ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed has no valid SHA-256 for the archive."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್‌ನಲ್ಲಿ ಆರ್ಕೈವ್‌ಗೆ ಮಾನ್ಯ SHA-256 ಇಲ್ಲ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed has no valid version."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್‌ನಲ್ಲಿ ಮಾನ್ಯ ಆವೃತ್ತಿ ಇಲ್ಲ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed is not valid JSON."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ ಮಾನ್ಯ JSON ಅಲ್ಲ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed is too large."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ ತುಂಬಾ ದೊಡ್ಡದಾಗಿದೆ."

#: src/modules/Clientfence/Updates.php
msgid "The ClientFence release feed names an archive outside its own folder."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ ತನ್ನದೇ ಫೋಲ್ಡರ್‌ನ ಹೊರಗಿನ ಆರ್ಕೈವ್ ಅನ್ನು ಹೆಸರಿಸುತ್ತದೆ."

#: src/library/ClientFence/Update.php
msgid "The ClientFence release feed provided an invalid SHA-256 digest. Update canceled for security reasons."
msgstr "ClientFence ಬಿಡುಗಡೆ ಫೀಡ್ ಅಮಾನ್ಯ SHA-256 digest ನೀಡಿದೆ. ಭದ್ರತಾ ಕಾರಣಗಳಿಗಾಗಿ ಅಪ್‌ಡೇಟ್ ರದ್ದುಮಾಡಲಾಗಿದೆ."

#: src/library/Payment/Adapter/GoCardless.php
msgid "The Direct Debit collects :mandate, the invoice is in :invoice: pay this invoice another way."
msgstr "Direct Debit :mandate ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಇನ್‌ವಾಯ್ಸ್ :invoice ನಲ್ಲಿದೆ: ಈ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಪಾವತಿಸಿ."

#: src/modules/Clientfence/Health.php
msgid "The Dynadot API answers with this key."
msgstr "Dynadot API ಈ ಕೀಯೊಂದಿಗೆ ಉತ್ತರಿಸುತ್ತದೆ."

#: src/modules/Clientfence/Health.php
msgid "The Dynadot API did not answer."
msgstr "Dynadot API ಉತ್ತರಿಸಲಿಲ್ಲ."

