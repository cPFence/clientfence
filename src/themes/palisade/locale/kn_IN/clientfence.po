#: src/modules/Servicehosting/Api/Client.php src/modules/Servicehosting/templates/client/mod_servicehosting_account_email.html.twig
msgid "This hosting account is suspended, so its email accounts cannot be changed."
msgstr "ಈ ಹೋಸ್ಟಿಂಗ್ ಖಾತೆ ಅಮಾನತುಗೊಂಡಿದೆ, ಆದ್ದರಿಂದ ಅದರ ಇಮೇಲ್ ಖಾತೆಗಳನ್ನು ಬದಲಿಸಲಾಗುವುದಿಲ್ಲ."

