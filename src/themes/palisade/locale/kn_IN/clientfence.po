msgstr "ಸೂಪರ್ ಅಡ್ಮಿನಿಸ್ಟ್ರೇಟರ್‌ಗಳು ಮಾತ್ರ ಸೆಟಪ್ ವಿಝಾರ್ಡ್ ಚಲಾಯಿಸಬಹುದು."

#: src/modules/Staff/Api/Admin.php
msgid "Only Super Administrators can switch off two-factor sign-in."
msgstr "ಸೂಪರ್ ಅಡ್ಮಿನಿಸ್ಟ್ರೇಟರ್‌ಗಳು ಮಾತ್ರ ಎರಡು-ಹಂತದ ಸೈನ್-ಇನ್ ಅನ್ನು ಆಫ್ ಮಾಡಬಹುದು."

#: src/modules/Staff/templates/admin/mod_staff_settings.html.twig
msgid "Only Super Administrators create groups or update group details."
msgstr "ಸೂಪರ್ ಅಡ್ಮಿನಿಸ್ಟ್ರೇಟರ್‌ಗಳು ಮಾತ್ರ ಗುಂಪುಗಳನ್ನು ರಚಿಸುತ್ತಾರೆ ಅಥವಾ ಗುಂಪಿನ ವಿವರಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡುತ್ತಾರೆ."

#: src/modules/Client/templates/admin/mod_client_settings_google.html.twig
msgid "Only a browser that opened the store preview link (Settings → Orders) can sign up."
msgstr "ಸ್ಟೋರ್ ಮುನ್ನೋಟ ಲಿಂಕ್ ತೆರೆದ ಬ್ರೌಸರ್ ಮಾತ್ರ (ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಆರ್ಡರ್‌ಗಳು) ಸೈನ್ ಅಪ್ ಮಾಡಬಹುದು."

#: src/modules/Invoice/Service.php
msgid "Only a paid invoice can be refunded, and only once."
msgstr "ಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಮಾತ್ರ, ಮತ್ತು ಒಮ್ಮೆ ಮಾತ್ರ ಮರುಪಾವತಿಸಬಹುದು."

#: src/modules/Invoice/PaymentReversal.php
msgid "Only a payment staff recorded on an unpaid invoice can be reversed here, and only once."
msgstr "ಪಾವತಿಯಾಗದ ಇನ್‌ವಾಯ್ಸ್‌ನಲ್ಲಿ ಸಿಬ್ಬಂದಿ ದಾಖಲಿಸಿದ ಪಾವತಿಯನ್ನು ಮಾತ್ರ ಇಲ್ಲಿ, ಮತ್ತು ಒಮ್ಮೆ ಮಾತ್ರ ಹಿಂತೆಗೆದುಕೊಳ್ಳಬಹುದು."

#: src/modules/Client/Affiliates/Affiliates.php
msgid "Only a pending commission can be cancelled."
msgstr "ಬಾಕಿ ಇರುವ ಕಮಿಷನ್ ಅನ್ನು ಮಾತ್ರ ರದ್ದುಮಾಡಬಹುದು."

#: src/modules/Invoice/Quotes.php
msgid "Only a quote that is not accepted, lost or dead can be sent."
msgstr "ಸ್ವೀಕರಿಸದ, ಕೈತಪ್ಪದ ಅಥವಾ ಮುಚ್ಚದ ಕೊಟೇಶನ್ ಅನ್ನು ಮಾತ್ರ ಕಳುಹಿಸಬಹುದು."

#: src/modules/Invoice/Promotions.php
msgid "Only a recurring promotion comes off renewals."
msgstr "ಮರುಕಳಿಸುವ ಪ್ರಚಾರ ಮಾತ್ರ ನವೀಕರಣಗಳಿಂದ ಕಳೆಯಲ್ಪಡುತ್ತದೆ."

#: src/modules/Order/Service.php
msgid "Only a service billed by period can be cancelled at the end of its period."
msgstr "ಅವಧಿಯ ಪ್ರಕಾರ ಬಿಲ್ ಮಾಡಲಾಗುವ ಸೇವೆಯನ್ನು ಮಾತ್ರ ಅದರ ಅವಧಿಯ ಕೊನೆಯಲ್ಲಿ ರದ್ದುಮಾಡಬಹುದು."

#: src/modules/Order/Service.php
msgid "Only active orders can be suspended"
msgstr "ಸಕ್ರಿಯ ಆರ್ಡರ್‌ಗಳನ್ನು ಮಾತ್ರ ಅಮಾನತುಗೊಳಿಸಬಹುದು"

#: src/modules/Order/Upgrades.php
msgid "Only active services can be changed."
msgstr "ಸಕ್ರಿಯ ಸೇವೆಗಳನ್ನು ಮಾತ್ರ ಬದಲಿಸಬಹುದು."

#: src/modules/Support/Service.php
msgid "Only admin replies can be edited"
msgstr "ಅಡ್ಮಿನ್ ಪ್ರತ್ಯುತ್ತರಗಳನ್ನು ಮಾತ್ರ ಸಂಪಾದಿಸಬಹುದು"

#: src/modules/Invoice/Api/Client.php
msgid "Only an active or suspended service can be renewed."
msgstr "ಸಕ್ರಿಯ ಅಥವಾ ಅಮಾನತುಗೊಂಡ ಸೇವೆಯನ್ನು ಮಾತ್ರ ನವೀಕರಿಸಬಹುದು."

#: src/modules/Order/CancelRequests.php
msgid "Only an active service can be cancelled."
msgstr "ಸಕ್ರಿಯ ಸೇವೆಯನ್ನು ಮಾತ್ರ ರದ್ದುಮಾಡಬಹುದು."

#: src/modules/Invoice/Service.php
msgid "Only an approved, unpaid invoice can be sent."
msgstr "ಅನುಮೋದಿಸಿದ, ಪಾವತಿಯಾಗದ ಇನ್‌ವಾಯ್ಸ್ ಅನ್ನು ಮಾತ್ರ ಕಳುಹಿಸಬಹುದು."

#: src/modules/Invoice/ServiceTransaction.php
msgid "Only approved transaction can be processed"
msgstr "ಅನುಮೋದಿಸಿದ ವಹಿವಾಟನ್ನು ಮಾತ್ರ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಬಹುದು"

#: src/modules/Client/Users.php
msgid "Only authorized users can switch accounts."
msgstr "ಅಧಿಕೃತ ಬಳಕೆದಾರರು ಮಾತ್ರ ಖಾತೆಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು."

#: src/modules/Client/Users.php
msgid "Only authorized users have this profile."
msgstr "ಅಧಿಕೃತ ಬಳಕೆದಾರರಿಗೆ ಮಾತ್ರ ಈ ಪ್ರೊಫೈಲ್ ಇದೆ."

#: src/modules/Order/Api/Admin.php
msgid "Only canceled orders can be uncanceled"
msgstr "ರದ್ದಾದ ಆರ್ಡರ್‌ಗಳನ್ನು ಮಾತ್ರ ರದ್ದತಿಯಿಂದ ಮರಳಿ ತರಬಹುದು"

#: src/modules/Invoice/Api/Admin.php
msgid "Only cancelled invoices can be marked unpaid."
msgstr "ರದ್ದಾದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಮಾತ್ರ ಪಾವತಿಯಾಗಿಲ್ಲ ಎಂದು ಗುರುತಿಸಬಹುದು."

#: src/modules/Support/templates/admin/mod_support_helpdesk_mail.html.twig
msgid "Only clients and their authorized users can open tickets by email; anyone else is told so by email. Off: others get a guest ticket (while guest tickets are on in Support settings)."
msgstr "ಕ್ಲೈಂಟ್‌ಗಳು ಮತ್ತು ಅವರ ಅಧಿಕೃತ ಬಳಕೆದಾರರು ಮಾತ್ರ ಇಮೇಲ್ ಮೂಲಕ ಟಿಕೆಟ್‌ಗಳನ್ನು ತೆರೆಯಬಹುದು; ಬೇರೆ ಯಾರಿಗಾದರೂ ಇದನ್ನು ಇಮೇಲ್ ಮೂಲಕ ತಿಳಿಸಲಾಗುತ್ತದೆ. ಆಫ್: ಇತರರಿಗೆ ಅತಿಥಿ ಟಿಕೆಟ್ ದೊರೆಯುತ್ತದೆ (ಬೆಂಬಲ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅತಿಥಿ ಟಿಕೆಟ್‌ಗಳು ಆನ್ ಆಗಿರುವವರೆಗೆ)."

#: src/modules/Clientfence/templates/admin/mod_clientfence_setup.html.twig
msgid "Only clients in one client group can order."
msgstr "ಒಂದು ಕ್ಲೈಂಟ್ ಗುಂಪಿನಲ್ಲಿರುವ ಕ್ಲೈಂಟ್‌ಗಳು ಮಾತ್ರ ಆರ್ಡರ್ ಮಾಡಬಹುದು."

#: src/modules/Client/templates/admin/mod_client_settings_id_documents.html.twig
msgid "Only clients whose order another check holds (fraud check, hosting network)"
msgstr "ಇನ್ನೊಂದು ಪರಿಶೀಲನೆ (ವಂಚನೆ ಪರಿಶೀಲನೆ, ಹೋಸ್ಟಿಂಗ್ ನೆಟ್‌ವರ್ಕ್) ಆರ್ಡರ್ ತಡೆಹಿಡಿದಿರುವ ಕ್ಲೈಂಟ್‌ಗಳು ಮಾತ್ರ"

#: src/modules/Security/templates/admin/mod_security_rate_limits.html.twig
msgid "Only currently rate-limited IP counters are shown here. Reset all clears every limiter counter."
msgstr "ಪ್ರಸ್ತುತ ದರ-ಮಿತಿಗೊಳಿಸಿದ IP ಕೌಂಟರ್‌ಗಳನ್ನು ಮಾತ್ರ ಇಲ್ಲಿ ತೋರಿಸಲಾಗುತ್ತದೆ. ಎಲ್ಲವನ್ನೂ ಮರುಹೊಂದಿಸಿ ಪ್ರತಿ ಮಿತಿ ಕೌಂಟರ್ ಅನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ."

#: src/modules/Email/Api/Admin.php
msgid "Only custom email templates can be deleted"
msgstr "ಕಸ್ಟಮ್ ಇಮೇಲ್ ಟೆಂಪ್ಲೇಟ್‌ಗಳನ್ನು ಮಾತ್ರ ಅಳಿಸಬಹುದು"

#: src/modules/Clientfence/templates/admin/mod_clientfence_signin_panel.html.twig
msgid "Only from a new country or network"
msgstr "ಹೊಸ ದೇಶ ಅಥವಾ ನೆಟ್‌ವರ್ಕ್‌ನಿಂದ ಮಾತ್ರ"

#: src/modules/Servicehosting/Service.php
msgid "Only hosting accounts on an Enhance server can be linked by hand."
msgstr "Enhance ಸರ್ವರ್‌ನಲ್ಲಿರುವ ಹೋಸ್ಟಿಂಗ್ ಖಾತೆಗಳನ್ನು ಮಾತ್ರ ಕೈಯಾರೆ ಲಿಂಕ್ ಮಾಡಬಹುದು."

#: src/modules/Clientfence/templates/admin/mod_clientfence_whmcs_panel.html.twig
msgid "Only if Blesta runs on another server: a copy of its support_manager_files folder on this one (Blesta > Settings > System > General > Uploads Directory). Files not found are named in the warnings and show as removed."
msgstr "Blesta ಇನ್ನೊಂದು ಸರ್ವರ್‌ನಲ್ಲಿ ಚಲಿಸುತ್ತಿದ್ದರೆ ಮಾತ್ರ: ಅದರ support_manager_files ಫೋಲ್ಡರ್‌ನ ಪ್ರತಿ ಈ ಸರ್ವರ್‌ನಲ್ಲಿ (Blesta > Settings > System > General > Uploads Directory). ಕಂಡುಬರದ ಫೈಲ್‌ಗಳನ್ನು ಎಚ್ಚರಿಕೆಗಳಲ್ಲಿ ಹೆಸರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ತೆಗೆದುಹಾಕಲಾಗಿದೆ ಎಂದು ತೋರಿಸಲಾಗುತ್ತದೆ."

#: src/modules/System/templates/admin/mod_system_settings.html.twig
msgid "Only needed if the Redis server's certificate isn't signed by a CA your system already trusts."
msgstr "Redis ಸರ್ವರ್‌ನ ಪ್ರಮಾಣಪತ್ರಕ್ಕೆ ನಿಮ್ಮ ಸಿಸ್ಟಮ್ ಈಗಾಗಲೇ ನಂಬುವ CA ಸಹಿ ಹಾಕದಿದ್ದರೆ ಮಾತ್ರ ಅಗತ್ಯ."

#: src/library/ClientFence/IpSeats.php src/themes/palisade/html/mod_servicelicense_head.html.twig src/themes/palisade/html/partials/ip_seats.html.twig
msgid "Only our staff can change these IP addresses. Please open a ticket."
msgstr "ನಮ್ಮ ಸಿಬ್ಬಂದಿ ಮಾತ್ರ ಈ IP ವಿಳಾಸಗಳನ್ನು ಬದಲಿಸಬಹುದು. ದಯವಿಟ್ಟು ಟಿಕೆಟ್ ತೆರೆಯಿರಿ."

#: src/modules/Order/Api/Client.php
msgid "Only pending and failed setup orders can be deleted."
msgstr "ಬಾಕಿ ಇರುವ ಮತ್ತು ಸೆಟಪ್ ವಿಫಲವಾದ ಆರ್ಡರ್‌ಗಳನ್ನು ಮಾತ್ರ ಅಳಿಸಬಹುದು."

#: src/modules/Order/Service.php
msgid "Only pending setup or failed orders can be activated"
msgstr "ಸೆಟಪ್ ಬಾಕಿ ಇರುವ ಅಥವಾ ವಿಫಲವಾದ ಆರ್ಡರ್‌ಗಳನ್ನು ಮಾತ್ರ ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು"

#: src/modules/Order/templates/admin/mod_order_bulk_prices.html.twig
msgid "Only services at this price"
msgstr "ಈ ಬೆಲೆಯಲ್ಲಿರುವ ಸೇವೆಗಳು ಮಾತ್ರ"

#: src/modules/Order/Upgrades.php
msgid "Only services billed by period can be changed."
msgstr "ಅವಧಿಯ ಪ್ರಕಾರ ಬಿಲ್ ಮಾಡಲಾಗುವ ಸೇವೆಗಳನ್ನು ಮಾತ್ರ ಬದಲಿಸಬಹುದು."

#: src/modules/Clientfence/templates/admin/mod_clientfence_settings_store.html.twig
msgid "Only signed-in clients in the chosen client group see the store and order themselves. Everyone else sees that the store is closed. New accounts join that group only when made with the store preview link."
msgstr "ಆಯ್ಕೆಮಾಡಿದ ಕ್ಲೈಂಟ್ ಗುಂಪಿನಲ್ಲಿರುವ ಸೈನ್ ಇನ್ ಆದ ಕ್ಲೈಂಟ್‌ಗಳು ಮಾತ್ರ ಸ್ಟೋರ್ ನೋಡುತ್ತಾರೆ ಮತ್ತು ತಾವೇ ಆರ್ಡರ್ ಮಾಡುತ್ತಾರೆ. ಉಳಿದವರೆಲ್ಲರೂ ಸ್ಟೋರ್ ಮುಚ್ಚಿದೆ ಎಂದು ನೋಡುತ್ತಾರೆ. ಸ್ಟೋರ್ ಮುನ್ನೋಟ ಲಿಂಕ್ ಮೂಲಕ ಮಾಡಿದ ಹೊಸ ಖಾತೆಗಳು ಮಾತ್ರ ಆ ಗುಂಪಿಗೆ ಸೇರುತ್ತವೆ."

#: src/modules/Support/TicketFeedback.php
msgid "Only staff replies of this ticket can be rated."
msgstr "ಈ ಟಿಕೆಟ್‌ನ ಸಿಬ್ಬಂದಿ ಪ್ರತ್ಯುತ್ತರಗಳನ್ನು ಮಾತ್ರ ರೇಟ್ ಮಾಡಬಹುದು."

#: src/modules/Invoice/templates/admin/mod_invoice_tax.html.twig
msgid "Only staff who may change system settings can switch tax support on or off."
msgstr "ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಿಸಬಹುದಾದ ಸಿಬ್ಬಂದಿ ಮಾತ್ರ ತೆರಿಗೆ ಬೆಂಬಲವನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಬಹುದು."

#: src/modules/Staff/Service.php
msgid "Only super administrators can manage staff groups"
msgstr "ಸೂಪರ್ ಅಡ್ಮಿನಿಸ್ಟ್ರೇಟರ್‌ಗಳು ಮಾತ್ರ ಸಿಬ್ಬಂದಿ ಗುಂಪುಗಳನ್ನು ನಿರ್ವಹಿಸಬಹುದು"

#: src/modules/Order/Api/Admin.php
msgid "Only suspended orders can be unsuspended"
msgstr "ಅಮಾನತುಗೊಂಡ ಆರ್ಡರ್‌ಗಳ ಅಮಾನತನ್ನು ಮಾತ್ರ ತೆಗೆಯಬಹುದು"

#: src/modules/Client/Users.php
msgid "Only the account owner can change the account email."
msgstr "ಖಾತೆ ಮಾಲೀಕರು ಮಾತ್ರ ಖಾತೆಯ ಇಮೇಲ್ ಬದಲಿಸಬಹುದು."

#: src/modules/Servicehosting/Api/Client.php
msgid "Only the account owner can restore backups."
msgstr "ಖಾತೆ ಮಾಲೀಕರು ಮಾತ್ರ ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು."

#: src/modules/Invoice/Api/Client.php src/modules/Invoice/Controller/Client.php
msgid "Only the account owner can save a payment method."
msgstr "ಖಾತೆ ಮಾಲೀಕರು ಮಾತ್ರ ಪಾವತಿ ವಿಧಾನವನ್ನು ಉಳಿಸಬಹುದು."

#: src/modules/Invoice/templates/admin/mod_invoice_report.html.twig
msgid "Only the first :count rows are shown. Narrow the filters to see the rest."
msgstr "ಮೊದಲ :count ಸಾಲುಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸಲಾಗಿದೆ. ಉಳಿದವನ್ನು ನೋಡಲು ಫಿಲ್ಟರ್‌ಗಳನ್ನು ಕಿರಿದಾಗಿಸಿ."

#: src/modules/Invoice/PaymentReversal.php
msgid "Only the payment of a paid invoice can be reversed."
msgstr "ಪಾವತಿಸಿದ ಇನ್‌ವಾಯ್ಸ್‌ನ ಪಾವತಿಯನ್ನು ಮಾತ್ರ ಹಿಂತೆಗೆದುಕೊಳ್ಳಬಹುದು."

#: src/modules/Clientfence/templates/admin/mod_clientfence_chat_alerts_panel.html.twig
msgid "Only the ticked alerts are sent here."
msgstr "ಟಿಕ್ ಮಾಡಿದ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಮಾತ್ರ ಇಲ್ಲಿಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ."

#: src/modules/Support/TicketMerge.php
msgid "Only tickets of the same client, or guest tickets from the same email address, can be merged."
msgstr "ಅದೇ ಕ್ಲೈಂಟ್‌ನ ಟಿಕೆಟ್‌ಗಳು, ಅಥವಾ ಅದೇ ಇಮೇಲ್ ವಿಳಾಸದಿಂದ ಬಂದ ಅತಿಥಿ ಟಿಕೆಟ್‌ಗಳನ್ನು ಮಾತ್ರ ವಿಲೀನಗೊಳಿಸಬಹುದು."

#: src/modules/Invoice/Api/Admin.php
msgid "Only unpaid invoices can be cancelled."
msgstr "ಪಾವತಿಯಾಗದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಮಾತ್ರ ರದ್ದುಮಾಡಬಹುದು."

#: src/modules/Invoice/Api/Admin.php
msgid "Only unpaid issued invoices get a reminder."
msgstr "ನೀಡಲಾದ ಪಾವತಿಯಾಗದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳಿಗೆ ಮಾತ್ರ ಜ್ಞಾಪನೆ ಸಿಗುತ್ತದೆ."

#: src/themes/palisade/config/settings.html.twig
