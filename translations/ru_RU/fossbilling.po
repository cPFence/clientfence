msgid ""
"Allow the staff member to uninstall extensions, including their associated "
"database records and files."
msgstr ""
"Позволяет сотруднику удалять расширения, включая связанные с ними записи в "
"базе данных и файлы."

msgid "Allow transfer:"
msgstr "Разрешить перенос:"

msgid "Allows the staff member to add new currencies to the system."
msgstr "Позволяет сотруднику добавлять в систему новые валюты."

msgid ""
"Allows the staff member to add or remove balance entries for client accounts."
msgstr ""
"Позволяет сотруднику добавлять или удалять проводки баланса для счетов "
"клиентов."

msgid "Allows the staff member to authenticate as any client account."
msgstr ""
"Позволяет сотруднику аутентифицироваться под клиентской учетной записью."

msgid "Allows the staff member to change the system default currency."
msgstr "Позволяет сотруднику изменять валюту системы по умолчанию."

msgid ""
"Allows the staff member to clear cached update information and fetch the "
"latest update metadata."
msgstr ""
"Позволяет сотруднику очистить кэш информации об обновлении и получить "
"последнюю информацию об обновлениях."

msgid "Allows the staff member to create and edit :type: accounts."
msgstr "Позволяет сотруднику создавать и редактировать :type: учетные записи."

msgid "Allows the staff member to create and edit redirects."
msgstr "Позволяет сотруднику создавать и редактировать перенаправления."

msgid "Allows the staff member to create new client accounts."
msgstr "Позволяет сотруднику создавать и редактировать  учетные записи."

msgid "Allows the staff member to create, update, and delete client groups."
msgstr "Позволяет сотруднику создавать, обновлять и удалять группы клиентов."

msgid ""
"Allows the staff member to create, update, delete, reset, and regenerate "
"email templates."
msgstr ""
"Позволяет сотруднику создавать, обновлять, удалять, сбрасывать и "
"восстанавливать шаблоны писем."

msgid "Allows the staff member to delete :type: accounts."
msgstr "Позволяет сотруднику удалять :type: учётные записи."

msgid "Allows the staff member to delete redirects."
msgstr "Позволяет сотруднику удалять переадресации."

msgid "Allows the staff member to delete sent email log entries."
msgstr ""
"Позволяет сотруднику удалять записи отправленных писем в журнале электронной "
"почты."

msgid "Allows the staff member to edit settings for this module."
msgstr "Позволяет сотруднику редактировать настройки этого модуля."

msgid ""
"Allows the staff member to enable or disable error reporting for this "
"FOSSBilling instance."
msgstr ""
"Позволяет сотруднику включить или отключить сообщение об ошибках для этого "
"экземпляра FOSSBilling."

msgid "Allows the staff member to export client account data."
msgstr "Позволяет сотруднику экспортировать данные учетной записи клиента."

msgid ""
"Allows the staff member to fetch a list of all local interface IP addresses "
"and set the default network interface for ClientFence to use."
msgstr ""
"Позволяет сотруднику получать список всех локальных IP-адресов интерфейсов и "
"устанавливать сетевой интерфейс по умолчанию для использования ClientFence."

msgid ""
"Allows the staff member to fetch a list of all local interface IP addresses "
"and set the default network interface for FOSSBilling to use."
msgstr ""
"Позволяет сотруднику получать список всех локальных IP-адресов интерфейсов и "
"устанавливать сетевой интерфейс по умолчанию для использования FOSSBilling."

msgid "Allows the staff member to install, update, or deactivate extensions."
msgstr ""
"Позволяет сотруднику устанавливать, обновлять или деактивировать расширения."

msgid ""
"Allows the staff member to invalidate the ClientFence cache from within the "
"system settings."
msgstr "Позволяет сотруднику очищать кэш ClientFence из системных настроек."

msgid ""
"Allows the staff member to invalidate the FOSSBilling cache from within the "
"system settings."
msgstr "Позволяет сотруднику очищать кэш FOSSBilling из системных настроек."

msgid ""
"Allows the staff member to invoke hooks manually with custom event payloads."
msgstr ""
"Позволяет сотруднику вручную вызывать хуки с пользовательскими payload."

msgid ""
"Allows the staff member to manage client module settings and configuration."
msgstr ""
"Позволяет сотруднику управлять настройками и настройками модулей клиента."

msgid "Allows the staff member to manage staff member groups."
msgstr "Позволяет сотруднику управлять группами сотрудников."

msgid "Allows the staff member to perform password resets on :type: accounts."
msgstr "Позволить сотруднику выполнять сброс пароля на :type: аккаунтах."

msgid "Allows the staff member to permanently remove client accounts."
msgstr "Позволяет сотруднику окончательно удалять учетные записи клиентов."

msgid ""
"Allows the staff member to permanently remove multiple client accounts in a "
"single action."
msgstr ""
"Позволяет сотруднику окончательно удалить несколько учетных записей клиентов "
"в одном действии."

msgid "Allows the staff member to refresh all currency conversion rates."
msgstr "Позволяет сотруднику обновлять все курсы конвертации валют."

msgid "Allows the staff member to remove currencies from the system."
msgstr "Позволяет сотруднику удалять валюты из системы."

msgid ""
"Allows the staff member to run security checks on the ClientFence "
"installation."
msgstr ""
"Позволяет сотруднику запускать проверки безопасности установки ClientFence."

msgid ""
"Allows the staff member to run security checks on the FOSSBilling "
"installation."
msgstr ""
"Позволяет сотруднику запускать проверки безопасности установки FOSSBilling."

msgid "Allows the staff member to send, resend, and process queued emails."
msgstr ""
"Позволяет сотруднику отправлять, пересылать и обрабатывать очереди писем."

msgid "Allows the staff member to set new passwords for client accounts."
msgstr "Позволить сотруднику выполнять сброс пароля на  аккаунтах."

msgid "Allows the staff member to update ClientFence."
msgstr "Позволяет сотруднику обновлять ClientFence."

msgid "Allows the staff member to update FOSSBilling."
msgstr "Позволяет сотруднику обновлять FOSSBilling."

msgid ""
"Allows the staff member to update client profile details and account "
"settings."
msgstr ""
"Позволяет сотруднику обновлять данные профиля клиента и настройки учетной "
"записи."

msgid ""
"Allows the staff member to update company details as set under the system "
"module."
msgstr ""
"Позволяет сотруднику обновлять данные компании, установленные в системном "
"модуле."

msgid ""
"Allows the staff member to update company legal as set under the system "
"module."
msgstr ""
"Позволяет сотруднику обновлять юридическую информацию компании, "
"установленную в системном модуле."

msgid ""
"Allows the staff member to update system parameters through the system API "
"endpoint."
msgstr ""
"Позволяет сотруднику обновлять системные параметры через конечную точку API "
"системы."

msgid ""
"Allows the staff member to view and generate API keys for client accounts."
msgstr ""
"Позволяет сотруднику просматривать и генерировать API ключи для клиентов "
"аккаунтов."

msgid "Allows the staff member to view client account details and listings."
msgstr ""
"Разрешает сотруднику просматривать данные учетной записи клиента и списки "
"клиентов."

msgid "Allows the staff member to view client login history and IP addresses."
msgstr "Позволяет сотруднику просматривать историю входа клиента и IP-адреса."

msgid "Allows the staff member to view email templates and template details."
msgstr "Позволяет сотруднику просматривать шаблоны писем и детали шаблона."

msgid "Allows the staff member to view sent emails and queued email messages."
msgstr ""
"Позволяет сотруднику просматривать отправленные письма и отправленные в "
"очередь сообщения."

