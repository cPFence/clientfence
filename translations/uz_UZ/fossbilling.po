msgstr ""
"Xodimga kengaytmalarni o'rnatish, yangilash yoki o'chirishga ruxsat beradi."

msgid ""
"Allows the staff member to invalidate the ClientFence cache from within the "
"system settings."
msgstr ""
"Xodimga tizim sozlamalari ichidan ClientFence keshini bekor qilish imkonini "
"beradi."

msgid ""
"Allows the staff member to invalidate the FOSSBilling cache from within the "
"system settings."
msgstr ""
"Xodimga tizim sozlamalari ichidan FOSSBilling keshini bekor qilish imkonini "
"beradi."

msgid ""
"Allows the staff member to invoke hooks manually with custom event payloads."
msgstr ""
"Xodimga maxsus hodisa yuklamalari bilan ilgaklarni qo'lda chaqirish imkonini "
"beradi."

msgid ""
"Allows the staff member to manage client module settings and configuration."
msgstr ""
"Xodimga mijoz moduli sozlamalari va konfiguratsiyasini boshqarishga ruxsat "
"beradi."

msgid "Allows the staff member to manage staff member groups."
msgstr "Xodimga xodimlar guruhlarini boshqarishga ruxsat beradi."

msgid "Allows the staff member to perform password resets on :type: accounts."
msgstr ""
"Xodimga:type: hisoblarida parolni tiklashni amalga oshirishga ruxsat beradi."

msgid "Allows the staff member to permanently remove client accounts."
msgstr "Xodimga mijoz hisoblarini butunlay olib tashlashga ruxsat beradi."

msgid ""
"Allows the staff member to permanently remove multiple client accounts in a "
"single action."
msgstr ""
"Xodimga bitta amalda bir nechta mijoz hisoblarini butunlay olib tashlash "
"imkonini beradi."

