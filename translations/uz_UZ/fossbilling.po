msgstr ""
"Xodimga barcha valyuta ayirboshlash kurslarini yangilash imkonini beradi."

msgid "Allows the staff member to remove currencies from the system."
msgstr "Xodimga tizimdan valyutalarni olib tashlashga ruxsat beradi."

msgid ""
"Allows the staff member to run security checks on the ClientFence "
"installation."
msgstr ""
"Xodimga ClientFence o'rnatishda xavfsizlik tekshiruvlarini o'tkazishga "
"ruxsat beradi."

