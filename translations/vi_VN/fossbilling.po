msgid ""
"Allow the staff member to uninstall extensions, including their associated "
"database records and files."
msgstr ""
"Cho phép nhân viên gỡ cài đặt tiện ích mở rộng, bao gồm các bản ghi cơ sở dữ "
"liệu và tệp liên quan."

msgid "Allow transfer:"
msgstr "Cho phép chuyển tiếp:"

msgid "Allows the staff member to add new currencies to the system."
msgstr "Cho phép nhân viên thêm tiền tệ mới vào hệ thống."

msgid ""
"Allows the staff member to add or remove balance entries for client accounts."
msgstr "Cho phép nhân viên thêm hoặc xóa số dư cho tài khoản khách hàng."

msgid "Allows the staff member to authenticate as any client account."
msgstr ""
"Cho phép nhân viên xác thực với tư cách bất kỳ tài khoản khách hàng nào."

msgid "Allows the staff member to change the system default currency."
msgstr "Cho phép nhân viên thay đổi tiền tệ mặc định của hệ thống."

msgid ""
"Allows the staff member to clear cached update information and fetch the "
"latest update metadata."
msgstr ""
"Cho phép nhân viên xóa thông tin cập nhật đã lưu và lấy metadata cập nhật "
"mới nhất."

msgid "Allows the staff member to create and edit :type: accounts."
msgstr "Cho phép nhân viên tạo và chỉnh sửa tài khoản :type:."

msgid "Allows the staff member to create and edit redirects."
msgstr "Cho phép nhân viên tạo và chỉnh sửa các chuyển hướng."

msgid "Allows the staff member to create new client accounts."
msgstr "Cho phép nhân viên tạo tài khoản khách hàng mới."

msgid "Allows the staff member to create, update, and delete client groups."
msgstr "Cho phép nhân viên tạo, cập nhật và xóa nhóm khách hàng."

msgid ""
"Allows the staff member to create, update, delete, reset, and regenerate "
"email templates."
msgstr "Cho phép nhân viên tạo, cập nhật, xóa, đặt lại và tái tạo mẫu email."

