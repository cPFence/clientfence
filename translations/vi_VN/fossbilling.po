msgstr ""
"Cho phép nhân viên cập nhật thông số hệ thống qua API endpoint hệ thống."

msgid ""
"Allows the staff member to view and generate API keys for client accounts."
msgstr "Cho phép nhân viên xem và tạo khóa API cho tài khoản khách hàng."

msgid "Allows the staff member to view client account details and listings."
msgstr ""
"Cho phép nhân viên xem thông tin chi tiết và danh sách tài khoản khách hàng."

msgid "Allows the staff member to view client login history and IP addresses."
msgstr "Cho phép nhân viên xem lịch sử đăng nhập và địa chỉ IP của khách hàng."

msgid "Allows the staff member to view email templates and template details."
msgstr "Cho phép nhân viên xem mẫu email và thông tin chi tiết mẫu."

msgid "Allows the staff member to view sent emails and queued email messages."
msgstr "Cho phép nhân viên xem email đã gửi và email trong hàng đợi."

