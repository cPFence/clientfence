"Allows the staff member to fetch a list of all local interface IP addresses "
"and set the default network interface for FOSSBilling to use."
msgstr ""
"Дозволяє співробітнику отримати список всіх IP-адрес локального інтерфейсу і "
"встановити мережевий інтерфейс за замовчуванням для FOSSBilling."

msgid ""
"Allows the staff member to invalidate the ClientFence cache from within the "
"system settings."
msgstr ""
"Дозволяє співробітнику анулювати кеш ClientFence з налаштувань системи."

msgid ""
"Allows the staff member to invalidate the FOSSBilling cache from within the "
"system settings."
msgstr ""
"Дозволяє співробітнику анулювати кеш FOSSBilling з налаштувань системи."

msgid "Allows the staff member to manage staff member groups."
msgstr "Дозволяє співробітникам керувати групами співробітників."

msgid "Allows the staff member to perform password resets on :type: accounts."
msgstr ""
"Дозволяє персоналу виконувати скидання пароля для облікового запису :type: ."

msgid "Allows the staff member to update ClientFence."
msgstr "Дозволяє співробітнику оновити ClientFence."

msgid "Allows the staff member to update FOSSBilling."
msgstr "Дозволяє співробітнику оновити FOSSBilling."

msgid ""
"Allows the staff member to update company details as set under the system "
"module."
msgstr ""
"Дозволяє співробітникам оновлювати інформацію про компанію, як встановлено в "
"модулі системи."

msgid ""
"Allows the staff member to update company legal as set under the system "
"module."
msgstr ""
"Дозволяє співробітнику оновлювати юридичні документи компанії відповідно до "
"налаштувань системного модуля."

